      "title": "Indiana Departmental Notice #1 — How to Compute Withholding for State and County Income Tax",
      "revision": "R46 / 01-26",
      "sha256": "a4c6e71c43295bfe273d5831922565bcd49cb2f0b33208e59d922c4274a0b77d",
      "bytes": 204818
    }
  ],
  "selection": {
    "determinationDate": "January 1 of the employee's taxable year",
    "precedence": [
      { "when": "Employee resides in an Indiana county on the determination date", "jurisdictionBasis": "residenceCounty" },
      { "when": "Employee resides outside Indiana and has a principal place of work or business in an Indiana county on the determination date", "jurisdictionBasis": "principalWorkCounty" }
    ],
    "midyearMoveDoesNotChangeSelectedCounty": true
  },
  "calculation": {
    "method": "periodic-deduction-then-separate-flat-state-and-county-rates",
    "stateRate": 0.0295,
    "annualDeductions": {
      "personalExemption": 1000,
      "additionalDependentExemption": 1500,
      "firstTimeAdditionalDependentExemption": 1500,
      "adoptedChildDependentExemption": 3000
    },
    "periodicPayments": "Subtract each annual deduction divided by the number of payroll periods from gross wages, then apply the state and selected county rates separately.",
    "oneTimeOrNonPeriodicPayments": "Compute withholding without exemptions.",
    "federalNoWithholdingElectionRecognized": false,
    "publishedDeductionConstants": {
      "personalExemption": { "Daily": 2.74, "Weekly": 19.23, "Biweekly": 38.46, "Semimonthly": 41.67, "Monthly": 83.33 },
      "additionalOrFirstTimeDependentExemption": { "Daily": 4.11, "Weekly": 28.85, "Biweekly": 57.69, "Semimonthly": 62.50, "Monthly": 125.00 },
      "adoptedChildDependentExemption": { "Daily": 8.22, "Weekly": 57.69, "Biweekly": 115.38, "Semimonthly": 125.00, "Monthly": 250.00 }
    },
    "rounding": "The publication displays deduction constants and each state/county withholding result to cents; exact intermediate and tie-breaking behavior requires independent verification before activation."
  },
  "employeeInputs": [
    { "code": "indianaResidenceCountyOnJanuary1", "source": "Form WH-4", "requiredWhen": "Indiana resident" },
    { "code": "indianaPrincipalWorkCountyOnJanuary1", "source": "Form WH-4", "requiredWhen": "Nonresident with principal Indiana work location" },
    { "code": "personalExemptions", "source": "Form WH-4 line 5" },
    { "code": "additionalDependentExemptions", "source": "Form WH-4 line 6" },
    { "code": "firstTimeAdditionalDependentExemptions", "source": "Form WH-4 line 7" },
    { "code": "adoptedChildDependentExemptions", "source": "Form WH-4 line 8" },
    { "code": "nonresidentThirtyDayAffidavit", "source": "Form WH-4AFF" },
    { "code": "indianaWorkDaysYearToDate", "source": "Contemporaneous time and attendance plus prior-employer days" }
  ],
  "specialRules": {
    "qualifyingNonresidentThirtyDayRule": {
      "withholdingMayBeDeferredWhen": [
        "A contemporaneous time-and-attendance system allocates compensation by out-of-state work location and the employee is reasonably expected to work in Indiana for 30 days or fewer during the year",
        "The employee supplies a properly completed Form WH-4AFF"
      ],
      "thresholdDays": 30,
      "priorEmployerIndianaDaysCount": true,
      "whenThresholdExceeded": "Withhold amounts otherwise due for the first 30 days and withhold on later Indiana compensation; reasonable catch-up withholding is permitted and is reported when actually withheld.",
      "excludedWorkers": ["Professional athlete", "Professional sports team member", "Race team member", "Professional entertainer", "Public figure", "Anyone who is or will become an Indiana resident during the year"]
    },
    "specialIndustryReferences": ["Income Tax Information Bulletin #88", "Income Tax Information Bulletin #88B"]
  },
