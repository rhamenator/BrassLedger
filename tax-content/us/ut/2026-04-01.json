  "businessRules": [
    { "code": "UT-WORK-IN-STATE", "description": "Withhold for wages paid for work performed in Utah unless an employee exclusion applies." },
    { "code": "UT-RESIDENT-OUT-OF-STATE", "description": "Withhold for a Utah resident working outside Utah; reduce Utah withholding by tax withheld by the other state, not below zero." },
    { "code": "UT-NONRESIDENT-20-DAY", "description": "A qualifying nonresident with no other Utah income who works in Utah for 20 days or fewer may be excluded when the residence-state conditions are satisfied." },
    { "code": "UT-INTERSTATE-TRANSPORT", "description": "Qualifying interstate transportation wages are taxable only by the employee's residence state and require the specified W-4 annotation." },
    { "code": "UT-MILITARY-SPOUSE", "description": "Qualifying nonresident military-spouse wages are exempt when the required W-4 annotation and eligibility conditions are present." },
    { "code": "UT-ZERO-RETURN", "description": "An open withholding account must file a return even when withholding is zero." },
    { "code": "UT-EFILE", "description": "Withholding returns, annual reconciliation, W-2s, and Utah-reportable 1099s must be filed electronically." }
  ],
