@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="branding/brassledger-mark.svg" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes @rendermode="RoutesRenderMode" />
    </CascadingAuthenticationState>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="blazor-start.js"></script>
</body>

</html>

@code {
    private Microsoft.AspNetCore.Components.IComponentRenderMode? RoutesRenderMode
    {
        get
        {
            var path = HttpContextAccessor.HttpContext?.Request.Path.Value;
            return path is not null && (path.StartsWith("/login", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/setup", StringComparison.OrdinalIgnoreCase))
                ? null
                : InteractiveServer;
        }
    }
}
