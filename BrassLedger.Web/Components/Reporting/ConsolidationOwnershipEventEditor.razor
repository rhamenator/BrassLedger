@using BrassLedger.Application.Accounting
@using BrassLedger.Domain.Accounting
@using BrassLedger.Infrastructure.Auth
@using System.Text.Json
@inject IConsolidationService ConsolidationService

<section class="panel" aria-labelledby="ownershipEventsHeading">
    <h3 id="ownershipEventsHeading">Acquisitions, disposals, ownership changes and attribution</h3>
    <p class="page-intro">Retain the measurement schedule and its balanced consolidation-only posting together. The application checks the accounting equation, ownership history and reporting accounts; separate operators prepare, approve and post each event.</p>
    @if (!string.IsNullOrWhiteSpace(Message)) { <div class="@(IsError ? "auth-error" : "muted-copy")" role="@(IsError ? "alert" : "status")">@Message</div> }
    @if (Workspace is null)
    {
        <p class="muted-copy">Ownership events are unavailable because this user does not have access to every company in the retained ownership history.</p>
    }
    else
    {
        <EditForm Model="Editor" OnValidSubmit="SaveAsync">
            <div class="content-grid">
                <div class="field-group"><label class="field-label" for="ownershipSubject">Subject company</label><InputSelect id="ownershipSubject" class="field-input" @bind-Value="Editor.SubjectCompanyId"><option value="@Guid.Empty">Choose a company</option>@foreach (var member in Workspace.Members.GroupBy(item => item.CompanyId).Select(group => group.First()).OrderBy(item => item.CompanyName)) { <option value="@member.CompanyId">@member.CompanyName</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label" for="ownershipEventDate">Accounting date</label><InputDate id="ownershipEventDate" class="field-input" @bind-Value="Editor.EventDate" /></div>
                <div class="field-group"><label class="field-label" for="ownershipEventType">Event type</label><InputSelect id="ownershipEventType" class="field-input" @bind-Value="Editor.EventType">@foreach (var eventType in EventTypes) { <option value="@eventType">@EventLabel(eventType)</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label" for="ownershipReference">Reference</label><InputText id="ownershipReference" class="field-input" maxlength="64" @bind-Value="Editor.Reference" /></div>
                <div class="field-group"><label class="field-label" for="ownershipFramework">Framework</label><InputText id="ownershipFramework" class="field-input" maxlength="32" list="ownershipFrameworkChoices" @bind-Value="Editor.FrameworkCode" /><datalist id="ownershipFrameworkChoices"><option value="US-GAAP"></option><option value="IFRS"></option><option value="IFRS-SME"></option><option value="Other"></option></datalist></div>
                <div class="field-group"><label class="field-label" for="ownershipFrameworkEdition">Framework edition</label><InputText id="ownershipFrameworkEdition" class="field-input" maxlength="80" @bind-Value="Editor.FrameworkEdition" /></div>
                <div class="field-group"><label class="field-label" for="ownershipBefore">Ownership before</label><InputNumber id="ownershipBefore" class="field-input" min="0" max="1" step="0.000001" @bind-Value="Editor.OwnershipBefore" /><small>Use 0.75 for 75%.</small></div>
                <div class="field-group"><label class="field-label" for="ownershipAfter">Ownership after</label><InputNumber id="ownershipAfter" class="field-input" min="0" max="1" step="0.000001" @bind-Value="Editor.OwnershipAfter" /></div>
                <div class="field-group"><label class="field-label" for="ownershipNciMethod">NCI measurement</label><InputSelect id="ownershipNciMethod" class="field-input" @bind-Value="Editor.NciMeasurementMethod"><option value="FullFairValue">Full fair value</option><option value="ProportionateShare">Proportionate share</option><option value="NotApplicable">Not applicable</option></InputSelect></div>
                <div class="field-group"><label class="field-label" for="ownershipRationale">Measurement rationale</label><InputTextArea id="ownershipRationale" class="field-input" maxlength="4000" @bind-Value="Editor.MeasurementRationale" /></div>
                <div class="field-group"><label class="field-label" for="ownershipSource">Source / working paper</label><InputText id="ownershipSource" class="field-input" maxlength="1000" @bind-Value="Editor.SourceReference" /></div>
            </div>

            @if (Editor.EventType is nameof(ConsolidationOwnershipEventType.AcquisitionOfControl) or nameof(ConsolidationOwnershipEventType.StepAcquisition))
            {
                <h4>Acquisition-method measurement</h4>
                <div class="content-grid">
                    <OwnershipMoneyInput Label="Consideration transferred" Id="acquisitionConsideration" @bind-Value="Editor.ConsiderationTransferred" />
                    <OwnershipMoneyInput Label="Previously held interest at fair value" Id="acquisitionPriorInterest" @bind-Value="Editor.PreviousInterestFairValue" />
                    <OwnershipMoneyInput Label="NCI recognized" Id="acquisitionNci" @bind-Value="Editor.NoncontrollingInterestRecognized" />
                    <OwnershipMoneyInput Label="Identifiable net assets at fair value" Id="acquisitionNetAssets" @bind-Value="Editor.IdentifiableNetAssetsFairValue" />
                    <OwnershipMoneyInput Label="Goodwill" Id="acquisitionGoodwill" @bind-Value="Editor.Goodwill" />
                    <OwnershipMoneyInput Label="Bargain purchase gain" Id="acquisitionBargain" @bind-Value="Editor.BargainPurchaseGain" />
                </div><p class="muted-copy">Calculated residual: @AcquisitionResidual.ToString("N2"). Positive is goodwill; negative is a bargain gain.</p>
                <div class="field-group"><label class="field-label" for="acquisitionMeasurementEnd">Measurement-period end</label><InputDate id="acquisitionMeasurementEnd" class="field-input" @bind-Value="Editor.MeasurementPeriodEndsOn" /></div>
                <h4>Consideration components</h4><p class="muted-copy">Break total consideration into cash, equity, contingent or deferred consideration, replacement awards, and other supported components. Detail difference: @ConsiderationDetailDifference.ToString("N2").</p>
                @foreach (var component in Editor.ConsiderationComponents)
                {
                    <fieldset class="panel" @key="component"><legend>Consideration component</legend><div class="content-grid">
                        <div class="field-group"><label class="field-label">Code</label><InputText aria-label="Consideration component code" class="field-input" maxlength="64" @bind-Value="component.Code" /></div>
                        <div class="field-group"><label class="field-label">Description</label><InputText aria-label="Consideration component description" class="field-input" maxlength="300" @bind-Value="component.Description" /></div>
                        <div class="field-group"><label class="field-label">Type</label><InputSelect aria-label="Consideration component type" class="field-input" @bind-Value="component.ComponentType">@foreach (var kind in ConsiderationTypes) { <option value="@kind">@SplitLabel(kind)</option> }</InputSelect></div>
                        <OwnershipMoneyInput Label="Consideration component fair value" @bind-Value="component.FairValue" />
                        <div class="field-group"><label class="field-label">Source / working paper</label><InputText aria-label="Consideration component source" class="field-input" maxlength="1000" @bind-Value="component.SourceReference" /></div>
                    </div><button class="action-secondary" type="button" @onclick="() => Editor.ConsiderationComponents.Remove(component)">Remove component</button></fieldset>
                }
                <button class="action-secondary" type="button" @onclick="() => Editor.ConsiderationComponents.Add(new())">Add consideration component</button>
                <h4>Identifiable assets, liabilities and deferred tax</h4><p class="muted-copy">Net line-item fair value: @IdentifiableDetailTotal.ToString("N2"); difference from the acquisition total: @IdentifiableDetailDifference.ToString("N2").</p>
                @foreach (var item in Editor.IdentifiableItems)
                {
                    <fieldset class="panel" @key="item"><legend>Identifiable item</legend><div class="content-grid">
                        <div class="field-group"><label class="field-label">Code</label><InputText aria-label="Identifiable item code" class="field-input" maxlength="64" @bind-Value="item.Code" /></div>
                        <div class="field-group"><label class="field-label">Description</label><InputText aria-label="Identifiable item description" class="field-input" maxlength="300" @bind-Value="item.Description" /></div>
                        <div class="field-group"><label class="field-label">Type</label><InputSelect aria-label="Identifiable item type" class="field-input" @bind-Value="item.ItemType"><option value="Asset">Asset</option><option value="Liability">Liability</option></InputSelect></div>
                        <OwnershipMoneyInput Label="Identifiable item fair value" @bind-Value="item.FairValue" />
                        <OwnershipMoneyInput Label="Deferred-tax asset" @bind-Value="item.DeferredTaxAsset" />
                        <OwnershipMoneyInput Label="Deferred-tax liability" @bind-Value="item.DeferredTaxLiability" />
                        <div class="field-group"><label class="field-label">Source / working paper</label><InputText aria-label="Identifiable item source" class="field-input" maxlength="1000" @bind-Value="item.SourceReference" /></div>
                    </div><button class="action-secondary" type="button" @onclick="() => Editor.IdentifiableItems.Remove(item)">Remove item</button></fieldset>
                }
                <button class="action-secondary" type="button" @onclick="() => Editor.IdentifiableItems.Add(new())">Add identifiable item</button>
                <h4>Measurement-period adjustments</h4><p class="muted-copy">Add only new information about acquisition-date facts. Each row independently reconciles to its goodwill or bargain-gain change.</p>
                @foreach (var adjustment in Editor.MeasurementPeriodAdjustments)
                {
                    <fieldset class="panel" @key="adjustment"><legend>Measurement-period adjustment</legend><div class="content-grid">
                        <div class="field-group"><label class="field-label">Recognized on</label><InputDate aria-label="Measurement adjustment date" class="field-input" @bind-Value="adjustment.RecognizedOn" /></div>
                        <div class="field-group"><label class="field-label">Code</label><InputText aria-label="Measurement adjustment code" class="field-input" maxlength="64" @bind-Value="adjustment.Code" /></div>
                        <div class="field-group"><label class="field-label">Description</label><InputText aria-label="Measurement adjustment description" class="field-input" maxlength="500" @bind-Value="adjustment.Description" /></div>
                        <OwnershipMoneyInput Label="Consideration change" @bind-Value="adjustment.ConsiderationChange" /><OwnershipMoneyInput Label="Prior-interest fair-value change" @bind-Value="adjustment.PreviousInterestFairValueChange" />
                        <OwnershipMoneyInput Label="NCI change" @bind-Value="adjustment.NoncontrollingInterestChange" /><OwnershipMoneyInput Label="Identifiable net-assets change" @bind-Value="adjustment.IdentifiableNetAssetsChange" />
                        <OwnershipMoneyInput Label="Goodwill change" @bind-Value="adjustment.GoodwillChange" /><OwnershipMoneyInput Label="Bargain-gain change" @bind-Value="adjustment.BargainPurchaseGainChange" />
                        <div class="field-group"><label class="field-label">Source / working paper</label><InputText aria-label="Measurement adjustment source" class="field-input" maxlength="1000" @bind-Value="adjustment.SourceReference" /></div>
                    </div><p class="muted-copy">Adjustment difference: @MeasurementAdjustmentDifference(adjustment).ToString("N2")</p><button class="action-secondary" type="button" @onclick="() => Editor.MeasurementPeriodAdjustments.Remove(adjustment)">Remove adjustment</button></fieldset>
                }
                <button class="action-secondary" type="button" @onclick="AddMeasurementPeriodAdjustment">Add measurement-period adjustment</button>
            }
            else if (Editor.EventType == nameof(ConsolidationOwnershipEventType.OwnershipChangeWithoutLossOfControl))
            {
                <h4>Equity-transaction measurement</h4><div class="content-grid">
                    <OwnershipMoneyInput Label="Consideration paid" Id="changePaid" @bind-Value="Editor.ConsiderationPaid" />
                    <OwnershipMoneyInput Label="Consideration received" Id="changeReceived" @bind-Value="Editor.ConsiderationReceived" />
                    <OwnershipMoneyInput Label="NCI increase" Id="changeNciIncrease" @bind-Value="Editor.NciIncrease" />
                    <OwnershipMoneyInput Label="NCI decrease" Id="changeNciDecrease" @bind-Value="Editor.NciDecrease" />
                    <OwnershipMoneyInput Label="Parent equity debit" Id="changeParentDebit" @bind-Value="Editor.ParentEquityDebit" />
                    <OwnershipMoneyInput Label="Parent equity credit" Id="changeParentCredit" @bind-Value="Editor.ParentEquityCredit" />
                </div><p class="muted-copy">Measurement difference: @OwnershipChangeDifference.ToString("N2")</p>
            }
            else if (Editor.EventType == nameof(ConsolidationOwnershipEventType.LossOfControl))
            {
                <h4>Loss-of-control measurement</h4><div class="content-grid">
                    <OwnershipMoneyInput Label="Consideration received" Id="lossProceeds" @bind-Value="Editor.LossConsiderationReceived" />
                    <OwnershipMoneyInput Label="Retained interest fair value" Id="lossRetained" @bind-Value="Editor.RetainedInterestFairValue" />
                    <OwnershipMoneyInput Label="NCI derecognized" Id="lossNci" @bind-Value="Editor.NciDerecognized" />
                    <OwnershipMoneyInput Label="Net assets derecognized" Id="lossNetAssets" @bind-Value="Editor.NetAssetsDerecognized" />
                    <OwnershipMoneyInput Label="Goodwill derecognized" Id="lossGoodwill" @bind-Value="Editor.GoodwillDerecognized" />
                    <OwnershipMoneyInput Label="OCI reclassification (signed)" Id="lossOci" @bind-Value="Editor.OciReclassification" />
                    <OwnershipMoneyInput Label="Gain / (loss)" Id="lossGain" @bind-Value="Editor.GainOrLoss" />
                </div><p class="muted-copy">Calculated gain / (loss): @LossOfControlResult.ToString("N2")</p>
            }
            else
            {
                <h4>Profit and OCI attribution</h4><div class="content-grid">
                    <OwnershipMoneyInput Label="Subsidiary profit / (loss)" Id="attrProfit" @bind-Value="Editor.SubsidiaryProfitOrLoss" />
                    <OwnershipMoneyInput Label="Parent profit / (loss)" Id="attrParentProfit" @bind-Value="Editor.ParentProfitOrLoss" />
                    <OwnershipMoneyInput Label="NCI profit / (loss)" Id="attrNciProfit" @bind-Value="Editor.NciProfitOrLoss" />
                    <OwnershipMoneyInput Label="Subsidiary OCI" Id="attrOci" @bind-Value="Editor.SubsidiaryOci" />
                    <OwnershipMoneyInput Label="Parent OCI" Id="attrParentOci" @bind-Value="Editor.ParentOci" />
                    <OwnershipMoneyInput Label="NCI OCI" Id="attrNciOci" @bind-Value="Editor.NciOci" />
                </div><p class="muted-copy">Profit attribution difference: @ProfitDifference.ToString("N2"); OCI attribution difference: @OciDifference.ToString("N2")</p>
            }

            <h4>Consolidation-only posting</h4>
            <p class="muted-copy">Use only mapped reporting accounts. If the posting contains revenue or expense, choose the equity account that will carry that result after the event period.</p>
            <div class="field-group"><label class="field-label" for="ownershipCarryforward">Prior-period retained-earnings account</label><InputSelect id="ownershipCarryforward" class="field-input" @bind-Value="Editor.CarryforwardAccountChoice"><option value="">Not needed</option>@foreach (var account in Workspace.ReportingAccounts.Where(item => item.AccountType == nameof(AccountType.Equity))) { <option value="@AccountChoiceValue(account)">@account.AccountNumber · @account.AccountName</option> }</InputSelect></div>
            @foreach (var line in Editor.PostingLines)
            {
                <fieldset class="panel" @key="line"><legend>Posting line</legend><div class="content-grid">
                    <div class="field-group"><label class="field-label">Reporting account</label><InputSelect aria-label="Ownership-event reporting account" class="field-input" @bind-Value="line.AccountChoice"><option value="">Choose an account</option>@foreach (var account in Workspace.ReportingAccounts) { <option value="@AccountChoiceValue(account)">@account.AccountNumber · @account.AccountName (@account.AccountType)</option> }</InputSelect></div>
                    <OwnershipMoneyInput Label="Debit" @bind-Value="line.Debit" />
                    <OwnershipMoneyInput Label="Credit" @bind-Value="line.Credit" />
                    <div class="field-group"><label class="field-label">Description</label><InputText class="field-input" maxlength="1000" @bind-Value="line.Description" /></div>
                </div><button class="action-secondary" type="button" @onclick="() => Editor.PostingLines.Remove(line)">Remove line</button></fieldset>
            }
            <p class="muted-copy">Posting difference (debits less credits): @PostingDifference.ToString("N2")</p>
            <div class="hero-actions"><button class="action-secondary" type="button" @onclick="() => Editor.PostingLines.Add(new())">Add posting line</button><button class="action-secondary" type="button" @onclick="UseStatementDate">Use statement date</button><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareJournals" Context="ownershipPreparationAuthorization"><button class="action-primary" type="submit">@(Editor.Id.HasValue ? "Save corrected event" : "Prepare ownership event")</button></AuthorizeView>@if (Editor.Id.HasValue) { <button class="action-secondary" type="button" @onclick="ResetEditor">Cancel edit</button> }</div>
        </EditForm>

        <div class="content-grid"><div class="field-group"><label class="field-label" for="ownershipDecisionReason">Rejection or reversal reason</label><InputText id="ownershipDecisionReason" class="field-input" maxlength="1000" @bind-Value="DecisionReason" /></div><div class="field-group"><label class="field-label" for="ownershipReversalDate">Reversal date</label><InputDate id="ownershipReversalDate" class="field-input" @bind-Value="ReversalDate" /></div></div>
        @if (Workspace.Events.Count == 0) { <p class="muted-copy">No ownership events have been retained for this group.</p> }
        else
        {
            <div class="table-scroll"><table class="data-table" aria-label="Retained consolidation ownership events"><thead><tr><th>Date / event</th><th>Measurement</th><th>Status</th><th>Control history</th><th>Actions</th></tr></thead><tbody>
            @foreach (var item in Workspace.Events)
            {
                <tr><td>@item.EventDate<br /><strong>@EventLabel(item.EventType)</strong><br />@item.SubjectCompanyName · @item.Reference<br /><small>@item.FrameworkCode · @item.FrameworkEdition · schema @item.SchemaVersion<br />SHA-256 @item.ContentSha256</small></td><td>@(item.Content.OwnershipBefore.ToString("P2")) → @(item.Content.OwnershipAfter.ToString("P2"))<br />@item.Content.PostingLines.Count posting line(s)</td><td>@item.Status@if (!string.IsNullOrWhiteSpace(item.DecisionReason)) { <br /><small>@item.DecisionReason</small> }@if (!string.IsNullOrWhiteSpace(item.ReversalReason)) { <br /><small>@item.ReversalReason</small> }</td><td>Prepared by @item.PreparedBy<br /><small>@item.PreparedAtUtc.LocalDateTime</small>@if (item.ApprovedBy is not null) { <br /><span>Approved by @item.ApprovedBy</span> }@if (item.PostedBy is not null) { <br /><span>Posted by @item.PostedBy</span> }</td><td><div class="hero-actions">@if (item.Status is "Draft" or "Rejected") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareJournals"><button class="action-secondary" type="button" @onclick="() => Edit(item)">Edit</button></AuthorizeView> }@if (item.Status == "Draft") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApproveJournals"><button class="action-primary" type="button" @onclick="() => ApproveAsync(item)">Approve</button><button class="action-secondary" type="button" @onclick="() => RejectAsync(item)">Reject</button></AuthorizeView> }@if (item.Status == "Approved") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PostJournals"><button class="action-primary" type="button" @onclick="() => PostAsync(item)">Post</button></AuthorizeView> }@if (item.Status == "Posted" && item.ReversalOfEventId is null) { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReverseJournals"><button class="action-secondary" type="button" @onclick="() => ReverseAsync(item)">Reverse</button></AuthorizeView> }</div></td></tr>
            }
            </tbody></table></div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid GroupId { get; set; }
    [Parameter] public DateOnly AsOf { get; set; }
    private Guid LoadedGroupId;
    private ConsolidationOwnershipEventWorkspace? Workspace;
    private OwnershipEventEditor Editor = new();
    private string DecisionReason = string.Empty; private DateOnly ReversalDate; private string Message = string.Empty; private bool IsError;
    private static readonly string[] EventTypes = Enum.GetNames<ConsolidationOwnershipEventType>();
    private static readonly string[] ConsiderationTypes = ["Cash", "EquityIssued", "ContingentConsideration", "DeferredConsideration", "ReplacementAward", "Other"];
    private decimal AcquisitionResidual => Editor.ConsiderationTransferred + Editor.PreviousInterestFairValue + Editor.NoncontrollingInterestRecognized - Editor.IdentifiableNetAssetsFairValue;
    private decimal ConsiderationDetailDifference => Editor.ConsiderationTransferred - Editor.ConsiderationComponents.Sum(item => item.FairValue);
    private decimal IdentifiableDetailTotal => Editor.IdentifiableItems.Sum(item => (item.ItemType == "Asset" ? item.FairValue : -item.FairValue) + item.DeferredTaxAsset - item.DeferredTaxLiability);
    private decimal IdentifiableDetailDifference => Editor.IdentifiableNetAssetsFairValue - IdentifiableDetailTotal;
    private decimal OwnershipChangeDifference => Editor.NciDecrease + Editor.ParentEquityDebit + Editor.ConsiderationReceived - Editor.NciIncrease - Editor.ParentEquityCredit - Editor.ConsiderationPaid;
    private decimal LossOfControlResult => Editor.LossConsiderationReceived + Editor.RetainedInterestFairValue + Editor.NciDerecognized - Editor.NetAssetsDerecognized - Editor.GoodwillDerecognized + Editor.OciReclassification;
    private decimal ProfitDifference => Editor.SubsidiaryProfitOrLoss - Editor.ParentProfitOrLoss - Editor.NciProfitOrLoss;
    private decimal OciDifference => Editor.SubsidiaryOci - Editor.ParentOci - Editor.NciOci;
    private decimal PostingDifference => Editor.PostingLines.Sum(item => item.Debit - item.Credit);
    private string AccountChoiceValue(ConsolidationReportingAccountSnapshot account) => Workspace!.ReportingAccounts.Count(item => item.AccountNumber == account.AccountNumber) == 1 ? account.AccountNumber : $"{account.AccountType}\u001f{account.AccountNumber}\u001f{account.AccountName}";
    private ConsolidationReportingAccountSnapshot? ResolveAccount(string choice) => Workspace?.ReportingAccounts.SingleOrDefault(item => AccountChoiceValue(item) == choice);
    private string ChoiceForStoredAccount(string number, string name, string type)
    {
        var account = Workspace?.ReportingAccounts.SingleOrDefault(item => item.AccountNumber == number && item.AccountName == name && item.AccountType == type);
        return account is null ? string.Empty : AccountChoiceValue(account);
    }

    protected override async Task OnParametersSetAsync() { if (GroupId == Guid.Empty || GroupId == LoadedGroupId) return; LoadedGroupId = GroupId; Workspace = await ConsolidationService.GetOwnershipEventWorkspaceAsync(GroupId); ResetEditor(); }
    private void UseStatementDate() { Editor.EventDate = AsOf; Editor.MeasurementPeriodEndsOn = DefaultMeasurementPeriodEnd(AsOf); ReversalDate = AsOf; }
    private void ResetEditor() { Editor = new() { EventDate = AsOf, MeasurementPeriodEndsOn = DefaultMeasurementPeriodEnd(AsOf), ConsiderationComponents = [new()], IdentifiableItems = [new()], PostingLines = [new(), new()] }; DecisionReason = string.Empty; ReversalDate = AsOf; }
    private static string EventLabel(string value) => value switch { nameof(ConsolidationOwnershipEventType.AcquisitionOfControl) => "Acquisition of control", nameof(ConsolidationOwnershipEventType.StepAcquisition) => "Step acquisition", nameof(ConsolidationOwnershipEventType.OwnershipChangeWithoutLossOfControl) => "Ownership change without loss of control", nameof(ConsolidationOwnershipEventType.LossOfControl) => "Loss of control / disposal", nameof(ConsolidationOwnershipEventType.ProfitAttribution) => "Profit and OCI attribution", _ => value };
    private static string SplitLabel(string value) => value switch { "EquityIssued" => "Equity issued", "ContingentConsideration" => "Contingent consideration", "DeferredConsideration" => "Deferred consideration", "ReplacementAward" => "Replacement award", _ => value };
    private static DateOnly DefaultMeasurementPeriodEnd(DateOnly date) => date > DateOnly.MaxValue.AddYears(-1) ? DateOnly.MaxValue : date.AddYears(1);
    private static decimal MeasurementAdjustmentDifference(MeasurementAdjustmentEditor adjustment) => adjustment.ConsiderationChange + adjustment.PreviousInterestFairValueChange + adjustment.NoncontrollingInterestChange - adjustment.IdentifiableNetAssetsChange - adjustment.GoodwillChange + adjustment.BargainPurchaseGainChange;
    private void AddMeasurementPeriodAdjustment() => Editor.MeasurementPeriodAdjustments.Add(new() { RecognizedOn = Editor.EventDate });

    private async Task SaveAsync()
    {
        if (Workspace is null) return;
        var lines = Editor.PostingLines.Select(line => { var account = ResolveAccount(line.AccountChoice); return new ConsolidationOwnershipPostingLine(account?.AccountNumber ?? string.Empty, account?.AccountName ?? string.Empty, account?.AccountType ?? string.Empty, line.Debit, line.Credit, line.Description, line.Extensions); }).ToArray();
        var carry = ResolveAccount(Editor.CarryforwardAccountChoice);
        AcquisitionOfControlMeasurement? acquisition = null; OwnershipChangeMeasurement? change = null; LossOfControlMeasurement? loss = null; ProfitAttributionMeasurement? attribution = null;
        if (Editor.EventType is nameof(ConsolidationOwnershipEventType.AcquisitionOfControl) or nameof(ConsolidationOwnershipEventType.StepAcquisition)) acquisition = new(Editor.ConsiderationTransferred, Editor.PreviousInterestFairValue, Editor.NoncontrollingInterestRecognized, Editor.IdentifiableNetAssetsFairValue, Editor.Goodwill, Editor.BargainPurchaseGain,
            Editor.ConsiderationComponents.Select(item => new AcquisitionConsiderationComponent(item.Code, item.Description, item.ComponentType, item.FairValue, item.SourceReference, item.Extensions)).ToArray(),
            Editor.IdentifiableItems.Select(item => new AcquisitionIdentifiableItem(item.Code, item.Description, item.ItemType, item.FairValue, item.DeferredTaxAsset, item.DeferredTaxLiability, item.SourceReference, item.Extensions)).ToArray(),
            Editor.MeasurementPeriodAdjustments.Select(item => new AcquisitionMeasurementPeriodAdjustment(item.RecognizedOn, item.Code, item.Description, item.ConsiderationChange, item.PreviousInterestFairValueChange, item.NoncontrollingInterestChange, item.IdentifiableNetAssetsChange, item.GoodwillChange, item.BargainPurchaseGainChange, item.SourceReference, item.Extensions)).ToArray(), Editor.MeasurementPeriodEndsOn, Editor.AcquisitionExtensions);
        else if (Editor.EventType == nameof(ConsolidationOwnershipEventType.OwnershipChangeWithoutLossOfControl)) change = new(Editor.ConsiderationPaid, Editor.ConsiderationReceived, Editor.NciIncrease, Editor.NciDecrease, Editor.ParentEquityDebit, Editor.ParentEquityCredit);
        else if (Editor.EventType == nameof(ConsolidationOwnershipEventType.LossOfControl)) loss = new(Editor.LossConsiderationReceived, Editor.RetainedInterestFairValue, Editor.NciDerecognized, Editor.NetAssetsDerecognized, Editor.GoodwillDerecognized, Editor.OciReclassification, Editor.GainOrLoss);
        else attribution = new(Editor.SubsidiaryProfitOrLoss, Editor.ParentProfitOrLoss, Editor.NciProfitOrLoss, Editor.SubsidiaryOci, Editor.ParentOci, Editor.NciOci);
        var content = new ConsolidationOwnershipEventDocument(2, Editor.OwnershipBefore, Editor.OwnershipAfter, Editor.NciMeasurementMethod, Editor.MeasurementRationale, Editor.SourceReference, carry?.AccountNumber ?? string.Empty, carry?.AccountName ?? string.Empty, lines, acquisition, change, loss, attribution, Editor.Extensions);
        var result = await ConsolidationService.SaveOwnershipEventAsync(new(Editor.Id, GroupId, Editor.SubjectCompanyId, Editor.EventDate, Editor.EventType, Editor.Reference, Editor.FrameworkCode, Editor.FrameworkEdition, content, Editor.ConcurrencyToken));
        await CompleteAsync(result, "The ownership event was retained for independent review.", result.Succeeded);
    }

    private void Edit(ConsolidationOwnershipEventSnapshot item)
    {
        var content = item.Content; Editor = new() { Id = item.Id, SubjectCompanyId = item.SubjectCompanyId, EventDate = item.EventDate, EventType = item.EventType, Reference = item.Reference, FrameworkCode = item.FrameworkCode, FrameworkEdition = item.FrameworkEdition, OwnershipBefore = content.OwnershipBefore, OwnershipAfter = content.OwnershipAfter, NciMeasurementMethod = content.NciMeasurementMethod, MeasurementRationale = content.MeasurementRationale, SourceReference = content.SourceReference, CarryforwardAccountChoice = ChoiceForStoredAccount(content.PriorPeriodEquityAccountNumber, content.PriorPeriodEquityAccountName, nameof(AccountType.Equity)), ConcurrencyToken = item.ConcurrencyToken, Extensions = content.Extensions, PostingLines = content.PostingLines.Select(line => new PostingEditor { AccountChoice = ChoiceForStoredAccount(line.ReportingAccountNumber, line.ReportingAccountName, line.ReportingAccountType), Debit = line.Debit, Credit = line.Credit, Description = line.Description, Extensions = line.Extensions }).ToList() };
        if (content.Acquisition is { } acquisition) { Editor.ConsiderationTransferred = acquisition.ConsiderationTransferred; Editor.PreviousInterestFairValue = acquisition.PreviousInterestFairValue; Editor.NoncontrollingInterestRecognized = acquisition.NoncontrollingInterestRecognized; Editor.IdentifiableNetAssetsFairValue = acquisition.IdentifiableNetAssetsFairValue; Editor.Goodwill = acquisition.Goodwill; Editor.BargainPurchaseGain = acquisition.BargainPurchaseGain; Editor.MeasurementPeriodEndsOn = acquisition.MeasurementPeriodEndsOn ?? DefaultMeasurementPeriodEnd(item.EventDate); Editor.AcquisitionExtensions = acquisition.Extensions; Editor.ConsiderationComponents = (acquisition.ConsiderationComponents ?? []).Select(value => new ConsiderationComponentEditor { Code = value.Code, Description = value.Description, ComponentType = value.ComponentType, FairValue = value.FairValue, SourceReference = value.SourceReference, Extensions = value.Extensions }).ToList(); Editor.IdentifiableItems = (acquisition.IdentifiableItems ?? []).Select(value => new IdentifiableItemEditor { Code = value.Code, Description = value.Description, ItemType = value.ItemType, FairValue = value.FairValue, DeferredTaxAsset = value.DeferredTaxAsset, DeferredTaxLiability = value.DeferredTaxLiability, SourceReference = value.SourceReference, Extensions = value.Extensions }).ToList(); Editor.MeasurementPeriodAdjustments = (acquisition.MeasurementPeriodAdjustments ?? []).Select(value => new MeasurementAdjustmentEditor { RecognizedOn = value.RecognizedOn, Code = value.Code, Description = value.Description, ConsiderationChange = value.ConsiderationChange, PreviousInterestFairValueChange = value.PreviousInterestFairValueChange, NoncontrollingInterestChange = value.NoncontrollingInterestChange, IdentifiableNetAssetsChange = value.IdentifiableNetAssetsChange, GoodwillChange = value.GoodwillChange, BargainPurchaseGainChange = value.BargainPurchaseGainChange, SourceReference = value.SourceReference, Extensions = value.Extensions }).ToList(); if (Editor.ConsiderationComponents.Count == 0) Editor.ConsiderationComponents.Add(new()); if (Editor.IdentifiableItems.Count == 0) Editor.IdentifiableItems.Add(new()); }
        if (content.OwnershipChange is { } change) { Editor.ConsiderationPaid = change.ConsiderationPaid; Editor.ConsiderationReceived = change.ConsiderationReceived; Editor.NciIncrease = change.NoncontrollingInterestIncrease; Editor.NciDecrease = change.NoncontrollingInterestDecrease; Editor.ParentEquityDebit = change.ParentEquityDebit; Editor.ParentEquityCredit = change.ParentEquityCredit; }
        if (content.LossOfControl is { } loss) { Editor.LossConsiderationReceived = loss.ConsiderationReceived; Editor.RetainedInterestFairValue = loss.RetainedInterestFairValue; Editor.NciDerecognized = loss.NoncontrollingInterestDerecognized; Editor.NetAssetsDerecognized = loss.NetAssetsDerecognized; Editor.GoodwillDerecognized = loss.GoodwillDerecognized; Editor.OciReclassification = loss.OciReclassification; Editor.GainOrLoss = loss.GainOrLoss; }
        if (content.ProfitAttribution is { } attribution) { Editor.SubsidiaryProfitOrLoss = attribution.SubsidiaryProfitOrLoss; Editor.ParentProfitOrLoss = attribution.ParentProfitOrLoss; Editor.NciProfitOrLoss = attribution.NoncontrollingInterestProfitOrLoss; Editor.SubsidiaryOci = attribution.SubsidiaryOtherComprehensiveIncome; Editor.ParentOci = attribution.ParentOtherComprehensiveIncome; Editor.NciOci = attribution.NoncontrollingInterestOtherComprehensiveIncome; }
    }
    private async Task ApproveAsync(ConsolidationOwnershipEventSnapshot item) => await CompleteAsync(await ConsolidationService.ApproveOwnershipEventAsync(new(GroupId, item.Id, item.ConcurrencyToken)), "The ownership event was independently approved.", false);
    private async Task RejectAsync(ConsolidationOwnershipEventSnapshot item) => await CompleteAsync(await ConsolidationService.RejectOwnershipEventAsync(new(GroupId, item.Id, DecisionReason, item.ConcurrencyToken)), "The ownership event was rejected for correction.", false);
    private async Task PostAsync(ConsolidationOwnershipEventSnapshot item) => await CompleteAsync(await ConsolidationService.PostOwnershipEventAsync(new(GroupId, item.Id, item.ConcurrencyToken)), "The ownership event was posted to consolidated reporting.", false);
    private async Task ReverseAsync(ConsolidationOwnershipEventSnapshot item) => await CompleteAsync(await ConsolidationService.ReverseOwnershipEventAsync(new(GroupId, item.Id, ReversalDate, DecisionReason, item.ConcurrencyToken)), "A dated, traceable reversing ownership event was posted.", false);
    private async Task CompleteAsync(TransactionResult result, string success, bool reset) { Message = result.Succeeded ? success : result.ErrorMessage; IsError = !result.Succeeded; if (result.Succeeded) { Workspace = await ConsolidationService.GetOwnershipEventWorkspaceAsync(GroupId); DecisionReason = string.Empty; if (reset) ResetEditor(); } }

