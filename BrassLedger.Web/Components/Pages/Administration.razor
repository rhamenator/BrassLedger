    private async Task RunQuickBooksSyncAsync(Guid connectionId, bool dryRun)
    {
        var key = QuickBooksPreviewKey(connectionId);
        var expectedSnapshot = dryRun ? string.Empty : QuickBooksPreviewSnapshots.GetValueOrDefault(key, string.Empty);
        if (!dryRun && string.IsNullOrWhiteSpace(expectedSnapshot))
        {
            StatusMessage = "Preview this QuickBooks data type before importing it.";
            return;
        }
        LatestQuickBooksSync = await QuickBooksOnlineSyncService.ImportAsync(new(connectionId, QuickBooksSyncEntity, dryRun, expectedSnapshot));
        StatusMessage = LatestQuickBooksSync.Succeeded
            ? dryRun ? "Preview complete. Review the counts and issues before importing this exact snapshot." : "The previewed QuickBooks snapshot was imported through controlled entity links."
            : LatestQuickBooksSync.ErrorMessage;
        if (dryRun && LatestQuickBooksSync.Succeeded) QuickBooksPreviewSnapshots[key] = LatestQuickBooksSync.SnapshotSha256;
        if (!dryRun || !LatestQuickBooksSync.Succeeded) QuickBooksPreviewSnapshots.Remove(key);
        QuickBooksSyncRuns = await QuickBooksOnlineSyncService.GetRecentRunsAsync(limit: 20);
        if (!dryRun && LatestQuickBooksSync.Succeeded) Connections = await IntegrationService.GetConnectionsAsync();
    }

    private bool HasCurrentQuickBooksPreview(Guid connectionId) => QuickBooksPreviewSnapshots.ContainsKey(QuickBooksPreviewKey(connectionId));
    private string QuickBooksPreviewKey(Guid connectionId) => $"{connectionId:N}:{QuickBooksSyncEntity}";
    private static bool HasQuickBooksAuthorization(IntegrationConnectionSnapshot connection) => connection.Status is "Connected" or "ValidationFailed" or "ReauthorizationRequired" or "DisconnectPending";

    private async Task PreviewQuickBooksMappingsAsync(Guid connectionId)
    {
        QuickBooksMappingWorkspace = await QuickBooksOnlineSyncService.PreviewMappingsAsync(connectionId, QuickBooksSyncEntity);
        QuickBooksMappingSelections.Clear();
        PendingQuickBooksMappingReplacementId = null;
        PendingQuickBooksMappingRemovalId = null;
        if (!QuickBooksMappingWorkspace.Succeeded)
        {
            StatusMessage = QuickBooksMappingWorkspace.ErrorMessage;
            return;
        }
        foreach (var remote in QuickBooksMappingWorkspace.RemoteCandidates)
            QuickBooksMappingSelections[remote.ProviderEntityId] = remote.MappedLocalEntityId ?? Guid.Empty;
        StatusMessage = "Mapping review loaded. Saving a link will not change or delete either QuickBooks or BrassLedger records.";
        QuickBooksSyncRuns = await QuickBooksOnlineSyncService.GetRecentRunsAsync(limit: 20);
    }

