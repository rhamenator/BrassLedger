        PendingQuickBooksMappingRemovalId = null;
    }

    private IReadOnlyList<QuickBooksLocalMappingCandidate> EligibleQuickBooksTargets(QuickBooksRemoteMappingCandidate remote)
    {
        if (QuickBooksMappingWorkspace is null) return [];
        return QuickBooksMappingWorkspace.LocalCandidates.Where(local =>
            (QuickBooksMappingWorkspace.EntityType != "accounts" || (local.Classification == remote.Classification && local.IsControlAccount == remote.IsControlAccount && (!remote.IsControlAccount || local.ControlAccountPurpose == remote.ControlAccountPurpose)))
            && (string.IsNullOrWhiteSpace(local.MappedProviderEntityId) || local.MappedProviderEntityId == remote.ProviderEntityId)).ToArray();
    }

    private string DescribeCurrentMapping(QuickBooksRemoteMappingCandidate remote)
    {
        if (!remote.MappedLocalEntityId.HasValue || QuickBooksMappingWorkspace is null) return "Not mapped";
        var local = QuickBooksMappingWorkspace.LocalCandidates.FirstOrDefault(candidate => candidate.LocalEntityId == remote.MappedLocalEntityId.Value);
        return local is null ? "Mapped local record is missing" : $"{local.Number} — {local.Name}";
    }

    private async Task SaveQuickBooksMappingAsync(QuickBooksRemoteMappingCandidate remote, bool confirmed)
    {
        if (QuickBooksMappingWorkspace is null || !QuickBooksMappingWorkspace.PreviewRunId.HasValue) return;
        var localEntityId = QuickBooksMappingSelections.GetValueOrDefault(remote.ProviderEntityId);
        var target = QuickBooksMappingWorkspace.LocalCandidates.FirstOrDefault(candidate => candidate.LocalEntityId == localEntityId);
        if (target is null)
        {
            StatusMessage = "Select a compatible BrassLedger record before saving the mapping.";
            return;
        }
        if (remote.MappedLocalEntityId.HasValue && remote.MappedLocalEntityId != localEntityId && !confirmed)
        {
            PendingQuickBooksMappingReplacementId = remote.ProviderEntityId;
            PendingQuickBooksMappingRemovalId = null;
            StatusMessage = "Confirm replacing this mapping. Neither the old nor new local record will be deleted or changed.";
            return;
        }
        var result = await QuickBooksOnlineSyncService.SaveMappingAsync(new(
            QuickBooksMappingWorkspace.ConnectionId, QuickBooksMappingWorkspace.EntityType, QuickBooksMappingWorkspace.PreviewRunId.Value,
            QuickBooksMappingWorkspace.SnapshotSha256, remote.ProviderEntityId, localEntityId, remote.MappedLocalEntityId,
            target.MappedProviderEntityId ?? string.Empty, confirmed));
        if (!result.Succeeded)
        {
            StatusMessage = result.ErrorMessage;
            return;
        }
        var completionMessage = remote.MappedLocalEntityId.HasValue ? "QuickBooks mapping replaced. No business record was changed or deleted." : "QuickBooks mapping saved. No business record was changed.";
        await PreviewQuickBooksMappingsAsync(QuickBooksMappingWorkspace.ConnectionId);
        StatusMessage = completionMessage;
    }

    private async Task RemoveQuickBooksMappingAsync(QuickBooksRemoteMappingCandidate remote, bool confirmed)
    {
        if (QuickBooksMappingWorkspace is null || !remote.MappedLocalEntityId.HasValue) return;
        if (!confirmed)
        {
            PendingQuickBooksMappingRemovalId = remote.ProviderEntityId;
            PendingQuickBooksMappingReplacementId = null;
            StatusMessage = "Confirm removing only the link. Neither the QuickBooks nor BrassLedger record will be deleted.";
            return;
        }
        var connectionId = QuickBooksMappingWorkspace.ConnectionId;
        var result = await QuickBooksOnlineSyncService.RemoveMappingAsync(new(connectionId, QuickBooksMappingWorkspace.EntityType, remote.ProviderEntityId, remote.MappedLocalEntityId.Value, true));
        if (!result.Succeeded)
        {
            StatusMessage = result.ErrorMessage;
            return;
        }
        await PreviewQuickBooksMappingsAsync(connectionId);
        StatusMessage = "QuickBooks mapping removed. Neither business record was deleted or changed.";
    }

