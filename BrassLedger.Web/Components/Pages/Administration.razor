    private static string TradingPartnerRecordKey(ConsolidationTradingPartnerCandidateSnapshot candidate) => $"{candidate.Kind}|{candidate.CounterpartyRecordId:N}";
    private void SelectTradingPartnerRecord(ChangeEventArgs args)
    {
        var key = args.Value?.ToString() ?? string.Empty; var separator = key.IndexOf('|');
        if (separator < 1 || !Guid.TryParse(key[(separator + 1)..], out var recordId) || TradingPartnerWorkspace is null) return;
        var kind = key[..separator]; var candidate = TradingPartnerWorkspace.Candidates.Single(item => item.Kind == kind && item.CounterpartyRecordId == recordId);
        TradingPartnerForm.RecordKey = key; TradingPartnerForm.Kind = candidate.Kind; TradingPartnerForm.RecordId = candidate.CounterpartyRecordId; TradingPartnerForm.MemberCompanyId = candidate.CompanyId;
        if (TradingPartnerForm.CounterpartyCompanyId == candidate.CompanyId) TradingPartnerForm.CounterpartyCompanyId = Guid.Empty;
    }

    private async Task SaveTradingPartnerAsync()
    {
        var result = await ConsolidationService.SaveTradingPartnerAsync(new(TradingPartnerForm.Id, TradingPartnerForm.ConsolidationGroupId, TradingPartnerForm.MemberCompanyId, TradingPartnerForm.CounterpartyCompanyId, TradingPartnerForm.Kind == "Customer" ? TradingPartnerForm.RecordId : null, TradingPartnerForm.Kind == "Vendor" ? TradingPartnerForm.RecordId : null, TradingPartnerForm.EffectiveFrom, TradingPartnerForm.EffectiveThrough, TradingPartnerForm.IsActive, TradingPartnerForm.ConcurrencyToken));
        if (result.Succeeded) { await LoadTradingPartnersAsync(TradingPartnerForm.ConsolidationGroupId); StatusMessage = "Trading-partner link saved with retained effective-date history."; }
        else StatusMessage = result.ErrorMessage;
    }

    private void LoadTradingPartner(ConsolidationTradingPartnerSnapshot link) => TradingPartnerForm = new() { Id = link.Id, ConsolidationGroupId = TradingPartnerWorkspace!.GroupId, MemberCompanyId = link.MemberCompanyId, CounterpartyCompanyId = link.CounterpartyCompanyId, Kind = link.Kind, RecordId = link.CounterpartyRecordId, RecordKey = $"{link.Kind}|{link.CounterpartyRecordId:N}", EffectiveFrom = link.EffectiveFrom, EffectiveThrough = link.EffectiveThrough, IsActive = link.IsActive, ConcurrencyToken = link.ConcurrencyToken };
    private void CancelTradingPartnerEdit() { var groupId = TradingPartnerForm.ConsolidationGroupId; TradingPartnerForm = new() { ConsolidationGroupId = groupId }; StatusMessage = "Trading-partner edit cancelled."; }

    private void ToggleConsolidationMember(Guid companyId, object? value)
    {
        var selected = value is bool boolValue ? boolValue : string.Equals(value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (selected) { ConsolidationForm.MemberCompanyIds.Add(companyId); ConsolidationForm.OwnershipPercentages.TryAdd(companyId, 1m); ConsolidationForm.ConsolidationBases.TryAdd(companyId, "CombinedAffiliate"); }
        else { ConsolidationForm.MemberCompanyIds.Remove(companyId); ConsolidationForm.OwnershipPercentages.Remove(companyId); ConsolidationForm.ConsolidationBases.Remove(companyId); ConsolidationForm.BasisRationales.Remove(companyId); }
    }

    private void SetConsolidationOwnership(Guid companyId, object? value)
    {
        if (decimal.TryParse(value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var ownership))
        {
            ConsolidationForm.OwnershipPercentages[companyId] = ownership;
        }
    }

    private void SetConsolidationBasis(Guid companyId, object? value) => ConsolidationForm.ConsolidationBases[companyId] = value?.ToString() ?? "CombinedAffiliate";
    private void SetConsolidationBasisRationale(Guid companyId, object? value) => ConsolidationForm.BasisRationales[companyId] = value?.ToString() ?? string.Empty;
    private static string DisplayConsolidationBasis(string value) => value switch { "ReportingParent" => "Reporting parent", "ControlledSubsidiary" => "Controlled subsidiary", "CombinedAffiliate" => "Combined affiliate", "ProportionateInterest" => "Proportionate interest", _ => value };

    private async Task LoadConsolidatedBalanceAsync(Guid groupId)
    {
        ConsolidatedBalance = await ConsolidationService.GetBalanceReportAsync(groupId, ConsolidationReportForm.PeriodStart, ConsolidationReportForm.AsOf);
        StatusMessage = ConsolidatedBalance is null ? "The consolidation report is unavailable to this session." : null;
    }

    private void TogglePermission(string permissionCode, object? value)
    {
        var selected = value switch
        {
            bool boolValue => boolValue,
            string stringValue => string.Equals(stringValue, "true", StringComparison.OrdinalIgnoreCase),
            _ => false
        };
        if (selected)
        {
            RoleForm.Permissions.Add(permissionCode);
        }
        else
        {
            RoleForm.Permissions.Remove(permissionCode);
        }
    }

    private async Task ReloadSnapshotAsync()
    {
        Snapshot = await SecurityAdministrationService.GetSnapshotAsync();
        Providers = await IntegrationService.GetCatalogAsync();
        Connections = await IntegrationService.GetConnectionsAsync();
        QuickBooksAvailability = await QuickBooksOnlineConnectionService.GetAvailabilityAsync();
        QuickBooksSyncRuns = await QuickBooksOnlineSyncService.GetRecentRunsAsync(limit: 20);
        Companies = await CompanyManagementService.GetMyCompaniesAsync();
        ConsolidationGroups = await ConsolidationService.GetGroupsAsync();
        ExchangeRates = await ConsolidationService.GetExchangeRatesAsync();
        AccountingControls = await AccountingPeriodService.GetSnapshotAsync();
        await ReloadOperationalAccountRolesAsync();
        PermissionLabels = Snapshot.Permissions.ToDictionary(permission => permission.Code, permission => permission.Name, StringComparer.OrdinalIgnoreCase);
    }

    private async Task ReloadOperationalAccountRolesAsync()
    {
        AccountingAccountRoles = await AccountingAccountRoleService.GetWorkspaceAsync();
        OperationalAccountSelections.Clear();
        foreach (var role in AccountingAccountRoles.Roles) OperationalAccountSelections[role.Code] = role.AccountId ?? Guid.Empty;
    }

