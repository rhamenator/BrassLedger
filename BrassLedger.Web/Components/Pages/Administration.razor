@page "/administration"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.AdministerSystem)]
@inject ISecurityAdministrationService SecurityAdministrationService
@inject IIntegrationService IntegrationService
@inject IQuickBooksOnlineConnectionService QuickBooksOnlineConnectionService
@inject IQuickBooksOnlineSyncService QuickBooksOnlineSyncService
@inject ICompanyManagementService CompanyManagementService
@inject IConsolidationService ConsolidationService
@inject IAccountingPeriodService AccountingPeriodService
@inject IBackupService BackupService
@inject NavigationManager NavigationManager

<PageTitle>Administration</PageTitle>

@if (Snapshot is null)
{
    <section class="panel">
        <h1>Loading administration workspace...</h1>
        <p>Role templates, operators, and security settings are being prepared.</p>
    </section>
}
else
{
    <section class="page-shell">
        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow">Administration</p>
                <h1>Define role templates, separate duties, and prepare replacement access before it becomes urgent.</h1>
                <p class="hero-text">
                    Administrator and Owner/CEO keep full access, while prepared templates split requisitioning,
                    purchasing, check disbursement, payroll, and reporting into distinct duties.
                </p>
            </div>

            <aside class="hero-panel">
                <p class="panel-kicker">Security snapshot</p>
                <ul class="metric-stack">
                    <li><strong>@Snapshot.Roles.Count</strong><span>Active roles</span></li>
                    <li><strong>@Snapshot.Operators.Count</strong><span>Operator accounts</span></li>
                    <li><strong>@Snapshot.Permissions.Count</strong><span>Permission flags</span></li>
                </ul>
            </aside>
        </section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManageUsers" Context="emailDeliveryAuthorization">
            <section class="panel">
                <h2>Security-email delivery</h2>
                <p class="page-intro">“Accepted by SMTP” means the configured mail server accepted the message; it does not prove inbox delivery. BrassLedger retains protected delivery metadata and clears message bodies after SMTP acceptance.</p>
                @if (Snapshot.SecurityEmailDeliveries.Count == 0)
                {
                    <p class="page-intro">No security-email attempts have been recorded for this company.</p>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead><tr><th>Created</th><th>Purpose</th><th>Recipient</th><th>Status</th><th>Attempts</th><th>Next attempt / accepted</th><th>Action</th></tr></thead>
                            <tbody>
                            @foreach (var delivery in Snapshot.SecurityEmailDeliveries)
                            {
                                <tr>
                                    <td>@delivery.CreatedAtUtc.LocalDateTime</td>
                                    <td>@delivery.Purpose</td>
                                    <td>@delivery.MaskedRecipient</td>
                                    <td>@(delivery.DeliveredAtUtc is null ? delivery.Status : "Accepted by SMTP")@if (!string.IsNullOrWhiteSpace(delivery.LastError)) { <div class="muted-copy">@delivery.LastError</div> }</td>
                                    <td>@delivery.AttemptCount</td>
                                    <td>@((delivery.DeliveredAtUtc ?? delivery.NextAttemptAtUtc).LocalDateTime)</td>
                                    <td>@if (delivery.DeliveredAtUtc is null && delivery.Status is "Failed" or "FailedPermanent") { <button class="action-secondary" type="button" @onclick="() => RetrySecurityEmailAsync(delivery.MessageId)">Retry</button> }</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </AuthorizeView>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <section class="panel">
                <p class="lead">@StatusMessage</p>
            </section>
        }

        <section class="content-grid">
            <article class="panel">
                <h2>Role templates</h2>
                <div class="module-grid">
                    @foreach (var role in Snapshot.Roles)
                    {
                        <article class="module-card">
                            <span class="module-code">@(role.IsSystemRole ? "SYS" : "CUS")</span>
                            <h3>@role.Name</h3>
                            <p class="module-area">@role.Description</p>
                            <p><strong>@role.AssignedUserCount</strong> assigned · <strong>@(role.RequiresMfa ? "MFA required" : "MFA optional")</strong></p>
                            <ul class="feature-list">
                                @foreach (var permission in role.Permissions)
                                {
                                    <li>@PermissionLabels.GetValueOrDefault(permission, permission)</li>
                                }
                            </ul>
                            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManageRoles" Context="roleMfaAuthorization">
                                <button class="action-secondary" type="button" @onclick="() => SetRoleMfaRequirementAsync(role)">@(role.RequiresMfa ? "Make MFA optional" : "Require MFA")</button>
                            </AuthorizeView>
                        </article>
                    }
                </div>
            </article>

            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManageRoles" Context="roleAuthorization">
            <article class="panel">
                <h2>Create custom role</h2>
                <EditForm Model="RoleForm" OnSubmit="CreateRoleAsync">
                    <div class="auth-form">
                        <div class="field-group">
                            <label class="field-label" for="roleName">Role name</label>
                            <InputText id="roleName" class="field-input" @bind-Value="RoleForm.Name" />
                        </div>

                        <div class="field-group">
                            <label class="field-label" for="roleDescription">Description</label>
                            <InputText id="roleDescription" class="field-input" @bind-Value="RoleForm.Description" />
                        </div>

                        <div class="field-group">
                            <span class="field-label">Permissions</span>
                            <div class="feature-list">
                                @foreach (var permission in Snapshot.Permissions)
                                {
                                    <label>
                                        <input
                                            type="checkbox"
                                            checked="@RoleForm.Permissions.Contains(permission.Code)"
                                            @onchange="args => TogglePermission(permission.Code, args.Value)" />
                                        @permission.Name
                                    </label>
                                }
                            </div>
                        </div>

                        <label><InputCheckbox @bind-Value="RoleForm.RequiresMfa" /> Require authenticator MFA before this role can access business data.</label>

                        <button class="action-primary" type="submit">Save custom role</button>
                    </div>
                </EditForm>
            </article>
            </AuthorizeView>
        </section>

        <section class="content-grid">
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManageUsers" Context="userAuthorization">
            <article class="panel">
                <h2>Operators</h2>
                <div class="detail-grid">
                    @foreach (var user in Snapshot.Operators)
                    {
                        <div>
                            <span class="detail-label">@user.Role</span>
                            <strong>@user.DisplayName</strong>
                            <p>@user.UserName · @user.Email · @(user.IsActive ? "Active" : "Invitation pending") · MFA @(user.MfaEnabled ? "enabled" : user.RoleRequiresMfa ? "enrollment required" : "optional")</p>
                        </div>
                    }
                </div>
            </article>

            <article class="panel">
                <h2>Invite operator</h2>
                @if (!Snapshot.SecurityEmailDeliveryConfigured)
                {
                    <div class="auth-error" role="alert">Configure an HTTPS public base URL and SMTP security-email delivery before inviting operators.</div>
                }
                <EditForm Model="OperatorForm" OnSubmit="InviteOperatorAsync">
                    <div class="auth-form">
                        <div class="field-group">
                            <label class="field-label" for="userName">Username</label>
                            <InputText id="userName" class="field-input" @bind-Value="OperatorForm.UserName" />
                        </div>

                        <div class="field-group">
                            <label class="field-label" for="displayName">Display name</label>
                            <InputText id="displayName" class="field-input" @bind-Value="OperatorForm.DisplayName" />
                        </div>

                        <div class="field-group">
                            <label class="field-label" for="email">Email</label>
                            <InputText id="email" class="field-input" @bind-Value="OperatorForm.Email" />
                        </div>

                        <div class="field-group">
                            <label class="field-label" for="role">Role</label>
                            <InputSelect id="role" class="field-input" @bind-Value="OperatorForm.RoleName">
                                <option value="">Select a role</option>
                                @foreach (var role in Snapshot.Roles)
                                {
                                    <option value="@role.Name">@role.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <button class="action-primary" type="submit" disabled="@(!Snapshot.SecurityEmailDeliveryConfigured)">Queue secure invitation</button>
                    </div>
                </EditForm>
            </article>

            <article class="panel">
                <h2>Administrator MFA recovery</h2>
                <p class="page-intro">Use only from an MFA-authenticated administrator session after following the company’s identity-verification procedure. You cannot reset yourself; owner accounts require another owner. The reset invalidates every session, authenticator secret, recovery code, pending MFA challenge, and account-action link.</p>
                <EditForm Model="MfaRecoveryForm" OnValidSubmit="ResetOperatorMfaAsync">
                    <div class="auth-form">
                        <div class="field-group">
                            <label class="field-label" for="mfaRecoveryOperator">MFA-enabled operator</label>
                            <InputSelect id="mfaRecoveryOperator" class="field-input" @bind-Value="MfaRecoveryForm.TargetUserId">
                                <option value="@Guid.Empty">Select an operator</option>
                                @foreach (var user in Snapshot.Operators.Where(user => user.IsActive && user.MfaEnabled))
                                {
                                    <option value="@user.UserId">@user.DisplayName — @user.UserName</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="field-group"><label class="field-label" for="mfaRecoveryConfirm">Type the exact username</label><InputText id="mfaRecoveryConfirm" class="field-input" autocomplete="off" @bind-Value="MfaRecoveryForm.ConfirmUserName" /></div>
                        <div class="field-group"><label class="field-label" for="mfaRecoveryPassword">Your current password</label><InputText id="mfaRecoveryPassword" class="field-input" type="password" autocomplete="current-password" maxlength="1024" @bind-Value="MfaRecoveryForm.CurrentAdministratorPassword" /></div>
                        <div class="field-group">
                            <label class="field-label" for="mfaRecoveryMethod">Identity-verification method</label>
                            <InputSelect id="mfaRecoveryMethod" class="field-input" @bind-Value="MfaRecoveryForm.VerificationMethod">
                                <option value="">Select the documented method</option>
                                <option>In-person identity verification</option>
                                <option>Video verification with known employee</option>
                                <option>Manager and HR attestation</option>
                                <option>Company-approved recovery procedure</option>
                            </InputSelect>
                        </div>
                        <div class="field-group"><label class="field-label" for="mfaRecoveryCase">Case or incident reference</label><InputText id="mfaRecoveryCase" class="field-input" maxlength="200" aria-describedby="mfaRecoveryCaseHelp" @bind-Value="MfaRecoveryForm.CaseReference" /><small id="mfaRecoveryCaseHelp" class="muted-copy">Enter only an internal reference; do not enter identity documents or other sensitive evidence.</small></div>
                        <button class="action-secondary" type="submit">Clear MFA and revoke access</button>
                    </div>
                </EditForm>
            </article>
            </AuthorizeView>
        </section>

        <section class="panel">
            <h2>Companies</h2>
            <p class="page-intro">Each company has isolated books, roles, bank accounts, tax content, and reporting currency. Use the active-company API endpoint to switch sessions after creating a company.</p>
            <div class="detail-grid">@foreach (var company in Companies) { <div><span class="detail-label">@company.Role@(company.IsOwner ? " · Owner" : "")</span><strong>@company.Name</strong><p>@company.LegalName · @company.BaseCurrency</p></div> }</div>
            <form method="post" action="/account/active-company" class="auth-form"><AntiforgeryToken /><input type="hidden" name="returnUrl" value="/" /><div class="field-group"><label class="field-label" for="activeCompany">Switch active company</label><select id="activeCompany" name="companyId" class="field-input">@foreach (var company in Companies) { <option value="@company.CompanyId">@company.Name — @company.BaseCurrency</option> }</select></div><button class="action-secondary" type="submit">Switch company</button></form>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManageUsers" Context="companyAuthorization"><EditForm Model="CompanyForm" OnValidSubmit="CreateCompanyAsync"><div class="content-grid"><div class="field-group"><label class="field-label">Company name</label><InputText aria-label="Company name" class="field-input" @bind-Value="CompanyForm.Name" /></div><div class="field-group"><label class="field-label">Legal name</label><InputText aria-label="Company legal name" class="field-input" @bind-Value="CompanyForm.LegalName" /></div><div class="field-group"><label class="field-label">Tax ID</label><InputText aria-label="Company tax ID" class="field-input" @bind-Value="CompanyForm.TaxId" /></div><div class="field-group"><label class="field-label">Base currency</label><InputText aria-label="Company base currency" class="field-input" @bind-Value="CompanyForm.BaseCurrency" /></div><div class="field-group"><label class="field-label">Fiscal-year start month</label><InputNumber aria-label="Fiscal year start month" class="field-input" @bind-Value="CompanyForm.FiscalYearStartMonth" /></div></div><button class="action-primary" type="submit">Create company</button></EditForm></AuthorizeView>
        </section>

        <section class="panel">
            <h2>Backup and recovery rehearsal</h2>
            <p class="page-intro">SQLite backups are consistent snapshots with the data-protection key ring. Verification checks integrity; the restore rehearsal opens an isolated copy and never writes over the live database.</p>
            <div class="hero-actions"><button class="action-primary" type="button" @onclick="CreateBackupAsync">Create backup</button>@if (LatestBackup?.BackupId is { } backupId) { <button class="action-secondary" type="button" @onclick="VerifyBackupAsync">Verify backup</button><button class="action-secondary" type="button" @onclick="RehearseRestoreAsync">Rehearse restore</button> }</div>
            @if (LatestBackup is not null) { <p class="muted-copy">@(LatestBackup.Succeeded ? $"Latest backup: {LatestBackup.BackupId} at {LatestBackup.CreatedAtUtc:u}" : LatestBackup.ErrorMessage)</p> }
            @if (BackupVerification is not null) { <p class="muted-copy">@(BackupVerification.Succeeded ? $"Verified at {BackupVerification.VerifiedAtUtc:u}" : BackupVerification.ErrorMessage)</p> }
            @if (RecoveryRehearsal is not null) { <p class="muted-copy">@(RecoveryRehearsal.Succeeded ? $"Restore rehearsal passed: {RecoveryRehearsal.CompanyCount} company(ies), {RecoveryRehearsal.JournalEntryCount} journals, {RecoveryRehearsal.PayrollRunCount} payroll runs, and {RecoveryRehearsal.DataProtectionKeyCount} key file(s)." : RecoveryRehearsal.ErrorMessage)</p> }
        </section>

        <section class="panel">
            <h2>Accounting controls and audit trail</h2>
            <p class="page-intro">Close a period only after review. Every journal posting and period status change is retained as business audit evidence for the active company.</p>
            <EditForm Model="AccountingPeriodForm" OnValidSubmit="SaveAccountingPeriodAsync"><div class="content-grid"><div class="field-group"><label class="field-label">Period starts</label><InputDate aria-label="Accounting period start" class="field-input" @bind-Value="AccountingPeriodForm.StartsOn" /></div><div class="field-group"><label class="field-label">Period ends</label><InputDate aria-label="Accounting period end" class="field-input" @bind-Value="AccountingPeriodForm.EndsOn" /></div><div class="field-group"><label class="field-label">Notes</label><InputText aria-label="Accounting period notes" class="field-input" @bind-Value="AccountingPeriodForm.Notes" /></div></div><button class="action-secondary" type="submit">Save accounting period</button></EditForm>
            @if (AccountingControls.Periods.Count > 0) { <table class="data-table"><thead><tr><th>Period</th><th>Status</th><th>Closed by</th><th></th></tr></thead><tbody>@foreach (var period in AccountingControls.Periods) { <tr><td>@period.StartsOn to @period.EndsOn<br />@period.Notes</td><td>@period.Status</td><td>@(period.ClosedBy ?? "—") @period.ClosedAtUtc</td><td><button class="action-secondary" type="button" @onclick="() => TogglePeriodStatusAsync(period)">@(period.Status == "Closed" ? "Reopen" : "Close")</button></td></tr> }</tbody></table> }
            <h3>Recent business audit events</h3>
            @if (AccountingControls.AuditEntries.Count == 0) { <p class="page-intro">No audited business events have been recorded yet.</p> }
            else { <table class="data-table"><thead><tr><th>When</th><th>Action</th><th>Entity</th><th>Operator</th></tr></thead><tbody>@foreach (var audit in AccountingControls.AuditEntries) { <tr><td>@audit.OccurredAtUtc.LocalDateTime</td><td>@audit.Action</td><td>@audit.EntityType</td><td>@(audit.PerformedBy ?? "System")</td></tr> }</tbody></table> }
        </section>

        <section class="panel">
            <h2>Consolidation and currencies</h2>
            <p class="page-intro">Consolidations convert each member company’s balances at the latest effective rate, then apply the ownership percentage. Intercompany eliminations remain controlled journal adjustments and are not automatic.</p>
            <div class="content-grid">
                <EditForm Model="ExchangeRateForm" OnValidSubmit="SaveExchangeRateAsync">
                    <div class="auth-form"><h3>Effective exchange rate</h3><div class="field-group"><label class="field-label">Base currency</label><InputText aria-label="Exchange rate base currency" class="field-input" @bind-Value="ExchangeRateForm.BaseCurrency" /></div><div class="field-group"><label class="field-label">Quote currency</label><InputText aria-label="Exchange rate quote currency" class="field-input" @bind-Value="ExchangeRateForm.QuoteCurrency" /></div><div class="field-group"><label class="field-label">Rate</label><InputNumber aria-label="Exchange rate" class="field-input" @bind-Value="ExchangeRateForm.Rate" /></div><div class="field-group"><label class="field-label">Effective date</label><InputDate aria-label="Exchange rate effective date" class="field-input" @bind-Value="ExchangeRateForm.EffectiveOn" /></div><div class="field-group"><label class="field-label">Source</label><InputText aria-label="Exchange rate source" class="field-input" @bind-Value="ExchangeRateForm.Source" /></div><button class="action-secondary" type="submit">Save exchange rate</button></div>
                </EditForm>
                <EditForm Model="ConsolidationForm" OnValidSubmit="SaveConsolidationGroupAsync">
                    <div class="auth-form"><h3>Consolidation group</h3><div class="field-group"><label class="field-label">Group name</label><InputText aria-label="Consolidation group name" class="field-input" @bind-Value="ConsolidationForm.Name" /></div><div class="field-group"><label class="field-label">Reporting currency</label><InputText aria-label="Consolidation reporting currency" class="field-input" @bind-Value="ConsolidationForm.ReportingCurrency" /></div><span class="field-label">Member companies and ownership</span>@foreach (var company in Companies) { var companyId = company.CompanyId; <div class="field-group"><label><input type="checkbox" checked="@ConsolidationForm.MemberCompanyIds.Contains(companyId)" @onchange="args => ToggleConsolidationMember(companyId, args.Value)" /> @company.Name (@company.BaseCurrency)</label><input type="number" min="0" max="1" step="0.0001" aria-label="@($"{company.Name} ownership percentage")" class="field-input" value="@ConsolidationForm.OwnershipPercentages.GetValueOrDefault(companyId, 1m).ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="args => SetConsolidationOwnership(companyId, args.Value)" disabled="@(!ConsolidationForm.MemberCompanyIds.Contains(companyId))" /></div> }<button class="action-primary" type="submit">Save consolidation group</button></div>
                </EditForm>
            </div>
            @if (ConsolidationGroups.Count > 0)
            {
                <table class="data-table"><thead><tr><th>Group</th><th>Members</th><th>Reporting currency</th><th></th></tr></thead><tbody>@foreach (var group in ConsolidationGroups) { <tr><td>@group.Name</td><td>@string.Join(", ", group.Members.Select(member => $"{member.CompanyName} ({member.OwnershipPercentage:P0})"))</td><td>@group.ReportingCurrency</td><td><button class="action-secondary" type="button" @onclick="() => LoadConsolidatedBalanceAsync(group.Id)">View balance</button></td></tr> }</tbody></table>
            }
            @if (ConsolidatedBalance is not null)
            {
                <h3>@ConsolidatedBalance.GroupName consolidated balance — @ConsolidatedBalance.AsOf</h3>
                @if (ConsolidatedBalance.Warnings.Count > 0) { <ul class="feature-list">@foreach (var warning in ConsolidatedBalance.Warnings) { <li>@warning</li> }</ul> }
                <table class="data-table"><thead><tr><th>Account</th><th>Type</th><th>Balance (@ConsolidatedBalance.ReportingCurrency)</th></tr></thead><tbody>@foreach (var account in ConsolidatedBalance.Accounts) { <tr><td>@account.AccountNumber · @account.AccountName</td><td>@account.AccountType</td><td>@account.ConvertedBalance.ToString("N2")</td></tr> }</tbody></table>
            }
        </section>

        <section class="panel">
            <h2>Integration catalog</h2>
            <p class="page-intro">QuickBooks uses Intuit’s authorization page; its client secret is deployment configuration and its rotating tokens are protected at rest. BrassLedger never asks an operator to paste QuickBooks credentials into JSON.</p>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManageUsers" Context="integrationAuthorization">
                <Authorized>
                    @if (QuickBooksAvailability is not null)
                    {
                        <div class="notice-panel"><strong>QuickBooks Online</strong><p>@QuickBooksAvailability.Message</p></div>
                        <EditForm Model="QuickBooksForm" OnValidSubmit="ConnectQuickBooksAsync">
                            <div class="content-grid">
                                <div class="field-group"><label class="field-label">Connection name</label><InputText aria-label="QuickBooks connection name" class="field-input" @bind-Value="QuickBooksForm.ConnectionName" /></div>
                                <div class="field-group"><label class="field-label">Intuit environment</label><input aria-label="QuickBooks environment" class="field-input" value="@QuickBooksAvailability.Environment" disabled /></div>
                            </div>
                            <button class="action-primary" type="submit" disabled="@(!QuickBooksAvailability.Configured)">Connect through Intuit</button>
                        </EditForm>
                    }
                    @{ var quickBooksConnections = Connections.Where(connection => connection.ProviderCode == "quickbooks-online").ToArray(); }
                    <div class="field-group"><label class="field-label">QuickBooks data to import</label><InputSelect aria-label="QuickBooks API sync entity" class="field-input" @bind-Value="QuickBooksSyncEntity"><option value="accounts">Chart of accounts</option><option value="customers">Customers</option><option value="vendors">Vendors</option></InputSelect><small>Preview fetches and compares data without changing accounting records. Import is enabled only for the exact snapshot you previewed during this session.</small></div>
                    @if (quickBooksConnections.Length == 0)
                    {
                        <p class="muted-copy">No QuickBooks company is connected. Reviewed CSV interchange remains available from the Ledger page.</p>
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="data-table">
                                <thead><tr><th>Name</th><th>Company</th><th>Status</th><th>Last validated</th><th>Actions</th></tr></thead>
                                <tbody>
                                @foreach (var connection in quickBooksConnections)
                                {
                                    <tr>
                                        <td>@connection.Name</td>
                                        <td>@DescribeQuickBooksConnection(connection)</td>
                                        <td>@connection.Status</td>
                                        <td>@(connection.LastValidatedAtUtc?.LocalDateTime.ToString("g") ?? "Not validated")</td>
                                        <td>
                                            @if (connection.Status is "Connected" or "ValidationFailed") { <button class="action-secondary" type="button" @onclick="() => ValidateQuickBooksAsync(connection.Id)">Validate</button> }
                                            @if (connection.Status == "Connected")
                                            {
                                                <button class="action-secondary" type="button" @onclick="() => RunQuickBooksSyncAsync(connection.Id, true)">Preview import</button>
                                                <button class="action-primary" type="button" disabled="@(!HasCurrentQuickBooksPreview(connection.Id))" @onclick="() => RunQuickBooksSyncAsync(connection.Id, false)">Import previewed snapshot</button>
                                            }
                                            <button class="action-secondary" type="button" @onclick="() => ReconnectQuickBooksAsync(connection)">Reconnect</button>
                                            @if (HasQuickBooksAuthorization(connection))
                                            {
                                                @if (PendingQuickBooksDisconnectId == connection.Id)
                                                {
                                                    <button class="action-danger" type="button" @onclick="() => DisconnectQuickBooksAsync(connection.Id)">Confirm disconnect</button>
                                                    <button class="action-secondary" type="button" @onclick="CancelQuickBooksDisconnect">Cancel</button>
                                                }
                                                else
                                                {
                                                    <button class="action-secondary" type="button" @onclick="() => PendingQuickBooksDisconnectId = connection.Id">Disconnect</button>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (LatestQuickBooksSync is not null)
                    {
                        <div class="notice-panel" role="status">
                            <strong>@(LatestQuickBooksSync.DryRun ? "QuickBooks import preview" : "QuickBooks import result")</strong>
                            <p>Fetched @LatestQuickBooksSync.FetchedCount; create @LatestQuickBooksSync.CreatedCount; update @LatestQuickBooksSync.UpdatedCount; unchanged @LatestQuickBooksSync.UnchangedCount; conflicts @LatestQuickBooksSync.ConflictCount; rejected @LatestQuickBooksSync.RejectedCount.</p>
                            @if (LatestQuickBooksSync.Issues.Count > 0) { <ul class="warning-list">@foreach (var issue in LatestQuickBooksSync.Issues) { <li>@issue.Code — @issue.Message @if (!string.IsNullOrWhiteSpace(issue.ProviderEntityId)) { <span>(QuickBooks ID @issue.ProviderEntityId)</span> }</li> }</ul> }
                        </div>
                    }
                    @if (QuickBooksSyncRuns.Count > 0)
                    {
                        <h3>Recent QuickBooks API synchronization runs</h3>
                        <div class="table-scroll"><table class="data-table"><thead><tr><th>Completed</th><th>Entity</th><th>Mode</th><th>Status</th><th>Counts</th><th>Operator</th></tr></thead><tbody>@foreach (var run in QuickBooksSyncRuns) { <tr><td>@run.CompletedAtUtc.LocalDateTime</td><td>@run.EntityType</td><td>@(run.IsDryRun ? "Preview" : "Import")</td><td>@run.Status</td><td>@run.CreatedCount create · @run.UpdatedCount update · @run.ConflictCount conflict · @run.RejectedCount rejected</td><td>@(run.InitiatedBy ?? "Unknown")</td></tr> }</tbody></table></div>
                    }

                    <details>
                        <summary>Other provider connection profiles</summary>
                        <p class="page-intro">These entries store protected configuration only. They do not claim a working connection or synchronization adapter.</p>
                        <EditForm Model="IntegrationForm" OnValidSubmit="SaveIntegrationConnectionAsync"><div class="content-grid"><div class="field-group"><label class="field-label">Provider</label><InputSelect aria-label="Integration provider" class="field-input" @bind-Value="IntegrationForm.ProviderCode"><option value="">Select provider</option>@foreach (var provider in Providers.Where(provider => provider.Code != "quickbooks-online")) { <option value="@provider.Code">@provider.Name — @provider.ImplementationStatus</option> }</InputSelect></div><div class="field-group"><label class="field-label">Profile name</label><InputText aria-label="Integration connection name" class="field-input" @bind-Value="IntegrationForm.Name" /></div><div class="field-group"><label class="field-label">Settings JSON</label><InputTextArea aria-label="Integration settings JSON" class="field-input" @bind-Value="IntegrationForm.SettingsJson" /></div><div class="field-group"><label class="field-label">Credentials JSON</label><InputTextArea aria-label="Integration credentials JSON" class="field-input" autocomplete="off" @bind-Value="IntegrationForm.CredentialsJson" /></div><div class="field-group"><label><InputCheckbox aria-label="Enable integration connection" @bind-Value="IntegrationForm.Enable" /> Mark profile active (does not connect)</label></div></div><button class="action-secondary" type="submit">Save connection profile</button></EditForm>
                    </details>
                </Authorized>
                <NotAuthorized><p class="muted-copy">User-administration permission is required to manage external accounting authorizations.</p></NotAuthorized>
            </AuthorizeView>
            <div class="table-scroll"><table class="data-table">
                <thead><tr><th>Provider</th><th>Implementation</th><th>Supported now</th><th>Profile status</th></tr></thead>
                <tbody>@foreach (var provider in Providers) { var connections = Connections.Where(connection => connection.ProviderCode == provider.Code).ToArray(); <tr><td>@provider.Name<br /><small>@provider.Category</small></td><td>@provider.ImplementationStatus<br /><small>@provider.Description</small></td><td>@provider.SupportedCapabilities<br /><small>Live sync: @(provider.LiveSynchronizationAvailable ? "available" : "not implemented")</small></td><td>@(connections.Length == 0 ? "No stored profile" : string.Join(", ", connections.Select(connection => $"{connection.Name}: {connection.Status}"))) @foreach (var connection in connections.Where(connection => connection.ProviderCode != "quickbooks-online" && connection.Status != "Disabled")) { <button class="action-secondary" type="button" @onclick="() => DisableIntegrationConnectionAsync(connection)">Disable @connection.Name</button> }</td></tr> }</tbody>
            </table></div>
        </section>
    </section>
}

@code {
    private SecurityAdministrationSnapshot? Snapshot;
    private string? StatusMessage;
    private CreateRoleForm RoleForm { get; set; } = new();
    private CreateOperatorForm OperatorForm { get; set; } = new();
    private AdministratorMfaRecoveryForm MfaRecoveryForm { get; set; } = new();
    private Dictionary<string, string> PermissionLabels { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<IntegrationProviderSnapshot> Providers { get; set; } = [];
    private IReadOnlyList<IntegrationConnectionSnapshot> Connections { get; set; } = [];
    private IReadOnlyList<CompanyMembershipSnapshot> Companies { get; set; } = [];
    private CreateCompanyForm CompanyForm { get; set; } = new();
    private ExchangeRateEditor ExchangeRateForm { get; set; } = new();
    private ConsolidationGroupEditor ConsolidationForm { get; set; } = new();
    private IReadOnlyList<ConsolidationGroupSnapshot> ConsolidationGroups { get; set; } = [];
    private ConsolidatedBalanceReport? ConsolidatedBalance { get; set; }
    private AccountingControlsSnapshot AccountingControls { get; set; } = new([], []);
    private AccountingPeriodEditor AccountingPeriodForm { get; set; } = new();
    private IntegrationConnectionEditor IntegrationForm { get; set; } = new();
    private QuickBooksConnectionEditor QuickBooksForm { get; set; } = new();
    private QuickBooksOnlineAvailability? QuickBooksAvailability { get; set; }
    private Guid? PendingQuickBooksDisconnectId { get; set; }
    private string QuickBooksSyncEntity { get; set; } = "accounts";
    private QuickBooksSyncResult? LatestQuickBooksSync { get; set; }
    private IReadOnlyList<QuickBooksSyncRunSnapshot> QuickBooksSyncRuns { get; set; } = [];
    private Dictionary<string, string> QuickBooksPreviewSnapshots { get; } = new(StringComparer.Ordinal);
    private BackupResult? LatestBackup { get; set; }
    private BackupVerificationResult? BackupVerification { get; set; }
    private BackupRecoveryRehearsalResult? RecoveryRehearsal { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ReloadSnapshotAsync();
        if (string.Equals(QuickBooksCallbackStatus, "connected", StringComparison.OrdinalIgnoreCase))
            StatusMessage = $"Connected and validated {QuickBooksCallbackCompany ?? "the selected QuickBooks company"}.";
        else if (string.Equals(QuickBooksCallbackStatus, "error", StringComparison.OrdinalIgnoreCase))
            StatusMessage = string.IsNullOrWhiteSpace(QuickBooksCallbackMessage) ? "QuickBooks authorization did not complete." : QuickBooksCallbackMessage;
    }

    [SupplyParameterFromQuery(Name = "quickbooks")]
    public string? QuickBooksCallbackStatus { get; set; }

    [SupplyParameterFromQuery(Name = "company")]
    public string? QuickBooksCallbackCompany { get; set; }

    [SupplyParameterFromQuery(Name = "message")]
    public string? QuickBooksCallbackMessage { get; set; }

    private async Task CreateRoleAsync(EditContext _)
    {
        var result = await SecurityAdministrationService.CreateRoleAsync(
            new CreateAccessRoleRequest(RoleForm.Name, RoleForm.Description, RoleForm.Permissions.ToArray(), RoleForm.RequiresMfa));

        StatusMessage = result.Succeeded ? "Custom role saved." : result.ErrorMessage;
        if (result.Succeeded)
        {
            RoleForm = new CreateRoleForm();
            await ReloadSnapshotAsync();
        }
    }

    private async Task SetRoleMfaRequirementAsync(AccessRoleSnapshot role)
    {
        var result = await SecurityAdministrationService.SetRoleMfaRequirementAsync(role.Name, !role.RequiresMfa);
        StatusMessage = result.Succeeded
            ? $"{role.Name} now {(role.RequiresMfa ? "allows password-only access" : "requires MFA")}. Assigned operators must sign in again."
            : result.ErrorMessage;
        if (result.Succeeded) await ReloadSnapshotAsync();
    }

    private async Task InviteOperatorAsync(EditContext _)
    {
        var result = await SecurityAdministrationService.InviteOperatorAsync(
            new CreateOperatorInvitationRequest(
                OperatorForm.UserName,
                OperatorForm.DisplayName,
                OperatorForm.Email,
                OperatorForm.RoleName));

        StatusMessage = result.Succeeded ? "The inactive operator account was created and its one-time invitation was queued for delivery." : result.ErrorMessage;
        if (result.Succeeded)
        {
            OperatorForm = new CreateOperatorForm();
            await ReloadSnapshotAsync();
        }
    }

    private async Task RetrySecurityEmailAsync(Guid messageId)
    {
        var result = await SecurityAdministrationService.RetrySecurityEmailAsync(messageId);
        StatusMessage = result.Succeeded ? "The security-email delivery was queued for another bounded attempt." : result.ErrorMessage;
        await ReloadSnapshotAsync();
    }

    private async Task ResetOperatorMfaAsync()
    {
        var result = await SecurityAdministrationService.ResetOperatorMfaAsync(new AdministratorMfaRecoveryRequest(
            MfaRecoveryForm.TargetUserId,
            MfaRecoveryForm.ConfirmUserName,
            MfaRecoveryForm.CurrentAdministratorPassword,
            MfaRecoveryForm.VerificationMethod,
            MfaRecoveryForm.CaseReference));
        StatusMessage = result.Succeeded
            ? Snapshot?.SecurityEmailDeliveryConfigured == true
                ? "MFA recovery completed, all target sessions were revoked, and a security notice was queued to the registered email address."
                : "MFA recovery completed and all target sessions were revoked. Notify the operator through the company’s verified out-of-band procedure."
            : result.ErrorMessage;
        if (result.Succeeded) MfaRecoveryForm = new AdministratorMfaRecoveryForm();
        await ReloadSnapshotAsync();
    }

    private async Task CreateCompanyAsync()
    {
        var result = await CompanyManagementService.CreateCompanyAsync(new CreateCompanyRequest(CompanyForm.Name, CompanyForm.LegalName, CompanyForm.TaxId, CompanyForm.BaseCurrency, CompanyForm.FiscalYearStartMonth));
        StatusMessage = result.Succeeded ? "Company created. Switch the active company session to begin working in its separate books." : result.ErrorMessage;
        if (result.Succeeded) { CompanyForm = new CreateCompanyForm(); Companies = await CompanyManagementService.GetMyCompaniesAsync(); }
    }

    private async Task SaveExchangeRateAsync()
    {
        var result = await ConsolidationService.SaveExchangeRateAsync(new SaveExchangeRateRequest(ExchangeRateForm.BaseCurrency, ExchangeRateForm.QuoteCurrency, ExchangeRateForm.Rate, ExchangeRateForm.EffectiveOn, ExchangeRateForm.Source));
        StatusMessage = result.Succeeded ? "Exchange rate saved." : result.ErrorMessage;
    }

    private async Task SaveIntegrationConnectionAsync()
    {
        var result = await IntegrationService.SaveConnectionAsync(new SaveIntegrationConnectionRequest(null, IntegrationForm.ProviderCode, IntegrationForm.Name, IntegrationForm.SettingsJson, IntegrationForm.CredentialsJson, IntegrationForm.Enable));
        StatusMessage = result.Succeeded ? "Integration connection profile saved. Credentials are not displayed after saving." : result.ErrorMessage;
        if (result.Succeeded) { IntegrationForm = new IntegrationConnectionEditor(); Connections = await IntegrationService.GetConnectionsAsync(); }
    }

    private async Task ConnectQuickBooksAsync()
    {
        if (QuickBooksAvailability is null) return;
        var result = await QuickBooksOnlineConnectionService.BeginAuthorizationAsync(new(null, QuickBooksForm.ConnectionName, QuickBooksAvailability.Environment));
        StatusMessage = result.ErrorMessage;
        if (result.Succeeded && !string.IsNullOrWhiteSpace(result.AuthorizationUrl))
            NavigationManager.NavigateTo(result.AuthorizationUrl, forceLoad: true);
    }

    private async Task ReconnectQuickBooksAsync(IntegrationConnectionSnapshot connection)
    {
        if (QuickBooksAvailability is null) return;
        var result = await QuickBooksOnlineConnectionService.BeginAuthorizationAsync(new(connection.Id, connection.Name, QuickBooksAvailability.Environment));
        StatusMessage = result.ErrorMessage;
        if (result.Succeeded && !string.IsNullOrWhiteSpace(result.AuthorizationUrl))
            NavigationManager.NavigateTo(result.AuthorizationUrl, forceLoad: true);
    }

    private async Task ValidateQuickBooksAsync(Guid connectionId)
    {
        var result = await QuickBooksOnlineConnectionService.ValidateConnectionAsync(connectionId);
        StatusMessage = result.Succeeded ? "The QuickBooks company and authorization were validated." : result.ErrorMessage;
        Connections = await IntegrationService.GetConnectionsAsync();
    }

    private async Task RunQuickBooksSyncAsync(Guid connectionId, bool dryRun)
    {
        var key = QuickBooksPreviewKey(connectionId);
        var expectedSnapshot = dryRun ? string.Empty : QuickBooksPreviewSnapshots.GetValueOrDefault(key, string.Empty);
        if (!dryRun && string.IsNullOrWhiteSpace(expectedSnapshot))
        {
            StatusMessage = "Preview this QuickBooks data type before importing it.";
            return;
        }
        LatestQuickBooksSync = await QuickBooksOnlineSyncService.ImportAsync(new(connectionId, QuickBooksSyncEntity, dryRun, expectedSnapshot));
        StatusMessage = LatestQuickBooksSync.Succeeded
            ? dryRun ? "Preview complete. Review the counts and issues before importing this exact snapshot." : "The previewed QuickBooks snapshot was imported through controlled entity links."
            : LatestQuickBooksSync.ErrorMessage;
        if (dryRun && LatestQuickBooksSync.Succeeded) QuickBooksPreviewSnapshots[key] = LatestQuickBooksSync.SnapshotSha256;
        if (!dryRun || !LatestQuickBooksSync.Succeeded) QuickBooksPreviewSnapshots.Remove(key);
        QuickBooksSyncRuns = await QuickBooksOnlineSyncService.GetRecentRunsAsync(limit: 20);
        if (!dryRun && LatestQuickBooksSync.Succeeded) Connections = await IntegrationService.GetConnectionsAsync();
    }

    private bool HasCurrentQuickBooksPreview(Guid connectionId) => QuickBooksPreviewSnapshots.ContainsKey(QuickBooksPreviewKey(connectionId));
    private string QuickBooksPreviewKey(Guid connectionId) => $"{connectionId:N}:{QuickBooksSyncEntity}";
    private static bool HasQuickBooksAuthorization(IntegrationConnectionSnapshot connection) => connection.Status is "Connected" or "ValidationFailed" or "ReauthorizationRequired" or "DisconnectPending";

    private async Task DisconnectQuickBooksAsync(Guid connectionId)
    {
        var result = await QuickBooksOnlineConnectionService.DisconnectAsync(connectionId);
        StatusMessage = result.Succeeded ? "The QuickBooks authorization was revoked and protected tokens were removed." : result.ErrorMessage;
        PendingQuickBooksDisconnectId = null;
        Connections = await IntegrationService.GetConnectionsAsync();
    }

    private void CancelQuickBooksDisconnect() => PendingQuickBooksDisconnectId = null;

    private static string DescribeQuickBooksConnection(IntegrationConnectionSnapshot connection)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(connection.SettingsJson);
            var root = document.RootElement;
            var companyName = root.TryGetProperty("CompanyName", out var company) ? company.GetString() : null;
            var environment = root.TryGetProperty("Environment", out var environmentValue) ? environmentValue.GetString() : null;
            return string.IsNullOrWhiteSpace(companyName) ? environment ?? "Not linked" : $"{companyName} ({environment})";
        }
        catch (System.Text.Json.JsonException)
        {
            return "Connection metadata unavailable";
        }
    }

    private async Task CreateBackupAsync()
    {
        LatestBackup = await BackupService.CreateBackupAsync();
        BackupVerification = null; RecoveryRehearsal = null;
        StatusMessage = LatestBackup.Succeeded ? "Backup created. Verify it, then run a restore rehearsal before relying on it operationally." : LatestBackup.ErrorMessage;
    }

    private async Task VerifyBackupAsync()
    {
        if (LatestBackup?.BackupId is null) return;
        BackupVerification = await BackupService.VerifyBackupAsync(LatestBackup.BackupId);
        StatusMessage = BackupVerification.Succeeded ? "Backup integrity verification passed." : BackupVerification.ErrorMessage;
    }

    private async Task RehearseRestoreAsync()
    {
        if (LatestBackup?.BackupId is null) return;
        RecoveryRehearsal = await BackupService.RehearseRestoreAsync(LatestBackup.BackupId);
        StatusMessage = RecoveryRehearsal.Succeeded ? "Isolated restore rehearsal passed; live data was not changed." : RecoveryRehearsal.ErrorMessage;
    }

    private async Task DisableIntegrationConnectionAsync(IntegrationConnectionSnapshot connection)
    {
        var result = await IntegrationService.SaveConnectionAsync(new SaveIntegrationConnectionRequest(connection.Id, connection.ProviderCode, connection.Name, connection.SettingsJson, string.Empty, false));
        StatusMessage = result.Succeeded ? $"{connection.Name} was disabled; its credentials were retained securely for a future authorized re-enable." : result.ErrorMessage;
        if (result.Succeeded) Connections = await IntegrationService.GetConnectionsAsync();
    }

    private async Task SaveAccountingPeriodAsync()
    {
        var result = await AccountingPeriodService.SavePeriodAsync(new SaveAccountingPeriodRequest(null, AccountingPeriodForm.StartsOn, AccountingPeriodForm.EndsOn, AccountingPeriodForm.Notes));
        StatusMessage = result.Succeeded ? "Accounting period saved." : result.ErrorMessage;
        if (result.Succeeded) { AccountingPeriodForm = new AccountingPeriodEditor(); AccountingControls = await AccountingPeriodService.GetSnapshotAsync(); }
    }

    private async Task SetPeriodStatusAsync(Guid periodId, bool close)
    {
        var result = await AccountingPeriodService.SetPeriodStatusAsync(periodId, close, close ? "Closed from administration." : "Reopened from administration.");
        StatusMessage = result.Succeeded ? (close ? "Accounting period closed." : "Accounting period reopened.") : result.ErrorMessage;
        if (result.Succeeded) AccountingControls = await AccountingPeriodService.GetSnapshotAsync();
    }

    private Task TogglePeriodStatusAsync(AccountingPeriodSnapshot period) => SetPeriodStatusAsync(period.Id, period.Status != "Closed");

    private async Task SaveConsolidationGroupAsync()
    {
        var members = ConsolidationForm.MemberCompanyIds.Select(companyId => new ConsolidationMemberRequest(companyId, ConsolidationForm.OwnershipPercentages.GetValueOrDefault(companyId, 1m))).ToArray();
        var result = await ConsolidationService.SaveGroupAsync(new SaveConsolidationGroupRequest(null, ConsolidationForm.Name, ConsolidationForm.ReportingCurrency, members));
        StatusMessage = result.Succeeded ? "Consolidation group saved." : result.ErrorMessage;
        if (result.Succeeded) { ConsolidationForm = new ConsolidationGroupEditor(); await ReloadSnapshotAsync(); }
    }

    private void ToggleConsolidationMember(Guid companyId, object? value)
    {
        var selected = value is bool boolValue ? boolValue : string.Equals(value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (selected) { ConsolidationForm.MemberCompanyIds.Add(companyId); ConsolidationForm.OwnershipPercentages.TryAdd(companyId, 1m); }
        else ConsolidationForm.MemberCompanyIds.Remove(companyId);
    }

    private void SetConsolidationOwnership(Guid companyId, object? value)
    {
        if (decimal.TryParse(value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var ownership))
        {
            ConsolidationForm.OwnershipPercentages[companyId] = ownership;
        }
    }

    private async Task LoadConsolidatedBalanceAsync(Guid groupId)
    {
        ConsolidatedBalance = await ConsolidationService.GetBalanceReportAsync(groupId, DateOnly.FromDateTime(DateTime.Today));
        StatusMessage = ConsolidatedBalance is null ? "The consolidation report is unavailable to this session." : null;
    }

    private void TogglePermission(string permissionCode, object? value)
    {
        var selected = value switch
        {
            bool boolValue => boolValue,
            string stringValue => string.Equals(stringValue, "true", StringComparison.OrdinalIgnoreCase),
            _ => false
        };
        if (selected)
        {
            RoleForm.Permissions.Add(permissionCode);
        }
        else
        {
            RoleForm.Permissions.Remove(permissionCode);
        }
    }

    private async Task ReloadSnapshotAsync()
    {
        Snapshot = await SecurityAdministrationService.GetSnapshotAsync();
        Providers = await IntegrationService.GetCatalogAsync();
        Connections = await IntegrationService.GetConnectionsAsync();
        QuickBooksAvailability = await QuickBooksOnlineConnectionService.GetAvailabilityAsync();
        QuickBooksSyncRuns = await QuickBooksOnlineSyncService.GetRecentRunsAsync(limit: 20);
        Companies = await CompanyManagementService.GetMyCompaniesAsync();
        ConsolidationGroups = await ConsolidationService.GetGroupsAsync();
        AccountingControls = await AccountingPeriodService.GetSnapshotAsync();
        PermissionLabels = Snapshot.Permissions.ToDictionary(permission => permission.Code, permission => permission.Name, StringComparer.OrdinalIgnoreCase);
    }

    private sealed class CreateRoleForm
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public HashSet<string> Permissions { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public bool RequiresMfa { get; set; }
    }

    private sealed class CreateOperatorForm
    {
        public string UserName { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string RoleName { get; set; } = string.Empty;
    }
    private sealed class AdministratorMfaRecoveryForm
    {
        public Guid TargetUserId { get; set; }
        public string ConfirmUserName { get; set; } = string.Empty;
        public string CurrentAdministratorPassword { get; set; } = string.Empty;
        public string VerificationMethod { get; set; } = string.Empty;
        public string CaseReference { get; set; } = string.Empty;
    }
    private sealed class CreateCompanyForm { public string Name { get; set; } = string.Empty; public string LegalName { get; set; } = string.Empty; public string TaxId { get; set; } = string.Empty; public string BaseCurrency { get; set; } = "USD"; public int FiscalYearStartMonth { get; set; } = 1; }
    private sealed class ExchangeRateEditor { public string BaseCurrency { get; set; } = "USD"; public string QuoteCurrency { get; set; } = "CAD"; public decimal Rate { get; set; } = 1m; public DateOnly EffectiveOn { get; set; } = DateOnly.FromDateTime(DateTime.Today); public string Source { get; set; } = string.Empty; }
    private sealed class ConsolidationGroupEditor { public string Name { get; set; } = string.Empty; public string ReportingCurrency { get; set; } = "USD"; public HashSet<Guid> MemberCompanyIds { get; } = []; public Dictionary<Guid, decimal> OwnershipPercentages { get; } = []; }
    private sealed class AccountingPeriodEditor { public DateOnly StartsOn { get; set; } = new(DateTime.Today.Year, 1, 1); public DateOnly EndsOn { get; set; } = new(DateTime.Today.Year, 12, 31); public string Notes { get; set; } = string.Empty; }
    private sealed class IntegrationConnectionEditor { public string ProviderCode { get; set; } = string.Empty; public string Name { get; set; } = string.Empty; public string SettingsJson { get; set; } = "{}"; public string CredentialsJson { get; set; } = "{}"; public bool Enable { get; set; } }
    private sealed class QuickBooksConnectionEditor { public string ConnectionName { get; set; } = "Primary QuickBooks company"; }
}
