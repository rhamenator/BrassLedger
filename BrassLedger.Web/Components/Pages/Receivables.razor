        SetInvoiceDefaults();
        SyncPaymentApplications();
    }

    private async Task SaveInvoiceDraftAsync()
    {
        var lines = InvoiceForm.Lines.Select(line => new SalesInvoiceLineRequest(line.Description, line.Quantity, line.UnitPrice, line.Discount, line.Tax, line.RevenueAccount, line.ProjectJobId, line.ProjectPhaseId, line.ProjectCostCodeId, line.DepartmentId, line.ClassId)).ToArray();
        var result = await TransactionService.SaveInvoiceDraftAsync(new CreateInvoiceRequest(InvoiceForm.CustomerId, InvoiceForm.Number, InvoiceForm.Date, InvoiceForm.DueDate, 0m, 0m, lines.FirstOrDefault()?.RevenueAccountNumber ?? DefaultRevenueAccountNumber, $"Invoice {InvoiceForm.Number}", lines, Currency: InvoiceForm.Currency, ExchangeRateId: InvoiceForm.ExchangeRateId));
        StatusMessage = result.Succeeded ? "Invoice draft saved." : result.ErrorMessage;
        if (result.Succeeded)
        {
            Workspace = await WorkspaceService.GetWorkspaceAsync();
            InvoiceForm.Reset(DefaultRevenueAccountNumber);
            SyncPaymentApplications();
        }
    }

    private async Task SaveRecurringInvoiceTemplateAsync() { var lines = InvoiceForm.Lines.Select(line => new SalesInvoiceLineRequest(line.Description, line.Quantity, line.UnitPrice, line.Discount, line.Tax, line.RevenueAccount, line.ProjectJobId, line.ProjectPhaseId, line.ProjectCostCodeId, line.DepartmentId, line.ClassId)).ToArray(); var request = new CreateInvoiceRequest(InvoiceForm.CustomerId, InvoiceForm.Number, InvoiceForm.Date, InvoiceForm.DueDate, 0m, 0m, lines.FirstOrDefault()?.RevenueAccountNumber ?? DefaultRevenueAccountNumber, $"Recurring invoice {InvoiceForm.Number}", lines, InvoiceForm.Currency, InvoiceForm.ExchangeRateId); var result = await TransactionService.SaveRecurringInvoiceTemplateAsync(new SaveRecurringInvoiceTemplateRequest(request, RecurringForm.Frequency, RecurringForm.Interval, RecurringForm.NextDate)); StatusMessage = result.Succeeded ? "Recurring invoice template saved." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); InvoiceForm.Reset(DefaultRevenueAccountNumber); } }
    private async Task GenerateRecurringDraftsAsync() { var result = await TransactionService.GenerateDueRecurringDocumentsAsync(RecurringForm.GenerateThrough); StatusMessage = result.Succeeded ? "Due recurring drafts generated." : result.ErrorMessage; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    private async Task ApproveWorkflowAsync(Guid id) { var result = await TransactionService.ApproveSubledgerDocumentAsync(id); StatusMessage = result.Succeeded ? "Invoice draft approved." : result.ErrorMessage; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    private async Task RejectWorkflowAsync(SubledgerDocumentWorkflowSnapshot workflow) { var result = await TransactionService.RejectSubledgerDocumentAsync(new RejectSubledgerDocumentRequest(workflow.Id, RejectionReason, workflow.ConcurrencyToken)); StatusMessage = result.Succeeded ? "Invoice draft rejected. Its preparer can correct and resubmit it using the same number." : result.ErrorMessage; if (result.Succeeded) RejectionReason = string.Empty; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    private async Task PostWorkflowAsync(Guid id) { var result = await TransactionService.PostApprovedSubledgerDocumentAsync(id); StatusMessage = result.Succeeded ? "Approved invoice posted." : result.ErrorMessage; Workspace = await WorkspaceService.GetWorkspaceAsync(); SyncPaymentApplications(); }

    private void AddInvoiceLine() => InvoiceForm.Lines.Add(new InvoiceLineEditor { RevenueAccount = DefaultRevenueAccountNumber });
    private void RemoveInvoiceLine(InvoiceLineEditor line) { if (InvoiceForm.Lines.Count > 1) InvoiceForm.Lines.Remove(line); }

    private async Task ApplyPaymentAsync()
    {
        var applications = AvailableInvoiceApplications.Where(application => application.Selected).Select(application => new PaymentDocumentApplicationRequest(application.DocumentId, application.Amount)).ToArray();
        var result = await TransactionService.RecordCustomerPaymentAsync(new RecordCustomerPaymentRequest(PaymentForm.CustomerId, PaymentForm.BankId, PaymentForm.Date, PaymentForm.Amount, PaymentForm.Reference, PaymentForm.Method, applications, PaymentForm.Currency, PaymentForm.ExchangeRateId));
        StatusMessage = result.Succeeded ? "Customer payment recorded." : result.ErrorMessage;
        if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); PaymentForm.Reset(); SyncPaymentApplications(); }
    }

    private async Task ReversePaymentAsync(Guid paymentId)
    {
        var result = await TransactionService.ReverseSubledgerPaymentAsync(new ReverseSubledgerPaymentRequest(paymentId, ReversalForm.Date, ReversalForm.Reason, ReversalForm.Kind));
        StatusMessage = result.Succeeded ? $"Customer payment marked {ReversalForm.Kind.ToLowerInvariant()}." : result.ErrorMessage;
        if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); PaymentForm.Reset(); SyncPaymentApplications(); ReversalForm.Reason = string.Empty; }
    }

    private async Task RecordAdjustmentAsync() { var isForeign = SelectedAdjustmentInvoice is { } invoice && !IsBaseCurrency(invoice.TransactionCurrency); var rateBasis = !isForeign ? "" : AdjustmentForm.Kind == "WriteOff" ? "CarryingValue" : AdjustmentForm.RateBasis; var exchangeRateId = isForeign && rateBasis == "AdjustmentDateRate" ? AdjustmentForm.ExchangeRateId : null; var result = await TransactionService.RecordCustomerAdjustmentAsync(new RecordCustomerAdjustmentRequest(AdjustmentForm.InvoiceId, AdjustmentForm.Date, AdjustmentForm.Amount, AdjustmentForm.Reference, AdjustmentForm.OffsetAccount, AdjustmentForm.Reason, AdjustmentForm.Kind, exchangeRateId, rateBasis)); StatusMessage = result.Succeeded ? "Customer adjustment posted." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); AdjustmentForm.Reset(); SyncPaymentApplications(); } }
    private async Task RefundDepositAsync() { var result = await TransactionService.RefundUnappliedPaymentAsync(new RefundUnappliedPaymentRequest(RefundForm.PaymentId, RefundForm.BankId, RefundForm.Date, RefundForm.Amount, RefundForm.Reference, RefundForm.Reason, RefundForm.ExchangeRateId, SelectedRefundPayment?.ConcurrencyToken ?? string.Empty)); StatusMessage = result.Succeeded ? "Customer deposit refunded." : result.ErrorMessage; Workspace = await WorkspaceService.GetWorkspaceAsync(); if (result.Succeeded) { RefundForm.Reset(); } }
    private async Task VoidInvoiceAsync() { var result = await TransactionService.VoidInvoiceAsync(new VoidSubledgerDocumentRequest(VoidForm.DocumentId, VoidForm.Date, VoidForm.Reason)); StatusMessage = result.Succeeded ? "Invoice voided." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); VoidForm.Reset(); SyncPaymentApplications(); } }
    private async Task ReverseAdjustmentAsync(Guid id) { var result = await TransactionService.ReverseSubledgerAdjustmentAsync(new ReverseSubledgerAdjustmentRequest(id, AdjustmentReversalForm.Date, AdjustmentReversalForm.Reason)); StatusMessage = result.Succeeded ? "Customer adjustment reversed." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); AdjustmentReversalForm.Reason = string.Empty; SyncPaymentApplications(); } }

    private void SyncPaymentApplications()
    {
        PaymentForm.Applications.Clear();
        if (Workspace is null) return;
        PaymentForm.Applications.AddRange(Workspace.Receivables.Invoices.Where(invoice => invoice.TransactionBalanceDue > 0).Select(invoice => new PaymentApplicationEditor(invoice.Id, invoice.CustomerId, invoice.InvoiceNumber, invoice.DueDate, invoice.TransactionBalanceDue, invoice.TransactionCurrency)));
    }

    private string NormalizeCurrency(string? currency) => (string.IsNullOrWhiteSpace(currency) ? Workspace?.Company.BaseCurrency : currency)?.Trim().ToUpperInvariant() ?? string.Empty;
    private bool IsBaseCurrency(string? currency) => NormalizeCurrency(currency) == Workspace?.Company.BaseCurrency;
    private string FormatTransactionAmount(decimal amount, string currency) => IsBaseCurrency(currency) ? $"{amount:C} {currency}" : $"{amount:N2} {currency}";
    private IEnumerable<ExchangeRateSnapshot> ApplicableRates(string? currency, DateOnly date)
    {
        var transactionCurrency = NormalizeCurrency(currency); var baseCurrency = Workspace?.Company.BaseCurrency ?? string.Empty;
        return ExchangeRates.Where(rate => rate.IsActive && rate.RateType == "Closing" && rate.EffectiveOn <= date && ((rate.BaseCurrency == transactionCurrency && rate.QuoteCurrency == baseCurrency) || (rate.BaseCurrency == baseCurrency && rate.QuoteCurrency == transactionCurrency))).OrderByDescending(rate => rate.EffectiveOn);
    }
    private static string RateLabel(ExchangeRateSnapshot rate) => $"{rate.EffectiveOn}: {rate.BaseCurrency}/{rate.QuoteCurrency} {rate.Rate:N8} — {rate.Source}";
    private SubledgerPaymentSnapshot? SelectedRefundPayment => (Workspace?.Receivables.Payments ?? []).SingleOrDefault(payment => payment.Id == RefundForm.PaymentId);
    private InvoiceSnapshot? SelectedAdjustmentInvoice => (Workspace?.Receivables.Invoices ?? []).SingleOrDefault(invoice => invoice.Id == AdjustmentForm.InvoiceId);

    private string DefaultRevenueAccountNumber => Workspace?.GeneralLedger.Accounts.SingleOrDefault(account => account.OperationalRole == BrassLedger.Domain.Accounting.AccountingAccountRoles.DefaultRevenue)?.Number ?? string.Empty;
    private IEnumerable<TrackingDimensionValueSnapshot> ActiveTrackingDimensions(string type, DateOnly effectiveOn) =>
        (Workspace?.GeneralLedger.TrackingDimensions ?? []).Where(value => value.DimensionType == type && value.IsActive && (!value.EffectiveFrom.HasValue || value.EffectiveFrom <= effectiveOn) && (!value.EffectiveThrough.HasValue || value.EffectiveThrough >= effectiveOn));

    private void SetInvoiceDefaults()
    {
        foreach (var line in InvoiceForm.Lines.Where(line => string.IsNullOrWhiteSpace(line.RevenueAccount))) line.RevenueAccount = DefaultRevenueAccountNumber;
        if (string.IsNullOrWhiteSpace(AdjustmentForm.OffsetAccount)) AdjustmentForm.OffsetAccount = DefaultRevenueAccountNumber;
    }

