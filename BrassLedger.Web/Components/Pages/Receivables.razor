    private sealed class CustomerAdjustmentEditor { public Guid InvoiceId { get; set; } public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public decimal Amount { get; set; } public string Reference { get; set; } = string.Empty; public string OffsetAccount { get; set; } = "4000"; public string Reason { get; set; } = string.Empty; public string Kind { get; set; } = "CreditMemo"; public void Reset() { InvoiceId = Guid.Empty; Amount = 0; Reference = string.Empty; Reason = string.Empty; } }
    private sealed class RefundEditor { public Guid PaymentId { get; set; } public Guid BankId { get; set; } public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public decimal Amount { get; set; } public string Reference { get; set; } = string.Empty; public string Reason { get; set; } = string.Empty; public void Reset() { PaymentId = Guid.Empty; Amount = 0; Reference = string.Empty; Reason = string.Empty; } }
    private sealed class VoidEditor { public Guid DocumentId { get; set; } public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public string Reason { get; set; } = string.Empty; public void Reset() { DocumentId = Guid.Empty; Reason = string.Empty; } }
    private sealed class AdjustmentReversalEditor { public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public string Reason { get; set; } = string.Empty; }
    private sealed class RecurringEditor { public string Frequency { get; set; } = "Monthly"; public int Interval { get; set; } = 1; public DateOnly NextDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddMonths(1)); public DateOnly GenerateThrough { get; set; } = DateOnly.FromDateTime(DateTime.Today); }
