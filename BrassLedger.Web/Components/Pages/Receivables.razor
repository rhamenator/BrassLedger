@page "/receivables"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.ManageReceivables)]
@inject IBusinessWorkspaceService WorkspaceService
@inject IAccountingTransactionService TransactionService

<PageTitle>Receivables</PageTitle>

@if (Workspace is null)
{
    <section class="panel">
        <h1>Loading receivables...</h1>
    </section>
}
else
{
    <section class="page-shell">
        <header class="page-header">
            <div>
                <p class="eyebrow">Accounts Receivable and CRM</p>
                <h1>Customers, invoices, and open-balance follow-up.</h1>
            </div>
            <p class="page-intro">Create itemized invoices, post revenue and sales tax to the ledger, and follow open customer balances.</p>
        </header>

        <section class="stats-grid">
            <article class="stat-card accent-sand">
                <span class="stat-value">@Workspace.Receivables.OpenBalance.ToString("C0")</span>
                <span class="stat-label">Open A/R</span>
            </article>
            <article class="stat-card accent-sky">
                <span class="stat-value">@Workspace.Receivables.Customers.Count</span>
                <span class="stat-label">Customers</span>
            </article>
            <article class="stat-card accent-sage">
                <span class="stat-value">@Workspace.Receivables.Invoices.Count</span>
                <span class="stat-label">Invoices</span>
            </article>
            <article class="stat-card accent-coral">
                <span class="stat-value">@Workspace.Receivables.PastDueCount</span>
                <span class="stat-label">Past due</span>
            </article>
        </section>

        <section class="panel">
            <h2>Create and post invoice</h2>
            @if (!string.IsNullOrWhiteSpace(StatusMessage)) { <p class="lead" role="status" aria-live="polite">@StatusMessage</p> }
            <EditForm Model="InvoiceForm" OnValidSubmit="SaveInvoiceDraftAsync">
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Customer</label><InputSelect aria-label="Invoice customer" class="field-input" @bind-Value="InvoiceForm.CustomerId"><option value="@Guid.Empty">Select customer</option>@foreach (var customer in Workspace.Receivables.Customers) { <option value="@customer.Id">@customer.CustomerNumber — @customer.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Invoice number</label><InputText aria-label="Invoice number" class="field-input" @bind-Value="InvoiceForm.Number" /></div>
                    <div class="field-group"><label class="field-label">Invoice date</label><InputDate aria-label="Invoice date" class="field-input" @bind-Value="InvoiceForm.Date" /></div>
                    <div class="field-group"><label class="field-label">Due date</label><InputDate aria-label="Invoice due date" class="field-input" @bind-Value="InvoiceForm.DueDate" /></div>
                </div>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Description</th><th>Quantity</th><th>Unit price</th><th>Discount</th><th>Tax</th><th>Revenue account</th><th>Line total</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var line in InvoiceForm.Lines)
                            {
                                <tr @key="line">
                                    <td><InputText aria-label="Invoice line description" class="field-input" @bind-Value="line.Description" /></td>
                                    <td><InputNumber aria-label="Invoice line quantity" class="field-input" @bind-Value="line.Quantity" /></td>
                                    <td><InputNumber aria-label="Invoice line unit price" class="field-input" @bind-Value="line.UnitPrice" /></td>
                                    <td><InputNumber aria-label="Invoice line discount" class="field-input" @bind-Value="line.Discount" /></td>
                                    <td><InputNumber aria-label="Invoice line tax" class="field-input" @bind-Value="line.Tax" /></td>
                                    <td><InputSelect aria-label="Invoice line revenue account" class="field-input" @bind-Value="line.RevenueAccount">@foreach (var account in Workspace.GeneralLedger.Accounts.Where(x => x.Type == "Revenue")) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></td>
                                    <td>@line.Total.ToString("C")</td>
                                    <td><button class="action-secondary" type="button" disabled="@(InvoiceForm.Lines.Count == 1)" @onclick="() => RemoveInvoiceLine(line)">Remove</button></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr><th colspan="6">Invoice total</th><th>@InvoiceForm.Total.ToString("C")</th><th></th></tr></tfoot>
                    </table>
                </div>
                <button class="action-secondary" type="button" @onclick="AddInvoiceLine">Add line</button>
                <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareSubledgerDocuments" Context="invoicePreparationAuthorization"><button class="action-primary" type="submit">Save invoice draft</button><div class="content-grid"><div class="field-group"><label class="field-label">Recurring frequency</label><InputSelect aria-label="Recurring invoice frequency" class="field-input" @bind-Value="RecurringForm.Frequency"><option>Monthly</option><option>Weekly</option><option>Quarterly</option><option>Annually</option></InputSelect></div><div class="field-group"><label class="field-label">Every</label><InputNumber aria-label="Recurring invoice interval" class="field-input" @bind-Value="RecurringForm.Interval" /></div><div class="field-group"><label class="field-label">Next date</label><InputDate aria-label="Recurring invoice next date" class="field-input" @bind-Value="RecurringForm.NextDate" /></div></div><button class="action-secondary" type="button" @onclick="SaveRecurringInvoiceTemplateAsync">Save recurring template</button></AuthorizeView>
            </EditForm>
        </section>

        <section class="panel"><h2>Invoice review queue</h2><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareSubledgerDocuments"><div class="content-grid"><div class="field-group"><label class="field-label">Generate recurring drafts through</label><InputDate aria-label="Generate recurring invoice drafts through" class="field-input" @bind-Value="RecurringForm.GenerateThrough" /></div><button class="action-secondary" type="button" @onclick="GenerateRecurringDraftsAsync">Generate due drafts</button></div></AuthorizeView><div class="table-scroll"><table class="data-table"><thead><tr><th>Number</th><th>Status</th><th>Source</th><th>Next</th><th>Actions</th></tr></thead><tbody>@foreach (var workflow in Workspace.Receivables.Workflows ?? []) { <tr><td>@workflow.DocumentNumber</td><td>@workflow.Status</td><td>@(workflow.IsRecurringTemplate ? $"{workflow.Frequency} template" : workflow.SourceTemplateId.HasValue ? "Recurring draft" : "Manual draft")</td><td>@workflow.NextOccurrenceDate</td><td>@if (!workflow.IsRecurringTemplate && workflow.Status == "Draft") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApproveSubledgerDocuments"><button class="action-secondary" type="button" @onclick="() => ApproveWorkflowAsync(workflow.Id)">Approve</button></AuthorizeView> } @if (!workflow.IsRecurringTemplate && workflow.Status == "Approved") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PostSubledgerDocuments"><button class="action-primary" type="button" @onclick="() => PostWorkflowAsync(workflow.Id)">Post</button></AuthorizeView> }</td></tr> }</tbody></table></div></section>

        <section class="panel">
            <h2>Record customer payment or deposit</h2>
            <p class="page-intro">Apply one receipt across invoices or leave part of it unapplied as a customer deposit.</p>
            <EditForm Model="PaymentForm" OnValidSubmit="ApplyPaymentAsync">
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Customer</label><InputSelect aria-label="Payment customer" class="field-input" @bind-Value="PaymentForm.CustomerId"><option value="@Guid.Empty">Select customer</option>@foreach (var customer in Workspace.Receivables.Customers) { <option value="@customer.Id">@customer.CustomerNumber — @customer.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Deposit account</label><InputSelect aria-label="Payment deposit account" class="field-input" @bind-Value="PaymentForm.BankId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Payment date</label><InputDate aria-label="Payment date" class="field-input" @bind-Value="PaymentForm.Date" /></div>
                    <div class="field-group"><label class="field-label">Payment total</label><InputNumber aria-label="Payment total" class="field-input" @bind-Value="PaymentForm.Amount" /></div>
                    <div class="field-group"><label class="field-label">Method</label><InputSelect aria-label="Payment method" class="field-input" @bind-Value="PaymentForm.Method">@foreach (var method in PaymentMethods) { <option value="@method">@method</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Payment reference" class="field-input" @bind-Value="PaymentForm.Reference" /></div>
                </div>
                @if (PaymentForm.CustomerId != Guid.Empty)
                {
                    <div class="table-scroll"><table class="data-table"><thead><tr><th>Apply</th><th>Invoice</th><th>Due</th><th>Open balance</th><th>Apply amount</th></tr></thead><tbody>
                        @foreach (var application in AvailableInvoiceApplications)
                        {
                            <tr @key="application.DocumentId"><td><InputCheckbox aria-label="@($"Apply to {application.DocumentNumber}")" @bind-Value="application.Selected" /></td><td>@application.DocumentNumber</td><td>@application.DueDate</td><td>@application.OpenBalance.ToString("C")</td><td><InputNumber aria-label="@($"Amount for {application.DocumentNumber}")" class="field-input" disabled="@(!application.Selected)" @bind-Value="application.Amount" /></td></tr>
                        }
                    </tbody><tfoot><tr><th colspan="3">Payment allocation</th><th>Applied: @PaymentForm.AppliedAmount.ToString("C")</th><th>Unapplied deposit: @PaymentForm.UnappliedAmount.ToString("C")</th></tr></tfoot></table></div>
                }
                <button class="action-primary" type="submit">Record customer payment</button>
            </EditForm>
        </section>

        <section class="panel">
            <h2>Customer payment history</h2>
            <div class="content-grid"><div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Customer payment reversal date" class="field-input" @bind-Value="ReversalForm.Date" /></div><div class="field-group"><label class="field-label">Outcome</label><InputSelect aria-label="Customer payment reversal kind" class="field-input" @bind-Value="ReversalForm.Kind"><option>Returned</option><option>Voided</option><option>Reversed</option></InputSelect></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Customer payment reversal reason" class="field-input" @bind-Value="ReversalForm.Reason" /></div></div>
            <div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Customer</th><th>Reference</th><th>Method</th><th>Total</th><th>Applied</th><th>Deposit</th><th>Status</th><th></th></tr></thead><tbody>
                @foreach (var payment in Workspace.Receivables.Payments ?? [])
                {
                    <tr><td>@payment.PaymentDate</td><td>@payment.CounterpartyName</td><td>@payment.Reference</td><td>@payment.Method</td><td>@payment.Amount.ToString("C")</td><td>@payment.AppliedAmount.ToString("C")</td><td>@payment.UnappliedAmount.ToString("C")</td><td>@payment.Status</td><td>@if (payment.Status == "Posted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments"><button class="action-secondary" type="button" @onclick="() => ReversePaymentAsync(payment.Id)">Record @ReversalForm.Kind.ToLowerInvariant()</button></AuthorizeView> }</td></tr>
                }
            </tbody></table></div>
        </section>

        <section class="panel">
            <h2>Credits and write-offs</h2>
            <EditForm Model="AdjustmentForm" OnValidSubmit="RecordAdjustmentAsync"><div class="content-grid">
                <div class="field-group"><label class="field-label">Invoice</label><InputSelect aria-label="Adjustment invoice" class="field-input" @bind-Value="AdjustmentForm.InvoiceId"><option value="@Guid.Empty">Select invoice</option>@foreach (var invoice in Workspace.Receivables.Invoices.Where(item => item.BalanceDue > 0)) { <option value="@invoice.Id">@invoice.InvoiceNumber — @invoice.BalanceDue.ToString("C")</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label">Kind</label><InputSelect aria-label="Customer adjustment kind" class="field-input" @bind-Value="AdjustmentForm.Kind"><option>CreditMemo</option><option>WriteOff</option></InputSelect></div>
                <div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Customer adjustment date" class="field-input" @bind-Value="AdjustmentForm.Date" /></div>
                <div class="field-group"><label class="field-label">Amount</label><InputNumber aria-label="Customer adjustment amount" class="field-input" @bind-Value="AdjustmentForm.Amount" /></div>
                <div class="field-group"><label class="field-label">Offset account</label><InputSelect aria-label="Customer adjustment offset account" class="field-input" @bind-Value="AdjustmentForm.OffsetAccount"><option value="">Select account</option>@foreach (var account in Workspace.GeneralLedger.Accounts.Where(item => !item.IsControlAccount && item.Type is "Revenue" or "Expense")) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Customer adjustment reference" class="field-input" @bind-Value="AdjustmentForm.Reference" /></div>
                <div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Customer adjustment reason" class="field-input" @bind-Value="AdjustmentForm.Reason" /></div>
            </div><button class="action-primary" type="submit">Post customer adjustment</button></EditForm>
        </section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments" Context="refundAuthorization">
            <section class="panel"><h2>Refund deposit or void invoice</h2><div class="content-grid">
                <EditForm Model="RefundForm" OnValidSubmit="RefundDepositAsync"><div class="field-group"><label class="field-label">Deposit</label><InputSelect aria-label="Refund customer deposit" class="field-input" @bind-Value="RefundForm.PaymentId"><option value="@Guid.Empty">Select deposit</option>@foreach (var payment in (Workspace.Receivables.Payments ?? []).Where(item => item.Status == "Posted" && item.UnappliedAmount > 0)) { <option value="@payment.Id">@payment.Reference — @payment.UnappliedAmount.ToString("C")</option> }</InputSelect></div><div class="field-group"><label class="field-label">Bank</label><InputSelect aria-label="Customer refund bank" class="field-input" @bind-Value="RefundForm.BankId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div><div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Customer refund date" class="field-input" @bind-Value="RefundForm.Date" /></div><div class="field-group"><label class="field-label">Amount</label><InputNumber aria-label="Customer refund amount" class="field-input" @bind-Value="RefundForm.Amount" /></div><div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Customer refund reference" class="field-input" @bind-Value="RefundForm.Reference" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Customer refund reason" class="field-input" @bind-Value="RefundForm.Reason" /></div><button class="action-primary" type="submit">Refund customer deposit</button></EditForm>
                <EditForm Model="VoidForm" OnValidSubmit="VoidInvoiceAsync"><div class="field-group"><label class="field-label">Invoice</label><InputSelect aria-label="Void invoice" class="field-input" @bind-Value="VoidForm.DocumentId"><option value="@Guid.Empty">Select invoice</option>@foreach (var invoice in Workspace.Receivables.Invoices.Where(item => item.Status != "Voided" && item.BalanceDue == item.TotalAmount)) { <option value="@invoice.Id">@invoice.InvoiceNumber</option> }</InputSelect></div><div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Invoice void date" class="field-input" @bind-Value="VoidForm.Date" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Invoice void reason" class="field-input" @bind-Value="VoidForm.Reason" /></div><button class="action-primary" type="submit">Void invoice</button></EditForm>
            </div></section>
        </AuthorizeView>

        <section class="panel"><h2>Customer adjustment history</h2><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments"><div class="content-grid"><div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Customer adjustment reversal date" class="field-input" @bind-Value="AdjustmentReversalForm.Date" /></div><div class="field-group"><label class="field-label">Reversal reason</label><InputText aria-label="Customer adjustment reversal reason" class="field-input" @bind-Value="AdjustmentReversalForm.Reason" /></div></div></AuthorizeView><div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Kind</th><th>Customer</th><th>Document</th><th>Reference</th><th>Amount</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var adjustment in Workspace.Receivables.Adjustments ?? []) { <tr><td>@adjustment.AdjustmentDate</td><td>@adjustment.Kind</td><td>@adjustment.CounterpartyName</td><td>@adjustment.DocumentNumber</td><td>@adjustment.Reference</td><td>@adjustment.Amount.ToString("C")</td><td>@adjustment.Status</td><td>@if (adjustment.Status == "Posted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments"><button class="action-secondary" type="button" @onclick="() => ReverseAdjustmentAsync(adjustment.Id)">Reverse</button></AuthorizeView> }</td></tr> }</tbody></table></div></section>

        <section class="content-grid">
            <article class="panel">
                <h2>Customers</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>State</th>
                            <th>Credit limit</th>
                            <th>Open balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Workspace.Receivables.Customers)
                        {
                            <tr>
                                <td>@customer.CustomerNumber - @customer.Name</td>
                                <td>@customer.State</td>
                                <td>@customer.CreditLimit.ToString("C")</td>
                                <td>@customer.OpenBalance.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>

            <article class="panel">
                <h2>Open invoice stack</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Lines</th>
                            <th>Due</th>
                            <th>Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Workspace.Receivables.Invoices)
                        {
                            <tr>
                                <td>@invoice.InvoiceNumber</td>
                                <td>@invoice.CustomerName</td>
                                <td>@invoice.Status</td>
                                <td>@(invoice.Lines?.Count ?? 0)</td>
                                <td>@invoice.DueDate.ToString("MMM d, yyyy")</td>
                                <td>@invoice.BalanceDue.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>
        </section>
    </section>
}

@code {
    private BusinessWorkspaceSnapshot? Workspace;
    private string? StatusMessage;
    private InvoiceEditor InvoiceForm { get; } = new();
    private PaymentEditor PaymentForm { get; } = new();
    private PaymentReversalEditor ReversalForm { get; } = new();
    private CustomerAdjustmentEditor AdjustmentForm { get; } = new();
    private RefundEditor RefundForm { get; } = new();
    private VoidEditor VoidForm { get; } = new();
    private AdjustmentReversalEditor AdjustmentReversalForm { get; } = new();
    private RecurringEditor RecurringForm { get; } = new();
    private static readonly string[] PaymentMethods = ["Check", "ACH", "Card", "Wire", "Cash", "Other"];
    private IEnumerable<PaymentApplicationEditor> AvailableInvoiceApplications => PaymentForm.Applications.Where(application => application.CounterpartyId == PaymentForm.CustomerId);

    protected override async Task OnInitializedAsync()
    {
        Workspace = await WorkspaceService.GetWorkspaceAsync();
        SyncPaymentApplications();
    }

    private async Task SaveInvoiceDraftAsync()
    {
        var lines = InvoiceForm.Lines.Select(line => new SalesInvoiceLineRequest(line.Description, line.Quantity, line.UnitPrice, line.Discount, line.Tax, line.RevenueAccount)).ToArray();
        var result = await TransactionService.SaveInvoiceDraftAsync(new CreateInvoiceRequest(InvoiceForm.CustomerId, InvoiceForm.Number, InvoiceForm.Date, InvoiceForm.DueDate, 0m, 0m, lines.FirstOrDefault()?.RevenueAccountNumber ?? "4000", $"Invoice {InvoiceForm.Number}", lines));
        StatusMessage = result.Succeeded ? "Invoice draft saved." : result.ErrorMessage;
        if (result.Succeeded)
        {
            Workspace = await WorkspaceService.GetWorkspaceAsync();
            InvoiceForm.Reset();
            SyncPaymentApplications();
        }
    }

    private async Task SaveRecurringInvoiceTemplateAsync() { var lines = InvoiceForm.Lines.Select(line => new SalesInvoiceLineRequest(line.Description, line.Quantity, line.UnitPrice, line.Discount, line.Tax, line.RevenueAccount)).ToArray(); var request = new CreateInvoiceRequest(InvoiceForm.CustomerId, InvoiceForm.Number, InvoiceForm.Date, InvoiceForm.DueDate, 0m, 0m, lines.FirstOrDefault()?.RevenueAccountNumber ?? "4000", $"Recurring invoice {InvoiceForm.Number}", lines); var result = await TransactionService.SaveRecurringInvoiceTemplateAsync(new SaveRecurringInvoiceTemplateRequest(request, RecurringForm.Frequency, RecurringForm.Interval, RecurringForm.NextDate)); StatusMessage = result.Succeeded ? "Recurring invoice template saved." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); InvoiceForm.Reset(); } }
    private async Task GenerateRecurringDraftsAsync() { var result = await TransactionService.GenerateDueRecurringDocumentsAsync(RecurringForm.GenerateThrough); StatusMessage = result.Succeeded ? "Due recurring drafts generated." : result.ErrorMessage; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    private async Task ApproveWorkflowAsync(Guid id) { var result = await TransactionService.ApproveSubledgerDocumentAsync(id); StatusMessage = result.Succeeded ? "Invoice draft approved." : result.ErrorMessage; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    private async Task PostWorkflowAsync(Guid id) { var result = await TransactionService.PostApprovedSubledgerDocumentAsync(id); StatusMessage = result.Succeeded ? "Approved invoice posted." : result.ErrorMessage; Workspace = await WorkspaceService.GetWorkspaceAsync(); SyncPaymentApplications(); }

    private void AddInvoiceLine() => InvoiceForm.Lines.Add(new InvoiceLineEditor());
    private void RemoveInvoiceLine(InvoiceLineEditor line) { if (InvoiceForm.Lines.Count > 1) InvoiceForm.Lines.Remove(line); }

    private async Task ApplyPaymentAsync()
    {
        var applications = AvailableInvoiceApplications.Where(application => application.Selected).Select(application => new PaymentDocumentApplicationRequest(application.DocumentId, application.Amount)).ToArray();
        var result = await TransactionService.RecordCustomerPaymentAsync(new RecordCustomerPaymentRequest(PaymentForm.CustomerId, PaymentForm.BankId, PaymentForm.Date, PaymentForm.Amount, PaymentForm.Reference, PaymentForm.Method, applications));
        StatusMessage = result.Succeeded ? "Customer payment recorded." : result.ErrorMessage;
        if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); PaymentForm.Reset(); SyncPaymentApplications(); }
    }

    private async Task ReversePaymentAsync(Guid paymentId)
    {
        var result = await TransactionService.ReverseSubledgerPaymentAsync(new ReverseSubledgerPaymentRequest(paymentId, ReversalForm.Date, ReversalForm.Reason, ReversalForm.Kind));
        StatusMessage = result.Succeeded ? $"Customer payment marked {ReversalForm.Kind.ToLowerInvariant()}." : result.ErrorMessage;
        if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); PaymentForm.Reset(); SyncPaymentApplications(); ReversalForm.Reason = string.Empty; }
    }

    private async Task RecordAdjustmentAsync() { var result = await TransactionService.RecordCustomerAdjustmentAsync(new RecordCustomerAdjustmentRequest(AdjustmentForm.InvoiceId, AdjustmentForm.Date, AdjustmentForm.Amount, AdjustmentForm.Reference, AdjustmentForm.OffsetAccount, AdjustmentForm.Reason, AdjustmentForm.Kind)); StatusMessage = result.Succeeded ? "Customer adjustment posted." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); AdjustmentForm.Reset(); SyncPaymentApplications(); } }
    private async Task RefundDepositAsync() { var result = await TransactionService.RefundUnappliedPaymentAsync(new RefundUnappliedPaymentRequest(RefundForm.PaymentId, RefundForm.BankId, RefundForm.Date, RefundForm.Amount, RefundForm.Reference, RefundForm.Reason)); StatusMessage = result.Succeeded ? "Customer deposit refunded." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); RefundForm.Reset(); } }
    private async Task VoidInvoiceAsync() { var result = await TransactionService.VoidInvoiceAsync(new VoidSubledgerDocumentRequest(VoidForm.DocumentId, VoidForm.Date, VoidForm.Reason)); StatusMessage = result.Succeeded ? "Invoice voided." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); VoidForm.Reset(); SyncPaymentApplications(); } }
    private async Task ReverseAdjustmentAsync(Guid id) { var result = await TransactionService.ReverseSubledgerAdjustmentAsync(new ReverseSubledgerAdjustmentRequest(id, AdjustmentReversalForm.Date, AdjustmentReversalForm.Reason)); StatusMessage = result.Succeeded ? "Customer adjustment reversed." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); AdjustmentReversalForm.Reason = string.Empty; SyncPaymentApplications(); } }

    private void SyncPaymentApplications()
    {
        PaymentForm.Applications.Clear();
        if (Workspace is null) return;
        PaymentForm.Applications.AddRange(Workspace.Receivables.Invoices.Where(invoice => invoice.BalanceDue > 0).Select(invoice => new PaymentApplicationEditor(invoice.Id, invoice.CustomerId, invoice.InvoiceNumber, invoice.DueDate, invoice.BalanceDue)));
    }

    private sealed class InvoiceEditor
    {
        public Guid CustomerId { get; set; }
        public string Number { get; set; } = string.Empty;
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public DateOnly DueDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(30));
        public List<InvoiceLineEditor> Lines { get; } = [new()];
        public decimal Total => Lines.Sum(line => line.Total);
        public void Reset() { Number = string.Empty; Lines.Clear(); Lines.Add(new InvoiceLineEditor()); }
    }
    private sealed class InvoiceLineEditor
    {
        public string Description { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1m;
        public decimal UnitPrice { get; set; }
        public decimal Discount { get; set; }
        public decimal Tax { get; set; }
        public string RevenueAccount { get; set; } = "4000";
        public decimal Total => decimal.Round(Quantity * UnitPrice - Discount + Tax, 2, MidpointRounding.AwayFromZero);
    }
    private sealed class PaymentEditor
    {
        public Guid CustomerId { get; set; }
        public Guid BankId { get; set; }
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public decimal Amount { get; set; }
        public string Method { get; set; } = "Check";
        public string Reference { get; set; } = string.Empty;
        public List<PaymentApplicationEditor> Applications { get; } = [];
        public decimal AppliedAmount => Applications.Where(application => application.Selected).Sum(application => application.Amount);
        public decimal UnappliedAmount => Math.Max(0m, Amount - AppliedAmount);
        public void Reset() { CustomerId = Guid.Empty; Amount = 0m; Reference = string.Empty; Applications.Clear(); }
    }
    private sealed class PaymentApplicationEditor(Guid documentId, Guid counterpartyId, string documentNumber, DateOnly dueDate, decimal openBalance)
    {
        public Guid DocumentId { get; } = documentId; public Guid CounterpartyId { get; } = counterpartyId; public string DocumentNumber { get; } = documentNumber; public DateOnly DueDate { get; } = dueDate; public decimal OpenBalance { get; } = openBalance; public bool Selected { get; set; } public decimal Amount { get; set; } = openBalance;
    }
