@page "/receivables"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.ManageReceivables)]
@inject IBusinessWorkspaceService WorkspaceService
@inject IAccountingTransactionService TransactionService
@inject IConsolidationService ConsolidationService

<PageTitle>Receivables</PageTitle>

@if (Workspace is null)
{
    <section class="panel">
        <h1>Loading receivables...</h1>
    </section>
}
else
{
    <section class="page-shell">
        <header class="page-header">
            <div>
                <p class="eyebrow">Accounts Receivable and CRM</p>
                <h1>Customers, invoices, and open-balance follow-up.</h1>
            </div>
            <p class="page-intro">Create itemized invoices, post revenue and sales tax to the ledger, and follow open customer balances.</p>
        </header>

        <section class="stats-grid">
            <article class="stat-card accent-sand">
                <span class="stat-value">@Workspace.Receivables.OpenBalance.ToString("C0")</span>
                <span class="stat-label">Open A/R</span>
            </article>
            <article class="stat-card accent-sky">
                <span class="stat-value">@Workspace.Receivables.Customers.Count</span>
                <span class="stat-label">Customers</span>
            </article>
            <article class="stat-card accent-sage">
                <span class="stat-value">@Workspace.Receivables.Invoices.Count</span>
                <span class="stat-label">Invoices</span>
            </article>
            <article class="stat-card accent-coral">
                <span class="stat-value">@Workspace.Receivables.PastDueCount</span>
                <span class="stat-label">Past due</span>
            </article>
        </section>

        <section class="panel">
            <h2>Create and post invoice</h2>
            @if (!string.IsNullOrWhiteSpace(StatusMessage)) { <p class="lead" role="status" aria-live="polite">@StatusMessage</p> }
            <EditForm Model="InvoiceForm" OnValidSubmit="SaveInvoiceDraftAsync">
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Customer</label><InputSelect aria-label="Invoice customer" class="field-input" @bind-Value="InvoiceForm.CustomerId"><option value="@Guid.Empty">Select customer</option>@foreach (var customer in Workspace.Receivables.Customers) { <option value="@customer.Id">@customer.CustomerNumber — @customer.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Invoice number</label><InputText aria-label="Invoice number" class="field-input" @bind-Value="InvoiceForm.Number" /></div>
                    <div class="field-group"><label class="field-label">Invoice date</label><InputDate aria-label="Invoice date" class="field-input" @bind-Value="InvoiceForm.Date" /></div>
                    <div class="field-group"><label class="field-label">Due date</label><InputDate aria-label="Invoice due date" class="field-input" @bind-Value="InvoiceForm.DueDate" /></div>
                    <div class="field-group"><label class="field-label">Transaction currency</label><InputText aria-label="Invoice transaction currency" class="field-input" maxlength="3" @bind-Value="InvoiceForm.Currency" /><span class="field-help">Use a three-letter code. The company base currency is @Workspace.Company.BaseCurrency.</span></div>
                    <div class="field-group"><label class="field-label">Closing exchange rate</label><InputSelect aria-label="Invoice exchange rate" class="field-input" @bind-Value="InvoiceForm.ExchangeRateId" disabled="@(IsBaseCurrency(InvoiceForm.Currency))"><option value="">Select retained rate</option>@foreach (var rate in ApplicableRates(InvoiceForm.Currency, InvoiceForm.Date)) { <option value="@rate.Id">@RateLabel(rate)</option> }</InputSelect></div>
                </div>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Description</th><th>Project</th><th>Phase / task</th><th>Cost code</th><th>Department</th><th>Class</th><th>Quantity</th><th>Unit price</th><th>Discount</th><th>Tax</th><th>Revenue account</th><th>Line total</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var line in InvoiceForm.Lines)
                            {
                                <tr @key="line">
                                    <td><InputText aria-label="Invoice line description" class="field-input" @bind-Value="line.Description" /></td>
                                    <td><InputSelect aria-label="Invoice line project" class="field-input" @bind-Value="line.ProjectJobId" @bind-Value:after="line.ProjectChanged"><option value="">No project</option>@foreach (var project in Workspace.Projects.Jobs.Where(project => project.Status == "Active")) { <option value="@project.Id">@project.JobNumber</option> }</InputSelect></td>
                                    <td><InputSelect aria-label="Invoice line project phase" class="field-input" @bind-Value="line.ProjectPhaseId" disabled="@(!line.ProjectJobId.HasValue)"><option value="">No phase</option>@foreach (var phase in (Workspace.Projects.Phases ?? []).Where(phase => phase.IsActive && phase.ProjectJobId == line.ProjectJobId)) { <option value="@phase.Id">@phase.Code — @phase.Name</option> }</InputSelect></td>
                                    <td><InputSelect aria-label="Invoice line project cost code" class="field-input" @bind-Value="line.ProjectCostCodeId" disabled="@(!line.ProjectJobId.HasValue)"><option value="">No cost code</option>@foreach (var costCode in (Workspace.Projects.CostCodes ?? []).Where(candidate => candidate.IsActive)) { <option value="@costCode.Id">@costCode.Code — @costCode.Name</option> }</InputSelect></td>
                                    <td><InputSelect aria-label="Invoice line department" class="field-input" @bind-Value="line.DepartmentId"><option value="">No department</option>@foreach (var dimension in ActiveTrackingDimensions("Department", InvoiceForm.Date)) { <option value="@dimension.Id">@dimension.Code — @dimension.Name</option> }</InputSelect></td>
                                    <td><InputSelect aria-label="Invoice line class" class="field-input" @bind-Value="line.ClassId"><option value="">No class</option>@foreach (var dimension in ActiveTrackingDimensions("Class", InvoiceForm.Date)) { <option value="@dimension.Id">@dimension.Code — @dimension.Name</option> }</InputSelect></td>
                                    <td><InputNumber aria-label="Invoice line quantity" class="field-input" @bind-Value="line.Quantity" /></td>
                                    <td><InputNumber aria-label="Invoice line unit price" class="field-input" @bind-Value="line.UnitPrice" /></td>
                                    <td><InputNumber aria-label="Invoice line discount" class="field-input" @bind-Value="line.Discount" /></td>
                                    <td><InputNumber aria-label="Invoice line tax" class="field-input" @bind-Value="line.Tax" /></td>
                                    <td><InputSelect aria-label="Invoice line revenue account" class="field-input" @bind-Value="line.RevenueAccount">@foreach (var account in Workspace.GeneralLedger.Accounts.Where(x => x.Type == "Revenue")) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></td>
                                    <td>@line.Total.ToString("C")</td>
                                    <td><button class="action-secondary" type="button" disabled="@(InvoiceForm.Lines.Count == 1)" @onclick="() => RemoveInvoiceLine(line)">Remove</button></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr><th colspan="11">Invoice total</th><th>@InvoiceForm.Total.ToString("C")</th><th></th></tr></tfoot>
                    </table>
                </div>
                <button class="action-secondary" type="button" @onclick="AddInvoiceLine">Add line</button>
                <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareSubledgerDocuments" Context="invoicePreparationAuthorization"><button class="action-primary" type="submit">Save invoice draft</button><div class="content-grid"><div class="field-group"><label class="field-label">Recurring frequency</label><InputSelect aria-label="Recurring invoice frequency" class="field-input" @bind-Value="RecurringForm.Frequency"><option>Monthly</option><option>Weekly</option><option>Quarterly</option><option>Annually</option></InputSelect></div><div class="field-group"><label class="field-label">Every</label><InputNumber aria-label="Recurring invoice interval" class="field-input" @bind-Value="RecurringForm.Interval" /></div><div class="field-group"><label class="field-label">Next date</label><InputDate aria-label="Recurring invoice next date" class="field-input" @bind-Value="RecurringForm.NextDate" /></div></div><button class="action-secondary" type="button" @onclick="SaveRecurringInvoiceTemplateAsync">Save recurring template</button></AuthorizeView>
            </EditForm>
        </section>

        <section class="panel">
            <h2>Invoice review queue</h2>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareSubledgerDocuments">
                <div class="content-grid"><div class="field-group"><label class="field-label">Generate recurring drafts through</label><InputDate aria-label="Generate recurring invoice drafts through" class="field-input" @bind-Value="RecurringForm.GenerateThrough" /></div><button class="action-secondary" type="button" @onclick="GenerateRecurringDraftsAsync">Generate due drafts</button></div>
            </AuthorizeView>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApproveSubledgerDocuments">
                <div class="field-group"><label class="field-label">Rejection reason</label><InputText aria-label="Invoice rejection reason" class="field-input" @bind-Value="RejectionReason" /><span class="field-help">Enter a reason, then reject the applicable draft. The preparer can correct and resubmit it using the same invoice number.</span></div>
            </AuthorizeView>
            <div class="table-scroll"><table class="data-table"><thead><tr><th>Number</th><th>Status</th><th>Review note</th><th>Source</th><th>Next</th><th>Actions</th></tr></thead><tbody>
                @foreach (var workflow in Workspace.Receivables.Workflows ?? [])
                {
                    <tr><td>@workflow.DocumentNumber</td><td>@workflow.Status</td><td>@(string.IsNullOrWhiteSpace(workflow.DecisionReason) ? "—" : workflow.DecisionReason)</td><td>@(workflow.IsRecurringTemplate ? $"{workflow.Frequency} template" : workflow.SourceTemplateId.HasValue ? "Recurring draft" : "Manual draft")</td><td>@workflow.NextOccurrenceDate</td><td>
                        @if (!workflow.IsRecurringTemplate && workflow.Status == "Draft") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApproveSubledgerDocuments"><button class="action-secondary" type="button" @onclick="() => ApproveWorkflowAsync(workflow.Id)">Approve</button></AuthorizeView> }
                        @if (!workflow.IsRecurringTemplate && workflow.Status is "Draft" or "Approved") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApproveSubledgerDocuments"><button class="action-secondary" type="button" @onclick="() => RejectWorkflowAsync(workflow)">Reject</button></AuthorizeView> }
                        @if (!workflow.IsRecurringTemplate && workflow.Status == "Approved") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PostSubledgerDocuments"><button class="action-primary" type="button" @onclick="() => PostWorkflowAsync(workflow.Id)">Post</button></AuthorizeView> }
                    </td></tr>
                }
            </tbody></table></div>
        </section>

        <section class="panel">
            <h2>Record customer payment or deposit</h2>
            <p class="page-intro">Apply one receipt across invoices or leave part of it unapplied as a customer deposit.</p>
            <EditForm Model="PaymentForm" OnValidSubmit="ApplyPaymentAsync">
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Customer</label><InputSelect aria-label="Payment customer" class="field-input" @bind-Value="PaymentForm.CustomerId"><option value="@Guid.Empty">Select customer</option>@foreach (var customer in Workspace.Receivables.Customers) { <option value="@customer.Id">@customer.CustomerNumber — @customer.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Deposit account</label><InputSelect aria-label="Payment deposit account" class="field-input" @bind-Value="PaymentForm.BankId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Payment date</label><InputDate aria-label="Payment date" class="field-input" @bind-Value="PaymentForm.Date" /></div>
                    <div class="field-group"><label class="field-label">Payment total</label><InputNumber aria-label="Payment total" class="field-input" @bind-Value="PaymentForm.Amount" /></div>
                    <div class="field-group"><label class="field-label">Method</label><InputSelect aria-label="Payment method" class="field-input" @bind-Value="PaymentForm.Method">@foreach (var method in PaymentMethods) { <option value="@method">@method</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Payment reference" class="field-input" @bind-Value="PaymentForm.Reference" /></div>
                    <div class="field-group"><label class="field-label">Transaction currency</label><InputText aria-label="Customer payment transaction currency" class="field-input" maxlength="3" @bind-Value="PaymentForm.Currency" /><span class="field-help">Applications are limited to invoices in this currency.</span></div>
                    <div class="field-group"><label class="field-label">Closing exchange rate</label><InputSelect aria-label="Customer payment exchange rate" class="field-input" @bind-Value="PaymentForm.ExchangeRateId" disabled="@(IsBaseCurrency(PaymentForm.Currency))"><option value="">Select retained rate</option>@foreach (var rate in ApplicableRates(PaymentForm.Currency, PaymentForm.Date)) { <option value="@rate.Id">@RateLabel(rate)</option> }</InputSelect></div>
                </div>
                @if (PaymentForm.CustomerId != Guid.Empty)
                {
                    <div class="table-scroll"><table class="data-table"><thead><tr><th>Apply</th><th>Invoice</th><th>Due</th><th>Open balance</th><th>Apply amount</th></tr></thead><tbody>
                        @foreach (var application in AvailableInvoiceApplications)
                        {
                            <tr @key="application.DocumentId"><td><InputCheckbox aria-label="@($"Apply to {application.DocumentNumber}")" @bind-Value="application.Selected" /></td><td>@application.DocumentNumber</td><td>@application.DueDate</td><td>@application.OpenBalance.ToString("N2") @application.Currency</td><td><InputNumber aria-label="@($"Amount for {application.DocumentNumber}")" class="field-input" disabled="@(!application.Selected)" @bind-Value="application.Amount" /></td></tr>
                        }
                    </tbody><tfoot><tr><th colspan="3">Payment allocation</th><th>Applied: @PaymentForm.AppliedAmount.ToString("C")</th><th>Unapplied deposit: @PaymentForm.UnappliedAmount.ToString("C")</th></tr></tfoot></table></div>
                }
                <button class="action-primary" type="submit">Record customer payment</button>
            </EditForm>
        </section>

        <section class="panel">
            <h2>Customer payment history</h2>
            <div class="content-grid"><div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Customer payment reversal date" class="field-input" @bind-Value="ReversalForm.Date" /></div><div class="field-group"><label class="field-label">Outcome</label><InputSelect aria-label="Customer payment reversal kind" class="field-input" @bind-Value="ReversalForm.Kind"><option>Returned</option><option>Voided</option><option>Reversed</option></InputSelect></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Customer payment reversal reason" class="field-input" @bind-Value="ReversalForm.Reason" /></div></div>
            <div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Customer</th><th>Reference</th><th>Method</th><th>Transaction total</th><th>Applied</th><th>Deposit</th><th>Base total</th><th>Realized FX</th><th>Rate provenance</th><th>Status</th><th></th></tr></thead><tbody>
                @foreach (var payment in Workspace.Receivables.Payments ?? [])
                {
                    <tr><td>@payment.PaymentDate</td><td>@payment.CounterpartyName</td><td>@payment.Reference</td><td>@payment.Method</td><td>@FormatTransactionAmount(payment.TransactionAmount, payment.TransactionCurrency)</td><td>@FormatTransactionAmount(payment.TransactionAppliedAmount, payment.TransactionCurrency)</td><td>@FormatTransactionAmount(payment.TransactionUnappliedAmount, payment.TransactionCurrency)</td><td>@payment.Amount.ToString("C") @Workspace.Company.BaseCurrency</td><td>@payment.RealizedGainLoss.ToString("N2") @Workspace.Company.BaseCurrency</td><td>@(!IsBaseCurrency(payment.TransactionCurrency) ? $"{payment.ExchangeRateEffectiveOn}: {payment.ExchangeRateToBase:N10} — {payment.ExchangeRateSource}" : "Base currency")</td><td>@payment.Status</td><td>@if (payment.Status == "Posted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments"><button class="action-secondary" type="button" @onclick="() => ReversePaymentAsync(payment.Id)">Record @ReversalForm.Kind.ToLowerInvariant()</button></AuthorizeView> }</td></tr>
                }
            </tbody></table></div>
        </section>

        <section class="panel">
            <h2>Credits and write-offs</h2>
            <EditForm Model="AdjustmentForm" OnValidSubmit="RecordAdjustmentAsync"><div class="content-grid">
                <div class="field-group"><label class="field-label">Invoice</label><InputSelect aria-label="Adjustment invoice" class="field-input" @bind-Value="AdjustmentForm.InvoiceId"><option value="@Guid.Empty">Select invoice</option>@foreach (var invoice in Workspace.Receivables.Invoices.Where(item => item.BalanceDue > 0)) { <option value="@invoice.Id">@invoice.InvoiceNumber — @invoice.BalanceDue.ToString("C")</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label">Kind</label><InputSelect aria-label="Customer adjustment kind" class="field-input" @bind-Value="AdjustmentForm.Kind"><option>CreditMemo</option><option>WriteOff</option></InputSelect></div>
                <div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Customer adjustment date" class="field-input" @bind-Value="AdjustmentForm.Date" /></div>
                @if (SelectedAdjustmentInvoice is { } adjustmentInvoice && !IsBaseCurrency(adjustmentInvoice.TransactionCurrency))
                {
                    @if (AdjustmentForm.Kind == "WriteOff")
                    {
                        <div class="field-group"><label class="field-label">Rate basis</label><span class="field-input" aria-label="Customer write-off rate basis">Carrying value</span><span class="field-help">Releases the invoice's current recorded carrying value; no new conversion.</span></div>
                    }
                    else
                    {
                        <div class="field-group"><label class="field-label">Rate basis</label><InputSelect aria-label="Customer credit memo rate basis" class="field-input" @bind-Value="AdjustmentForm.RateBasis"><option value="OriginalDocumentRate">Original document rate</option><option value="AdjustmentDateRate">Adjustment-date rate</option></InputSelect></div>
                        @if (AdjustmentForm.RateBasis == "AdjustmentDateRate")
                        {
                            <div class="field-group"><label class="field-label">Adjustment-date closing exchange rate</label><InputSelect aria-label="Customer credit memo exchange rate" class="field-input" @bind-Value="AdjustmentForm.ExchangeRateId"><option value="">Select retained rate</option>@foreach (var rate in ApplicableRates(adjustmentInvoice.TransactionCurrency, AdjustmentForm.Date)) { <option value="@rate.Id">@RateLabel(rate)</option> }</InputSelect></div>
                        }
                    }
                }
                <div class="field-group"><label class="field-label">Amount (@(SelectedAdjustmentInvoice is { } currencyInvoice && !IsBaseCurrency(currencyInvoice.TransactionCurrency) ? currencyInvoice.TransactionCurrency : Workspace.Company.BaseCurrency))</label><InputNumber aria-label="Customer adjustment amount" class="field-input" @bind-Value="AdjustmentForm.Amount" /></div>
                <div class="field-group"><label class="field-label">Offset account</label><InputSelect aria-label="Customer adjustment offset account" class="field-input" @bind-Value="AdjustmentForm.OffsetAccount"><option value="">Select account</option>@foreach (var account in Workspace.GeneralLedger.Accounts.Where(item => !item.IsControlAccount && item.Type is "Revenue" or "Expense")) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Customer adjustment reference" class="field-input" @bind-Value="AdjustmentForm.Reference" /></div>
                <div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Customer adjustment reason" class="field-input" @bind-Value="AdjustmentForm.Reason" /></div>
            </div><button class="action-primary" type="submit">Post customer adjustment</button></EditForm>
        </section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments" Context="refundAuthorization">
            <section class="panel"><h2>Refund deposit or void invoice</h2><div class="content-grid">
                <EditForm Model="RefundForm" OnValidSubmit="RefundDepositAsync"><div class="field-group"><label class="field-label">Deposit</label><InputSelect aria-label="Refund customer deposit" class="field-input" @bind-Value="RefundForm.PaymentId"><option value="@Guid.Empty">Select deposit</option>@foreach (var payment in (Workspace.Receivables.Payments ?? []).Where(item => item.Status == "Posted" && item.TransactionUnappliedAmount > 0)) { <option value="@payment.Id">@payment.Reference — @FormatTransactionAmount(payment.TransactionUnappliedAmount, payment.TransactionCurrency) (@payment.UnappliedAmount.ToString("C") carrying)</option> }</InputSelect></div><div class="field-group"><label class="field-label">Bank</label><InputSelect aria-label="Customer refund bank" class="field-input" @bind-Value="RefundForm.BankId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div><div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Customer refund date" class="field-input" @bind-Value="RefundForm.Date" /></div>@if (SelectedRefundPayment is { } refundPayment && !IsBaseCurrency(refundPayment.TransactionCurrency)) { <div class="field-group"><label class="field-label">Refund-date closing exchange rate</label><InputSelect aria-label="Customer refund exchange rate" class="field-input" @bind-Value="RefundForm.ExchangeRateId"><option value="">Select retained rate</option>@foreach (var rate in ApplicableRates(refundPayment.TransactionCurrency, RefundForm.Date)) { <option value="@rate.Id">@RateLabel(rate)</option> }</InputSelect></div> }<div class="field-group"><label class="field-label">Amount (@(SelectedRefundPayment?.TransactionCurrency ?? Workspace.Company.BaseCurrency))</label><InputNumber aria-label="Customer refund amount" class="field-input" @bind-Value="RefundForm.Amount" /></div><div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Customer refund reference" class="field-input" @bind-Value="RefundForm.Reference" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Customer refund reason" class="field-input" @bind-Value="RefundForm.Reason" /></div><button class="action-primary" type="submit">Refund customer deposit</button></EditForm>
                <EditForm Model="VoidForm" OnValidSubmit="VoidInvoiceAsync"><div class="field-group"><label class="field-label">Invoice</label><InputSelect aria-label="Void invoice" class="field-input" @bind-Value="VoidForm.DocumentId"><option value="@Guid.Empty">Select invoice</option>@foreach (var invoice in Workspace.Receivables.Invoices.Where(item => item.Status != "Voided" && item.BalanceDue == item.TotalAmount)) { <option value="@invoice.Id">@invoice.InvoiceNumber</option> }</InputSelect></div><div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Invoice void date" class="field-input" @bind-Value="VoidForm.Date" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Invoice void reason" class="field-input" @bind-Value="VoidForm.Reason" /></div><button class="action-primary" type="submit">Void invoice</button></EditForm>
            </div></section>
        </AuthorizeView>

        <section class="panel"><h2>Customer adjustment history</h2><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments"><div class="content-grid"><div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Customer adjustment reversal date" class="field-input" @bind-Value="AdjustmentReversalForm.Date" /></div><div class="field-group"><label class="field-label">Reversal reason</label><InputText aria-label="Customer adjustment reversal reason" class="field-input" @bind-Value="AdjustmentReversalForm.Reason" /></div></div></AuthorizeView><div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Kind</th><th>Customer</th><th>Document</th><th>Reference</th><th>Amount</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var adjustment in Workspace.Receivables.Adjustments ?? []) { <tr><td>@adjustment.AdjustmentDate</td><td>@adjustment.Kind</td><td>@adjustment.CounterpartyName</td><td>@adjustment.DocumentNumber</td><td>@adjustment.Reference</td><td>@adjustment.Amount.ToString("C")</td><td>@adjustment.Status</td><td>@if (adjustment.Status == "Posted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments"><button class="action-secondary" type="button" @onclick="() => ReverseAdjustmentAsync(adjustment.Id)">Reverse</button></AuthorizeView> }</td></tr> }</tbody></table></div></section>

        <section class="content-grid">
            <article class="panel">
                <h2>Customers</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>State</th>
                            <th>Credit limit</th>
                            <th>Open balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Workspace.Receivables.Customers)
                        {
                            <tr>
                                <td>@customer.CustomerNumber - @customer.Name</td>
                                <td>@customer.State</td>
                                <td>@customer.CreditLimit.ToString("C")</td>
                                <td>@customer.OpenBalance.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>

            <article class="panel">
                <h2>Open invoice stack</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Lines</th>
                            <th>Due</th>
                            <th>Transaction balance</th>
                            <th>Base balance</th>
                            <th>Rate provenance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Workspace.Receivables.Invoices)
                        {
                            <tr>
                                <td>@invoice.InvoiceNumber</td>
                                <td>@invoice.CustomerName</td>
                                <td>@invoice.Status</td>
                                <td>@(invoice.Lines?.Count ?? 0)</td>
                                <td>@invoice.DueDate.ToString("MMM d, yyyy")</td>
                                <td>@FormatTransactionAmount(invoice.TransactionBalanceDue, invoice.TransactionCurrency)</td>
                                <td>@invoice.BalanceDue.ToString("N2") @Workspace.Company.BaseCurrency</td>
                                <td>@(!IsBaseCurrency(invoice.TransactionCurrency) ? $"{invoice.ExchangeRateEffectiveOn}: {invoice.ExchangeRateToBase:N10} — {invoice.ExchangeRateSource}" : "Base currency")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>
        </section>
    </section>
}

@code {
