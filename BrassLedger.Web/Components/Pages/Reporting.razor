@page "/reporting"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.ManageReporting)]
@inject IBusinessWorkspaceService WorkspaceService
@inject IProductCatalogService AssessmentService
@inject IConsolidationService ConsolidationService

<PageTitle>Reporting</PageTitle>

@{
    var assessment = AssessmentService.GetCatalog();
}

@if (Workspace is null)
{
    <section class="panel">
        <h1>Loading reporting...</h1>
    </section>
}
else
{
    <section class="page-shell">
        <header class="page-header">
            <div>
                <p class="eyebrow">Printable Surface</p>
                <h1>Reports, labels, forms, and print fidelity stay in the product.</h1>
            </div>
            <p class="page-intro">
                The product has a huge printable footprint. The workspace now includes a live report catalog and
                label inventory so the conversion work can move from theory into authored layouts for statements, checks,
                paychecks, tax forms, year-end employee forms, shipment documents, and labels.
            </p>
        </header>

        <section class="stats-grid">
            <article class="stat-card accent-sand">
                <span class="stat-value">@assessment.PrintableInventory.Reports</span>
                <span class="stat-label">Legacy reports discovered</span>
            </article>
            <article class="stat-card accent-sky">
                <span class="stat-value">@Workspace.Reporting.ReportCount</span>
                <span class="stat-label">Current report definitions</span>
            </article>
            <article class="stat-card accent-sage">
                <span class="stat-value">@Workspace.Reporting.LabelCount</span>
                <span class="stat-label">Current label templates</span>
            </article>
            <article class="stat-card accent-coral">
                <span class="stat-value">@assessment.PrintableInventory.ActiveXControls</span>
                <span class="stat-label">Binary controls to replace</span>
            </article>
        </section>

        <section class="content-grid">
            <article class="panel">
                <h2>Run current reports</h2>
                <p>Download live CSV output for review, spreadsheet analysis, or controlled distribution.</p>
                <div class="hero-actions">
                    <a class="action-primary" href="/reports/trial-balance.csv">Trial balance</a>
                    <a class="action-secondary" href="/reports/ar-aging.csv">A/R aging</a>
                    <a class="action-secondary" href="/reports/ap-aging.csv">A/P aging</a>
                </div>
            </article>
            <article class="panel">
                <h2>Report stance</h2>
                <p><strong>Preferred designer:</strong> @Workspace.Reporting.PreferredDesigner</p>
                <p><strong>Rendering strategy:</strong> @Workspace.Reporting.RenderingStrategy</p>
                <p>
                    Use stable read models for statements, checks, operational documents, and labels so report layouts
                    stay portable even when the database provider changes.
                </p>
            </article>

            <article class="panel">
                <h2>Conversion workstreams</h2>
                <ul class="feature-list">
                    @foreach (var item in assessment.ConversionWorkstreams)
                    {
                        <li>@item</li>
                    }
                </ul>
            </article>
        </section>

        <section class="content-grid">
            <article class="panel">
                <h2>Seeded report catalog</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Layout</th>
                            <th>VS friendly</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Workspace.Reporting.Reports)
                        {
                            <tr>
                                <td>@report.Code</td>
                                <td>@report.Name</td>
                                <td>@report.Category</td>
                                <td>@report.LayoutType</td>
                                <td>@(report.SupportsVisualStudioDesign ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>

            <article class="panel">
                <h2>Label templates</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Stock</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var label in Workspace.Reporting.Labels)
                        {
                            <tr>
                                <td>@label.Code</td>
                                <td>@label.Name</td>
                                <td>@label.StockType</td>
                                <td>@label.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>
        </section>

        <section class="panel" aria-labelledby="consolidationAdjustmentHeading">
            <h2 id="consolidationAdjustmentHeading">Consolidation adjustments and eliminations</h2>
            <p class="page-intro">Prepare reporting-only entries for one exact consolidation period. They never alter a member company’s ledger. Intercompany eliminations retain the matched company pair and reference; approval and posting require different operators.</p>
            @if (!string.IsNullOrWhiteSpace(ConsolidationMessage))
            {
                <div class="@(ConsolidationError ? "auth-error" : "muted-copy")" role="@(ConsolidationError ? "alert" : "status")">@ConsolidationMessage</div>
            }
            @if (ConsolidationGroups.Count == 0)
            {
                <p class="muted-copy">Create a consolidation group and its effective account mappings in Administration before preparing reporting entries.</p>
            }
            else
            {
                <div class="content-grid">
                    <div class="field-group">
                        <label class="field-label" for="adjustmentGroup">Consolidation group</label>
                        <select id="adjustmentGroup" class="field-input" value="@SelectedGroupId" @onchange="SelectConsolidationGroupAsync">
                            @foreach (var group in ConsolidationGroups) { <option value="@group.Id">@group.Name — @group.ReportingCurrency</option> }
                        </select>
                    </div>
                    <div class="field-group"><label class="field-label" for="adjustmentPeriodStart">Period starts</label><InputDate id="adjustmentPeriodStart" class="field-input" @bind-Value="AdjustmentForm.PeriodStart" /></div>
                    <div class="field-group"><label class="field-label" for="adjustmentAsOf">As of</label><InputDate id="adjustmentAsOf" class="field-input" @bind-Value="AdjustmentForm.AsOf" /></div>
                    <div class="field-group"><label class="field-label" for="comparisonPeriodStart">Comparison period starts</label><InputDate id="comparisonPeriodStart" class="field-input" @bind-Value="ComparisonForm.PeriodStart" /></div>
                    <div class="field-group"><label class="field-label" for="comparisonAsOf">Comparison as of</label><InputDate id="comparisonAsOf" class="field-input" @bind-Value="ComparisonForm.AsOf" /><small class="muted-copy">The comparison as-of date must precede the current as-of date.</small></div>
                    <div class="field-group"><label class="field-label" for="adjustmentKind">Entry kind</label><InputSelect id="adjustmentKind" class="field-input" @bind-Value="AdjustmentForm.Kind"><option value="ManualAdjustment">Manual adjustment</option><option value="IntercompanyElimination">Intercompany elimination</option><option value="NoncontrollingInterest">Noncontrolling-interest reclassification</option></InputSelect></div>
                    <div class="field-group"><label class="field-label" for="adjustmentReference">Reference</label><InputText id="adjustmentReference" class="field-input" maxlength="64" @bind-Value="AdjustmentForm.Reference" /></div>
                    <div class="field-group"><label class="field-label" for="adjustmentDescription">Description</label><InputText id="adjustmentDescription" class="field-input" maxlength="1000" @bind-Value="AdjustmentForm.Description" /></div>
                    @if (AdjustmentForm.Kind == "IntercompanyElimination")
                    {
                        <div class="field-group"><label class="field-label" for="adjustmentMatchReference">Match reference</label><InputText id="adjustmentMatchReference" class="field-input" maxlength="160" @bind-Value="AdjustmentForm.MatchReference" /><small class="muted-copy">Use a reviewed discovery result or an invoice, settlement, reconciliation, or other shared reference. Discovery never infers accounting lines or posts silently.</small></div>
                    }
                    else if (AdjustmentForm.Kind == "NoncontrollingInterest")
                    {
                        <div class="field-group"><label class="field-label" for="adjustmentSubjectCompany">Controlled subsidiary</label><InputSelect id="adjustmentSubjectCompany" class="field-input" @bind-Value="AdjustmentForm.SubjectCompanyId" disabled="@AdjustmentForm.Id.HasValue"><option value="">Select partially owned subsidiary</option>@foreach (var member in EffectiveMembers().Where(item => item.ConsolidationBasis == "ControlledSubsidiary" && item.OwnershipPercentage < 1m)) { <option value="@member.CompanyId">@member.CompanyName — @member.OwnershipPercentage.ToString("P2") parent interest</option> }</InputSelect><small class="muted-copy">Enter the reviewed, balanced equity reclassification for this exact period. BrassLedger does not infer acquisition accounting, goodwill, or the NCI amount.</small></div>
                    }
                </div>
                @if (AdjustmentWorkspace is null)
                {
                    <p class="muted-copy">This group is unavailable because you do not have access to every retained member company.</p>
                }
                else
                {
                    <section aria-labelledby="intercompanyMatchHeading">
                        <h3 id="intercompanyMatchHeading">Reviewed intercompany matches</h3>
                        <p class="page-intro">Discovery retains only unambiguous same-currency invoice and bill pairs with exact references and amounts through effective customer/vendor links. It never posts an elimination or guesses accounting lines.</p>
                        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareJournals"><button class="action-secondary" type="button" @onclick="DiscoverIntercompanyMatchesAsync">Discover exact matches</button></AuthorizeView>
                        @if (IntercompanyMatchWorkspace?.Matches.Count > 0)
                        {
                            <div class="table-scroll"><table class="data-table" aria-label="Reviewed intercompany matches"><thead><tr><th>Seller invoice</th><th>Buyer bill</th><th>Amount / balances</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var match in IntercompanyMatchWorkspace.Matches) { <tr><td>@match.SellerCompanyName · @match.InvoiceNumber<br /><small>@match.InvoiceDate</small></td><td>@match.BuyerCompanyName · @match.BillNumber<br /><small>@match.BillDate</small></td><td>@match.Amount.ToString("N2") @match.Currency<br /><small>AR @match.SellerBalanceDue.ToString("N2") · AP @match.BuyerBalanceDue.ToString("N2")</small></td><td>@match.Status@if (!string.IsNullOrWhiteSpace(match.ReviewReason)) { <br /><small>@match.ReviewReason</small> }</td><td><div class="hero-actions">@if (match.Status == "Suggested") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareJournals"><button class="action-primary" type="button" @onclick="() => UseIntercompanyMatch(match)">Prepare elimination</button><button class="action-secondary" type="button" @onclick="() => ExcludeIntercompanyMatchAsync(match)">Exclude</button></AuthorizeView> } else if (match.Status == "Excluded") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareJournals"><button class="action-secondary" type="button" @onclick="() => RestoreIntercompanyMatchAsync(match)">Restore</button></AuthorizeView> } else { <span>Adjustment @match.ConsolidationAdjustmentBatchId</span> }</div></td></tr> }</tbody></table></div>
                        }
                        else { <p class="muted-copy">No retained exact matches exist for this group and period.</p> }
                    </section>
                    <EditForm Model="AdjustmentForm" OnValidSubmit="SaveAdjustmentAsync">
                        <div class="table-scroll">
                            <table class="data-table" aria-label="Consolidation adjustment lines">
                                <thead><tr><th>Reporting account</th><th>Debit</th><th>Credit</th><th>Description</th>@if (AdjustmentForm.Kind == "IntercompanyElimination") { <th>Source company</th><th>Counterparty</th> }<th></th></tr></thead>
                                <tbody>
                                @foreach (var line in AdjustmentForm.Lines)
                                {
                                    <tr @key="line">
                                        <td><InputSelect aria-label="Reporting account" class="field-input" @bind-Value="line.AccountKey"><option value="">Select reporting account</option>@foreach (var account in AdjustmentWorkspace.ReportingAccounts) { <option value="@AccountKey(account)">@account.AccountNumber — @account.AccountName (@account.AccountType)</option> }</InputSelect></td>
                                        <td><InputNumber aria-label="Adjustment debit" class="field-input" step="0.01" min="0" @bind-Value="line.Debit" /></td>
                                        <td><InputNumber aria-label="Adjustment credit" class="field-input" step="0.01" min="0" @bind-Value="line.Credit" /></td>
                                        <td><InputText aria-label="Adjustment line description" class="field-input" maxlength="1000" @bind-Value="line.Description" /></td>
                                        @if (AdjustmentForm.Kind == "IntercompanyElimination")
                                        {
                                            <td><InputSelect aria-label="Elimination source company" class="field-input" @bind-Value="line.SourceCompanyId"><option value="">Select source</option>@foreach (var member in EffectiveMembers()) { <option value="@member.CompanyId">@member.CompanyName</option> }</InputSelect></td>
                                            <td><InputSelect aria-label="Elimination counterparty company" class="field-input" @bind-Value="line.CounterpartyCompanyId"><option value="">Select counterparty</option>@foreach (var member in EffectiveMembers()) { <option value="@member.CompanyId">@member.CompanyName</option> }</InputSelect></td>
                                        }
                                        <td><button class="action-secondary" type="button" disabled="@(AdjustmentForm.Lines.Count <= 2)" @onclick="() => RemoveAdjustmentLine(line)">Remove</button></td>
                                    </tr>
                                }
                                </tbody>
                                <tfoot><tr><th>Totals</th><th>@AdjustmentForm.Lines.Sum(line => line.Debit).ToString("N2")</th><th>@AdjustmentForm.Lines.Sum(line => line.Credit).ToString("N2")</th><th colspan="@(AdjustmentForm.Kind == "IntercompanyElimination" ? 4 : 2)">Difference: @((AdjustmentForm.Lines.Sum(line => line.Debit) - AdjustmentForm.Lines.Sum(line => line.Credit)).ToString("N2"))</th></tr></tfoot>
                            </table>
                        </div>
                        <div class="hero-actions"><button class="action-secondary" type="button" @onclick="AddAdjustmentLine">Add line</button><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareJournals" Context="adjustmentPreparationAuthorization"><button class="action-primary" type="submit">@(AdjustmentForm.Id.HasValue ? "Save corrected draft" : "Prepare draft")</button></AuthorizeView>@if (AdjustmentForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="ResetAdjustmentForm">Cancel edit</button> }<button class="action-secondary" type="button" @onclick="RunConsolidatedReportAsync">Preview consolidated balance</button><button class="action-primary" type="button" @onclick="RunConsolidatedStatementsAsync">Run statement package</button><button class="action-secondary" type="button" @onclick="RunComparativeStatementsAsync">Compare statement periods</button></div>
                    </EditForm>

                    <div class="field-group"><label class="field-label" for="adjustmentDecisionReason">Rejection, exclusion, or reversal reason</label><InputText id="adjustmentDecisionReason" class="field-input" maxlength="1000" @bind-Value="DecisionReason" /></div>
                    @if (AdjustmentWorkspace.Adjustments.Count == 0) { <p class="muted-copy">No retained consolidation entries exist for this group.</p> }
                    else
                    {
                        <div class="table-scroll"><table class="data-table" aria-label="Retained consolidation adjustments"><thead><tr><th>Period</th><th>Reference</th><th>Kind / match</th><th>Status</th><th>Control history</th><th>Amount</th><th>Actions</th></tr></thead><tbody>
                        @foreach (var adjustment in AdjustmentWorkspace.Adjustments)
                        {
                            <tr><td>@adjustment.PeriodStart to @adjustment.AsOf</td><td><strong>@adjustment.Reference</strong><br /><small>@adjustment.Description</small></td><td>@DisplayKind(adjustment.Kind)@if (!string.IsNullOrWhiteSpace(adjustment.MatchReference)) { <br /><small>@adjustment.MatchReference</small> }@if (!string.IsNullOrWhiteSpace(adjustment.SubjectCompanyName)) { <br /><small>@adjustment.SubjectCompanyName</small> }</td><td>@adjustment.Status@if (!string.IsNullOrWhiteSpace(adjustment.DecisionReason)) { <br /><small>@adjustment.DecisionReason</small> }@if (!string.IsNullOrWhiteSpace(adjustment.ReversalReason)) { <br /><small>@adjustment.ReversalReason</small> }</td><td>Prepared by @adjustment.PreparedBy<br /><small>@adjustment.PreparedAtUtc.LocalDateTime</small>@if (adjustment.ApprovedBy is not null) { <br /><span>Approved by @adjustment.ApprovedBy</span> }@if (adjustment.RejectedBy is not null) { <br /><span>Rejected by @adjustment.RejectedBy</span> }@if (adjustment.PostedBy is not null) { <br /><span>Posted by @adjustment.PostedBy</span> }</td><td>@adjustment.Lines.Sum(line => line.Debit).ToString("N2") @AdjustmentWorkspace.ReportingCurrency</td><td><div class="hero-actions">@if (adjustment.Status is "Draft" or "Rejected") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareJournals"><button class="action-secondary" type="button" @onclick="() => EditAdjustment(adjustment)">Edit</button></AuthorizeView> }@if (adjustment.Status == "Draft") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApproveJournals"><button class="action-primary" type="button" @onclick="() => ApproveAdjustmentAsync(adjustment)">Approve</button><button class="action-secondary" type="button" @onclick="() => RejectAdjustmentAsync(adjustment)">Reject</button></AuthorizeView> }@if (adjustment.Status == "Approved") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PostJournals"><button class="action-primary" type="button" @onclick="() => PostAdjustmentAsync(adjustment)">Post</button></AuthorizeView> }@if (adjustment.Status == "Posted" && !adjustment.ReversalOfBatchId.HasValue) { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReverseJournals"><button class="action-secondary" type="button" @onclick="() => ReverseAdjustmentAsync(adjustment)">Reverse</button></AuthorizeView> }</div></td></tr>
                        }
                        </tbody></table></div>
                    }
                    @if (ConsolidatedReport is not null)
                    {
                        <h3>@ConsolidatedReport.GroupName consolidated balance · @ConsolidatedReport.PeriodStart to @ConsolidatedReport.AsOf</h3>
                        @foreach (var warning in ConsolidatedReport.Warnings) { <div class="auth-error" role="alert">@warning</div> }
                        <div class="table-scroll"><table class="data-table" aria-label="Consolidated balance preview"><thead><tr><th>Account</th><th>Type</th><th>Translation</th><th>Balance (@ConsolidatedReport.ReportingCurrency)</th></tr></thead><tbody>@foreach (var account in ConsolidatedReport.Accounts) { <tr><td>@account.AccountNumber — @account.AccountName</td><td>@account.AccountType</td><td>@account.TranslationMethod</td><td>@account.ConvertedBalance.ToString("N2")</td></tr> }</tbody></table></div>
                    }
                    @if (ConsolidatedStatements is not null)
                    {
                        <section aria-labelledby="consolidatedStatementsHeading">
                            <h3 id="consolidatedStatementsHeading">@ConsolidatedStatements.GroupName statement package · @ConsolidatedStatements.PeriodStart to @ConsolidatedStatements.AsOf</h3>
                            <p role="status"><strong>Status:</strong> @(ConsolidatedStatements.IsComplete ? "Complete" : "Incomplete — resolve every warning before external use")</p>
                            <p><a class="action-secondary" href="@StatementCsvUrl()">Download statement package CSV</a></p>
                            @foreach (var warning in ConsolidatedStatements.Warnings) { <div class="auth-error" role="alert">@warning</div> }
                            @foreach (var statement in StatementSet())
                            {
                                <h4>@statement.Name</h4>
                                @foreach (var statementSection in statement.Sections)
                                {
                                    <div class="table-scroll"><table class="data-table" aria-label="@($"{statement.Name} — {statementSection.Name}")"><thead><tr><th>@statementSection.Name account</th><th>Amount (@ConsolidatedStatements.ReportingCurrency)</th><th>Drill-down</th></tr></thead><tbody>
                                    @foreach (var account in statementSection.Accounts)
                                    {
                                        <tr><td>@account.AccountNumber — @account.AccountName</td><td>@account.Amount.ToString("N2")</td><td>@if (account.Contributions.Count == 0) { <span class="muted-copy">Derived statement line</span> } else { <details><summary>@account.Contributions.Count source contribution(s)</summary><ul class="feature-list">@foreach (var contribution in account.Contributions) { <li>@contribution.CompanyName · @contribution.SourceAccountNumber — @contribution.SourceAccountName: @contribution.ConvertedBalance.ToString("N2") (@contribution.TranslationMethod)@if (!string.IsNullOrWhiteSpace(contribution.Reference)) { <span> · @contribution.Reference</span> }</li> }</ul></details> }</td></tr>
                                    }
                                    </tbody><tfoot><tr><th>@statementSection.Name total</th><th>@statementSection.Total.ToString("N2")</th><th></th></tr></tfoot></table></div>
                                }
                                <p><strong>Statement total:</strong> @statement.Total.ToString("N2") @ConsolidatedStatements.ReportingCurrency · <strong>reconciliation difference:</strong> @statement.ReconciliationDifference.ToString("N2")</p>
                            }
                            <div class="table-scroll"><table class="data-table" aria-label="Consolidated statement reconciliation"><thead><tr><th>Control</th><th>Amount (@ConsolidatedStatements.ReportingCurrency)</th></tr></thead><tbody>
                                <tr><td>Assets less liabilities, recorded equity, and current earnings</td><td>@ConsolidatedStatements.Reconciliation.BalanceSheetDifference.ToString("N2")</td></tr>
                                <tr><td>Presented ending equity reconciliation</td><td>@ConsolidatedStatements.Reconciliation.EquityStatementDifference.ToString("N2")</td></tr>
                                <tr><td>Ending cash less opening cash</td><td>@ConsolidatedStatements.Reconciliation.NetCashChange.ToString("N2")</td></tr>
                                <tr><td>Cash-flow statement reconciliation</td><td>@ConsolidatedStatements.Reconciliation.CashFlowDifference.ToString("N2")</td></tr>
                            </tbody></table></div>
                        </section>
                    }
                    @if (ComparativeStatements is not null)
                    {
                        <section aria-labelledby="comparativeStatementsHeading">
                            <h3 id="comparativeStatementsHeading">@ComparativeStatements.GroupName comparative statements</h3>
                            <p><strong>Current:</strong> @ComparativeStatements.Current.PeriodStart to @ComparativeStatements.Current.AsOf · <strong>Comparison:</strong> @ComparativeStatements.Comparison.PeriodStart to @ComparativeStatements.Comparison.AsOf · <strong>Variance:</strong> current minus comparison</p>
                            <p role="status"><strong>Status:</strong> @(ComparativeStatements.IsComplete ? "Complete" : "Incomplete — resolve warnings in both periods before external use")</p>
                            <p><a class="action-secondary" href="@ComparativeStatementCsvUrl()">Download comparative statement CSV</a></p>
                            @foreach (var warning in ComparativeStatements.Warnings) { <div class="auth-error" role="alert">@warning</div> }
                            @foreach (var statement in ComparativeStatements.Statements)
                            {
                                <h4>@statement.Name comparison</h4>
                                <div class="table-scroll"><table class="data-table" aria-label="@($"{statement.Name} comparison")"><thead><tr><th>Account</th><th>Current section / caption</th><th>@ComparativeStatements.Current.AsOf</th><th>Comparison section / caption</th><th>@ComparativeStatements.Comparison.AsOf</th><th>Variance</th></tr></thead><tbody>
                                @foreach (var line in statement.Lines)
                                {
                                    <tr><td>@line.AccountNumber (@line.AccountType)</td><td>@(string.IsNullOrWhiteSpace(line.CurrentSectionName) ? "Not present" : $"{line.CurrentSectionName} · {line.CurrentLineCaption}")</td><td>@line.CurrentAmount.ToString("N2")</td><td>@(string.IsNullOrWhiteSpace(line.ComparisonSectionName) ? "Not present" : $"{line.ComparisonSectionName} · {line.ComparisonLineCaption}")</td><td>@line.ComparisonAmount.ToString("N2")</td><td>@line.Variance.ToString("N2")</td></tr>
                                }
                                </tbody><tfoot><tr><th colspan="2">Statement total</th><th>@statement.CurrentTotal.ToString("N2")</th><th></th><th>@statement.ComparisonTotal.ToString("N2")</th><th>@statement.Variance.ToString("N2")</th></tr></tfoot></table></div>
                            }
                        </section>
                    }
                }
            }
        </section>
    </section>
}

@code {
    private BusinessWorkspaceSnapshot? Workspace;
    private IReadOnlyList<ConsolidationGroupSnapshot> ConsolidationGroups = [];
    private ConsolidationAdjustmentWorkspace? AdjustmentWorkspace;
    private ConsolidationIntercompanyMatchWorkspace? IntercompanyMatchWorkspace;
    private ConsolidatedBalanceReport? ConsolidatedReport;
    private ConsolidatedStatementPackage? ConsolidatedStatements;
    private ConsolidatedComparativeStatementPackage? ComparativeStatements;
    private Guid SelectedGroupId;
    private AdjustmentEditor AdjustmentForm = NewAdjustmentEditor();
    private ComparisonEditor ComparisonForm = new();
    private string DecisionReason = string.Empty;
    private string ConsolidationMessage = string.Empty;
    private bool ConsolidationError;

    protected override async Task OnInitializedAsync()
    {
        Workspace = await WorkspaceService.GetWorkspaceAsync();
        ConsolidationGroups = await ConsolidationService.GetGroupsAsync();
        if (ConsolidationGroups.Count > 0) { SelectedGroupId = ConsolidationGroups[0].Id; await LoadAdjustmentWorkspaceAsync(); }
    }

    private async Task SelectConsolidationGroupAsync(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var groupId)) { SelectedGroupId = groupId; ResetAdjustmentForm(); await LoadAdjustmentWorkspaceAsync(); }
    }
    private async Task LoadAdjustmentWorkspaceAsync() { AdjustmentWorkspace = await ConsolidationService.GetAdjustmentWorkspaceAsync(SelectedGroupId); IntercompanyMatchWorkspace = await ConsolidationService.GetIntercompanyMatchWorkspaceAsync(SelectedGroupId, AdjustmentForm.PeriodStart, AdjustmentForm.AsOf); ConsolidatedReport = null; ConsolidatedStatements = null; ComparativeStatements = null; }
    private static AdjustmentEditor NewAdjustmentEditor() => new() { Lines = [new(), new()] };
    private void ResetAdjustmentForm() { AdjustmentForm = NewAdjustmentEditor(); DecisionReason = string.Empty; ConsolidationMessage = string.Empty; ConsolidationError = false; }
    private void AddAdjustmentLine() => AdjustmentForm.Lines.Add(new());
    private void RemoveAdjustmentLine(AdjustmentLineEditor line) { if (AdjustmentForm.Lines.Count > 2) AdjustmentForm.Lines.Remove(line); }
    private static string AccountKey(ConsolidationReportingAccountSnapshot account) => $"{account.AccountType}|{account.AccountNumber}|{account.AccountName}";
    private IReadOnlyList<ConsolidationGroupMemberSnapshot> EffectiveMembers() => AdjustmentWorkspace?.Members.Where(member => member.EffectiveFrom <= AdjustmentForm.AsOf && (member.EffectiveThrough is null || member.EffectiveThrough >= AdjustmentForm.AsOf)).GroupBy(member => member.CompanyId).Select(group => group.First()).ToArray() ?? [];
    private ConsolidationReportingAccountSnapshot? ResolveAccount(string key) => AdjustmentWorkspace?.ReportingAccounts.SingleOrDefault(account => AccountKey(account) == key);
    private async Task SaveAdjustmentAsync()
    {
        if (AdjustmentWorkspace is null) return;
        var lines = new List<ConsolidationAdjustmentLineRequest>();
        foreach (var editor in AdjustmentForm.Lines)
        {
            var account = ResolveAccount(editor.AccountKey); if (account is null) { SetConsolidationMessage("Choose a reporting account for every line.", true); return; }
            lines.Add(new(account.AccountNumber, account.AccountName, account.AccountType, editor.Debit, editor.Credit, editor.Description, AdjustmentForm.Kind == "IntercompanyElimination" ? editor.SourceCompanyId : AdjustmentForm.Kind == "NoncontrollingInterest" ? AdjustmentForm.SubjectCompanyId : null, AdjustmentForm.Kind == "IntercompanyElimination" ? editor.CounterpartyCompanyId : null));
        }
        var result = await ConsolidationService.SaveAdjustmentAsync(new(AdjustmentForm.Id, SelectedGroupId, AdjustmentForm.PeriodStart, AdjustmentForm.AsOf, AdjustmentForm.Kind, AdjustmentForm.Reference, AdjustmentForm.Description, AdjustmentForm.Kind == "IntercompanyElimination" ? AdjustmentForm.MatchReference : string.Empty, lines, AdjustmentForm.ConcurrencyToken, AdjustmentForm.Kind == "NoncontrollingInterest" ? AdjustmentForm.SubjectCompanyId : null));
        SetConsolidationMessage(result.Succeeded ? "The consolidation draft was retained for independent review." : result.ErrorMessage, !result.Succeeded);
        if (result.Succeeded) { AdjustmentForm = NewAdjustmentEditor(); await LoadAdjustmentWorkspaceAsync(); ConsolidationMessage = "The consolidation draft was retained for independent review."; }
    }
    private void EditAdjustment(ConsolidationAdjustmentSnapshot adjustment)
    {
        AdjustmentForm = new AdjustmentEditor { Id = adjustment.Id, PeriodStart = adjustment.PeriodStart, AsOf = adjustment.AsOf, Kind = adjustment.Kind, Reference = adjustment.Reference, Description = adjustment.Description, MatchReference = adjustment.MatchReference, SubjectCompanyId = adjustment.SubjectCompanyId, ConcurrencyToken = adjustment.ConcurrencyToken,
            Lines = adjustment.Lines.Select(line => new AdjustmentLineEditor { AccountKey = AccountKey(new(line.ReportingAccountNumber, line.ReportingAccountName, line.ReportingAccountType)), Debit = line.Debit, Credit = line.Credit, Description = line.Description, SourceCompanyId = line.SourceCompanyId, CounterpartyCompanyId = line.CounterpartyCompanyId }).ToList() };
        ConsolidationMessage = $"Editing {adjustment.Reference}."; ConsolidationError = false;
    }
    private async Task DiscoverIntercompanyMatchesAsync()
    {
        var result = await ConsolidationService.DiscoverIntercompanyMatchesAsync(new(SelectedGroupId, AdjustmentForm.PeriodStart, AdjustmentForm.AsOf));
        SetConsolidationMessage(result.Succeeded ? $"Discovery retained {result.CreatedCount} new and refreshed {result.RefreshedCount} existing exact match(es).{(result.Warnings.Count > 0 ? $" {string.Join(" ", result.Warnings)}" : string.Empty)}" : result.ErrorMessage, !result.Succeeded);
        IntercompanyMatchWorkspace = await ConsolidationService.GetIntercompanyMatchWorkspaceAsync(SelectedGroupId, AdjustmentForm.PeriodStart, AdjustmentForm.AsOf);
    }
    private void UseIntercompanyMatch(ConsolidationIntercompanyMatchSnapshot match)
    {
        AdjustmentForm = NewAdjustmentEditor(); AdjustmentForm.PeriodStart = IntercompanyMatchWorkspace!.PeriodStart; AdjustmentForm.AsOf = IntercompanyMatchWorkspace.AsOf; AdjustmentForm.Kind = "IntercompanyElimination"; AdjustmentForm.Reference = $"ELIM-{match.InvoiceNumber}"[..Math.Min(64, 5 + match.InvoiceNumber.Length)]; AdjustmentForm.Description = $"Eliminate {match.SellerCompanyName} invoice {match.InvoiceNumber} matched to {match.BuyerCompanyName} bill {match.BillNumber}."; AdjustmentForm.MatchReference = match.MatchReference;
        foreach (var line in AdjustmentForm.Lines) { line.SourceCompanyId = match.SellerCompanyId; line.CounterpartyCompanyId = match.BuyerCompanyId; }
        SetConsolidationMessage("Choose and balance the reporting accounts for this exact match. No accounting entry has been inferred or posted.", false);
    }
    private async Task DecideIntercompanyMatchAsync(ConsolidationIntercompanyMatchSnapshot match, string decision)
    {
        var result = await ConsolidationService.SetIntercompanyMatchDecisionAsync(new(SelectedGroupId, match.Id, decision, decision == "Exclude" ? DecisionReason : string.Empty, match.ConcurrencyToken));
        SetConsolidationMessage(result.Succeeded ? $"The match was {(decision == "Exclude" ? "excluded with retained reason" : "restored for review")}." : result.ErrorMessage, !result.Succeeded);
        if (result.Succeeded) { DecisionReason = string.Empty; IntercompanyMatchWorkspace = await ConsolidationService.GetIntercompanyMatchWorkspaceAsync(SelectedGroupId, AdjustmentForm.PeriodStart, AdjustmentForm.AsOf); }
    }
    private Task ExcludeIntercompanyMatchAsync(ConsolidationIntercompanyMatchSnapshot match) => DecideIntercompanyMatchAsync(match, "Exclude");
    private Task RestoreIntercompanyMatchAsync(ConsolidationIntercompanyMatchSnapshot match) => DecideIntercompanyMatchAsync(match, "Restore");
    private Task ApproveAdjustmentAsync(ConsolidationAdjustmentSnapshot adjustment) => RunAdjustmentActionAsync(() => ConsolidationService.ApproveAdjustmentAsync(new(SelectedGroupId, adjustment.Id, adjustment.ConcurrencyToken)), "The consolidation adjustment was approved.");
    private Task RejectAdjustmentAsync(ConsolidationAdjustmentSnapshot adjustment) => RunAdjustmentActionAsync(() => ConsolidationService.RejectAdjustmentAsync(new(SelectedGroupId, adjustment.Id, DecisionReason, adjustment.ConcurrencyToken)), "The consolidation adjustment was rejected for correction.");
    private Task PostAdjustmentAsync(ConsolidationAdjustmentSnapshot adjustment) => RunAdjustmentActionAsync(() => ConsolidationService.PostAdjustmentAsync(new(SelectedGroupId, adjustment.Id, adjustment.ConcurrencyToken)), "The consolidation adjustment was posted to the reporting ledger.");
    private Task ReverseAdjustmentAsync(ConsolidationAdjustmentSnapshot adjustment) => RunAdjustmentActionAsync(() => ConsolidationService.ReverseAdjustmentAsync(new(SelectedGroupId, adjustment.Id, DecisionReason, adjustment.ConcurrencyToken)), "A non-destructive reversal was posted to the reporting ledger.");
    private async Task RunAdjustmentActionAsync(Func<Task<TransactionResult>> action, string successMessage) { var result = await action(); SetConsolidationMessage(result.Succeeded ? successMessage : result.ErrorMessage, !result.Succeeded); if (result.Succeeded) { DecisionReason = string.Empty; await LoadAdjustmentWorkspaceAsync(); ConsolidationMessage = successMessage; } }
    private async Task RunConsolidatedReportAsync() { ConsolidatedReport = await ConsolidationService.GetBalanceReportAsync(SelectedGroupId, AdjustmentForm.PeriodStart, AdjustmentForm.AsOf); if (ConsolidatedReport is null) SetConsolidationMessage("The consolidated balance could not be produced for this period and access context.", true); }
    private async Task RunConsolidatedStatementsAsync() { ConsolidatedStatements = await ConsolidationService.GetStatementPackageAsync(SelectedGroupId, AdjustmentForm.PeriodStart, AdjustmentForm.AsOf); if (ConsolidatedStatements is null) SetConsolidationMessage("The consolidated statement package could not be produced for this period and access context.", true); }
    private async Task RunComparativeStatementsAsync() { ComparativeStatements = await ConsolidationService.GetComparativeStatementPackageAsync(SelectedGroupId, AdjustmentForm.PeriodStart, AdjustmentForm.AsOf, ComparisonForm.PeriodStart, ComparisonForm.AsOf); if (ComparativeStatements is null) SetConsolidationMessage("Choose valid current and comparison periods with the comparison as-of date before the current as-of date.", true); }
    private IEnumerable<ConsolidatedFinancialStatement> StatementSet() => ConsolidatedStatements is null ? [] : [ConsolidatedStatements.BalanceSheet, ConsolidatedStatements.IncomeStatement, ConsolidatedStatements.EquityStatement, ConsolidatedStatements.CashFlowStatement];
    private string StatementCsvUrl() => ConsolidatedStatements is null ? "#" : $"/consolidation-groups/{ConsolidatedStatements.GroupId}/statements.csv?periodStart={ConsolidatedStatements.PeriodStart:yyyy-MM-dd}&asOf={ConsolidatedStatements.AsOf:yyyy-MM-dd}";
    private string ComparativeStatementCsvUrl() => ComparativeStatements is null ? "#" : $"/consolidation-groups/{ComparativeStatements.GroupId}/statements/comparative.csv?currentPeriodStart={ComparativeStatements.Current.PeriodStart:yyyy-MM-dd}&currentAsOf={ComparativeStatements.Current.AsOf:yyyy-MM-dd}&comparisonPeriodStart={ComparativeStatements.Comparison.PeriodStart:yyyy-MM-dd}&comparisonAsOf={ComparativeStatements.Comparison.AsOf:yyyy-MM-dd}";
    private void SetConsolidationMessage(string message, bool error) { ConsolidationMessage = message; ConsolidationError = error; }
    private static string DisplayKind(string kind) => kind switch { "IntercompanyElimination" => "Intercompany elimination", "NoncontrollingInterest" => "Noncontrolling-interest reclassification", _ => "Manual adjustment" };

    private sealed class AdjustmentEditor
    {
        public Guid? Id { get; set; }
        public DateOnly PeriodStart { get; set; } = new(DateTime.UtcNow.Year, 1, 1);
        public DateOnly AsOf { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);
        public string Kind { get; set; } = "ManualAdjustment";
        public string Reference { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string MatchReference { get; set; } = string.Empty;
        public Guid? SubjectCompanyId { get; set; }
        public string ConcurrencyToken { get; set; } = string.Empty;
        public List<AdjustmentLineEditor> Lines { get; set; } = [];
    }
    private sealed class ComparisonEditor { public DateOnly PeriodStart { get; set; } = new(DateTime.UtcNow.Year - 1, 1, 1); public DateOnly AsOf { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow).AddYears(-1); }
    private sealed class AdjustmentLineEditor
    {
        public string AccountKey { get; set; } = string.Empty;
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public string Description { get; set; } = string.Empty;
        public Guid? SourceCompanyId { get; set; }
        public Guid? CounterpartyCompanyId { get; set; }
    }
}
