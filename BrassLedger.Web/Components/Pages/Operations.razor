    private sealed class LandedCostEditor
    {
        private LandedCostEditor(InventoryReceiptSnapshot receipt) { InventoryReceiptId = receipt.Id; ReceiptNumber = receipt.ReceiptNumber; ReceiptConcurrencyToken = receipt.ConcurrencyToken; var today = DateOnly.FromDateTime(DateTime.Today); BillDate = today < receipt.ReceivedOn ? receipt.ReceivedOn : today; DueDate = BillDate.AddDays(30); Lines = receipt.Lines.Where(line => line.Quantity > line.ReturnedQuantity).Select(line => new LandedCostLineEditor(line.Id, line.Sku, 0m)).ToList(); }
        public static LandedCostEditor Create(InventoryReceiptSnapshot receipt) => new(receipt);
        public static LandedCostEditor Edit(LandedCostAllocationSnapshot allocation, InventoryReceiptSnapshot receipt)
        {
            var editor = new LandedCostEditor(receipt) { Id = allocation.Id, VendorId = allocation.VendorId, AllocationNumber = allocation.AllocationNumber, BillNumber = allocation.BillNumber, BillDate = allocation.BillDate, DueDate = allocation.DueDate, AllocationMethod = allocation.AllocationMethod, Description = allocation.Description, ConcurrencyToken = allocation.ConcurrencyToken };
            editor.Charges.Clear(); editor.Charges.AddRange(allocation.Charges.Select(charge => new LandedCostChargeEditor(charge.ChargeType, charge.Description, charge.Amount)));
            foreach (var line in editor.Lines) line.AllocatedAmount = allocation.Lines.SingleOrDefault(item => item.InventoryReceiptLineId == line.InventoryReceiptLineId)?.AllocatedAmount ?? 0m;
            return editor;
        }
