    private void BeginBackorderPromise(SalesOrderSnapshot order)
    {
        var outstandingByLine = (Workspace?.Operations.BackorderPromises ?? [])
            .Where(promise => promise.SalesOrderId == order.Id && promise.Status is "Open" or "PartiallyFulfilled")
            .GroupBy(promise => promise.SalesOrderLineId)
            .ToDictionary(group => group.Key, group => group.Sum(promise => promise.OutstandingQuantity));
        var lines = (order.Lines ?? [])
            .Select(line => new SalesBackorderLineEditor(line.Id, line.Sku, line.OrderedQuantity - line.ShippedQuantity - line.CancelledQuantity - line.AllocatedQuantity - outstandingByLine.GetValueOrDefault(line.Id)))
            .Where(line => line.AvailableDemand > 0m)
            .ToList();
        SalesBackorderForm = new SalesBackorderEditor(order.Id, order.OrderNumber, order.ConcurrencyToken, lines);
    }
    private bool HasUnpromisedBackorderDemand(SalesOrderSnapshot order)
    {
        var outstandingByLine = (Workspace?.Operations.BackorderPromises ?? [])
            .Where(promise => promise.SalesOrderId == order.Id && promise.Status is "Open" or "PartiallyFulfilled")
            .GroupBy(promise => promise.SalesOrderLineId)
            .ToDictionary(group => group.Key, group => group.Sum(promise => promise.OutstandingQuantity));
        return (order.Lines ?? []).Any(line => line.OrderedQuantity - line.ShippedQuantity - line.CancelledQuantity - line.AllocatedQuantity - outstandingByLine.GetValueOrDefault(line.Id) > 0m);
    }
