    private IReadOnlyList<PurchaseInvoiceMatchSnapshot> InvoiceMatchesForReceipt(Guid receiptId) => (Workspace?.Operations.PurchaseInvoiceMatches ?? []).Where(match => match.InventoryReceiptId == receiptId).ToArray();
    private IReadOnlyList<MatchedVendorBillSnapshot> ActiveReceiptBills(InventoryReceiptSnapshot receipt) => (receipt.VendorBills ?? []).Where(bill => bill.Status != "Voided").ToArray();
    private bool IsLegacyMatchedReceipt(InventoryReceiptSnapshot receipt) => ActiveReceiptBills(receipt).Count == 1 && InvoiceMatchesForReceipt(receipt.Id).Count == 0;
    private bool CanPreparePurchaseInvoice(InventoryReceiptSnapshot receipt)
    {
        if (receipt.Status != "Posted" || IsLegacyMatchedReceipt(receipt)) return false;
        var reservedLines = InvoiceMatchesForReceipt(receipt.Id).Where(match => match.Status is "Draft" or "Submitted" or "Approved" or "Posted").SelectMany(match => match.Lines);
        return receipt.Lines.Any(line => line.Quantity - line.ReturnedQuantity - reservedLines.Where(matchLine => matchLine.InventoryReceiptLineId == line.Id).Sum(matchLine => matchLine.MatchedQuantity) > 0m);
    }
    private bool CanReversePurchaseReceipt(InventoryReceiptSnapshot receipt) => receipt.Status == "Posted" && ActiveReceiptBills(receipt).Count == 0 && !InvoiceMatchesForReceipt(receipt.Id).Any(match => match.Status is not ("Cancelled" or "Reversed"));
    private void BeginBillMatch(InventoryReceiptSnapshot receipt)
    {
        var reservedLines = InvoiceMatchesForReceipt(receipt.Id).Where(match => match.Status is "Draft" or "Submitted" or "Approved" or "Posted").SelectMany(match => match.Lines);
        var lines = receipt.Lines.Select(line => new BillMatchLineEditor(line.Id, line.Sku, Math.Max(0m, line.Quantity - line.ReturnedQuantity - reservedLines.Where(matchLine => matchLine.InventoryReceiptLineId == line.Id).Sum(matchLine => matchLine.MatchedQuantity)), line.UnitCost)).Where(line => line.AvailableQuantity > 0m).ToList();
        BillMatchForm = BillMatchEditor.Create(receipt, lines);
    }
