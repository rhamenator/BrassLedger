@page "/operations"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.ManageOperations)]
@inject IBusinessWorkspaceService WorkspaceService
@inject IAccountingTransactionService TransactionService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Operations</PageTitle>

@if (Workspace is null)
{
    <section class="panel">
        <h1>Loading operations...</h1>
    </section>
}
else
{
    <section class="page-shell">
        <header class="page-header">
            <div>
                <p class="eyebrow">Inventory, Orders, Purchasing, POS</p>
                <h1>Operational flow from stock to shipment.</h1>
            </div>
            <p class="page-intro">
                Prepare customer and supplier orders, reserve stock, post shipments and receipts, and create their accounting documents.
                Physical inventory movements remain separate from receivable and payable authority.
            </p>
        </header>

        @if (!string.IsNullOrWhiteSpace(StatusMessage)) { <p class="lead" role="status">@StatusMessage</p> }

        <section class="stats-grid">
            <article class="stat-card accent-sand">
                <span class="stat-value">@Workspace.Operations.InventoryItemCount</span>
                <span class="stat-label">Active items</span>
            </article>
            <article class="stat-card accent-sky">
                <span class="stat-value">@Workspace.Operations.ReorderAlerts</span>
                <span class="stat-label">Reorder alerts</span>
            </article>
            <article class="stat-card accent-sage">
                <span class="stat-value">@Workspace.Operations.OpenSalesOrderCount</span>
                <span class="stat-label">Open sales orders</span>
            </article>
            <article class="stat-card accent-coral">
                <span class="stat-value">@Workspace.Operations.OpenPurchaseOrderCount</span>
                <span class="stat-label">Open purchase orders</span>
            </article>
        </section>

        <section class="content-grid">
            @if (CanManageSales)
            {
            <article class="panel">
                <h2>Prepare sales quote</h2>
                <p class="page-intro">Record an expiring, priced offer. Approval locks its commercial terms; conversion copies those exact lines into a draft sales order.</p>
                <details class="panel-subsection">
                <summary>Create quote draft</summary>
                <EditForm Model="SalesQuoteForm" OnValidSubmit="SaveSalesQuoteAsync"><div class="auth-form">
                    <div class="field-group"><label class="field-label">Customer</label><InputSelect aria-label="Sales quote customer" class="field-input" @bind-Value="SalesQuoteForm.CustomerId"><option value="@Guid.Empty">Select customer</option>@foreach (var customer in Workspace.Receivables.Customers) { <option value="@customer.Id">@customer.CustomerNumber — @customer.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Quote number</label><InputText aria-label="Sales quote number" class="field-input" @bind-Value="SalesQuoteForm.QuoteNumber" /></div>
                    <div class="field-group"><label class="field-label">Quote date</label><InputDate aria-label="Sales quote date" class="field-input" @bind-Value="SalesQuoteForm.QuotedOn" /></div>
                    <div class="field-group"><label class="field-label">Expires</label><InputDate aria-label="Sales quote expiration date" class="field-input" @bind-Value="SalesQuoteForm.ExpiresOn" /></div>
                    <div class="field-group"><label class="field-label">Notes</label><InputText aria-label="Sales quote notes" class="field-input" @bind-Value="SalesQuoteForm.Notes" /></div>
                    @for (var index = 0; index < SalesQuoteForm.Lines.Count; index++)
                    {
                        var lineIndex = index; var line = SalesQuoteForm.Lines[lineIndex];
                        <fieldset class="panel-subsection"><legend>Quote line @(lineIndex + 1)</legend>
                            <div class="field-group"><label class="field-label">Inventory item</label><InputSelect aria-label="@($"Sales quote line {lineIndex + 1} item")" class="field-input" @bind-Value="line.InventoryItemId"><option value="@Guid.Empty">Select item</option>@foreach (var item in Workspace.Operations.InventoryItems) { <option value="@item.Id">@item.Sku — @item.Description</option> }</InputSelect></div>
                            <div class="field-group"><label class="field-label">Description</label><InputText aria-label="@($"Sales quote line {lineIndex + 1} description")" class="field-input" @bind-Value="line.Description" /></div>
                            <div class="field-group"><label class="field-label">Quantity</label><InputNumber aria-label="@($"Sales quote line {lineIndex + 1} quantity")" class="field-input" @bind-Value="line.Quantity" /></div>
                            <div class="field-group"><label class="field-label">Unit price</label><InputNumber aria-label="@($"Sales quote line {lineIndex + 1} unit price")" class="field-input" @bind-Value="line.UnitPrice" /></div>
                            <div class="field-group"><label class="field-label">Discount</label><InputNumber aria-label="@($"Sales quote line {lineIndex + 1} discount")" class="field-input" @bind-Value="line.DiscountAmount" /></div>
                            <div class="field-group"><label class="field-label">Tax</label><InputNumber aria-label="@($"Sales quote line {lineIndex + 1} tax")" class="field-input" @bind-Value="line.TaxAmount" /></div>
                            <div class="field-group"><label class="field-label">Revenue account</label><InputSelect aria-label="@($"Sales quote line {lineIndex + 1} revenue account")" class="field-input" @bind-Value="line.RevenueAccountNumber"><option value="">Select revenue account</option>@foreach (var account in Workspace.GeneralLedger.Accounts.Where(account => account.Type == "Revenue" && !account.IsControlAccount)) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></div>
                            @if (SalesQuoteForm.Lines.Count > 1) { <button class="action-secondary" type="button" @onclick="() => RemoveSalesQuoteLine(lineIndex)">Remove line</button> }
                        </fieldset>
                    }
                    <button class="action-secondary" type="button" @onclick="AddSalesQuoteLine">Add quote line</button>
                    <button class="action-primary" type="submit">Save quote draft</button>
                </div></EditForm>
                </details>
            </article>
            <article class="panel">
                <h2>Prepare sales order</h2>
                <p class="page-intro">Save a priced multi-line draft. Approval authorizes fulfillment but does not reserve or ship stock.</p>
                <EditForm Model="SalesOrderForm" OnValidSubmit="SaveSalesOrderAsync"><div class="auth-form">
                    <div class="field-group"><label class="field-label">Customer</label><InputSelect aria-label="Sales order customer" class="field-input" @bind-Value="SalesOrderForm.CustomerId"><option value="@Guid.Empty">Select customer</option>@foreach (var customer in Workspace.Receivables.Customers) { <option value="@customer.Id">@customer.CustomerNumber — @customer.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Order number</label><InputText aria-label="Sales order number" class="field-input" @bind-Value="SalesOrderForm.OrderNumber" /></div>
                    <div class="field-group"><label class="field-label">Order date</label><InputDate aria-label="Sales order date" class="field-input" @bind-Value="SalesOrderForm.OrderedOn" /></div>
                    <div class="field-group"><label class="field-label">Requested ship date</label><InputDate aria-label="Sales order requested ship date" class="field-input" @bind-Value="SalesOrderForm.RequestedShipOn" /></div>
                    <div class="field-group"><label class="field-label">Notes</label><InputText aria-label="Sales order notes" class="field-input" @bind-Value="SalesOrderForm.Notes" /></div>
                    @for (var index = 0; index < SalesOrderForm.Lines.Count; index++)
                    {
                        var lineIndex = index; var line = SalesOrderForm.Lines[lineIndex];
                        <fieldset class="panel-subsection"><legend>Line @(lineIndex + 1)</legend>
                            <div class="field-group"><label class="field-label">Inventory item</label><InputSelect aria-label="@($"Sales order line {lineIndex + 1} item")" class="field-input" @bind-Value="line.InventoryItemId"><option value="@Guid.Empty">Select item</option>@foreach (var item in Workspace.Operations.InventoryItems) { <option value="@item.Id">@item.Sku — @item.Description</option> }</InputSelect></div>
                            <div class="field-group"><label class="field-label">Description</label><InputText aria-label="@($"Sales order line {lineIndex + 1} description")" class="field-input" @bind-Value="line.Description" /></div>
                            <div class="field-group"><label class="field-label">Quantity</label><InputNumber aria-label="@($"Sales order line {lineIndex + 1} quantity")" class="field-input" @bind-Value="line.Quantity" /></div>
                            <div class="field-group"><label class="field-label">Unit price</label><InputNumber aria-label="@($"Sales order line {lineIndex + 1} unit price")" class="field-input" @bind-Value="line.UnitPrice" /></div>
                            <div class="field-group"><label class="field-label">Discount</label><InputNumber aria-label="@($"Sales order line {lineIndex + 1} discount")" class="field-input" @bind-Value="line.DiscountAmount" /></div>
                            <div class="field-group"><label class="field-label">Tax</label><InputNumber aria-label="@($"Sales order line {lineIndex + 1} tax")" class="field-input" @bind-Value="line.TaxAmount" /></div>
                            <div class="field-group"><label class="field-label">Revenue account</label><InputSelect aria-label="@($"Sales order line {lineIndex + 1} revenue account")" class="field-input" @bind-Value="line.RevenueAccountNumber"><option value="">Select revenue account</option>@foreach (var account in Workspace.GeneralLedger.Accounts.Where(account => account.Type == "Revenue" && !account.IsControlAccount)) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></div>
                            @if (SalesOrderForm.Lines.Count > 1) { <button class="action-secondary" type="button" @onclick="() => RemoveSalesOrderLine(lineIndex)">Remove line</button> }
                        </fieldset>
                    }
                    <button class="action-secondary" type="button" @onclick="AddSalesOrderLine">Add line</button>
                    <button class="action-primary" type="submit">Save sales-order draft</button>
                </div></EditForm>
            </article>
            }
            @if (CanManageRequisitions)
            {
            <article class="panel">
                <h2>Prepare purchase requisition</h2>
                <p class="page-intro">Request inventory without creating supplier authority. Purchasing must approve the submitted request before it can become a purchase-order draft.</p>
                <EditForm Model="PurchaseRequisitionForm" OnValidSubmit="SavePurchaseRequisitionAsync"><div class="auth-form">
                    <div class="field-group"><label class="field-label">Suggested vendor</label><InputSelect aria-label="Purchase requisition suggested vendor" class="field-input" @bind-Value="PurchaseRequisitionForm.RequestedVendorId"><option value="">Vendor to be selected</option>@foreach (var vendor in Workspace.Payables.Vendors) { <option value="@vendor.Id">@vendor.VendorNumber — @vendor.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Requisition number</label><InputText aria-label="Purchase requisition number" class="field-input" @bind-Value="PurchaseRequisitionForm.RequisitionNumber" /></div>
                    <div class="field-group"><label class="field-label">Request date</label><InputDate aria-label="Purchase requisition date" class="field-input" @bind-Value="PurchaseRequisitionForm.RequestedOn" /></div>
                    <div class="field-group"><label class="field-label">Needed by</label><InputDate aria-label="Purchase requisition needed by date" class="field-input" @bind-Value="PurchaseRequisitionForm.NeededBy" /></div>
                    <div class="field-group"><label class="field-label">Business purpose</label><InputText aria-label="Purchase requisition business purpose" class="field-input" @bind-Value="PurchaseRequisitionForm.Purpose" /></div>
                    @for (var index = 0; index < PurchaseRequisitionForm.Lines.Count; index++)
                    {
                        var lineIndex = index; var line = PurchaseRequisitionForm.Lines[lineIndex];
                        <fieldset class="panel-subsection"><legend>Requested line @(lineIndex + 1)</legend>
                            <div class="field-group"><label class="field-label">Inventory item</label><InputSelect aria-label="@($"Purchase requisition line {lineIndex + 1} item")" class="field-input" @bind-Value="line.InventoryItemId"><option value="@Guid.Empty">Select item</option>@foreach (var item in Workspace.Operations.InventoryItems) { <option value="@item.Id">@item.Sku — @item.Description</option> }</InputSelect></div>
                            <div class="field-group"><label class="field-label">Description</label><InputText aria-label="@($"Purchase requisition line {lineIndex + 1} description")" class="field-input" @bind-Value="line.Description" /></div>
                            <div class="field-group"><label class="field-label">Quantity</label><InputNumber aria-label="@($"Purchase requisition line {lineIndex + 1} quantity")" class="field-input" @bind-Value="line.Quantity" /></div>
                            <div class="field-group"><label class="field-label">Estimated unit cost</label><InputNumber aria-label="@($"Purchase requisition line {lineIndex + 1} estimated unit cost")" class="field-input" @bind-Value="line.EstimatedUnitCost" /></div>
                            @if (PurchaseRequisitionForm.Lines.Count > 1) { <button class="action-secondary" type="button" @onclick="() => RemovePurchaseRequisitionLine(lineIndex)">Remove line</button> }
                        </fieldset>
                    }
                    <button class="action-secondary" type="button" @onclick="AddPurchaseRequisitionLine">Add requested line</button>
                    <button class="action-primary" type="submit">@(PurchaseRequisitionForm.Id.HasValue ? "Save requisition changes" : "Save requisition draft")</button>
                    @if (PurchaseRequisitionForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="CancelPurchaseRequisitionEdit">Cancel edit</button> }
                </div></EditForm>
            </article>
            }
            @if (CanManagePurchasing)
            {
            <article class="panel">
                <h2>Prepare direct purchase order</h2>
                <p class="page-intro">Purchasing can prepare a direct supplier order when a separate requisition is not required. Converted requisitions create the same reviewable draft automatically.</p>
                <EditForm Model="PurchaseOrderForm" OnValidSubmit="SavePurchaseOrderAsync">
                    <div class="auth-form">
                        <div class="field-group"><label class="field-label">Vendor</label><InputSelect aria-label="Purchase order vendor" class="field-input" @bind-Value="PurchaseOrderForm.VendorId"><option value="@Guid.Empty">Select vendor</option>@foreach (var vendor in Workspace.Payables.Vendors) { <option value="@vendor.Id">@vendor.VendorNumber — @vendor.Name</option> }</InputSelect></div>
                        <div class="field-group"><label class="field-label">Order number</label><InputText aria-label="Purchase order number" class="field-input" @bind-Value="PurchaseOrderForm.OrderNumber" /></div>
                        <div class="field-group"><label class="field-label">Order date</label><InputDate aria-label="Purchase order date" class="field-input" @bind-Value="PurchaseOrderForm.OrderedOn" /></div>
                        <div class="field-group"><label class="field-label">Expected date</label><InputDate aria-label="Purchase order expected date" class="field-input" @bind-Value="PurchaseOrderForm.ExpectedOn" /></div>
                        <div class="field-group"><label class="field-label">Notes</label><InputText aria-label="Purchase order notes" class="field-input" @bind-Value="PurchaseOrderForm.Notes" /></div>
                        @for (var index = 0; index < PurchaseOrderForm.Lines.Count; index++)
                        {
                            var lineIndex = index;
                            var line = PurchaseOrderForm.Lines[lineIndex];
                            <fieldset class="panel-subsection">
                                <legend>Line @(lineIndex + 1)</legend>
                                <div class="field-group"><label class="field-label">Inventory item</label><InputSelect aria-label="@($"Purchase order line {lineIndex + 1} item")" class="field-input" @bind-Value="line.InventoryItemId"><option value="@Guid.Empty">Select item</option>@foreach (var item in Workspace.Operations.InventoryItems) { <option value="@item.Id">@item.Sku — @item.Description</option> }</InputSelect></div>
                                <div class="field-group"><label class="field-label">Description</label><InputText aria-label="@($"Purchase order line {lineIndex + 1} description")" class="field-input" @bind-Value="line.Description" /></div>
                                <div class="field-group"><label class="field-label">Quantity</label><InputNumber aria-label="@($"Purchase order line {lineIndex + 1} quantity")" class="field-input" @bind-Value="line.Quantity" /></div>
                                <div class="field-group"><label class="field-label">Unit cost</label><InputNumber aria-label="@($"Purchase order line {lineIndex + 1} unit cost")" class="field-input" @bind-Value="line.UnitCost" /></div>
                                @if (PurchaseOrderForm.Lines.Count > 1) { <button class="action-secondary" type="button" @onclick="() => RemovePurchaseOrderLine(lineIndex)">Remove line</button> }
                            </fieldset>
                        }
                        <button class="action-secondary" type="button" @onclick="AddPurchaseOrderLine">Add line</button>
                        <button class="action-primary" type="submit">Save purchase-order draft</button>
                    </div>
                </EditForm>
            </article>
            }
            @if (CanManagePurchasing)
            {
            <article class="panel">
                <h2>Inventory adjustment</h2>
                <p class="page-intro">Use documented count adjustments only. The system posts the inventory value and offset automatically; it will reject closed-period postings and negative on-hand quantity.</p>
                <EditForm Model="AdjustmentForm" OnValidSubmit="RecordAdjustmentAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Item</label><InputSelect aria-label="Inventory adjustment item" class="field-input" @bind-Value="AdjustmentForm.InventoryItemId"><option value="@Guid.Empty">Select item</option>@foreach (var item in Workspace.Operations.InventoryItems) { <option value="@item.Id">@item.Sku — @item.Description</option> }</InputSelect></div><div class="field-group"><label class="field-label">Warehouse/bin</label><InputSelect aria-label="Inventory adjustment bin" class="field-input" @bind-Value="AdjustmentForm.BinId"><option value="@Guid.Empty">Default location</option>@foreach (var warehouse in (Workspace.Operations.Warehouses ?? []).Where(item => item.IsActive)) { @foreach (var bin in warehouse.Bins.Where(item => item.IsActive)) { <option value="@bin.Id">@warehouse.Code/@bin.Code — @bin.Name</option> } }</InputSelect></div><div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Inventory adjustment date" class="field-input" @bind-Value="AdjustmentForm.OccurredOn" /></div><div class="field-group"><label class="field-label">Quantity change</label><InputNumber aria-label="Inventory quantity change" class="field-input" @bind-Value="AdjustmentForm.QuantityChange" /></div><div class="field-group"><label class="field-label">Unit cost</label><InputNumber aria-label="Inventory adjustment unit cost" class="field-input" @bind-Value="AdjustmentForm.UnitCost" /></div><div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Inventory adjustment reference" class="field-input" @bind-Value="AdjustmentForm.Reference" /></div><div class="field-group"><label class="field-label">Description</label><InputText aria-label="Inventory adjustment description" class="field-input" @bind-Value="AdjustmentForm.Description" /></div><button class="action-primary" type="submit">Post adjustment</button></div></EditForm>
            </article>
            }
            <article class="panel">
                <h2>Inventory</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Description</th>
                            <th>On hand</th>
                            <th>Reorder point</th>
                            <th>Unit price</th>
                            <th>Average cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Workspace.Operations.InventoryItems)
                        {
                            <tr>
                                <td>@item.Sku</td>
                                <td>@item.Description</td>
                                <td>@item.QuantityOnHand</td>
                                <td>@item.ReorderPoint</td>
                                <td>@item.UnitPrice.ToString("C")</td>
                                <td>@item.UnitCost.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>

            <article class="panel">
                <h2>Warehouses and bins</h2>
                <p class="page-intro">Company totals must equal the sum of all bin balances. A default location safely receives legacy requests; transfers move physical stock without creating a general-ledger entry.</p>
                <table class="data-table" aria-label="Inventory locations"><thead><tr><th>Warehouse</th><th>Address</th><th>Bin</th><th>Status</th><th>Stock</th><th>Action</th></tr></thead><tbody>
                    @foreach (var warehouse in Workspace.Operations.Warehouses ?? [])
                    {
                        @foreach (var bin in warehouse.Bins)
                        {
                            <tr><td>@warehouse.Code — @warehouse.Name @(warehouse.IsDefault ? "(default)" : "")</td><td>@WarehouseAddress(warehouse)</td><td>@bin.Code — @bin.Name @(bin.IsDefault ? "(default)" : "")</td><td>@(warehouse.IsActive && bin.IsActive ? "Active" : "Inactive")</td><td>@string.Join(", ", bin.Balances.Where(balance => balance.QuantityOnHand != 0m).Select(balance => $"{balance.Sku}: {balance.QuantityOnHand}"))</td><td>@if (CanManagePurchasing) { <button class="action-secondary" type="button" @onclick="() => EditWarehouse(warehouse)">Edit warehouse</button> <button class="action-secondary" type="button" @onclick="() => EditBin(bin)">Edit bin</button> }</td></tr>
                        }
                    }
                </tbody></table>
                @if (CanManagePurchasing)
                {
                    <details class="panel-subsection" open="@(WarehouseForm.Id.HasValue)"><summary>@(WarehouseForm.Id.HasValue ? "Edit warehouse" : "Add warehouse")</summary><EditForm Model="WarehouseForm" OnValidSubmit="SaveWarehouseAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Code</label><InputText aria-label="Warehouse code" class="field-input" @bind-Value="WarehouseForm.Code" /></div><div class="field-group"><label class="field-label">Name</label><InputText aria-label="Warehouse name" class="field-input" @bind-Value="WarehouseForm.Name" /></div><div class="field-group"><label class="field-label">Address line 1</label><InputText aria-label="Warehouse address line 1" class="field-input" @bind-Value="WarehouseForm.AddressLine1" /></div><div class="field-group"><label class="field-label">Address line 2</label><InputText aria-label="Warehouse address line 2" class="field-input" @bind-Value="WarehouseForm.AddressLine2" /></div><div class="field-group"><label class="field-label">City</label><InputText aria-label="Warehouse city" class="field-input" @bind-Value="WarehouseForm.City" /></div><div class="field-group"><label class="field-label">State/province</label><InputText aria-label="Warehouse state or province" class="field-input" @bind-Value="WarehouseForm.StateOrProvince" /></div><div class="field-group"><label class="field-label">Postal code</label><InputText aria-label="Warehouse postal code" class="field-input" @bind-Value="WarehouseForm.PostalCode" /></div><div class="field-group"><label class="field-label">Country</label><InputText aria-label="Warehouse country code" class="field-input" @bind-Value="WarehouseForm.CountryCode" /></div><div class="field-group"><label class="field-label">Default</label><InputCheckbox aria-label="Warehouse default" @bind-Value="WarehouseForm.IsDefault" /></div><div class="field-group"><label class="field-label">Active</label><InputCheckbox aria-label="Warehouse active" @bind-Value="WarehouseForm.IsActive" /></div><button class="action-primary" type="submit">Save warehouse</button>@if (WarehouseForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="CancelWarehouseEdit">Cancel edit</button> }</div></EditForm></details>
                    <details class="panel-subsection" open="@(BinForm.Id.HasValue)"><summary>@(BinForm.Id.HasValue ? "Edit bin" : "Add bin")</summary><EditForm Model="BinForm" OnValidSubmit="SaveBinAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Warehouse</label><InputSelect aria-label="Bin warehouse" class="field-input" disabled="@(BinForm.Id.HasValue)" @bind-Value="BinForm.WarehouseId"><option value="@Guid.Empty">Select warehouse</option>@foreach (var warehouse in (Workspace.Operations.Warehouses ?? []).Where(item => item.IsActive)) { <option value="@warehouse.Id">@warehouse.Code — @warehouse.Name</option> }</InputSelect></div><div class="field-group"><label class="field-label">Code</label><InputText aria-label="Bin code" class="field-input" @bind-Value="BinForm.Code" /></div><div class="field-group"><label class="field-label">Name</label><InputText aria-label="Bin name" class="field-input" @bind-Value="BinForm.Name" /></div><div class="field-group"><label class="field-label">Default</label><InputCheckbox aria-label="Bin default" @bind-Value="BinForm.IsDefault" /></div><div class="field-group"><label class="field-label">Active</label><InputCheckbox aria-label="Bin active" @bind-Value="BinForm.IsActive" /></div><button class="action-primary" type="submit">Save bin</button>@if (BinForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="CancelBinEdit">Cancel edit</button> }</div></EditForm></details>
                }
                @if (CanFulfillSales)
                {
                    <details class="panel-subsection"><summary>Transfer stock</summary><EditForm Model="InventoryTransferForm" OnValidSubmit="TransferInventoryAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Item</label><InputSelect aria-label="Transfer inventory item" class="field-input" @bind-Value="InventoryTransferForm.InventoryItemId"><option value="@Guid.Empty">Select item</option>@foreach (var item in Workspace.Operations.InventoryItems) { <option value="@item.Id">@item.Sku — @item.Description</option> }</InputSelect></div><div class="field-group"><label class="field-label">Source</label><InputSelect aria-label="Transfer source bin" class="field-input" @bind-Value="InventoryTransferForm.SourceBinId"><option value="@Guid.Empty">Select source bin</option>@foreach (var warehouse in (Workspace.Operations.Warehouses ?? []).Where(item => item.IsActive)) { @foreach (var bin in warehouse.Bins.Where(item => item.IsActive)) { <option value="@bin.Id">@warehouse.Code/@bin.Code</option> } }</InputSelect></div><div class="field-group"><label class="field-label">Destination</label><InputSelect aria-label="Transfer destination bin" class="field-input" @bind-Value="InventoryTransferForm.DestinationBinId"><option value="@Guid.Empty">Select destination bin</option>@foreach (var warehouse in (Workspace.Operations.Warehouses ?? []).Where(item => item.IsActive)) { @foreach (var bin in warehouse.Bins.Where(item => item.IsActive)) { <option value="@bin.Id">@warehouse.Code/@bin.Code</option> } }</InputSelect></div><div class="field-group"><label class="field-label">Quantity</label><InputNumber aria-label="Transfer quantity" class="field-input" @bind-Value="InventoryTransferForm.Quantity" /></div><div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Transfer date" class="field-input" @bind-Value="InventoryTransferForm.TransferDate" /></div><div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Transfer reference" class="field-input" @bind-Value="InventoryTransferForm.Reference" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Transfer reason" class="field-input" @bind-Value="InventoryTransferForm.Reason" /></div><button class="action-primary" type="submit">Post transfer</button></div></EditForm></details>
                }
                <table class="data-table" aria-label="Inventory transfers"><thead><tr><th>Reference</th><th>Date</th><th>Item</th><th>Route</th><th>Quantity</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach (var transfer in Workspace.Operations.InventoryTransfers ?? []) { <tr><td>@transfer.Reference</td><td>@transfer.TransferDate.ToString("MMM d, yyyy")</td><td>@transfer.Sku</td><td>@transfer.SourceLocation → @transfer.DestinationLocation</td><td>@transfer.Quantity</td><td>@transfer.Status</td><td>@if (CanFulfillSales && transfer.Status == "Posted") { <button class="action-secondary" type="button" @onclick="() => BeginTransferReversal(transfer)">Reverse</button> }</td></tr> }</tbody></table>
            </article>
            @if (CanFulfillSales && TransferReversalForm is not null)
            {
                <section class="panel"><h2>Reverse transfer @TransferReversalForm.Reference</h2><EditForm Model="TransferReversalForm" OnValidSubmit="ReverseTransferAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Transfer reversal date" class="field-input" @bind-Value="TransferReversalForm.ReversalDate" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Transfer reversal reason" class="field-input" @bind-Value="TransferReversalForm.Reason" /></div><button class="action-primary" type="submit">Confirm transfer reversal</button><button class="action-secondary" type="button" @onclick="CancelTransferReversal">Cancel</button></div></EditForm></section>
            }

            <article class="panel">
                <h2>Sales quotes</h2>
                <p class="page-intro">Expired offers remain visible but cannot be converted. Withdrawals require a reason and converted quotes retain their exact order link.</p>
                <table class="data-table">
                    <thead><tr><th>Quote</th><th>Customer</th><th>Status</th><th>Valid through</th><th>Total</th><th>Action</th></tr></thead>
                    <tbody>
                        @foreach (var quote in Workspace.Operations.SalesQuotes ?? [])
                        {
                            <tr><td>@quote.QuoteNumber</td><td>@quote.CustomerName</td><td>@(quote.IsExpired ? "Expired" : quote.Status)</td><td>@quote.ExpiresOn.ToString("MMM d, yyyy")</td><td>@quote.TotalAmount.ToString("C")</td><td>
                                @if (CanManageSales && quote.Status == "Draft") { <button class="action-secondary" type="button" @onclick="() => ApproveSalesQuoteAsync(quote)">Approve</button> }
                                @if (CanManageSales && quote.Status == "Approved" && !quote.IsExpired) { <button class="action-secondary" type="button" @onclick="() => BeginQuoteConversion(quote)">Convert to order</button> }
                                @if (CanManageSales && quote.Status is "Draft" or "Approved") { <button class="action-secondary" type="button" @onclick="() => BeginQuoteWithdrawal(quote)">Withdraw</button> }
                            </td></tr>
                        }
                    </tbody>
                </table>
            </article>

            @if (QuoteConversionForm is not null)
            {
                <article class="panel"><h2>Convert @QuoteConversionForm.QuoteNumber</h2><p class="page-intro">Conversion creates a draft order from the approved quote without reserving inventory.</p><EditForm Model="QuoteConversionForm" OnValidSubmit="ConvertSalesQuoteAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Order number</label><InputText aria-label="Converted sales order number" class="field-input" @bind-Value="QuoteConversionForm.OrderNumber" /></div><div class="field-group"><label class="field-label">Order date</label><InputDate aria-label="Converted sales order date" class="field-input" @bind-Value="QuoteConversionForm.OrderedOn" /></div><div class="field-group"><label class="field-label">Requested ship date</label><InputDate aria-label="Converted sales order requested ship date" class="field-input" @bind-Value="QuoteConversionForm.RequestedShipOn" /></div><div class="field-group"><label class="field-label">Order notes</label><InputText aria-label="Converted sales order notes" class="field-input" @bind-Value="QuoteConversionForm.Notes" /></div><button class="action-primary" type="submit">Create draft order</button><button class="action-secondary" type="button" @onclick="CancelQuoteConversion">Cancel</button></div></EditForm></article>
            }
            @if (QuoteWithdrawalForm is not null)
            {
                <article class="panel"><h2>Withdraw @QuoteWithdrawalForm.QuoteNumber</h2><EditForm Model="QuoteWithdrawalForm" OnValidSubmit="WithdrawSalesQuoteAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Sales quote withdrawal reason" class="field-input" @bind-Value="QuoteWithdrawalForm.Reason" /></div><button class="action-primary" type="submit">Withdraw quote</button><button class="action-secondary" type="button" @onclick="CancelQuoteWithdrawal">Cancel</button></div></EditForm></article>
            }

            <article class="panel">
                <h2>Sales orders</h2>
                <table class="data-table" aria-label="Sales orders">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Ordered</th>
                            <th>Total</th>
                            <th>Progress</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Workspace.Operations.SalesOrders)
                        {
                            <tr>
                                <td>@order.OrderNumber</td>
                                <td>@order.CustomerName</td>
                                <td>@order.Status</td>
                                <td>@order.OrderedOn.ToString("MMM d, yyyy")</td>
                                <td>@order.TotalAmount.ToString("C")</td>
                                <td>@((order.Lines ?? []).Sum(line => line.AllocatedQuantity)) allocated / @((order.Lines ?? []).Sum(line => line.OrderedQuantity)) ordered<br />@((order.Lines ?? []).Sum(line => line.ShippedQuantity)) shipped; @((order.Lines ?? []).Sum(line => line.CancelledQuantity)) cancelled; @((order.Lines ?? []).Sum(line => line.InvoicedQuantity)) invoiced@if ((order.Lines ?? []).Any(line => line.AllocatedQuantity > 0m)) { <br /><span>@string.Join(", ", (order.Lines ?? []).Where(line => line.AllocatedQuantity > 0m).Select(line => $"{line.Sku}: {line.AllocationLocation}"))</span> }</td>
                                <td>
                                    @if (CanManageSales && order.Status == "Draft") { <button class="action-secondary" type="button" @onclick="() => ApproveSalesOrderAsync(order)">Approve</button> }
                                    @if (CanManageSales && order.SalesQuoteId is null && order.Status is ("Approved" or "Allocated") && (order.Lines ?? []).All(line => line.ShippedQuantity == 0m && line.InvoicedQuantity == 0m && line.ReturnedQuantity == 0m && line.CancelledQuantity == 0m)) { <button class="action-secondary" type="button" @onclick="() => BeginSalesOrderAmendment(order)">Amend</button> }
                                    @if (CanManageSales && order.Status is ("Draft" or "Approved" or "Allocated" or "PartiallyShipped") && (order.Lines ?? []).Any(line => line.OrderedQuantity > line.ShippedQuantity + line.CancelledQuantity)) { <button class="action-secondary" type="button" @onclick="() => BeginSalesOrderCancellation(order)">Cancel open quantity</button> }
                                    @if (CanManageSales && order.Status is ("Approved" or "Allocated" or "PartiallyShipped") && HasUnpromisedBackorderDemand(order)) { <button class="action-secondary" type="button" @onclick="() => BeginBackorderPromise(order)">Promise backorder</button> }
                                    @if (CanFulfillSales && order.Status is "Approved" or "Allocated" or "PartiallyShipped") { <button class="action-secondary" type="button" @onclick="() => BeginAllocation(order)">Allocate</button> }
                                    @if (CanFulfillSales && HasUncommittedPickAllocation(order)) { <button class="action-secondary" type="button" @onclick="() => BeginInventoryPick(order)">Create pick</button> }
                                    @if (CanFulfillSales && HasDirectShipmentQuantity(order)) { <button class="action-secondary" type="button" @onclick="() => BeginShipment(order)">Ship</button> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>
        </section>

        @if (CanManageSales && SalesOrderAmendmentForm is not null)
        {
            <section class="panel"><h2>Amend @SalesOrderAmendmentForm.OrderNumber</h2><p class="page-intro">A commercial amendment releases every reservation, retains before-and-after evidence, and returns the order to draft for fresh approval.</p><EditForm Model="SalesOrderAmendmentForm" OnValidSubmit="AmendSalesOrderAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Order date</label><InputDate aria-label="Amended sales order date" class="field-input" @bind-Value="SalesOrderAmendmentForm.OrderedOn" /></div><div class="field-group"><label class="field-label">Requested ship date</label><InputDate aria-label="Amended requested ship date" class="field-input" @bind-Value="SalesOrderAmendmentForm.RequestedShipOn" /></div><div class="field-group"><label class="field-label">Notes</label><InputText aria-label="Amended sales order notes" class="field-input" @bind-Value="SalesOrderAmendmentForm.Notes" /></div><div class="field-group"><label class="field-label">Amendment reason</label><InputText aria-label="Sales order amendment reason" class="field-input" @bind-Value="SalesOrderAmendmentForm.Reason" /></div>
                @for (var index = 0; index < SalesOrderAmendmentForm.Lines.Count; index++) { var lineIndex = index; var line = SalesOrderAmendmentForm.Lines[lineIndex]; <fieldset class="panel-subsection"><legend>Amended line @(lineIndex + 1)</legend><div class="field-group"><label class="field-label">Inventory item</label><InputSelect aria-label="@($"Amended sales order line {lineIndex + 1} item")" class="field-input" @bind-Value="line.InventoryItemId"><option value="@Guid.Empty">Select item</option>@foreach (var item in Workspace.Operations.InventoryItems) { <option value="@item.Id">@item.Sku — @item.Description</option> }</InputSelect></div><div class="field-group"><label class="field-label">Description</label><InputText aria-label="@($"Amended sales order line {lineIndex + 1} description")" class="field-input" @bind-Value="line.Description" /></div><div class="field-group"><label class="field-label">Quantity</label><InputNumber aria-label="@($"Amended sales order line {lineIndex + 1} quantity")" class="field-input" @bind-Value="line.Quantity" /></div><div class="field-group"><label class="field-label">Unit price</label><InputNumber aria-label="@($"Amended sales order line {lineIndex + 1} unit price")" class="field-input" @bind-Value="line.UnitPrice" /></div><div class="field-group"><label class="field-label">Discount</label><InputNumber aria-label="@($"Amended sales order line {lineIndex + 1} discount")" class="field-input" @bind-Value="line.DiscountAmount" /></div><div class="field-group"><label class="field-label">Tax</label><InputNumber aria-label="@($"Amended sales order line {lineIndex + 1} tax")" class="field-input" @bind-Value="line.TaxAmount" /></div><div class="field-group"><label class="field-label">Revenue account</label><InputSelect aria-label="@($"Amended sales order line {lineIndex + 1} revenue account")" class="field-input" @bind-Value="line.RevenueAccountNumber"><option value="">Select revenue account</option>@foreach (var account in Workspace.GeneralLedger.Accounts.Where(account => account.Type == "Revenue" && !account.IsControlAccount)) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></div>@if (SalesOrderAmendmentForm.Lines.Count > 1) { <button class="action-secondary" type="button" @onclick="() => RemoveAmendmentLine(lineIndex)">Remove line</button> }</fieldset> }
                <button class="action-secondary" type="button" @onclick="AddAmendmentLine">Add line</button><button class="action-primary" type="submit">Save amendment for reapproval</button><button class="action-secondary" type="button" @onclick="CancelSalesOrderAmendment">Discard</button>
            </div></EditForm></section>
        }
        @if (CanManageSales && SalesOrderCancellationForm is not null)
        {
            <section class="panel"><h2>Cancel open quantity on @SalesOrderCancellationForm.OrderNumber</h2><p class="page-intro">This releases reservations and closes every unshipped quantity. Posted shipments and invoices remain unchanged.</p><EditForm Model="SalesOrderCancellationForm" OnValidSubmit="CancelSalesOrderAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Sales order cancellation reason" class="field-input" @bind-Value="SalesOrderCancellationForm.Reason" /></div><button class="action-primary" type="submit">Confirm cancellation</button><button class="action-secondary" type="button" @onclick="DismissSalesOrderCancellation">Keep order open</button></div></EditForm></section>
        }

        @if (CanFulfillSales && AllocationForm is not null)
        {
            <section class="panel"><h2>Allocate @AllocationForm.SalesOrderNumber</h2><p class="page-intro">Enter the total quantity to reserve on each line. Zero releases an existing reservation; availability includes reservations on other orders.</p><EditForm Model="AllocationForm" OnValidSubmit="AllocateSalesOrderAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Warehouse/bin</label><InputSelect aria-label="Sales allocation bin" class="field-input" @bind-Value="AllocationForm.BinId"><option value="@Guid.Empty">Default location</option>@foreach (var warehouse in (Workspace.Operations.Warehouses ?? []).Where(item => item.IsActive)) { @foreach (var bin in warehouse.Bins.Where(item => item.IsActive)) { <option value="@bin.Id">@warehouse.Code/@bin.Code — @bin.Name</option> } }</InputSelect></div>
                @foreach (var line in AllocationForm.Lines) { <div class="field-group"><label class="field-label">@line.Sku — unshipped @line.UnshippedQuantity</label><InputNumber aria-label="@($"Allocate {line.Sku} quantity")" class="field-input" @bind-Value="line.Quantity" /></div> }
                <button class="action-primary" type="submit">Save allocation</button><button class="action-secondary" type="button" @onclick="CancelAllocation">Cancel</button>
            </div></EditForm></section>
        }

        @if (CanManageSales && SalesBackorderForm is not null)
        {
            <section class="panel"><h2>Promise backorder for @SalesBackorderForm.OrderNumber</h2><p class="page-intro">Promise only open demand that is not already allocated or covered by another outstanding promise.</p><EditForm Model="SalesBackorderForm" OnValidSubmit="PromiseBackorderAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Order line</label><InputSelect aria-label="Backorder sales order line" class="field-input" @bind-Value="SalesBackorderForm.SalesOrderLineId"><option value="@Guid.Empty">Select line</option>@foreach (var line in SalesBackorderForm.Lines) { <option value="@line.SalesOrderLineId">@line.Sku — available demand @line.AvailableDemand</option> }</InputSelect></div><div class="field-group"><label class="field-label">Quantity</label><InputNumber aria-label="Backorder promised quantity" class="field-input" @bind-Value="SalesBackorderForm.Quantity" /></div><div class="field-group"><label class="field-label">Promised ship date</label><InputDate aria-label="Backorder promised ship date" class="field-input" @bind-Value="SalesBackorderForm.PromisedShipOn" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Backorder promise reason" class="field-input" @bind-Value="SalesBackorderForm.Reason" /></div><button class="action-primary" type="submit">Save backorder promise</button><button class="action-secondary" type="button" @onclick="CancelBackorderPromise">Cancel</button></div></EditForm></section>
        }

        @if (CanFulfillSales && InventoryPickForm is not null)
        {
            <section class="panel"><h2>Create pick for @InventoryPickForm.OrderNumber</h2><EditForm Model="InventoryPickForm" OnValidSubmit="CreateInventoryPickAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Pick number</label><InputText aria-label="Inventory pick number" class="field-input" @bind-Value="InventoryPickForm.PickNumber" /></div><div class="field-group"><label class="field-label">Pick date</label><InputDate aria-label="Inventory pick date" class="field-input" @bind-Value="InventoryPickForm.PickDate" /></div>@foreach (var line in InventoryPickForm.Lines) { <div class="field-group"><label class="field-label">@line.Sku — allocated @line.AllocatedQuantity</label><InputNumber aria-label="@($"Pick {line.Sku} quantity")" class="field-input" @bind-Value="line.Quantity" /></div> }<button class="action-primary" type="submit">Create pick ticket</button><button class="action-secondary" type="button" @onclick="CancelInventoryPickCreation">Cancel</button></div></EditForm></section>
        }

        @if (CanFulfillSales && InventoryPickCompletionForm is not null)
        {
            <section class="panel"><h2>Complete pick @InventoryPickCompletionForm.PickNumber</h2><EditForm Model="InventoryPickCompletionForm" OnValidSubmit="CompleteInventoryPickAsync"><div class="auth-form">@foreach (var line in InventoryPickCompletionForm.Lines) { <div class="field-group"><label class="field-label">@line.Sku — requested @line.RequestedQuantity</label><InputNumber aria-label="@($"Picked {line.Sku} quantity")" class="field-input" @bind-Value="line.PickedQuantity" /></div> }<button class="action-primary" type="submit">Complete pick ticket</button><button class="action-secondary" type="button" @onclick="CancelInventoryPickCompletion">Cancel</button></div></EditForm></section>
        }

        @if (CanFulfillSales && InventoryPackForm is not null)
        {
            <section class="panel"><h2>Pack @InventoryPackForm.PickNumber</h2><EditForm Model="InventoryPackForm" OnValidSubmit="PackInventoryPickAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Packing-slip number</label><InputText aria-label="Inventory packing slip number" class="field-input" @bind-Value="InventoryPackForm.PackingSlipNumber" /></div><div class="field-group"><label class="field-label">Packed on</label><InputDate aria-label="Inventory packed date" class="field-input" @bind-Value="InventoryPackForm.PackedOn" /></div>@foreach (var line in InventoryPackForm.Lines) { <div class="field-group"><label class="field-label">@line.Sku — unpacked @line.AvailableQuantity</label><InputNumber aria-label="@($"Pack {line.Sku} quantity")" class="field-input" @bind-Value="line.Quantity" /></div> }<button class="action-primary" type="submit">Create packing slip</button><button class="action-secondary" type="button" @onclick="CancelInventoryPacking">Cancel</button></div></EditForm></section>
        }

        <section class="panel"><h2>Pick tickets and packing slips</h2><p class="page-intro">Pick tickets commit an exact bin. Packing slips can split a completed pick into multiple shipments, and each packed shipment must match its slip exactly.</p><table class="data-table" aria-label="Inventory picks"><thead><tr><th>Pick</th><th>Order</th><th>Location</th><th>Status</th><th>Progress</th><th>Action</th></tr></thead><tbody>@foreach (var pick in Workspace.Operations.InventoryPicks ?? []) { <tr><td>@pick.PickNumber</td><td>@pick.OrderNumber</td><td>@pick.Location</td><td>@pick.Status</td><td>@string.Join(", ", pick.Lines.Select(line => $"{line.Sku}: {line.PickedQuantity}/{line.RequestedQuantity} picked, {line.PackedQuantity} packed"))</td><td>@if (CanFulfillSales && pick.Status == "Draft") { <button class="action-secondary" type="button" @onclick="() => BeginInventoryPickCompletion(pick)">Complete pick</button> } @if (CanFulfillSales && pick.Status is "Picked" or "PartiallyPacked") { <button class="action-secondary" type="button" @onclick="() => BeginInventoryPacking(pick)">Pack</button> } @if (CanFulfillSales && pick.Status is "Draft" or "Picked") { <button class="action-secondary" type="button" @onclick="() => BeginPickCancellation(pick)">Cancel pick</button> }</td></tr> }</tbody></table>
            <table class="data-table" aria-label="Inventory packing slips"><thead><tr><th>Packing slip</th><th>Pick</th><th>Order</th><th>Date</th><th>Status</th><th>Contents</th><th>Action</th></tr></thead><tbody>@foreach (var pack in Workspace.Operations.InventoryPackingSlips ?? []) { <tr><td>@pack.PackingSlipNumber</td><td>@((Workspace.Operations.InventoryPicks ?? []).SingleOrDefault(pick => pick.Id == pack.InventoryPickId)?.PickNumber)</td><td>@pack.OrderNumber</td><td>@pack.PackedOn.ToString("MMM d, yyyy")</td><td>@pack.Status</td><td>@string.Join(", ", pack.Lines.Select(line => $"{line.Sku}: {line.Quantity}"))</td><td>@if (CanFulfillSales && pack.Status == "Packed") { <button class="action-secondary" type="button" @onclick="() => BeginPackedShipment(pack)">Ship packing slip</button> <button class="action-secondary" type="button" @onclick="() => BeginPackingSlipCancellation(pack)">Cancel packing slip</button> }</td></tr> }</tbody></table>
        </section>

        <section class="panel"><h2>Backorder promises</h2><table class="data-table" aria-label="Sales backorder promises"><thead><tr><th>Order</th><th>Item</th><th>Promised</th><th>Fulfilled</th><th>Ship by</th><th>Status</th><th>Reason</th><th>Action</th></tr></thead><tbody>@foreach (var backorder in Workspace.Operations.BackorderPromises ?? []) { <tr><td>@backorder.OrderNumber</td><td>@backorder.Sku</td><td>@backorder.PromisedQuantity</td><td>@backorder.FulfilledQuantity</td><td>@backorder.PromisedShipOn.ToString("MMM d, yyyy")</td><td>@backorder.Status</td><td>@backorder.Reason</td><td>@if (CanManageSales && backorder.Status is "Open" or "PartiallyFulfilled") { <button class="action-secondary" type="button" @onclick="() => BeginBackorderCancellation(backorder)">Cancel promise</button> }</td></tr> }</tbody></table></section>

        @if (FulfillmentCancellationForm is not null)
        {
            <section class="panel"><h2>Cancel @FulfillmentCancellationForm.DocumentLabel</h2><EditForm Model="FulfillmentCancellationForm" OnValidSubmit="CancelFulfillmentDocumentAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Fulfillment document cancellation reason" class="field-input" @bind-Value="FulfillmentCancellationForm.Reason" /></div><button class="action-primary" type="submit">Confirm document cancellation</button><button class="action-secondary" type="button" @onclick="DismissFulfillmentCancellation">Keep document</button></div></EditForm></section>
        }
        @if (BackorderCancellationForm is not null)
        {
            <section class="panel"><h2>Cancel backorder promise for @BackorderCancellationForm.OrderNumber</h2><EditForm Model="BackorderCancellationForm" OnValidSubmit="CancelBackorderAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Backorder cancellation reason" class="field-input" @bind-Value="BackorderCancellationForm.Reason" /></div><button class="action-primary" type="submit">Confirm backorder cancellation</button><button class="action-secondary" type="button" @onclick="DismissBackorderCancellation">Keep promise</button></div></EditForm></section>
        }

        @if (CanFulfillSales && ShipmentForm is not null)
        {
            <section class="panel"><h2>Ship @ShipmentForm.SalesOrderNumber</h2><p class="page-intro">Only reserved quantities can ship. Posting relieves on-hand inventory and debits cost of goods sold at current average cost.</p><EditForm Model="ShipmentForm" OnValidSubmit="PostShipmentAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Shipment number</label><InputText aria-label="Inventory shipment number" class="field-input" @bind-Value="ShipmentForm.ShipmentNumber" /></div>
                <div class="field-group"><label class="field-label">Shipment date</label><InputDate aria-label="Inventory shipment date" class="field-input" @bind-Value="ShipmentForm.ShippedOn" /></div>
                @foreach (var line in ShipmentForm.Lines) { <div class="field-group"><label class="field-label">@line.Sku — allocated @line.AllocatedQuantity</label><InputNumber aria-label="@($"Ship {line.Sku} quantity")" class="field-input" @bind-Value="line.Quantity" /></div> }
                <button class="action-primary" type="submit">Post shipment</button><button class="action-secondary" type="button" @onclick="CancelShipment">Cancel</button>
            </div></EditForm></section>
        }

        <section class="panel"><h2>Customer shipments and invoicing</h2><p class="page-intro">Warehouse posting relieves inventory and COGS. Receivables then creates one invoice from the exact shipped quantities; void that invoice before reversing a shipment.</p>
            <table class="data-table" aria-label="Customer shipments"><thead><tr><th>Shipment</th><th>Sales order</th><th>Location</th><th>Date</th><th>Status</th><th>Cost</th><th>Invoice</th><th>Action</th></tr></thead><tbody>
                @foreach (var shipment in Workspace.Operations.InventoryShipments ?? [])
                {
                    <tr><td>@shipment.ShipmentNumber</td><td>@shipment.SalesOrderNumber</td><td>@shipment.Location</td><td>@shipment.ShippedOn.ToString("MMM d, yyyy")</td><td>@shipment.Status</td><td>@shipment.TotalCost.ToString("C")</td><td>@(shipment.SalesInvoiceId.HasValue ? "Invoiced" : "Uninvoiced")</td><td>
                        @if (CanInvoiceShipments && shipment.Status == "Posted" && !shipment.SalesInvoiceId.HasValue) { <button class="action-secondary" type="button" @onclick="() => BeginShipmentInvoice(shipment)">Create invoice</button> }
                        @if (CanManageSales && shipment.Status == "Posted" && shipment.Lines.Any(line => ReturnableQuantity(line.Id, line.Quantity) > 0m)) { <button class="action-secondary" type="button" @onclick="() => BeginCustomerReturn(shipment)">Authorize return</button> }
                        @if (CanFulfillSales && shipment.Status == "Posted" && !shipment.SalesInvoiceId.HasValue) { <button class="action-secondary" type="button" @onclick="() => BeginShipmentReversal(shipment)">Reverse shipment</button> }
                    </td></tr>
                }
            </tbody></table>
        </section>

        @if (CanInvoiceShipments && ShipmentInvoiceForm is not null)
        {
            <section class="panel"><h2>Invoice shipment @ShipmentInvoiceForm.ShipmentNumber</h2><EditForm Model="ShipmentInvoiceForm" OnValidSubmit="InvoiceShipmentAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Invoice number</label><InputText aria-label="Shipment invoice number" class="field-input" @bind-Value="ShipmentInvoiceForm.InvoiceNumber" /></div>
                <div class="field-group"><label class="field-label">Invoice date</label><InputDate aria-label="Shipment invoice date" class="field-input" @bind-Value="ShipmentInvoiceForm.InvoiceDate" /></div>
                <div class="field-group"><label class="field-label">Due date</label><InputDate aria-label="Shipment invoice due date" class="field-input" @bind-Value="ShipmentInvoiceForm.DueDate" /></div>
                <div class="field-group"><label class="field-label">Description</label><InputText aria-label="Shipment invoice description" class="field-input" @bind-Value="ShipmentInvoiceForm.Description" /></div>
                <button class="action-primary" type="submit">Post shipment invoice</button><button class="action-secondary" type="button" @onclick="CancelShipmentInvoice">Cancel</button>
            </div></EditForm></section>
        }

        @if (CanFulfillSales && ShipmentReversalForm is not null)
        {
            <section class="panel"><h2>Reverse shipment @ShipmentReversalForm.ShipmentNumber</h2><p class="page-intro">This preserves the original shipment and creates a dated reversing journal. Later valuation activity requires a compensating return or adjustment instead.</p><EditForm Model="ShipmentReversalForm" OnValidSubmit="ReverseShipmentAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Shipment reversal date" class="field-input" @bind-Value="ShipmentReversalForm.ReversalDate" /></div>
                <div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Shipment reversal reason" class="field-input" @bind-Value="ShipmentReversalForm.Reason" /></div>
                <button class="action-primary" type="submit">Confirm shipment reversal</button><button class="action-secondary" type="button" @onclick="CancelShipmentReversal">Cancel</button>
            </div></EditForm></section>
        }

        @if (CanManageSales && CustomerReturnForm is not null)
        {
            <section class="panel"><h2>Authorize return for @CustomerReturnForm.ShipmentNumber</h2><p class="page-intro">Authorization reserves exact shipped quantities. It does not move inventory or create a customer credit.</p><EditForm Model="CustomerReturnForm" OnValidSubmit="AuthorizeCustomerReturnAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Return authorization number</label><InputText aria-label="Customer return authorization number" class="field-input" @bind-Value="CustomerReturnForm.ReturnNumber" /></div><div class="field-group"><label class="field-label">Authorization date</label><InputDate aria-label="Customer return authorization date" class="field-input" @bind-Value="CustomerReturnForm.AuthorizedOn" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Customer return authorization reason" class="field-input" @bind-Value="CustomerReturnForm.Reason" /></div>
                @foreach (var line in CustomerReturnForm.Lines) { <div class="field-group"><label class="field-label">@line.Sku — available @line.AvailableQuantity</label><InputNumber aria-label="@($"Return {line.Sku} quantity")" class="field-input" @bind-Value="line.Quantity" /></div> }
                <button class="action-primary" type="submit">Authorize customer return</button><button class="action-secondary" type="button" @onclick="CancelCustomerReturnAuthorization">Cancel</button>
            </div></EditForm></section>
        }

        @if (CanFulfillSales && CustomerReturnReceiptForm is not null)
        {
            <section class="panel"><h2>Receive @CustomerReturnReceiptForm.ReturnNumber</h2><p class="page-intro">Post only goods physically inspected at the selected location. Inventory returns at the immutable cost from the original shipment.</p><EditForm Model="CustomerReturnReceiptForm" OnValidSubmit="ReceiveCustomerReturnAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Receipt number</label><InputText aria-label="Customer return receipt number" class="field-input" @bind-Value="CustomerReturnReceiptForm.ReceiptNumber" /></div><div class="field-group"><label class="field-label">Received on</label><InputDate aria-label="Customer return receipt date" class="field-input" @bind-Value="CustomerReturnReceiptForm.ReceivedOn" /></div><div class="field-group"><label class="field-label">Warehouse/bin</label><InputSelect aria-label="Customer return receipt bin" class="field-input" @bind-Value="CustomerReturnReceiptForm.BinId"><option value="@Guid.Empty">Default location</option>@foreach (var warehouse in (Workspace.Operations.Warehouses ?? []).Where(item => item.IsActive)) { @foreach (var bin in warehouse.Bins.Where(item => item.IsActive)) { <option value="@bin.Id">@warehouse.Code/@bin.Code — @bin.Name</option> } }</InputSelect></div>
                @foreach (var line in CustomerReturnReceiptForm.Lines) { <div class="field-group"><label class="field-label">@line.Sku — authorized remaining @line.RemainingQuantity</label><InputNumber aria-label="@($"Receive returned {line.Sku} quantity")" class="field-input" @bind-Value="line.Quantity" /></div> }
                <button class="action-primary" type="submit">Post physical return receipt</button><button class="action-secondary" type="button" @onclick="CancelCustomerReturnReceipt">Cancel</button>
            </div></EditForm></section>
        }

        <section class="panel"><h2>Customer return authorizations</h2><p class="page-intro">Sales authorizes; fulfillment receives; receivables credits. Each step retains its own date, actor, quantities, and reversal controls.</p><table class="data-table" aria-label="Customer return authorizations"><thead><tr><th>Return</th><th>Shipment</th><th>Customer</th><th>Date</th><th>Status</th><th>Progress</th><th>Action</th></tr></thead><tbody>@foreach (var item in Workspace.Operations.CustomerReturnAuthorizations ?? []) { <tr><td>@item.ReturnNumber</td><td>@item.ShipmentNumber</td><td>@item.CustomerName</td><td>@item.AuthorizedOn.ToString("MMM d, yyyy")</td><td>@item.Status</td><td>@string.Join(", ", item.Lines.Select(line => $"{line.Sku}: {line.ReceivedQuantity}/{line.AuthorizedQuantity}"))</td><td>@if (CanFulfillSales && item.Status is "Open" or "PartiallyReceived" && item.Lines.Any(line => line.ReceivedQuantity < line.AuthorizedQuantity)) { <button class="action-secondary" type="button" @onclick="() => BeginCustomerReturnReceipt(item)">Receive</button> } @if (CanManageSales && item.Status is "Open" or "PartiallyReceived" && !(Workspace.Operations.CustomerReturnReceipts ?? []).Any(receipt => receipt.CustomerReturnAuthorizationId == item.Id && receipt.Status == "Posted")) { <button class="action-secondary" type="button" @onclick="() => BeginCustomerReturnCancellation(item)">Cancel authorization</button> }</td></tr> }</tbody></table></section>

        @if (CustomerReturnCancellationForm is not null)
        {
            <section class="panel"><h2>Cancel return @CustomerReturnCancellationForm.ReturnNumber</h2><EditForm Model="CustomerReturnCancellationForm" OnValidSubmit="CancelCustomerReturnAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Customer return cancellation reason" class="field-input" @bind-Value="CustomerReturnCancellationForm.Reason" /></div><button class="action-primary" type="submit">Confirm return cancellation</button><button class="action-secondary" type="button" @onclick="DismissCustomerReturnCancellation">Keep authorization</button></div></EditForm></section>
        }

        @if (CanInvoiceShipments && CustomerReturnCreditForm is not null)
        {
            <section class="panel"><h2>Credit return receipt @CustomerReturnCreditForm.ReceiptNumber</h2><p class="page-intro">Amounts are calculated from the original invoice line, including discount and tax. Any amount beyond the original invoice balance remains available for another invoice or a refund.</p><EditForm Model="CustomerReturnCreditForm" OnValidSubmit="CreditCustomerReturnAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Credit number</label><InputText aria-label="Customer return credit number" class="field-input" @bind-Value="CustomerReturnCreditForm.CreditNumber" /></div><div class="field-group"><label class="field-label">Credit date</label><InputDate aria-label="Customer return credit date" class="field-input" @bind-Value="CustomerReturnCreditForm.CreditDate" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Customer return credit reason" class="field-input" @bind-Value="CustomerReturnCreditForm.Reason" /></div><button class="action-primary" type="submit">Post return credit</button><button class="action-secondary" type="button" @onclick="CancelCustomerReturnCredit">Cancel</button></div></EditForm></section>
        }

        @if (CanInvoiceShipments && CustomerReturnCreditSettlementForm is not null)
        {
            <section class="panel"><h2>Settle available credit @CustomerReturnCreditSettlementForm.CreditNumber</h2><EditForm Model="CustomerReturnCreditSettlementForm" OnValidSubmit="SettleCustomerReturnCreditAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Method</label><InputSelect aria-label="Customer return credit settlement method" class="field-input" @bind-Value="CustomerReturnCreditSettlementForm.Method"><option value="Apply">Apply to invoice</option><option value="Refund">Refund from bank</option></InputSelect></div>@if (CustomerReturnCreditSettlementForm.Method == "Apply") { <div class="field-group"><label class="field-label">Customer invoice</label><InputSelect aria-label="Customer return credit target invoice" class="field-input" @bind-Value="CustomerReturnCreditSettlementForm.InvoiceId"><option value="@Guid.Empty">Select open invoice</option>@foreach (var invoice in Workspace.Receivables.Invoices.Where(invoice => invoice.CustomerId == CustomerReturnCreditSettlementForm.CustomerId && invoice.BalanceDue > 0m && invoice.Status != "Voided")) { <option value="@invoice.Id">@invoice.InvoiceNumber — @invoice.BalanceDue.ToString("C") due</option> }</InputSelect></div> } else { <div class="field-group"><label class="field-label">Bank account</label><InputSelect aria-label="Customer return credit refund bank" class="field-input" @bind-Value="CustomerReturnCreditSettlementForm.BankAccountId"><option value="@Guid.Empty">Select bank account</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div><div class="field-group"><label class="field-label">Refund reference</label><InputText aria-label="Customer return credit refund reference" class="field-input" @bind-Value="CustomerReturnCreditSettlementForm.Reference" /></div> }<div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Customer return credit settlement date" class="field-input" @bind-Value="CustomerReturnCreditSettlementForm.SettledOn" /></div><div class="field-group"><label class="field-label">Amount (available @CustomerReturnCreditSettlementForm.AvailableAmount.ToString("C"))</label><InputNumber aria-label="Customer return credit settlement amount" class="field-input" @bind-Value="CustomerReturnCreditSettlementForm.Amount" /></div><button class="action-primary" type="submit">Post credit settlement</button><button class="action-secondary" type="button" @onclick="CancelCustomerReturnCreditSettlement">Cancel</button></div></EditForm></section>
        }

        @if (ReturnReversalForm is not null)
        {
            <section class="panel"><h2>Reverse @ReturnReversalForm.DocumentLabel</h2><EditForm Model="ReturnReversalForm" OnValidSubmit="ReverseReturnDocumentAsync"><div class="auth-form">@if (ReturnReversalForm.NeedsDate) { <div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Customer return reversal date" class="field-input" @bind-Value="ReturnReversalForm.ReversalDate" /></div> }<div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Customer return reversal reason" class="field-input" @bind-Value="ReturnReversalForm.Reason" /></div><button class="action-primary" type="submit">Confirm reversal</button><button class="action-secondary" type="button" @onclick="CancelReturnReversal">Cancel</button></div></EditForm></section>
        }

        <section class="panel"><h2>Return receipts and credits</h2><table class="data-table" aria-label="Customer return receipts"><thead><tr><th>Receipt</th><th>Return</th><th>Location</th><th>Status</th><th>Cost</th><th>Action</th></tr></thead><tbody>@foreach (var receipt in Workspace.Operations.CustomerReturnReceipts ?? []) { var activeCredit = (Workspace.Operations.CustomerReturnCredits ?? []).SingleOrDefault(credit => credit.CustomerReturnReceiptId == receipt.Id && credit.Status == "Posted"); <tr><td>@receipt.ReceiptNumber</td><td>@receipt.ReturnNumber</td><td>@receipt.Location</td><td>@receipt.Status</td><td>@receipt.TotalCost.ToString("C")</td><td>@if (CanInvoiceShipments && receipt.Status == "Posted" && activeCredit is null) { <button class="action-secondary" type="button" @onclick="() => BeginCustomerReturnCredit(receipt)">Create credit</button> } @if (CanReverseTransactions && CanFulfillSales && receipt.Status == "Posted" && activeCredit is null) { <button class="action-secondary" type="button" @onclick="() => BeginReturnReceiptReversal(receipt)">Reverse receipt</button> }</td></tr> }</tbody></table>
            <table class="data-table" aria-label="Customer return credits"><thead><tr><th>Credit</th><th>Customer</th><th>Original invoice</th><th>Total</th><th>Applied</th><th>Refunded</th><th>Available</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach (var credit in Workspace.Operations.CustomerReturnCredits ?? []) { <tr><td>@credit.CreditNumber</td><td>@credit.CustomerName</td><td>@credit.InvoiceNumber</td><td>@credit.TotalAmount.ToString("C")</td><td>@credit.AppliedAmount.ToString("C")</td><td>@credit.RefundedAmount.ToString("C")</td><td>@credit.AvailableAmount.ToString("C")</td><td>@credit.Status</td><td>@if (CanInvoiceShipments && credit.Status == "Posted" && credit.AvailableAmount > 0m) { <button class="action-secondary" type="button" @onclick="() => BeginCustomerReturnCreditSettlement(credit)">Apply or refund</button> } @if (CanReverseTransactions && credit.Status == "Posted" && credit.AppliedAmount == credit.SourceAppliedAmount && credit.RefundedAmount == 0m) { <button class="action-secondary" type="button" @onclick="() => BeginReturnCreditReversal(credit)">Reverse credit</button> } @foreach (var application in credit.Applications.Where(item => item.Status == "Posted")) { <button class="action-secondary" type="button" @onclick="() => BeginReturnApplicationReversal(application, credit.CreditNumber)">Reverse @application.InvoiceNumber application</button> } @foreach (var refund in credit.Refunds.Where(item => item.Status == "Posted")) { <button class="action-secondary" type="button" @onclick="() => BeginReturnRefundReversal(refund, credit.CreditNumber)">Reverse refund @refund.Reference</button> }</td></tr> }</tbody></table>
        </section>

        <section class="panel">
            <h2>Purchase requisitions</h2>
            <p class="page-intro">Drafts remain editable until submission. Purchasing records the decision and converts approved quantities and estimated costs exactly once into a traceable purchase-order draft.</p>
            <div class="table-scroll"><table class="data-table" aria-label="Purchase requisitions"><thead><tr><th>Requisition</th><th>Requested</th><th>Vendor</th><th>Purpose</th><th>Estimate</th><th>Status</th><th>Result</th><th>Action</th></tr></thead><tbody>
                @foreach (var requisition in Workspace.Operations.PurchaseRequisitions ?? [])
                {
                    <tr><td>@requisition.RequisitionNumber</td><td>@requisition.RequestedOn @if (requisition.NeededBy.HasValue) { <span>needed @requisition.NeededBy</span> }</td><td>@requisition.RequestedVendorName</td><td>@requisition.Purpose</td><td>@requisition.TotalEstimatedAmount.ToString("C")</td><td>@requisition.Status @if (!string.IsNullOrWhiteSpace(requisition.DecisionReason)) { <span>— @requisition.DecisionReason</span> } @if (!string.IsNullOrWhiteSpace(requisition.CancellationReason)) { <span>— @requisition.CancellationReason</span> }</td><td>@(requisition.PurchaseOrderId.HasValue ? requisition.PurchaseOrderNumber : "—")</td><td>
                        @if (CanManageRequisitions && requisition.Status == "Draft") { <button class="action-secondary" type="button" @onclick="() => EditPurchaseRequisition(requisition)">Edit</button> <button class="action-secondary" type="button" @onclick="() => SubmitPurchaseRequisitionAsync(requisition)">Submit</button> }
                        @if (CanManagePurchasing && requisition.Status == "Submitted") { <button class="action-secondary" type="button" @onclick="() => ApprovePurchaseRequisitionAsync(requisition)">Approve</button> <button class="action-secondary" type="button" @onclick="() => BeginPurchaseRequisitionDecision(requisition, false)">Reject</button> }
                        @if (CanManagePurchasing && requisition.Status == "Approved") { <button class="action-secondary" type="button" @onclick="() => BeginPurchaseRequisitionConversion(requisition)">Create purchase order</button> }
                        @if ((CanManageRequisitions && requisition.Status is "Draft" or "Submitted") || (CanManagePurchasing && requisition.Status == "Approved")) { <button class="action-secondary" type="button" @onclick="() => BeginPurchaseRequisitionDecision(requisition, true)">Cancel</button> }
                    </td></tr>
                }
            </tbody></table></div>
        </section>

        @if (PurchaseRequisitionDecisionForm is not null)
        {
            <section class="panel"><h2>@(PurchaseRequisitionDecisionForm.Cancel ? "Cancel" : "Reject") @PurchaseRequisitionDecisionForm.RequisitionNumber</h2><EditForm Model="PurchaseRequisitionDecisionForm" OnValidSubmit="CompletePurchaseRequisitionDecisionAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Purchase requisition decision reason" class="field-input" @bind-Value="PurchaseRequisitionDecisionForm.Reason" /></div><button class="action-primary" type="submit">Confirm</button><button class="action-secondary" type="button" @onclick="DismissPurchaseRequisitionDecision">Keep requisition</button></div></EditForm></section>
        }

        @if (CanManagePurchasing && PurchaseRequisitionConversionForm is not null)
        {
            <section class="panel"><h2>Create purchase order from @PurchaseRequisitionConversionForm.RequisitionNumber</h2><EditForm Model="PurchaseRequisitionConversionForm" OnValidSubmit="ConvertPurchaseRequisitionAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Vendor</label><InputSelect aria-label="Converted purchase order vendor" class="field-input" @bind-Value="PurchaseRequisitionConversionForm.VendorId"><option value="@Guid.Empty">Select vendor</option>@foreach (var vendor in Workspace.Payables.Vendors) { <option value="@vendor.Id">@vendor.VendorNumber — @vendor.Name</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label">Order number</label><InputText aria-label="Converted purchase order number" class="field-input" @bind-Value="PurchaseRequisitionConversionForm.OrderNumber" /></div>
                <div class="field-group"><label class="field-label">Order date</label><InputDate aria-label="Converted purchase order date" class="field-input" @bind-Value="PurchaseRequisitionConversionForm.OrderedOn" /></div>
                <div class="field-group"><label class="field-label">Expected date</label><InputDate aria-label="Converted purchase order expected date" class="field-input" @bind-Value="PurchaseRequisitionConversionForm.ExpectedOn" /></div>
                <div class="field-group"><label class="field-label">Order notes</label><InputText aria-label="Converted purchase order notes" class="field-input" @bind-Value="PurchaseRequisitionConversionForm.Notes" /></div>
                <button class="action-primary" type="submit">Create reviewable purchase-order draft</button><button class="action-secondary" type="button" @onclick="CancelPurchaseRequisitionConversion">Cancel</button>
            </div></EditForm></section>
        }

        <section class="panel">
            <h2>Purchase orders</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Vendor</th>
                        <th>Status</th>
                        <th>Ordered</th>
                        <th>Total</th>
                        <th>Progress</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Workspace.Operations.PurchaseOrders)
                    {
                        <tr>
                            <td>@order.OrderNumber</td>
                            <td>@order.VendorName</td>
                            <td>@order.Status</td>
                            <td>@order.OrderedOn.ToString("MMM d, yyyy")</td>
                            <td>@order.TotalAmount.ToString("C")</td>
                            <td>@((order.Lines ?? []).Sum(line => line.ReceivedQuantity)) / @((order.Lines ?? []).Sum(line => line.OrderedQuantity)) received<br />@((order.Lines ?? []).Sum(line => line.InvoicedQuantity)) invoiced</td>
                            <td>
                                @if (CanManagePurchasing && order.Status == "Draft") { <button class="action-secondary" type="button" @onclick="() => ApprovePurchaseOrderAsync(order)">Approve</button> }
                                @if (CanManagePurchasing && order.Status is "Approved" or "PartiallyReceived") { <button class="action-secondary" type="button" @onclick="() => BeginReceipt(order)">Receive</button> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        @if (CanManagePurchasing && ReceiptForm is not null)
        {
            <section class="panel">
                <h2>Receive @ReceiptForm.PurchaseOrderNumber</h2>
                <EditForm Model="ReceiptForm" OnValidSubmit="PostReceiptAsync"><div class="auth-form">
                    <div class="field-group"><label class="field-label">Receipt number</label><InputText aria-label="Inventory receipt number" class="field-input" @bind-Value="ReceiptForm.ReceiptNumber" /></div>
                    <div class="field-group"><label class="field-label">Received date</label><InputDate aria-label="Inventory receipt date" class="field-input" @bind-Value="ReceiptForm.ReceivedOn" /></div>
                    <div class="field-group"><label class="field-label">Warehouse/bin</label><InputSelect aria-label="Inventory receipt bin" class="field-input" @bind-Value="ReceiptForm.BinId"><option value="@Guid.Empty">Default location</option>@foreach (var warehouse in (Workspace.Operations.Warehouses ?? []).Where(item => item.IsActive)) { @foreach (var bin in warehouse.Bins.Where(item => item.IsActive)) { <option value="@bin.Id">@warehouse.Code/@bin.Code — @bin.Name</option> } }</InputSelect></div>
                    @foreach (var line in ReceiptForm.Lines) { <div class="field-group"><label class="field-label">@line.Sku remaining @line.RemainingQuantity</label><InputNumber aria-label="@($"Receive {line.Sku} quantity")" class="field-input" @bind-Value="line.Quantity" /></div> }
                    <button class="action-primary" type="submit">Post inventory receipt</button><button class="action-secondary" type="button" @onclick="CancelReceipt">Cancel</button>
                </div></EditForm>
            </section>
        }

        <section class="panel">
            <h2>Inventory receipts and invoice matching</h2>
            <p class="page-intro">Payables may enter partial supplier invoices and the supplier's actual quantities and prices. The system clears only received quantities from GRNI and identifies price and quantity variances for Purchasing review before posting.</p>
            <table class="data-table" aria-label="Inventory receipts"><thead><tr><th>Receipt</th><th>Purchase order</th><th>Location</th><th>Date</th><th>Status</th><th>Total</th><th>Invoice</th><th>Action</th></tr></thead><tbody>
                @foreach (var receipt in Workspace.Operations.InventoryReceipts ?? [])
                {
                    <tr><td>@receipt.ReceiptNumber</td><td>@receipt.PurchaseOrderNumber</td><td>@receipt.Location</td><td>@receipt.ReceivedOn.ToString("MMM d, yyyy")</td><td>@receipt.Status</td><td>@receipt.TotalAmount.ToString("C")</td><td>@if ((receipt.VendorBills ?? []).Count == 0) { <span>No linked bills</span> } else { @foreach (var bill in receipt.VendorBills ?? []) { <div>@bill.BillNumber — @bill.TotalAmount.ToString("C") (@bill.Status)</div> } }</td><td>
                        @if (CanManagePurchasing && receipt.Status == "Posted" && AvailableSupplierReturnLines(receipt).Count > 0) { <button class="action-secondary" type="button" @onclick="() => BeginSupplierReturn(receipt)">Return to supplier</button> }
                        @if (CanManagePayables && receipt.Status == "Posted") { <button class="action-secondary" type="button" @onclick="() => BeginLandedCost(receipt)">Allocate landed cost</button> }
                        @if (CanManagePayables && CanPreparePurchaseInvoice(receipt)) { <button class="action-secondary" type="button" @onclick="() => BeginBillMatch(receipt)">Prepare supplier invoice</button> }
                        @if (CanManagePurchasing && CanReversePurchaseReceipt(receipt)) { <button class="action-secondary" type="button" @onclick="() => BeginCorrection(receipt, false)">Reverse receipt</button> }
                        @if (CanMatchReceiptBills && IsLegacyMatchedReceipt(receipt)) { <button class="action-secondary" type="button" @onclick="() => BeginCorrection(receipt, true)">Void legacy matched bill</button> }
                    </td></tr>
                }
            </tbody></table>
        </section>

        @if (CanManagePayables && LandedCostForm is not null)
        {
            <section class="panel"><h2>@(LandedCostForm.Id.HasValue ? "Edit" : "Prepare") landed cost for receipt @LandedCostForm.ReceiptNumber</h2><p class="page-intro">Payables records the supplier charges and allocation basis. Purchasing must approve the draft before Payables can capitalize it into inventory and post the vendor bill.</p><EditForm Model="LandedCostForm" OnValidSubmit="SaveLandedCostAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Landed-cost vendor</label><InputSelect aria-label="Landed cost vendor" class="field-input" @bind-Value="LandedCostForm.VendorId"><option value="@Guid.Empty">Select vendor</option>@foreach (var vendor in Workspace.Payables.Vendors) { <option value="@vendor.Id">@vendor.VendorNumber — @vendor.Name</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label">Allocation number</label><InputText aria-label="Landed cost allocation number" class="field-input" @bind-Value="LandedCostForm.AllocationNumber" /></div>
                <div class="field-group"><label class="field-label">Vendor bill number</label><InputText aria-label="Landed cost bill number" class="field-input" @bind-Value="LandedCostForm.BillNumber" /></div>
                <div class="field-group"><label class="field-label">Bill date</label><InputDate aria-label="Landed cost bill date" class="field-input" @bind-Value="LandedCostForm.BillDate" /></div>
                <div class="field-group"><label class="field-label">Due date</label><InputDate aria-label="Landed cost due date" class="field-input" @bind-Value="LandedCostForm.DueDate" /></div>
                <div class="field-group"><label class="field-label">Allocation method</label><InputSelect aria-label="Landed cost allocation method" class="field-input" @bind-Value="LandedCostForm.AllocationMethod"><option value="ReceiptValue">Receipt value</option><option value="Quantity">Quantity</option><option value="Manual">Manual</option></InputSelect></div>
                <div class="field-group"><label class="field-label">Description</label><InputText aria-label="Landed cost description" class="field-input" @bind-Value="LandedCostForm.Description" /></div>
                @for (var index = 0; index < LandedCostForm.Charges.Count; index++)
                {
                    var chargeIndex = index; var charge = LandedCostForm.Charges[chargeIndex];
                    <fieldset class="field-group"><legend>Charge @(chargeIndex + 1)</legend><label class="field-label">Type</label><InputSelect aria-label="@($"Landed cost charge {chargeIndex + 1} type")" class="field-input" @bind-Value="charge.ChargeType">@foreach (var type in LandedCostChargeTypes) { <option value="@type">@type</option> }</InputSelect><label class="field-label">Description</label><InputText aria-label="@($"Landed cost charge {chargeIndex + 1} description")" class="field-input" @bind-Value="charge.Description" /><label class="field-label">Amount</label><InputNumber aria-label="@($"Landed cost charge {chargeIndex + 1} amount")" class="field-input" @bind-Value="charge.Amount" />@if (LandedCostForm.Charges.Count > 1) { <button class="action-secondary" type="button" @onclick="() => RemoveLandedCostCharge(chargeIndex)">Remove charge</button> }</fieldset>
                }
                <button class="action-secondary" type="button" @onclick="AddLandedCostCharge">Add charge</button>
                @if (LandedCostForm.AllocationMethod == "Manual")
                {
                    <p class="page-intro">Manual line amounts must include every retained receipt line and equal the total charges exactly.</p>
                    @foreach (var line in LandedCostForm.Lines) { <div class="field-group"><label class="field-label">@line.Sku allocation</label><InputNumber aria-label="@($"Landed cost {line.Sku} allocation")" class="field-input" @bind-Value="line.AllocatedAmount" /></div> }
                }
                <button class="action-primary" type="submit">Save landed-cost draft</button><button class="action-secondary" type="button" @onclick="CancelLandedCostEdit">Cancel</button>
            </div></EditForm></section>
        }

        @if (LandedCostDecisionForm is not null)
        {
            <section class="panel"><h2>@LandedCostDecisionForm.Title</h2><EditForm Model="LandedCostDecisionForm" OnValidSubmit="CompleteLandedCostDecisionAsync"><div class="auth-form">@if (LandedCostDecisionForm.NeedsDate) { <div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Landed cost reversal date" class="field-input" @bind-Value="LandedCostDecisionForm.ActionDate" /></div> }<div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Landed cost action reason" class="field-input" @bind-Value="LandedCostDecisionForm.Reason" /></div><button class="action-primary" type="submit">Confirm</button><button class="action-secondary" type="button" @onclick="CancelLandedCostDecision">Cancel</button></div></EditForm></section>
        }

        <section class="panel"><h2>Landed-cost allocations</h2><p class="page-intro">Freight and import charges remain tied to their source receipt, approval, vendor bill, journal, and inventory valuation. Reversals preserve the original history.</p><div class="table-scroll"><table class="data-table" aria-label="Landed cost allocations"><thead><tr><th>Allocation</th><th>Receipt</th><th>Vendor bill</th><th>Method</th><th>Total</th><th>Status</th><th>Review</th><th>Action</th></tr></thead><tbody>
            @foreach (var allocation in Workspace.Operations.LandedCostAllocations ?? [])
            {
                <tr><td>@allocation.AllocationNumber</td><td>@allocation.ReceiptNumber</td><td>@allocation.VendorName — @allocation.BillNumber</td><td>@allocation.AllocationMethod</td><td>@allocation.TotalAmount.ToString("C")</td><td>@allocation.Status</td><td>@allocation.DecisionReason @allocation.CancellationReason</td><td>
                    @if (CanManagePayables && allocation.Status is "Draft" or "Rejected") { <button class="action-secondary" type="button" @onclick="() => EditLandedCost(allocation)">Edit</button> }
                    @if (CanManagePayables && allocation.Status == "Draft") { <button class="action-secondary" type="button" @onclick="() => SubmitLandedCostAsync(allocation)">Submit</button> }
                    @if (CanManagePurchasing && allocation.Status == "Submitted") { <button class="action-secondary" type="button" @onclick='() => BeginLandedCostDecision(allocation, "Approve")'>Approve</button><button class="action-secondary" type="button" @onclick='() => BeginLandedCostDecision(allocation, "Reject")'>Reject</button> }
                    @if (CanManagePayables && allocation.Status == "Approved") { <button class="action-primary" type="button" @onclick="() => PostLandedCostAsync(allocation)">Post allocation</button> }
                    @if (CanManagePayables && allocation.Status is "Draft" or "Submitted" or "Approved" or "Rejected") { <button class="action-secondary" type="button" @onclick='() => BeginLandedCostDecision(allocation, "Cancel")'>Cancel</button> }
                    @if (CanManagePurchasing && CanReverseTransactions && allocation.Status == "Posted") { <button class="action-secondary" type="button" @onclick='() => BeginLandedCostDecision(allocation, "Reverse")'>Reverse</button> }
                </td></tr>
            }
        </tbody></table></div></section>

        @if (CanManagePurchasing && SupplierReturnAuthorizationForm is not null)
        {
            <section class="panel"><h2>Authorize return from receipt @SupplierReturnAuthorizationForm.ReceiptNumber</h2><p class="page-intro">Authorization reserves received quantities without moving stock. Enter only the quantities the vendor has agreed to accept.</p><EditForm Model="SupplierReturnAuthorizationForm" OnValidSubmit="AuthorizeSupplierReturnAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Return authorization number</label><InputText aria-label="Supplier return authorization number" class="field-input" @bind-Value="SupplierReturnAuthorizationForm.ReturnNumber" /></div>
                <div class="field-group"><label class="field-label">Authorization date</label><InputDate aria-label="Supplier return authorization date" class="field-input" @bind-Value="SupplierReturnAuthorizationForm.AuthorizedOn" /></div>
                <div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Supplier return authorization reason" class="field-input" @bind-Value="SupplierReturnAuthorizationForm.Reason" /></div>
                @foreach (var line in SupplierReturnAuthorizationForm.Lines) { <div class="field-group"><label class="field-label">@line.Sku available @line.AvailableQuantity</label><InputNumber aria-label="@($"Return {line.Sku} quantity")" class="field-input" @bind-Value="line.Quantity" /></div> }
                <button class="action-primary" type="submit">Authorize supplier return</button><button class="action-secondary" type="button" @onclick="CancelSupplierReturnAuthorization">Cancel</button>
            </div></EditForm></section>
        }

        @if (CanManagePurchasing && SupplierReturnShipmentForm is not null)
        {
            <section class="panel"><h2>Ship supplier return @SupplierReturnShipmentForm.ReturnNumber</h2><p class="page-intro">Choose the physical stock location. Posting removes inventory including capitalized landed cost, but reduces GRNI or vendor credit only for the goods vendor's receipt cost. Any nonrecoverable landed-cost difference posts to purchase-price variance.</p><EditForm Model="SupplierReturnShipmentForm" OnValidSubmit="ShipSupplierReturnAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Shipment number</label><InputText aria-label="Supplier return shipment number" class="field-input" @bind-Value="SupplierReturnShipmentForm.ShipmentNumber" /></div>
                <div class="field-group"><label class="field-label">Shipment date</label><InputDate aria-label="Supplier return shipment date" class="field-input" @bind-Value="SupplierReturnShipmentForm.ShippedOn" /></div>
                <div class="field-group"><label class="field-label">Warehouse/bin</label><InputSelect aria-label="Supplier return shipment bin" class="field-input" @bind-Value="SupplierReturnShipmentForm.BinId"><option value="@Guid.Empty">Select stock location</option>@foreach (var warehouse in (Workspace.Operations.Warehouses ?? []).Where(item => item.IsActive)) { @foreach (var bin in warehouse.Bins.Where(item => item.IsActive)) { <option value="@bin.Id">@warehouse.Code/@bin.Code — @bin.Name</option> } }</InputSelect></div>
                @foreach (var line in SupplierReturnShipmentForm.Lines) { <div class="field-group"><label class="field-label">@line.Sku remaining @line.RemainingQuantity</label><InputNumber aria-label="@($"Ship returned {line.Sku} quantity")" class="field-input" @bind-Value="line.Quantity" /></div> }
                <button class="action-primary" type="submit">Post supplier-return shipment</button><button class="action-secondary" type="button" @onclick="CancelSupplierReturnShipment">Cancel</button>
            </div></EditForm></section>
        }

        @if (SupplierReturnCancellationForm is not null)
        {
            <section class="panel"><h2>Cancel supplier return @SupplierReturnCancellationForm.ReturnNumber</h2><EditForm Model="SupplierReturnCancellationForm" OnValidSubmit="CancelSupplierReturnAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Supplier return cancellation reason" class="field-input" @bind-Value="SupplierReturnCancellationForm.Reason" /></div><button class="action-primary" type="submit">Confirm cancellation</button><button class="action-secondary" type="button" @onclick="DismissSupplierReturnCancellation">Keep authorization</button></div></EditForm></section>
        }

        @if (CanManagePayables && SupplierReturnCreditSettlementForm is not null)
        {
            <section class="panel"><h2>Settle vendor credit from @SupplierReturnCreditSettlementForm.ShipmentNumber</h2><EditForm Model="SupplierReturnCreditSettlementForm" OnValidSubmit="SettleSupplierReturnCreditAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Method</label><InputSelect aria-label="Supplier return credit settlement method" class="field-input" @bind-Value="SupplierReturnCreditSettlementForm.Method"><option value="Apply">Apply to vendor bill</option><option value="Refund">Record cash refund</option></InputSelect></div>@if (SupplierReturnCreditSettlementForm.Method == "Apply") { <div class="field-group"><label class="field-label">Vendor bill</label><InputSelect aria-label="Supplier return credit target bill" class="field-input" @bind-Value="SupplierReturnCreditSettlementForm.VendorBillId"><option value="@Guid.Empty">Select open bill</option>@foreach (var bill in Workspace.Payables.Bills.Where(bill => bill.VendorId == SupplierReturnCreditSettlementForm.VendorId && bill.BalanceDue > 0m && bill.Status != "Voided")) { <option value="@bill.Id">@bill.BillNumber — @bill.BalanceDue.ToString("C") due</option> }</InputSelect></div> } else { <div class="field-group"><label class="field-label">Bank account</label><InputSelect aria-label="Supplier return credit refund bank" class="field-input" @bind-Value="SupplierReturnCreditSettlementForm.BankAccountId"><option value="@Guid.Empty">Select bank account</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div><div class="field-group"><label class="field-label">Refund reference</label><InputText aria-label="Supplier return credit refund reference" class="field-input" @bind-Value="SupplierReturnCreditSettlementForm.Reference" /></div> }<div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Supplier return credit settlement date" class="field-input" @bind-Value="SupplierReturnCreditSettlementForm.SettledOn" /></div><div class="field-group"><label class="field-label">Amount (available @SupplierReturnCreditSettlementForm.AvailableAmount.ToString("C"))</label><InputNumber aria-label="Supplier return credit settlement amount" class="field-input" @bind-Value="SupplierReturnCreditSettlementForm.Amount" /></div><button class="action-primary" type="submit">Post vendor-credit settlement</button><button class="action-secondary" type="button" @onclick="CancelSupplierReturnCreditSettlement">Cancel</button></div></EditForm></section>
        }

        @if (SupplierReturnReversalForm is not null)
        {
            <section class="panel"><h2>Reverse @SupplierReturnReversalForm.DocumentLabel</h2><EditForm Model="SupplierReturnReversalForm" OnValidSubmit="ReverseSupplierReturnDocumentAsync"><div class="auth-form"><div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Supplier return reversal date" class="field-input" @bind-Value="SupplierReturnReversalForm.ReversalDate" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Supplier return reversal reason" class="field-input" @bind-Value="SupplierReturnReversalForm.Reason" /></div><button class="action-primary" type="submit">Confirm reversal</button><button class="action-secondary" type="button" @onclick="CancelSupplierReturnReversal">Cancel</button></div></EditForm></section>
        }

        <section class="panel"><h2>Supplier returns and vendor credits</h2><p class="page-intro">Returns remain linked to the exact receipt and purchase-order lines. Inventory removed and vendor credit are shown separately; nonrecoverable capitalized cost posts to purchase-price variance. Reverse later credit settlements before reversing a physical shipment.</p>
            <div class="table-scroll"><table class="data-table" aria-label="Supplier return authorizations"><thead><tr><th>Return</th><th>Receipt</th><th>Vendor</th><th>Date</th><th>Status</th><th>Progress</th><th>Action</th></tr></thead><tbody>@foreach (var authorization in Workspace.Operations.SupplierReturnAuthorizations ?? []) { <tr><td>@authorization.ReturnNumber</td><td>@authorization.ReceiptNumber</td><td>@authorization.VendorName</td><td>@authorization.AuthorizedOn</td><td>@authorization.Status @if (!string.IsNullOrWhiteSpace(authorization.CancellationReason)) { <span>— @authorization.CancellationReason</span> }</td><td>@authorization.Lines.Sum(line => line.ShippedQuantity) / @authorization.Lines.Sum(line => line.AuthorizedQuantity) shipped</td><td>@if (CanManagePurchasing && authorization.Status is "Open" or "PartiallyShipped") { <button class="action-secondary" type="button" @onclick="() => BeginSupplierReturnShipment(authorization)">Ship return</button> @if (!HasPostedSupplierReturnShipment(authorization.Id)) { <button class="action-secondary" type="button" @onclick="() => BeginSupplierReturnCancellation(authorization)">Cancel authorization</button> } }</td></tr> }</tbody></table></div>
            <div class="table-scroll"><table class="data-table" aria-label="Supplier return shipments"><thead><tr><th>Shipment</th><th>Return</th><th>Vendor</th><th>Location</th><th>Accounting</th><th>Inventory removed</th><th>Vendor credit</th><th>Applied</th><th>Refunded</th><th>Available</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach (var shipment in Workspace.Operations.SupplierReturnShipments ?? []) { <tr><td>@shipment.ShipmentNumber</td><td>@shipment.ReturnNumber</td><td>@shipment.VendorName</td><td>@shipment.Location</td><td>@(shipment.CreatesVendorCredit ? $"Vendor credit ({shipment.SourceVendorBillNumber})" : "GRNI reduction")</td><td>@shipment.TotalAmount.ToString("C")</td><td>@shipment.VendorCreditAmount.ToString("C")</td><td>@shipment.AppliedAmount.ToString("C")</td><td>@shipment.RefundedAmount.ToString("C")</td><td>@shipment.AvailableAmount.ToString("C")</td><td>@shipment.Status</td><td>@if (CanManagePayables && shipment.Status == "Posted" && shipment.CreatesVendorCredit && shipment.AvailableAmount > 0m) { <button class="action-secondary" type="button" @onclick="() => BeginSupplierReturnCreditSettlement(shipment)">Apply or refund</button> } @foreach (var application in shipment.Applications.Where(item => item.Status == "Posted")) { @if (CanReverseTransactions) { <button class="action-secondary" type="button" @onclick="() => BeginSupplierReturnApplicationReversal(application, shipment.ShipmentNumber)">Reverse @application.VendorBillNumber application</button> } } @foreach (var refund in shipment.Refunds.Where(item => item.Status == "Posted")) { @if (CanReverseTransactions) { <button class="action-secondary" type="button" @onclick="() => BeginSupplierReturnRefundReversal(refund, shipment.ShipmentNumber)">Reverse refund @refund.Reference</button> } } @if (CanReverseTransactions && CanManagePurchasing && shipment.Status == "Posted" && shipment.AppliedAmount == shipment.SourceAppliedAmount && shipment.RefundedAmount == 0m && shipment.Applications.All(item => item.Status != "Posted")) { <button class="action-secondary" type="button" @onclick="() => BeginSupplierReturnShipmentReversal(shipment)">Reverse shipment</button> }</td></tr> }</tbody></table></div>
        </section>

        @if (CanManagePayables && BillMatchForm is not null)
        {
            <section class="panel"><h2>@(BillMatchForm.Id.HasValue ? "Edit" : "Prepare") supplier invoice for receipt @BillMatchForm.ReceiptNumber</h2><p class="page-intro">Enter the invoice exactly as received. Quantities up to the retained, uninvoiced receipt quantity clear GRNI; excess quantity is shown as a quantity variance. Differences between receipt and invoice prices are shown as price variance.</p><EditForm Model="BillMatchForm" OnValidSubmit="MatchBillAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Vendor bill number</label><InputText aria-label="Matched vendor bill number" class="field-input" @bind-Value="BillMatchForm.BillNumber" /></div>
                <div class="field-group"><label class="field-label">Bill date</label><InputDate aria-label="Matched vendor bill date" class="field-input" @bind-Value="BillMatchForm.BillDate" /></div>
                <div class="field-group"><label class="field-label">Due date</label><InputDate aria-label="Matched vendor bill due date" class="field-input" @bind-Value="BillMatchForm.DueDate" /></div>
                <div class="field-group"><label class="field-label">Description</label><InputText aria-label="Matched vendor bill description" class="field-input" @bind-Value="BillMatchForm.Description" /></div>
                @foreach (var line in BillMatchForm.Lines) { <fieldset class="field-group"><legend>@line.Sku</legend><p class="page-intro">Available received quantity: @line.AvailableQuantity at @line.ReceiptUnitCost.ToString("C")</p><label class="field-label">Invoice quantity</label><InputNumber aria-label="@($"Invoice {line.Sku} quantity")" class="field-input" @bind-Value="line.Quantity" /><label class="field-label">Invoice unit cost</label><InputNumber aria-label="@($"Invoice {line.Sku} unit cost")" class="field-input" @bind-Value="line.UnitCost" />@if (line.Quantity > line.AvailableQuantity) { <p class="validation-message">Quantity variance: @(line.Quantity - line.AvailableQuantity)</p> }</fieldset> }
                <button class="action-primary" type="submit">Save invoice match draft</button><button class="action-secondary" type="button" @onclick="CancelBillMatch">Cancel</button>
            </div></EditForm></section>
        }

        @if (InvoiceMatchDecisionForm is not null)
        {
            <section class="panel"><h2>@InvoiceMatchDecisionForm.Title</h2><EditForm Model="InvoiceMatchDecisionForm" OnValidSubmit="CompleteInvoiceMatchDecisionAsync"><div class="auth-form">@if (InvoiceMatchDecisionForm.NeedsDate) { <div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Invoice match reversal date" class="field-input" @bind-Value="InvoiceMatchDecisionForm.ActionDate" /></div> }<div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Invoice match action reason" class="field-input" @bind-Value="InvoiceMatchDecisionForm.Reason" /></div><button class="action-primary" type="submit">Confirm</button><button class="action-secondary" type="button" @onclick="CancelInvoiceMatchDecision">Cancel</button></div></EditForm></section>
        }

        <section class="panel"><h2>Supplier invoice match review</h2><p class="page-intro">Preparation, Purchasing approval, and posting are separate actions. Positive variance increases expense; negative variance is favorable. Reversal preserves the original invoice, match, and journal evidence.</p><div class="table-scroll"><table class="data-table" aria-label="Supplier invoice matches"><thead><tr><th>Bill</th><th>Receipt</th><th>Invoice</th><th>GRNI cleared</th><th>Price variance</th><th>Quantity variance</th><th>Status</th><th>Review</th><th>Action</th></tr></thead><tbody>
            @foreach (var match in Workspace.Operations.PurchaseInvoiceMatches ?? [])
            {
                <tr><td>@match.BillNumber</td><td>@match.ReceiptNumber</td><td>@match.InvoiceAmount.ToString("C")</td><td>@match.AccrualAmount.ToString("C")</td><td>@match.PriceVarianceAmount.ToString("C")</td><td>@match.QuantityVarianceQuantity units / @match.QuantityVarianceAmount.ToString("C")</td><td>@match.Status</td><td>@match.DecisionReason @match.CancellationReason</td><td>
                    @if (CanManagePayables && match.Status is "Draft" or "Rejected") { <button class="action-secondary" type="button" @onclick="() => EditInvoiceMatch(match)">Edit</button> }
                    @if (CanManagePayables && match.Status == "Draft") { <button class="action-secondary" type="button" @onclick="() => SubmitInvoiceMatchAsync(match)">Submit</button> }
                    @if (CanManagePurchasing && match.Status == "Submitted") { <button class="action-secondary" type="button" @onclick='() => BeginInvoiceMatchDecision(match, "Approve")'>Approve</button><button class="action-secondary" type="button" @onclick='() => BeginInvoiceMatchDecision(match, "Reject")'>Reject</button> }
                    @if (CanManagePayables && match.Status == "Approved") { <button class="action-primary" type="button" @onclick="() => PostInvoiceMatchAsync(match)">Post invoice</button> }
                    @if (CanManagePayables && match.Status is "Draft" or "Submitted" or "Approved" or "Rejected") { <button class="action-secondary" type="button" @onclick='() => BeginInvoiceMatchDecision(match, "Cancel")'>Cancel</button> }
                    @if (CanManagePurchasing && CanReverseTransactions && match.Status == "Posted") { <button class="action-secondary" type="button" @onclick='() => BeginInvoiceMatchDecision(match, "Reverse")'>Reverse</button> }
                </td></tr>
            }
        </tbody></table></div></section>

        @if (CorrectionForm is not null)
        {
            <section class="panel"><h2>@(CorrectionForm.VoidBill ? "Void matched bill" : "Reverse inventory receipt") for @CorrectionForm.ReceiptNumber</h2><p class="page-intro">This creates a dated reversing journal and preserves the original documents. Review the date and enter a specific correction reason before confirming.</p><EditForm Model="CorrectionForm" OnValidSubmit="ExecuteCorrectionAsync"><div class="auth-form">
                <div class="field-group"><label class="field-label">Correction date</label><InputDate aria-label="Purchase correction date" class="field-input" @bind-Value="CorrectionForm.CorrectionDate" /></div>
                <div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Purchase correction reason" class="field-input" @bind-Value="CorrectionForm.Reason" /></div>
                <button class="action-primary" type="submit">@(CorrectionForm.VoidBill ? "Confirm bill void" : "Confirm receipt reversal")</button><button class="action-secondary" type="button" @onclick="CancelCorrection">Cancel</button>
            </div></EditForm></section>
        }
    </section>
}

@code {
    private BusinessWorkspaceSnapshot? Workspace;
    private string? StatusMessage;
    private InventoryAdjustmentEditor AdjustmentForm { get; } = new();
    private InventoryWarehouseEditor WarehouseForm { get; } = new();
    private InventoryBinEditor BinForm { get; } = new();
    private InventoryTransferEditor InventoryTransferForm { get; } = new();
    private InventoryTransferReversalEditor? TransferReversalForm;
    private SalesQuoteEditor SalesQuoteForm { get; } = new();
    private SalesOrderEditor SalesOrderForm { get; } = new();
    private SalesQuoteConversionEditor? QuoteConversionForm;
    private SalesQuoteWithdrawalEditor? QuoteWithdrawalForm;
    private SalesOrderAmendmentEditor? SalesOrderAmendmentForm;
    private SalesOrderCancellationEditor? SalesOrderCancellationForm;
    private PurchaseRequisitionEditor PurchaseRequisitionForm { get; } = new();
    private PurchaseRequisitionDecisionEditor? PurchaseRequisitionDecisionForm;
    private PurchaseRequisitionConversionEditor? PurchaseRequisitionConversionForm;
    private PurchaseOrderEditor PurchaseOrderForm { get; } = new();
    private SalesAllocationEditor? AllocationForm;
    private InventoryPickEditor? InventoryPickForm;
    private InventoryPickCompletionEditor? InventoryPickCompletionForm;
    private InventoryPackEditor? InventoryPackForm;
    private SalesBackorderEditor? SalesBackorderForm;
    private FulfillmentDocumentCancellationEditor? FulfillmentCancellationForm;
    private BackorderCancellationEditor? BackorderCancellationForm;
    private SalesShipmentEditor? ShipmentForm;
    private ShipmentInvoiceEditor? ShipmentInvoiceForm;
    private ShipmentReversalEditor? ShipmentReversalForm;
    private CustomerReturnAuthorizationEditor? CustomerReturnForm;
    private CustomerReturnReceiptEditor? CustomerReturnReceiptForm;
    private CustomerReturnCancellationEditor? CustomerReturnCancellationForm;
    private CustomerReturnCreditEditor? CustomerReturnCreditForm;
    private CustomerReturnCreditSettlementEditor? CustomerReturnCreditSettlementForm;
    private CustomerReturnReversalEditor? ReturnReversalForm;
    private ReceiptEditor? ReceiptForm;
    private BillMatchEditor? BillMatchForm;
    private InvoiceMatchDecisionEditor? InvoiceMatchDecisionForm;
    private PurchaseCorrectionEditor? CorrectionForm;
    private SupplierReturnAuthorizationEditor? SupplierReturnAuthorizationForm;
    private SupplierReturnShipmentEditor? SupplierReturnShipmentForm;
    private SupplierReturnCancellationEditor? SupplierReturnCancellationForm;
    private SupplierReturnCreditSettlementEditor? SupplierReturnCreditSettlementForm;
    private SupplierReturnReversalEditor? SupplierReturnReversalForm;
    private LandedCostEditor? LandedCostForm;
    private LandedCostDecisionEditor? LandedCostDecisionForm;
    private static readonly string[] LandedCostChargeTypes = ["Freight", "CustomsDuty", "Brokerage", "Insurance", "Handling", "PortFees", "Inspection", "Storage", "Demurrage", "Other"];
    private bool CanManageRequisitions;
    private bool CanManagePurchasing;
    private bool CanManagePayables;
    private bool CanMatchReceiptBills;
    private bool CanManageSales;
    private bool CanFulfillSales;
    private bool CanInvoiceShipments;
    private bool CanReverseTransactions;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var privileged = user.IsInRole("Administrator") || user.IsInRole("Owner/CEO");
        CanManageRequisitions = privileged || user.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.RequisitionManage);
        CanManagePurchasing = privileged || user.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.PurchasingManage);
        CanManagePayables = privileged || user.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.PayablesManage);
        CanMatchReceiptBills = CanManagePurchasing && CanManagePayables;
        CanManageSales = privileged || user.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.SalesManage);
        CanFulfillSales = privileged || user.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.FulfillmentManage);
        CanInvoiceShipments = privileged || user.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.ReceivablesManage);
        CanReverseTransactions = privileged || user.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.PaymentReverse);
        Workspace = await WorkspaceService.GetWorkspaceAsync();
    }
