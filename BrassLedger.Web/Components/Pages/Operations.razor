    private Dictionary<Guid, decimal> PickCommitments(Guid orderId) => (Workspace?.Operations.InventoryPicks ?? [])
        .Where(pick => pick.SalesOrderId == orderId && pick.Status is not ("Cancelled" or "Shipped"))
        .SelectMany(pick => pick.Lines.Select(line => new { line.SalesOrderLineId, Quantity = pick.Status == "Draft" ? line.RequestedQuantity : line.PickedQuantity }))
        .GroupBy(line => line.SalesOrderLineId)
        .ToDictionary(group => group.Key, group => group.Sum(line => line.Quantity));
