@page "/ledger"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.ManageLedger)]
@inject IBusinessWorkspaceService WorkspaceService
@inject IAccountingTransactionService TransactionService
@inject IAccountingInterchangeService InterchangeService

<PageTitle>Ledger</PageTitle>

@if (Workspace is null)
{
    <section class="panel">
        <h1>Loading ledger...</h1>
    </section>
}
else
{
    <section class="page-shell">
        <header class="page-header">
            <div>
                <p class="eyebrow">General Ledger</p>
                <h1>Core accounting balances and posting history.</h1>
            </div>
            <p class="page-intro">
                This is the first real accounting slice: chart of accounts, posted journal entries, and treasury balances
                live in a database-backed model instead of a static assessment.
            </p>
        </header>

        <section class="stats-grid">
            <article class="stat-card accent-sand">
                <span class="stat-value">@Workspace.GeneralLedger.Assets.ToString("C0")</span>
                <span class="stat-label">Assets</span>
            </article>
            <article class="stat-card accent-sky">
                <span class="stat-value">@Workspace.GeneralLedger.Liabilities.ToString("C0")</span>
                <span class="stat-label">Liabilities</span>
            </article>
            <article class="stat-card accent-sage">
                <span class="stat-value">@Workspace.GeneralLedger.Revenue.ToString("C0")</span>
                <span class="stat-label">Revenue</span>
            </article>
            <article class="stat-card accent-coral">
                <span class="stat-value">@Workspace.GeneralLedger.Expenses.ToString("C0")</span>
                <span class="stat-label">Expenses</span>
            </article>
        </section>

        <section class="panel">
            <h2>Prepare journal entry</h2>
            <p class="page-intro">Save the entry as a draft, approve it after review, and then post it. Account balances do not change until the approved entry is posted. Receivables, payables, inventory, and payroll control accounts remain restricted to their dedicated workflows.</p>
            @if (!string.IsNullOrWhiteSpace(StatusMessage)) { <p class="lead" role="status" aria-live="polite">@StatusMessage</p> }
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareJournals">
            <Authorized Context="journalPreparationAuthorization">
            <EditForm Model="JournalForm" OnValidSubmit="SaveJournalDraftAsync">
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Journal entry date" class="field-input" @bind-Value="JournalForm.Date" /></div>
                    <div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Journal entry reference" class="field-input" @bind-Value="JournalForm.Reference" /></div>
                    <div class="field-group"><label class="field-label">Description</label><InputText aria-label="Journal entry description" class="field-input" @bind-Value="JournalForm.Description" /></div>
                </div>
                <table class="data-table">
                    <thead><tr><th>Account</th><th>Line description</th><th>Debit</th><th>Credit</th><th><span class="sr-only">Remove line</span></th></tr></thead>
                    <tbody>
                        @foreach (var line in JournalForm.Lines)
                        {
                            <tr @key="line.Key">
                                <td><InputSelect aria-label="Journal entry account" class="field-input" @bind-Value="line.AccountNumber"><option value="">Select account</option>@foreach (var account in Workspace.GeneralLedger.Accounts.Where(account => !account.IsControlAccount)) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></td>
                                <td><InputText aria-label="Journal entry line description" class="field-input" @bind-Value="line.Description" /></td>
                                <td><InputNumber aria-label="Journal entry debit" class="field-input" @bind-Value="line.Debit" /></td>
                                <td><InputNumber aria-label="Journal entry credit" class="field-input" @bind-Value="line.Credit" /></td>
                                <td><button class="action-secondary" type="button" aria-label="Remove journal entry line" @onclick="() => RemoveJournalLine(line)">Remove</button></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th colspan="2">Totals</th><th>@JournalForm.Lines.Sum(line => line.Debit).ToString("C")</th><th>@JournalForm.Lines.Sum(line => line.Credit).ToString("C")</th><th></th></tr></tfoot>
                </table>
                <div class="hero-actions"><button class="action-secondary" type="button" @onclick="AddJournalLine">Add line</button><button class="action-primary" type="submit">Save draft</button></div>
            </EditForm>
            </Authorized>
            <NotAuthorized><p class="muted-copy">Your role can review the ledger but cannot prepare journal drafts.</p></NotAuthorized>
            </AuthorizeView>
        </section>

        <section class="panel">
            <h2>QuickBooks Online interchange</h2>
            <p class="page-intro">Exchange QuickBooks Online master lists and non-control general journal entries. Imports are validated as a complete batch before anything is saved; invoices, bills, and payments retain their dedicated audited workflows.</p>
            <div class="hero-actions">
                <a class="action-primary" href="/interchange/quickbooks-online/chart-of-accounts.csv">Chart of accounts CSV</a>
                <a class="action-secondary" href="/interchange/quickbooks-online/customers.csv">Customers CSV</a>
                <a class="action-secondary" href="/interchange/quickbooks-online/vendors.csv">Vendors CSV</a>
                <a class="action-secondary" href="/interchange/quickbooks-online/journal-entries.csv">General journals CSV</a>
            </div>
            <div class="content-grid interchange-import">
                <div class="field-group"><label class="field-label">Data to import</label><InputSelect aria-label="QuickBooks data to import" class="field-input" @bind-Value="QuickBooksImport.Entity"><option value="chart-of-accounts">Chart of accounts</option><option value="customers">Customers</option><option value="vendors">Vendors</option><option value="journal-entries">General journal entries</option></InputSelect></div>
                <div class="field-group"><label class="field-label">QuickBooks CSV file</label><InputFile aria-label="QuickBooks CSV file" class="field-input" accept=".csv,text/csv" OnChange="SelectQuickBooksFile" /></div>
                <div class="field-group import-action"><span class="field-label">Review and import selected file</span><div class="hero-actions"><button class="action-secondary" type="button" disabled="@(QuickBooksImport.File is null)" @onclick="() => ImportQuickBooksAsync(true)">Validate only</button><button class="action-primary" type="button" disabled="@(QuickBooksImport.File is null)" @onclick="() => ImportQuickBooksAsync(false)">Import CSV</button></div></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(QuickBooksImport.FileName)) { <p class="muted-copy">Selected: @QuickBooksImport.FileName</p> }
            @if (InterchangeBatches.Count > 0)
            {
                <h3>Recent interchange batches</h3>
                <div class="table-scroll"><table class="data-table"><thead><tr><th>Processed</th><th>File / data</th><th>Outcome</th><th>Counts</th><th>Evidence</th></tr></thead><tbody>@foreach (var batch in InterchangeBatches) { <tr><td>@batch.ProcessedAtUtc.ToLocalTime().ToString("g")<br /><small>@batch.ProcessedBy</small></td><td>@batch.FileName<br /><small>@batch.EntityType</small></td><td>@batch.Status@if (batch.Rejections.Count > 0) { <br /><small>@string.Join(" ", batch.Rejections.Take(2))</small> }</td><td>@batch.ImportedCount imported<br />@batch.DuplicateCount duplicate<br />@batch.RejectedCount rejected</td><td><code>@(batch.ContentSha256.Length >= 12 ? batch.ContentSha256[..12] : "unavailable")</code><br /><small>@batch.RowCount rows</small></td></tr> }</tbody></table></div>
            }
        </section>

        <section class="content-grid">
            <article class="panel">
                <h2>Chart of accounts</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Account</th>
                            <th>Type</th>
                            <th>Balance</th>
                            <th>Control</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Workspace.GeneralLedger.Accounts)
                        {
                            <tr>
                                <td>@account.Number - @account.Name</td>
                                <td>@account.Type</td>
                                <td>@account.Balance.ToString("C")</td>
                                <td>@(account.IsControlAccount ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>

            <article class="panel">
                <h2>Recent journal entries</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Entry</th>
                            <th>Date</th>
                            <th>Module</th>
                            <th>Status</th>
                            <th>Description</th>
                            <th>Total</th>
                            <th><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Workspace.GeneralLedger.RecentEntries)
                        {
                            <tr>
                                <td>@entry.EntryNumber</td>
                                <td>@entry.PostedOn.ToString("MMM d, yyyy")</td>
                                <td>@entry.SourceModule</td>
                                <td>@entry.Status</td>
                                <td>@entry.Description</td>
                                <td>@entry.TotalAmount.ToString("C")</td>
                                <td>
                                    @if (entry.Status == "Draft")
                                    {
                                        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApproveJournals">
                                            <Authorized Context="journalApprovalAuthorization"><button class="action-secondary" type="button" @onclick="() => ApproveJournalAsync(entry.Id)">Approve</button></Authorized>
                                        </AuthorizeView>
                                    }
                                    else if (entry.Status == "Approved")
                                    {
                                        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PostJournals">
                                            <Authorized Context="journalPostingAuthorization"><button class="action-primary" type="button" @onclick="() => PostApprovedJournalAsync(entry.Id)">Post</button></Authorized>
                                        </AuthorizeView>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>
        </section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReverseJournals">
        <Authorized Context="journalReversalAuthorization">
        <section class="panel">
            <h2>Reverse posted general journal</h2>
            <p class="page-intro">A reversal creates a new equal-and-opposite entry and preserves the original audit history. Transactions originating in receivables, payables, inventory, or payroll must be corrected in their originating workflow.</p>
            <EditForm Model="ReversalForm" OnValidSubmit="ReverseJournalAsync">
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Posted journal</label><InputSelect aria-label="Journal entry to reverse" class="field-input" @bind-Value="ReversalForm.JournalEntryId"><option value="@Guid.Empty">Select entry</option>@foreach (var entry in ReversibleJournalEntries) { <option value="@entry.Id">@entry.EntryNumber — @entry.Reference — @entry.TotalAmount.ToString("C")</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Journal reversal date" class="field-input" @bind-Value="ReversalForm.ReversalDate" /></div>
                    <div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Journal reversal reason" class="field-input" @bind-Value="ReversalForm.Reason" /></div>
                </div>
                <button class="action-primary" type="submit">Create reversal</button>
            </EditForm>
        </section>
        </Authorized>
        </AuthorizeView>

        <section class="panel"><h2>Bank statement import and matching</h2><div class="content-grid"><div class="field-group"><label class="field-label">Bank account</label><InputSelect aria-label="Statement import bank account" class="field-input" @bind-Value="StatementImportForm.BankAccountId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div><div class="field-group"><label class="field-label">Format</label><InputSelect aria-label="Bank statement format" class="field-input" @bind-Value="StatementImportForm.Format"><option>CSV</option><option>OFX</option><option>QFX</option><option>CAMT.053</option><option>MT940</option></InputSelect></div><div class="field-group"><label class="field-label">Statement file</label><InputFile aria-label="Bank statement file" class="field-input" OnChange="SelectBankStatementAsync" /></div><button class="action-secondary" type="button" disabled="@(string.IsNullOrWhiteSpace(StatementImportForm.Content))" @onclick="() => ImportBankStatementAsync(true)">Validate statement</button><button class="action-primary" type="button" disabled="@(string.IsNullOrWhiteSpace(StatementImportForm.Content))" @onclick="() => ImportBankStatementAsync(false)">Import statement</button></div>
            <div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Bank</th><th>External ID</th><th>Payee / memo</th><th>Amount</th><th>Status</th><th>Suggested or manual match</th><th></th></tr></thead><tbody>@foreach (var item in Workspace.Treasury.StatementTransactions ?? []) { <tr><td>@item.TransactionDate</td><td>@Workspace.Treasury.BankAccounts.Single(bank => bank.Id == item.BankAccountId).Name</td><td>@item.ExternalId</td><td>@item.Payee @item.Memo</td><td>@item.Amount.ToString("C")</td><td>@item.Status</td><td>@if (item.Status == "Unmatched") { <select aria-label="Journal entry to match" class="field-input" value="@GetMatchSelection(item.Id)" @onchange="args => SetMatchSelection(item.Id, args.Value?.ToString())"><option value="@Guid.Empty">Select journal</option>@foreach (var candidate in (Workspace.Treasury.ReconciliationCandidates ?? []).Where(candidate => candidate.BankAccountId == item.BankAccountId && candidate.SignedAmount == item.Amount).OrderBy(candidate => Math.Abs(candidate.PostedOn.DayNumber - item.TransactionDate.DayNumber))) { <option value="@candidate.JournalEntryId">@candidate.PostedOn — @candidate.Reference</option> }</select> }</td><td>@if (item.Status == "Unmatched") { <button class="action-secondary" type="button" @onclick="() => MatchBankTransactionAsync(item.Id)">Match</button> } else { <button class="action-secondary" type="button" @onclick="() => UnmatchBankTransactionAsync(item.Id)">Unmatch</button> }</td></tr> }</tbody></table></div>
        </section>

        <section class="panel"><h2>Transfers and reconciliation adjustments</h2><div class="content-grid"><EditForm Model="TransferForm" OnValidSubmit="CreateTransferAsync"><div class="auth-form"><h3>Transfer funds</h3><div class="field-group"><label class="field-label">From bank</label><InputSelect aria-label="Transfer from bank" class="field-input" @bind-Value="TransferForm.FromBankId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div><div class="field-group"><label class="field-label">To bank</label><InputSelect aria-label="Transfer to bank" class="field-input" @bind-Value="TransferForm.ToBankId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div><div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Transfer date" class="field-input" @bind-Value="TransferForm.Date" /></div><div class="field-group"><label class="field-label">Amount</label><InputNumber aria-label="Transfer amount" class="field-input" @bind-Value="TransferForm.Amount" /></div><div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Transfer reference" class="field-input" @bind-Value="TransferForm.Reference" /></div><div class="field-group"><label class="field-label">Memo</label><InputText aria-label="Transfer memo" class="field-input" @bind-Value="TransferForm.Memo" /></div><button class="action-primary" type="submit">Post bank transfer</button></div></EditForm>
            <EditForm Model="BankAdjustmentForm" OnValidSubmit="CreateBankAdjustmentAsync"><div class="auth-form"><h3>Reconciliation adjustment</h3><div class="field-group"><label class="field-label">Adjustment bank</label><InputSelect aria-label="Adjustment bank account" class="field-input" @bind-Value="BankAdjustmentForm.BankId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div><div class="field-group"><label class="field-label">Signed amount</label><InputNumber aria-label="Bank adjustment amount" class="field-input" @bind-Value="BankAdjustmentForm.Amount" /></div><div class="field-group"><label class="field-label">Offset account</label><InputSelect aria-label="Bank adjustment offset account" class="field-input" @bind-Value="BankAdjustmentForm.OffsetAccount"><option value="">Select account</option>@foreach (var account in Workspace.GeneralLedger.Accounts.Where(account => !account.IsControlAccount && account.Number != "1050" && !Workspace.Treasury.BankAccounts.Any(bank => bank.LedgerAccountNumber == account.Number))) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></div><div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Bank adjustment reference" class="field-input" @bind-Value="BankAdjustmentForm.Reference" /></div><div class="field-group"><label class="field-label">Description</label><InputText aria-label="Bank adjustment description" class="field-input" @bind-Value="BankAdjustmentForm.Description" /></div><button class="action-primary" type="submit">Post reconciliation adjustment</button></div></EditForm></div>
            @if ((Workspace.Treasury.Transfers ?? []).Count > 0)
            {
                <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReverseJournals">
                    <div class="content-grid">
                        <div class="field-group"><label class="field-label">Transfer reversal date</label><InputDate aria-label="Transfer reversal date" class="field-input" @bind-Value="TransferReversalForm.Date" /></div>
                        <div class="field-group"><label class="field-label">Transfer reversal reason</label><InputText aria-label="Transfer reversal reason" class="field-input" @bind-Value="TransferReversalForm.Reason" /></div>
                    </div>
                </AuthorizeView>
                <div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>From</th><th>To</th><th>Reference</th><th>Amount</th><th>Status</th><th></th></tr></thead><tbody>
                    @foreach (var transfer in Workspace.Treasury.Transfers ?? [])
                    {
                        <tr><td>@transfer.TransferDate</td><td>@Workspace.Treasury.BankAccounts.Single(bank => bank.Id == transfer.FromBankAccountId).Name</td><td>@Workspace.Treasury.BankAccounts.Single(bank => bank.Id == transfer.ToBankAccountId).Name</td><td>@transfer.Reference</td><td>@transfer.Amount.ToString("C")</td><td>@transfer.Status</td><td>@if (transfer.Status == "Posted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReverseJournals"><button class="action-secondary" type="button" @onclick="() => ReverseTransferAsync(transfer.Id)">Reverse</button></AuthorizeView> }</td></tr>
                    }
                </tbody></table></div>
            }
            @if ((Workspace.Treasury.Adjustments ?? []).Count > 0)
            {
                <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReverseJournals">
                    <div class="content-grid">
                        <div class="field-group"><label class="field-label">Adjustment reversal date</label><InputDate aria-label="Adjustment reversal date" class="field-input" @bind-Value="AdjustmentReversalForm.Date" /></div>
                        <div class="field-group"><label class="field-label">Adjustment reversal reason</label><InputText aria-label="Adjustment reversal reason" class="field-input" @bind-Value="AdjustmentReversalForm.Reason" /></div>
                    </div>
                </AuthorizeView>
                <div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Bank</th><th>Reference</th><th>Description</th><th>Amount</th><th>Status</th><th></th></tr></thead><tbody>
                    @foreach (var adjustment in Workspace.Treasury.Adjustments ?? [])
                    {
                        <tr><td>@adjustment.AdjustmentDate</td><td>@Workspace.Treasury.BankAccounts.Single(bank => bank.Id == adjustment.BankAccountId).Name</td><td>@adjustment.Reference</td><td>@adjustment.Description</td><td>@adjustment.Amount.ToString("C")</td><td>@adjustment.Status</td><td>@if (adjustment.Status == "Posted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReverseJournals"><button class="action-secondary" type="button" @onclick="() => ReverseBankAdjustmentAsync(adjustment.Id)">Reverse</button></AuthorizeView> }</td></tr>
                    }
                </tbody></table></div>
            }
        </section>

        <section class="panel">
            <h2>Treasury positions</h2>
            <div class="content-grid">
                <EditForm Model="ReconciliationForm" OnValidSubmit="ReconcileAsync">
                    <div class="auth-form"><h3>Reconcile bank statement</h3>
                        <div class="field-group"><label class="field-label">Bank account</label><InputSelect aria-label="Reconciliation bank account" class="field-input" @bind-Value="ReconciliationForm.BankAccountId" @bind-Value:after="ResetReconciliationSelections"><option value="@Guid.Empty">Select account</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div>
                        <div class="field-group"><label class="field-label">Statement date</label><InputDate aria-label="Reconciliation statement date" class="field-input" @bind-Value="ReconciliationForm.StatementDate" @bind-Value:after="ResetReconciliationSelections" /></div>
                        <div class="field-group"><label class="field-label">Statement closing balance</label><InputNumber aria-label="Reconciliation statement closing balance" class="field-input" @bind-Value="ReconciliationForm.StatementBalance" /></div>
                        <div class="field-group"><label class="field-label">Reconciliation notes</label><InputText aria-label="Bank reconciliation notes" class="field-input" @bind-Value="ReconciliationForm.Notes" /></div>
                        @if (ReconciliationForm.BankAccountId != Guid.Empty)
                        {
                            <div class="field-group">
                                <span class="field-label">Cleared statement activity</span>
                                @if (!VisibleReconciliationCandidates.Any())
                                {
                                    <p class="muted-copy">No unreconciled bank activity falls on or before this statement date.</p>
                                }
                                else
                                {
                                    <div class="checkbox-list">
                                        @foreach (var candidate in VisibleReconciliationCandidates)
                                        {
                                            <label class="checkbox-row" @key="candidate.JournalEntryId">
                                                <input aria-label="Clear @candidate.Reference" type="checkbox" checked="@ReconciliationForm.SelectedEntryIds.Contains(candidate.JournalEntryId)" @onchange="args => SetReconciliationSelection(candidate.JournalEntryId, args.Value is true)" />
                                                <span>@candidate.PostedOn.ToString("MMM d") · @candidate.Reference · @candidate.Description (@candidate.SignedAmount.ToString("C"))</span>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <button class="action-primary" type="submit">Reconcile</button>
                    </div>
                </EditForm>
                <EditForm Model="BankMappingForm" OnValidSubmit="UpdateBankMappingAsync">
                    <div class="auth-form"><h3>Map bank to GL cash account</h3>
                        <div class="field-group"><label class="field-label">Bank account</label><InputSelect aria-label="Bank account to map" class="field-input" @bind-Value="BankMappingForm.BankAccountId"><option value="@Guid.Empty">Select bank account</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name — currently @bank.LedgerAccountNumber</option> }</InputSelect></div>
                        <div class="field-group"><label class="field-label">GL cash account</label><InputSelect aria-label="GL account for bank mapping" class="field-input" @bind-Value="BankMappingForm.LedgerAccountNumber"><option value="">Select asset account</option>@foreach (var account in Workspace.GeneralLedger.Accounts.Where(account => account.Type == "Asset" && !account.IsControlAccount)) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></div>
                        <button class="action-primary" type="submit">Save mapping</button>
                    </div>
                </EditForm>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Account</th>
                        <th>Masked number</th>
                        <th>GL cash account</th>
                        <th>Balance</th>
                        <th>Unreconciled</th>
                        <th>Last reconciled</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Workspace.Treasury.BankAccounts)
                    {
                        <tr>
                            <td>@account.Name</td>
                            <td>@account.AccountNumberMasked</td>
                            <td>@account.LedgerAccountNumber</td>
                            <td>@account.CurrentBalance.ToString("C")</td>
                            <td>@account.UnreconciledAmount.ToString("C")</td>
                            <td>@account.LastReconciledOn.ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <h3>Completed reconciliation reports</h3><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReverseJournals"><div class="content-grid"><div class="field-group"><label class="field-label">Reopen reason</label><InputText aria-label="Bank reconciliation reopen reason" class="field-input" @bind-Value="ReopenForm.Reason" /></div></div></AuthorizeView><div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Bank</th><th>Opening</th><th>Cleared</th><th>Statement</th><th>Book</th><th>Variance</th><th>Items</th><th>Status / notes</th><th></th></tr></thead><tbody>@foreach (var report in Workspace.Treasury.Reconciliations ?? []) { <tr><td>@report.StatementDate</td><td>@Workspace.Treasury.BankAccounts.Single(bank => bank.Id == report.BankAccountId).Name</td><td>@report.OpeningBalance.ToString("C")</td><td>@report.ClearedAmount.ToString("C")</td><td>@report.StatementClosingBalance.ToString("C")</td><td>@report.BookBalance.ToString("C")</td><td>@report.Variance.ToString("C")</td><td>@report.ItemCount</td><td>@report.Status @if (report.Status == "Reopened") { <span>— @report.ReopenReason</span> } else if (!string.IsNullOrWhiteSpace(report.Notes)) { <span>— @report.Notes</span> }</td><td>@if (report.Status == "Completed") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReverseJournals"><button class="action-secondary" type="button" @onclick="() => ReopenReconciliationAsync(report.Id)">Reopen</button></AuthorizeView> }</td></tr> }</tbody></table></div>
        </section>
    </section>
}

@code {
    private BusinessWorkspaceSnapshot? Workspace;
    private IReadOnlyList<AccountingInterchangeBatchSnapshot> InterchangeBatches = [];
    private string? StatusMessage;
    private JournalEditor JournalForm { get; } = new();
    private JournalReversalEditor ReversalForm { get; } = new();
    private ReconciliationEditor ReconciliationForm { get; } = new();
    private BankMappingEditor BankMappingForm { get; } = new();
    private QuickBooksImportEditor QuickBooksImport { get; } = new();
    private StatementImportEditor StatementImportForm { get; } = new();
    private BankMatchEditor MatchForm { get; } = new();
    private Dictionary<Guid, Guid> MatchSelections { get; } = [];
    private BankTransferEditor TransferForm { get; } = new();
    private BankTransferReversalEditor TransferReversalForm { get; } = new();
    private BankAdjustmentEditor BankAdjustmentForm { get; } = new();
    private BankAdjustmentReversalEditor AdjustmentReversalForm { get; } = new();
    private ReopenEditor ReopenForm { get; } = new();

    protected override async Task OnInitializedAsync()
    {
        Workspace = await WorkspaceService.GetWorkspaceAsync();
        InterchangeBatches = await InterchangeService.GetRecentBatchesAsync();
    }

    private async Task SaveJournalDraftAsync()
    {
        var result = await TransactionService.SaveJournalEntryDraftAsync(new SaveJournalEntryDraftRequest(null, JournalForm.Date, JournalForm.Reference, JournalForm.Description,
            JournalForm.Lines.Select(line => new JournalLineRequest(line.AccountNumber, line.Debit, line.Credit, line.Description)).ToArray()));
        StatusMessage = result.Succeeded ? "Journal draft saved for review." : result.ErrorMessage;
        if (result.Succeeded) { JournalForm.Reset(); Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    }

    private async Task ApproveJournalAsync(Guid journalEntryId)
    {
        var result = await TransactionService.ApproveJournalEntryAsync(journalEntryId);
        StatusMessage = result.Succeeded ? "Journal entry approved and ready to post." : result.ErrorMessage;
        if (result.Succeeded) Workspace = await WorkspaceService.GetWorkspaceAsync();
    }

    private async Task PostApprovedJournalAsync(Guid journalEntryId)
    {
        var result = await TransactionService.PostApprovedJournalEntryAsync(journalEntryId);
        StatusMessage = result.Succeeded ? "Approved journal entry posted." : result.ErrorMessage;
        if (result.Succeeded) Workspace = await WorkspaceService.GetWorkspaceAsync();
    }

    private async Task ReverseJournalAsync()
    {
        var result = await TransactionService.ReverseJournalEntryAsync(new ReverseJournalEntryRequest(ReversalForm.JournalEntryId, ReversalForm.ReversalDate, ReversalForm.Reason));
        StatusMessage = result.Succeeded ? "Reversal posted with the original entry retained in the audit trail." : result.ErrorMessage;
        if (result.Succeeded) { ReversalForm.Reset(); Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    }

    private async Task ReconcileAsync()
    {
        var result = await TransactionService.ReconcileBankAccountAsync(new ReconcileBankAccountRequest(ReconciliationForm.BankAccountId, ReconciliationForm.StatementDate, ReconciliationForm.StatementBalance, ReconciliationForm.SelectedEntryIds.ToArray(), ReconciliationForm.Notes));
        StatusMessage = result.Succeeded ? "Bank account reconciled." : result.ErrorMessage;
        if (result.Succeeded) Workspace = await WorkspaceService.GetWorkspaceAsync();
    }

    private async Task UpdateBankMappingAsync()
    {
        var result = await TransactionService.UpdateBankLedgerMappingAsync(new UpdateBankLedgerMappingRequest(BankMappingForm.BankAccountId, BankMappingForm.LedgerAccountNumber));
        StatusMessage = result.Succeeded ? "Bank ledger mapping saved." : result.ErrorMessage;
        if (result.Succeeded) Workspace = await WorkspaceService.GetWorkspaceAsync();
    }

    private void SelectQuickBooksFile(InputFileChangeEventArgs args)
    {
        QuickBooksImport.File = args.File;
        QuickBooksImport.FileName = args.File.Name;
    }

    private async Task ImportQuickBooksAsync(bool dryRun)
    {
        if (QuickBooksImport.File is null) return;
        try
        {
            await using var content = QuickBooksImport.File.OpenReadStream(2 * 1024 * 1024);
            var result = await InterchangeService.ImportQuickBooksOnlineCsvAsync(QuickBooksImport.Entity, content, new(dryRun, QuickBooksImport.FileName));
            StatusMessage = result.Succeeded
                ? dryRun ? $"Validation passed: {result.ImportedCount} QuickBooks {QuickBooksImport.Entity} record(s) are ready to import; no accounting records changed." : $"Imported {result.ImportedCount} QuickBooks {QuickBooksImport.Entity} record(s)."
                : string.Join(" ", result.Errors);
            InterchangeBatches = await InterchangeService.GetRecentBatchesAsync();
            if (result.Succeeded && !dryRun) { QuickBooksImport.File = null; QuickBooksImport.FileName = string.Empty; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
        }
        catch (IOException)
        {
            StatusMessage = "The selected file could not be read. Choose a CSV no larger than 2 MB.";
        }
    }

    private async Task SelectBankStatementAsync(InputFileChangeEventArgs args) { var file = args.File; StatementImportForm.FileName = file.Name; await using var stream = file.OpenReadStream(10 * 1024 * 1024); using var reader = new StreamReader(stream); StatementImportForm.Content = await reader.ReadToEndAsync(); var extension = Path.GetExtension(file.Name).TrimStart('.').ToUpperInvariant(); if (extension is "OFX" or "QFX" or "CSV" or "MT940") StatementImportForm.Format = extension; else if (extension is "XML") StatementImportForm.Format = "CAMT.053"; }
    private async Task ImportBankStatementAsync(bool dryRun) { var result = await TransactionService.ImportBankStatementAsync(new ImportBankStatementRequest(StatementImportForm.BankAccountId, StatementImportForm.FileName, StatementImportForm.Format, StatementImportForm.Content, dryRun)); var rejectionDetail = result.Rejections.Count == 0 ? string.Empty : $" {string.Join(" ", result.Rejections.Take(3))}"; StatusMessage = result.Succeeded ? $"{(dryRun ? "Validated" : "Imported")} {result.ImportedCount} transaction(s); {result.DuplicateCount} duplicate(s), {result.RejectedCount} rejection(s).{rejectionDetail}" : result.ErrorMessage; if (result.Succeeded && !dryRun) { StatementImportForm.Content = string.Empty; Workspace = await WorkspaceService.GetWorkspaceAsync(); } }
    private async Task MatchBankTransactionAsync(Guid id) { var result = await TransactionService.MatchBankTransactionAsync(new MatchBankTransactionRequest(id, MatchSelections.GetValueOrDefault(id), MatchForm.Note)); StatusMessage = result.Succeeded ? "Bank transaction matched." : result.ErrorMessage; if (result.Succeeded) { MatchSelections.Remove(id); Workspace = await WorkspaceService.GetWorkspaceAsync(); } }
    private async Task UnmatchBankTransactionAsync(Guid id) { var result = await TransactionService.UnmatchBankTransactionAsync(id, string.IsNullOrWhiteSpace(MatchForm.Note) ? "Operator correction" : MatchForm.Note); StatusMessage = result.Succeeded ? "Bank transaction unmatched." : result.ErrorMessage; if (result.Succeeded) Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    private async Task CreateTransferAsync() { var result = await TransactionService.CreateBankTransferAsync(new CreateBankTransferRequest(TransferForm.FromBankId, TransferForm.ToBankId, TransferForm.Date, TransferForm.Amount, TransferForm.Reference, TransferForm.Memo)); StatusMessage = result.Succeeded ? "Bank transfer posted." : result.ErrorMessage; if (result.Succeeded) { TransferForm.Reset(); Workspace = await WorkspaceService.GetWorkspaceAsync(); } }
    private async Task ReverseTransferAsync(Guid id) { var result = await TransactionService.ReverseBankTransferAsync(new ReverseBankTransferRequest(id, TransferReversalForm.Date, TransferReversalForm.Reason)); StatusMessage = result.Succeeded ? "Bank transfer reversed." : result.ErrorMessage; if (result.Succeeded) { TransferReversalForm.Reason = string.Empty; Workspace = await WorkspaceService.GetWorkspaceAsync(); } }
    private async Task CreateBankAdjustmentAsync() { var result = await TransactionService.CreateReconciliationAdjustmentAsync(new CreateReconciliationAdjustmentRequest(BankAdjustmentForm.BankId, BankAdjustmentForm.Date, BankAdjustmentForm.Amount, BankAdjustmentForm.OffsetAccount, BankAdjustmentForm.Reference, BankAdjustmentForm.Description)); StatusMessage = result.Succeeded ? "Reconciliation adjustment posted." : result.ErrorMessage; if (result.Succeeded) { BankAdjustmentForm.Reset(); Workspace = await WorkspaceService.GetWorkspaceAsync(); } }
    private async Task ReverseBankAdjustmentAsync(Guid id) { var result = await TransactionService.ReverseReconciliationAdjustmentAsync(new ReverseReconciliationAdjustmentRequest(id, AdjustmentReversalForm.Date, AdjustmentReversalForm.Reason)); StatusMessage = result.Succeeded ? "Reconciliation adjustment reversed." : result.ErrorMessage; if (result.Succeeded) { AdjustmentReversalForm.Reason = string.Empty; Workspace = await WorkspaceService.GetWorkspaceAsync(); } }
    private async Task ReopenReconciliationAsync(Guid id) { var result = await TransactionService.ReopenBankReconciliationAsync(new ReopenBankReconciliationRequest(id, ReopenForm.Reason)); StatusMessage = result.Succeeded ? "Bank reconciliation reopened." : result.ErrorMessage; if (result.Succeeded) { ReopenForm.Reason = string.Empty; Workspace = await WorkspaceService.GetWorkspaceAsync(); } }

    private void AddJournalLine() => JournalForm.Lines.Add(new JournalLineEditor());
    private Guid GetMatchSelection(Guid transactionId) => MatchSelections.GetValueOrDefault(transactionId);
    private void SetMatchSelection(Guid transactionId, string? value) => MatchSelections[transactionId] = Guid.TryParse(value, out var selected) ? selected : Guid.Empty;
    private void RemoveJournalLine(JournalLineEditor line) { if (JournalForm.Lines.Count > 2) JournalForm.Lines.Remove(line); }
    private IEnumerable<BankReconciliationCandidateSnapshot> VisibleReconciliationCandidates => Workspace?.Treasury.ReconciliationCandidates?.Where(candidate => candidate.BankAccountId == ReconciliationForm.BankAccountId && candidate.PostedOn <= ReconciliationForm.StatementDate) ?? [];
    private IEnumerable<JournalEntrySnapshot> ReversibleJournalEntries => Workspace?.GeneralLedger.RecentEntries.Where(entry => entry.Status == "Posted" && entry.SourceModule == "General Ledger" && entry.ReversalOfJournalEntryId is null) ?? [];
    private void ResetReconciliationSelections() => ReconciliationForm.SelectedEntryIds = VisibleReconciliationCandidates.Select(candidate => candidate.JournalEntryId).ToHashSet();
    private void SetReconciliationSelection(Guid entryId, bool selected)
    {
        if (selected) ReconciliationForm.SelectedEntryIds.Add(entryId);
        else ReconciliationForm.SelectedEntryIds.Remove(entryId);
    }

    private sealed class JournalEditor { public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public string Reference { get; set; } = string.Empty; public string Description { get; set; } = string.Empty; public List<JournalLineEditor> Lines { get; } = [new(), new()]; public void Reset() { Date = DateOnly.FromDateTime(DateTime.Today); Reference = string.Empty; Description = string.Empty; Lines.Clear(); Lines.Add(new()); Lines.Add(new()); } }
    private sealed class JournalLineEditor { public Guid Key { get; } = Guid.NewGuid(); public string AccountNumber { get; set; } = string.Empty; public string Description { get; set; } = string.Empty; public decimal Debit { get; set; } public decimal Credit { get; set; } }
    private sealed class JournalReversalEditor { public Guid JournalEntryId { get; set; } public DateOnly ReversalDate { get; set; } = DateOnly.FromDateTime(DateTime.Today); public string Reason { get; set; } = string.Empty; public void Reset() { JournalEntryId = Guid.Empty; ReversalDate = DateOnly.FromDateTime(DateTime.Today); Reason = string.Empty; } }
    private sealed class ReconciliationEditor { public Guid BankAccountId { get; set; } public DateOnly StatementDate { get; set; } = DateOnly.FromDateTime(DateTime.Today); public decimal StatementBalance { get; set; } public string Notes { get; set; } = string.Empty; public HashSet<Guid> SelectedEntryIds { get; set; } = []; }
    private sealed class BankMappingEditor { public Guid BankAccountId { get; set; } public string LedgerAccountNumber { get; set; } = string.Empty; }
    private sealed class QuickBooksImportEditor { public string Entity { get; set; } = "chart-of-accounts"; public IBrowserFile? File { get; set; } public string FileName { get; set; } = string.Empty; }
    private sealed class StatementImportEditor { public Guid BankAccountId { get; set; } public string FileName { get; set; } = string.Empty; public string Format { get; set; } = "CSV"; public string Content { get; set; } = string.Empty; }
    private sealed class BankMatchEditor { public Guid JournalEntryId { get; set; } public string Note { get; set; } = string.Empty; }
    private sealed class BankTransferEditor { public Guid FromBankId { get; set; } public Guid ToBankId { get; set; } public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public decimal Amount { get; set; } public string Reference { get; set; } = string.Empty; public string Memo { get; set; } = string.Empty; public void Reset() { FromBankId = Guid.Empty; ToBankId = Guid.Empty; Amount = 0; Reference = string.Empty; Memo = string.Empty; } }
    private sealed class BankTransferReversalEditor { public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public string Reason { get; set; } = string.Empty; }
    private sealed class BankAdjustmentEditor { public Guid BankId { get; set; } public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public decimal Amount { get; set; } public string OffsetAccount { get; set; } = string.Empty; public string Reference { get; set; } = string.Empty; public string Description { get; set; } = string.Empty; public void Reset() { BankId = Guid.Empty; Amount = 0; OffsetAccount = string.Empty; Reference = string.Empty; Description = string.Empty; } }
    private sealed class BankAdjustmentReversalEditor { public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public string Reason { get; set; } = string.Empty; }
    private sealed class ReopenEditor { public string Reason { get; set; } = string.Empty; }
}
