        public DateOnly DisposalDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public decimal ProceedsAmount { get; set; }
        public Guid ProceedsBankAccountId { get; set; }
        public Guid GainAccountId { get; set; }
        public Guid LossAccountId { get; set; }
        public string Description { get; set; } = string.Empty;
        public string ConcurrencyToken { get; set; } = string.Empty;
        public void Load(AccountingScheduleSnapshot schedule, Guid gainAccountId, Guid lossAccountId) { ScheduleId = schedule.Id; ScheduleNumber = schedule.ScheduleNumber; DisposalDate = DateOnly.FromDateTime(DateTime.Today); ProceedsAmount = 0m; ProceedsBankAccountId = Guid.Empty; GainAccountId = gainAccountId; LossAccountId = lossAccountId; Description = $"Dispose or retire {schedule.Name}"; ConcurrencyToken = schedule.ConcurrencyToken; }
        public void Reset() { ScheduleId = Guid.Empty; ScheduleNumber = string.Empty; DisposalDate = DateOnly.FromDateTime(DateTime.Today); ProceedsAmount = 0m; ProceedsBankAccountId = Guid.Empty; GainAccountId = Guid.Empty; LossAccountId = Guid.Empty; Description = string.Empty; ConcurrencyToken = string.Empty; }
    }
}
