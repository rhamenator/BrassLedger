    {
        QuickBooksImport.File = args.File;
        QuickBooksImport.FileName = args.File.Name;
    }

    private async Task ImportQuickBooksAsync(bool dryRun)
    {
        if (QuickBooksImport.File is null) return;
        try
        {
            await using var content = QuickBooksImport.File.OpenReadStream(2 * 1024 * 1024);
            var result = await InterchangeService.ImportQuickBooksOnlineCsvAsync(QuickBooksImport.Entity, content, new(dryRun, QuickBooksImport.FileName));
            StatusMessage = result.Succeeded
                ? dryRun ? $"Validation passed: {result.ImportedCount} QuickBooks {QuickBooksImport.Entity} record(s) are ready to import; no accounting records changed."
                    : QuickBooksImport.Entity == "invoices" ? $"Created {result.ImportedCount} QuickBooks invoice draft(s) for review, approval, and posting; no balances changed yet."
                    : $"Imported {result.ImportedCount} QuickBooks {QuickBooksImport.Entity} record(s)."
                : string.Join(" ", result.Errors);
            InterchangeBatches = await InterchangeService.GetRecentBatchesAsync();
            if (result.Succeeded && !dryRun) { QuickBooksImport.File = null; QuickBooksImport.FileName = string.Empty; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
        }
        catch (IOException)
        {
            StatusMessage = "The selected file could not be read. Choose a CSV no larger than 2 MB.";
        }
    }

    private void SelectBankStatement(InputFileChangeEventArgs args) { var file = args.File; StatementImportForm.File = file; StatementImportForm.FileName = file.Name; var extension = Path.GetExtension(file.Name).TrimStart('.').ToUpperInvariant(); if (extension is "OFX" or "QFX" or "CSV" or "MT940") StatementImportForm.Format = extension; else if (extension is "XML") StatementImportForm.Format = "CAMT.053"; }
    private async Task ImportBankStatementAsync(bool dryRun)
    {
        if (StatementImportForm.File is null) return;
        try
        {
            await using var stream = StatementImportForm.File.OpenReadStream(10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();
            var result = await TransactionService.ImportBankStatementAsync(new ImportBankStatementRequest(StatementImportForm.BankAccountId, StatementImportForm.FileName, StatementImportForm.Format, content, dryRun));
            var rejectionDetail = result.Rejections.Count == 0 ? string.Empty : $" {string.Join(" ", result.Rejections.Take(3))}";
            StatusMessage = result.Succeeded ? $"{(dryRun ? "Validated" : "Imported")} {result.ImportedCount} transaction(s); {result.DuplicateCount} duplicate(s), {result.RejectedCount} rejection(s).{rejectionDetail}" : result.ErrorMessage;
            if (result.Succeeded && !dryRun) { StatementImportForm.File = null; StatementImportForm.FileName = string.Empty; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
        }
        catch (IOException)
        {
            StatusMessage = "The selected statement could not be read. Choose a supported file no larger than 10 MB.";
        }
    }
