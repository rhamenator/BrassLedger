@page "/payables"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.ManagePayables)]
@inject IBusinessWorkspaceService WorkspaceService
@inject IAccountingTransactionService TransactionService

<PageTitle>Payables</PageTitle>

@if (Workspace is null)
{
    <section class="panel">
        <h1>Loading payables...</h1>
    </section>
}
else
{
    <section class="page-shell">
        <header class="page-header">
            <div>
                <p class="eyebrow">Accounts Payable</p>
                <h1>Vendor management and outgoing cash commitments.</h1>
            </div>
            <p class="page-intro">Enter itemized vendor bills, distribute costs to expense accounts, and manage outstanding obligations.</p>
        </header>

        <section class="stats-grid">
            <article class="stat-card accent-sand">
                <span class="stat-value">@Workspace.Payables.OpenBalance.ToString("C0")</span>
                <span class="stat-label">Open A/P</span>
            </article>
            <article class="stat-card accent-sky">
                <span class="stat-value">@Workspace.Payables.Vendors.Count</span>
                <span class="stat-label">Vendors</span>
            </article>
            <article class="stat-card accent-sage">
                <span class="stat-value">@Workspace.Payables.Bills.Count</span>
                <span class="stat-label">Bills</span>
            </article>
            <article class="stat-card accent-coral">
                <span class="stat-value">@Workspace.Payables.DueThisWeekCount</span>
                <span class="stat-label">Due within 7 days</span>
            </article>
        </section>

        <section class="panel">
            <h2>Enter and post vendor bill</h2>
            @if (!string.IsNullOrWhiteSpace(StatusMessage)) { <p class="lead" role="status" aria-live="polite">@StatusMessage</p> }
            <EditForm Model="BillForm" OnValidSubmit="CreateBillAsync">
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Vendor</label><InputSelect aria-label="Bill vendor" class="field-input" @bind-Value="BillForm.VendorId"><option value="@Guid.Empty">Select vendor</option>@foreach (var vendor in Workspace.Payables.Vendors) { <option value="@vendor.Id">@vendor.VendorNumber — @vendor.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Bill number</label><InputText aria-label="Bill number" class="field-input" @bind-Value="BillForm.Number" /></div>
                    <div class="field-group"><label class="field-label">Bill date</label><InputDate aria-label="Bill date" class="field-input" @bind-Value="BillForm.Date" /></div>
                    <div class="field-group"><label class="field-label">Due date</label><InputDate aria-label="Bill due date" class="field-input" @bind-Value="BillForm.DueDate" /></div>
                </div>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Description</th><th>Quantity</th><th>Unit cost</th><th>Discount</th><th>Tax</th><th>Expense account</th><th>Line total</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var line in BillForm.Lines)
                            {
                                <tr @key="line">
                                    <td><InputText aria-label="Bill line description" class="field-input" @bind-Value="line.Description" /></td>
                                    <td><InputNumber aria-label="Bill line quantity" class="field-input" @bind-Value="line.Quantity" /></td>
                                    <td><InputNumber aria-label="Bill line unit cost" class="field-input" @bind-Value="line.UnitCost" /></td>
                                    <td><InputNumber aria-label="Bill line discount" class="field-input" @bind-Value="line.Discount" /></td>
                                    <td><InputNumber aria-label="Bill line tax" class="field-input" @bind-Value="line.Tax" /></td>
                                    <td><InputSelect aria-label="Bill line expense account" class="field-input" @bind-Value="line.ExpenseAccount">@foreach (var account in Workspace.GeneralLedger.Accounts.Where(x => x.Type == "Expense")) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></td>
                                    <td>@line.Total.ToString("C")</td>
                                    <td><button class="action-secondary" type="button" disabled="@(BillForm.Lines.Count == 1)" @onclick="() => RemoveBillLine(line)">Remove</button></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr><th colspan="6">Bill total</th><th>@BillForm.Total.ToString("C")</th><th></th></tr></tfoot>
                    </table>
                </div>
                <button class="action-secondary" type="button" @onclick="AddBillLine">Add line</button>
                <button class="action-primary" type="submit">Post bill</button>
            </EditForm>
        </section>

        <section class="panel">
            <h2>Apply vendor payment</h2>
            <EditForm Model="PaymentForm" OnValidSubmit="ApplyPaymentAsync"><div class="content-grid">
                <div class="field-group"><label class="field-label">Bill</label><InputSelect aria-label="Payment bill" class="field-input" @bind-Value="PaymentForm.BillId"><option value="@Guid.Empty">Select bill</option>@foreach (var bill in Workspace.Payables.Bills.Where(x => x.BalanceDue > 0)) { <option value="@bill.Id">@bill.BillNumber — @bill.BalanceDue.ToString("C")</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label">Payment account</label><InputSelect aria-label="Payment account" class="field-input" @bind-Value="PaymentForm.BankId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label">Amount</label><InputNumber aria-label="Payment amount" class="field-input" @bind-Value="PaymentForm.Amount" /></div>
                <div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Payment reference" class="field-input" @bind-Value="PaymentForm.Reference" /></div>
            </div><button class="action-primary" type="submit">Apply payment</button></EditForm>
        </section>

        <section class="content-grid">
            <article class="panel">
                <h2>Vendor roster</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vendor</th>
                            <th>State</th>
                            <th>Terms</th>
                            <th>Open balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vendor in Workspace.Payables.Vendors)
                        {
                            <tr>
                                <td>@vendor.VendorNumber - @vendor.Name</td>
                                <td>@vendor.State</td>
                                <td>@vendor.PaymentTerms</td>
                                <td>@vendor.OpenBalance.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>

            <article class="panel">
                <h2>Bill queue</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Bill</th>
                            <th>Vendor</th>
                            <th>Status</th>
                            <th>Lines</th>
                            <th>Due</th>
                            <th>Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in Workspace.Payables.Bills)
                        {
                            <tr>
                                <td>@bill.BillNumber</td>
                                <td>@bill.VendorName</td>
                                <td>@bill.Status</td>
                                <td>@(bill.Lines?.Count ?? 0)</td>
                                <td>@bill.DueDate.ToString("MMM d, yyyy")</td>
                                <td>@bill.BalanceDue.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>
        </section>
    </section>
}

@code {
    private BusinessWorkspaceSnapshot? Workspace;
    private string? StatusMessage;
    private BillEditor BillForm { get; } = new();
    private PaymentEditor PaymentForm { get; } = new();

    protected override async Task OnInitializedAsync()
    {
        Workspace = await WorkspaceService.GetWorkspaceAsync();
    }

    private async Task CreateBillAsync()
    {
        var lines = BillForm.Lines.Select(line => new VendorBillLineRequest(line.Description, line.Quantity, line.UnitCost, line.Discount, line.Tax, line.ExpenseAccount)).ToArray();
        var result = await TransactionService.CreateVendorBillAsync(new CreateVendorBillRequest(BillForm.VendorId, BillForm.Number, BillForm.Date, BillForm.DueDate, 0m, lines.FirstOrDefault()?.ExpenseAccountNumber ?? "5100", $"Bill {BillForm.Number}", lines));
        StatusMessage = result.Succeeded ? "Vendor bill posted." : result.ErrorMessage;
        if (result.Succeeded)
        {
            Workspace = await WorkspaceService.GetWorkspaceAsync();
            BillForm.Reset();
        }
    }

    private void AddBillLine() => BillForm.Lines.Add(new BillLineEditor());
    private void RemoveBillLine(BillLineEditor line) { if (BillForm.Lines.Count > 1) BillForm.Lines.Remove(line); }

    private async Task ApplyPaymentAsync()
    {
        var result = await TransactionService.ApplyBillPaymentAsync(new ApplyBillPaymentRequest(PaymentForm.BillId, PaymentForm.BankId, DateOnly.FromDateTime(DateTime.Today), PaymentForm.Amount, PaymentForm.Reference));
        StatusMessage = result.Succeeded ? "Vendor payment applied." : result.ErrorMessage;
        if (result.Succeeded) Workspace = await WorkspaceService.GetWorkspaceAsync();
    }

    private sealed class BillEditor
    {
        public Guid VendorId { get; set; }
        public string Number { get; set; } = string.Empty;
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public DateOnly DueDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(30));
        public List<BillLineEditor> Lines { get; } = [new()];
        public decimal Total => Lines.Sum(line => line.Total);
        public void Reset() { Number = string.Empty; Lines.Clear(); Lines.Add(new BillLineEditor()); }
    }
    private sealed class BillLineEditor
    {
        public string Description { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1m;
        public decimal UnitCost { get; set; }
        public decimal Discount { get; set; }
        public decimal Tax { get; set; }
        public string ExpenseAccount { get; set; } = "5100";
        public decimal Total => decimal.Round(Quantity * UnitCost - Discount + Tax, 2, MidpointRounding.AwayFromZero);
    }
    private sealed class PaymentEditor { public Guid BillId { get; set; } public Guid BankId { get; set; } public decimal Amount { get; set; } public string Reference { get; set; } = string.Empty; }
}
