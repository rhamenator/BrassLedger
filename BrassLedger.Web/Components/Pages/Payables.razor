@page "/payables"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.ManagePayables)]
@inject IBusinessWorkspaceService WorkspaceService
@inject IAccountingTransactionService TransactionService
@inject IConsolidationService ConsolidationService

<PageTitle>Payables</PageTitle>

@if (Workspace is null)
{
    <section class="panel">
        <h1>Loading payables...</h1>
    </section>
}
else
{
    <section class="page-shell">
        <header class="page-header">
            <div>
                <p class="eyebrow">Accounts Payable</p>
                <h1>Vendor management and outgoing cash commitments.</h1>
            </div>
            <p class="page-intro">Enter itemized vendor bills, distribute costs to expense accounts, and manage outstanding obligations.</p>
        </header>

        <section class="stats-grid">
            <article class="stat-card accent-sand">
                <span class="stat-value">@Workspace.Payables.OpenBalance.ToString("C0")</span>
                <span class="stat-label">Open A/P</span>
            </article>
            <article class="stat-card accent-sky">
                <span class="stat-value">@Workspace.Payables.Vendors.Count</span>
                <span class="stat-label">Vendors</span>
            </article>
            <article class="stat-card accent-sage">
                <span class="stat-value">@Workspace.Payables.Bills.Count</span>
                <span class="stat-label">Bills</span>
            </article>
            <article class="stat-card accent-coral">
                <span class="stat-value">@Workspace.Payables.DueThisWeekCount</span>
                <span class="stat-label">Due within 7 days</span>
            </article>
        </section>

        <section class="panel">
            <h2>Enter and post vendor bill</h2>
            @if (!string.IsNullOrWhiteSpace(StatusMessage)) { <p class="lead" role="status" aria-live="polite">@StatusMessage</p> }
            <EditForm Model="BillForm" OnValidSubmit="SaveBillDraftAsync">
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Vendor</label><InputSelect aria-label="Bill vendor" class="field-input" @bind-Value="BillForm.VendorId"><option value="@Guid.Empty">Select vendor</option>@foreach (var vendor in Workspace.Payables.Vendors) { <option value="@vendor.Id">@vendor.VendorNumber — @vendor.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Bill number</label><InputText aria-label="Bill number" class="field-input" @bind-Value="BillForm.Number" /></div>
                    <div class="field-group"><label class="field-label">Bill date</label><InputDate aria-label="Bill date" class="field-input" @bind-Value="BillForm.Date" /></div>
                    <div class="field-group"><label class="field-label">Due date</label><InputDate aria-label="Bill due date" class="field-input" @bind-Value="BillForm.DueDate" /></div>
                    <div class="field-group"><label class="field-label">Transaction currency</label><InputText aria-label="Bill transaction currency" class="field-input" maxlength="3" @bind-Value="BillForm.Currency" /><span class="field-help">Use a three-letter code. The company base currency is @Workspace.Company.BaseCurrency.</span></div>
                    <div class="field-group"><label class="field-label">Closing exchange rate</label><InputSelect aria-label="Bill exchange rate" class="field-input" @bind-Value="BillForm.ExchangeRateId" disabled="@(IsBaseCurrency(BillForm.Currency))"><option value="">Select retained rate</option>@foreach (var rate in ApplicableRates(BillForm.Currency, BillForm.Date)) { <option value="@rate.Id">@RateLabel(rate)</option> }</InputSelect></div>
                </div>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Description</th><th>Project</th><th>Phase / task</th><th>Cost code</th><th>Department</th><th>Class</th><th>Quantity</th><th>Unit cost</th><th>Discount</th><th>Tax</th><th>Expense account</th><th>Line total</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var line in BillForm.Lines)
                            {
                                <tr @key="line">
                                    <td><InputText aria-label="Bill line description" class="field-input" @bind-Value="line.Description" /></td>
                                    <td><InputSelect aria-label="Bill line project" class="field-input" @bind-Value="line.ProjectJobId" @bind-Value:after="line.ProjectChanged"><option value="">No project</option>@foreach (var project in Workspace.Projects.Jobs.Where(project => project.Status == "Active")) { <option value="@project.Id">@project.JobNumber</option> }</InputSelect></td>
                                    <td><InputSelect aria-label="Bill line project phase" class="field-input" @bind-Value="line.ProjectPhaseId" disabled="@(!line.ProjectJobId.HasValue)"><option value="">No phase</option>@foreach (var phase in (Workspace.Projects.Phases ?? []).Where(phase => phase.IsActive && phase.ProjectJobId == line.ProjectJobId)) { <option value="@phase.Id">@phase.Code — @phase.Name</option> }</InputSelect></td>
                                    <td><InputSelect aria-label="Bill line project cost code" class="field-input" @bind-Value="line.ProjectCostCodeId" disabled="@(!line.ProjectJobId.HasValue)"><option value="">No cost code</option>@foreach (var costCode in (Workspace.Projects.CostCodes ?? []).Where(candidate => candidate.IsActive)) { <option value="@costCode.Id">@costCode.Code — @costCode.Name</option> }</InputSelect></td>
                                    <td><InputSelect aria-label="Bill line department" class="field-input" @bind-Value="line.DepartmentId"><option value="">No department</option>@foreach (var dimension in ActiveTrackingDimensions("Department", BillForm.Date)) { <option value="@dimension.Id">@dimension.Code — @dimension.Name</option> }</InputSelect></td>
                                    <td><InputSelect aria-label="Bill line class" class="field-input" @bind-Value="line.ClassId"><option value="">No class</option>@foreach (var dimension in ActiveTrackingDimensions("Class", BillForm.Date)) { <option value="@dimension.Id">@dimension.Code — @dimension.Name</option> }</InputSelect></td>
                                    <td><InputNumber aria-label="Bill line quantity" class="field-input" @bind-Value="line.Quantity" /></td>
                                    <td><InputNumber aria-label="Bill line unit cost" class="field-input" @bind-Value="line.UnitCost" /></td>
                                    <td><InputNumber aria-label="Bill line discount" class="field-input" @bind-Value="line.Discount" /></td>
                                    <td><InputNumber aria-label="Bill line tax" class="field-input" @bind-Value="line.Tax" /></td>
                                    <td><InputSelect aria-label="Bill line expense account" class="field-input" @bind-Value="line.ExpenseAccount">@foreach (var account in Workspace.GeneralLedger.Accounts.Where(x => x.Type == "Expense")) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></td>
                                    <td>@line.Total.ToString("C")</td>
                                    <td><button class="action-secondary" type="button" disabled="@(BillForm.Lines.Count == 1)" @onclick="() => RemoveBillLine(line)">Remove</button></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr><th colspan="11">Bill total</th><th>@BillForm.Total.ToString("C")</th><th></th></tr></tfoot>
                    </table>
                </div>
                <button class="action-secondary" type="button" @onclick="AddBillLine">Add line</button>
                <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareSubledgerDocuments" Context="billPreparationAuthorization"><button class="action-primary" type="submit">Save bill draft</button><div class="content-grid"><div class="field-group"><label class="field-label">Recurring frequency</label><InputSelect aria-label="Recurring bill frequency" class="field-input" @bind-Value="RecurringForm.Frequency"><option>Monthly</option><option>Weekly</option><option>Quarterly</option><option>Annually</option></InputSelect></div><div class="field-group"><label class="field-label">Every</label><InputNumber aria-label="Recurring bill interval" class="field-input" @bind-Value="RecurringForm.Interval" /></div><div class="field-group"><label class="field-label">Next date</label><InputDate aria-label="Recurring bill next date" class="field-input" @bind-Value="RecurringForm.NextDate" /></div></div><button class="action-secondary" type="button" @onclick="SaveRecurringBillTemplateAsync">Save recurring template</button></AuthorizeView>
            </EditForm>
        </section>

        <section class="panel">
            <h2>Vendor bill review queue</h2>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PrepareSubledgerDocuments">
                <div class="content-grid"><div class="field-group"><label class="field-label">Generate recurring drafts through</label><InputDate aria-label="Generate recurring bill drafts through" class="field-input" @bind-Value="RecurringForm.GenerateThrough" /></div><button class="action-secondary" type="button" @onclick="GenerateRecurringDraftsAsync">Generate due drafts</button></div>
            </AuthorizeView>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApproveSubledgerDocuments">
                <div class="field-group"><label class="field-label">Rejection reason</label><InputText aria-label="Vendor bill rejection reason" class="field-input" @bind-Value="RejectionReason" /><span class="field-help">Enter a reason, then reject the applicable draft. The preparer can correct and resubmit it using the same vendor and bill number.</span></div>
            </AuthorizeView>
            <div class="table-scroll"><table class="data-table"><thead><tr><th>Number</th><th>Status</th><th>Review note</th><th>Source</th><th>Next</th><th>Actions</th></tr></thead><tbody>
                @foreach (var workflow in Workspace.Payables.Workflows ?? [])
                {
                    <tr><td>@workflow.DocumentNumber</td><td>@workflow.Status</td><td>@(string.IsNullOrWhiteSpace(workflow.DecisionReason) ? "—" : workflow.DecisionReason)</td><td>@(workflow.IsRecurringTemplate ? $"{workflow.Frequency} template" : workflow.SourceTemplateId.HasValue ? "Recurring draft" : "Manual draft")</td><td>@workflow.NextOccurrenceDate</td><td>
                        @if (!workflow.IsRecurringTemplate && workflow.Status == "Draft") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApproveSubledgerDocuments"><button class="action-secondary" type="button" @onclick="() => ApproveWorkflowAsync(workflow.Id)">Approve</button></AuthorizeView> }
                        @if (!workflow.IsRecurringTemplate && workflow.Status is "Draft" or "Approved") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApproveSubledgerDocuments"><button class="action-secondary" type="button" @onclick="() => RejectWorkflowAsync(workflow)">Reject</button></AuthorizeView> }
                        @if (!workflow.IsRecurringTemplate && workflow.Status == "Approved") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PostSubledgerDocuments"><button class="action-primary" type="button" @onclick="() => PostWorkflowAsync(workflow.Id)">Post</button></AuthorizeView> }
                    </td></tr>
                }
            </tbody></table></div>
        </section>

        <section class="panel">
            <h2>Record vendor payment or advance</h2>
            <p class="page-intro">Apply one disbursement across bills or leave part of it unapplied as a vendor advance.</p>
            <EditForm Model="PaymentForm" OnValidSubmit="ApplyPaymentAsync">
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Vendor</label><InputSelect aria-label="Payment vendor" class="field-input" @bind-Value="PaymentForm.VendorId"><option value="@Guid.Empty">Select vendor</option>@foreach (var vendor in Workspace.Payables.Vendors) { <option value="@vendor.Id">@vendor.VendorNumber — @vendor.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Payment account</label><InputSelect aria-label="Payment account" class="field-input" @bind-Value="PaymentForm.BankId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Payment date</label><InputDate aria-label="Vendor payment date" class="field-input" @bind-Value="PaymentForm.Date" /></div>
                    <div class="field-group"><label class="field-label">Payment total</label><InputNumber aria-label="Vendor payment total" class="field-input" @bind-Value="PaymentForm.Amount" /></div>
                    <div class="field-group"><label class="field-label">Method</label><InputSelect aria-label="Vendor payment method" class="field-input" @bind-Value="PaymentForm.Method">@foreach (var method in PaymentMethods) { <option value="@method">@method</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Payment reference" class="field-input" @bind-Value="PaymentForm.Reference" /></div>
                    <div class="field-group"><label class="field-label">Transaction currency</label><InputText aria-label="Vendor payment transaction currency" class="field-input" maxlength="3" @bind-Value="PaymentForm.Currency" /><span class="field-help">Applications are limited to bills in this currency.</span></div>
                    <div class="field-group"><label class="field-label">Closing exchange rate</label><InputSelect aria-label="Vendor payment exchange rate" class="field-input" @bind-Value="PaymentForm.ExchangeRateId" disabled="@(IsBaseCurrency(PaymentForm.Currency))"><option value="">Select retained rate</option>@foreach (var rate in ApplicableRates(PaymentForm.Currency, PaymentForm.Date)) { <option value="@rate.Id">@RateLabel(rate)</option> }</InputSelect></div>
                </div>
                @if (PaymentForm.VendorId != Guid.Empty)
                {
                    <div class="table-scroll"><table class="data-table"><thead><tr><th>Apply</th><th>Bill</th><th>Due</th><th>Open balance</th><th>Apply amount</th></tr></thead><tbody>
                        @foreach (var application in AvailableBillApplications)
                        {
                            <tr @key="application.DocumentId"><td><InputCheckbox aria-label="@($"Apply to {application.DocumentNumber}")" @bind-Value="application.Selected" /></td><td>@application.DocumentNumber</td><td>@application.DueDate</td><td>@application.OpenBalance.ToString("N2") @application.Currency</td><td><InputNumber aria-label="@($"Amount for {application.DocumentNumber}")" class="field-input" disabled="@(!application.Selected)" @bind-Value="application.Amount" /></td></tr>
                        }
                    </tbody><tfoot><tr><th colspan="3">Payment allocation</th><th>Applied: @PaymentForm.AppliedAmount.ToString("C")</th><th>Unapplied advance: @PaymentForm.UnappliedAmount.ToString("C")</th></tr></tfoot></table></div>
                }
                <button class="action-primary" type="submit">Record vendor payment</button>
            </EditForm>
        </section>

        <section class="panel">
            <h2>Vendor payment history</h2>
            <div class="content-grid"><div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Vendor payment reversal date" class="field-input" @bind-Value="ReversalForm.Date" /></div><div class="field-group"><label class="field-label">Outcome</label><InputSelect aria-label="Vendor payment reversal kind" class="field-input" @bind-Value="ReversalForm.Kind"><option>Voided</option><option>Returned</option><option>Reversed</option></InputSelect></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Vendor payment reversal reason" class="field-input" @bind-Value="ReversalForm.Reason" /></div></div>
            <div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Vendor</th><th>Reference</th><th>Method</th><th>Transaction total</th><th>Applied</th><th>Advance</th><th>Base total</th><th>Realized FX</th><th>Rate provenance</th><th>Status</th><th></th></tr></thead><tbody>
                @foreach (var payment in Workspace.Payables.Payments ?? [])
                {
                    <tr><td>@payment.PaymentDate</td><td>@payment.CounterpartyName</td><td>@payment.Reference</td><td>@payment.Method</td><td>@FormatTransactionAmount(payment.TransactionAmount, payment.TransactionCurrency)</td><td>@FormatTransactionAmount(payment.TransactionAppliedAmount, payment.TransactionCurrency)</td><td>@FormatTransactionAmount(payment.TransactionUnappliedAmount, payment.TransactionCurrency)</td><td>@payment.Amount.ToString("C") @Workspace.Company.BaseCurrency</td><td>@payment.RealizedGainLoss.ToString("N2") @Workspace.Company.BaseCurrency</td><td>@(!IsBaseCurrency(payment.TransactionCurrency) ? $"{payment.ExchangeRateEffectiveOn}: {payment.ExchangeRateToBase:N10} — {payment.ExchangeRateSource}" : "Base currency")</td><td>@payment.Status</td><td>@if (payment.Status == "Posted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments"><button class="action-secondary" type="button" @onclick="() => ReversePaymentAsync(payment.Id)">Record @ReversalForm.Kind.ToLowerInvariant()</button></AuthorizeView> }</td></tr>
                }
            </tbody></table></div>
        </section>

        <section class="panel"><h2>Vendor credits</h2><EditForm Model="CreditForm" OnValidSubmit="RecordVendorCreditAsync"><div class="content-grid">
            <div class="field-group"><label class="field-label">Bill</label><InputSelect aria-label="Vendor credit bill" class="field-input" @bind-Value="CreditForm.BillId"><option value="@Guid.Empty">Select bill</option>@foreach (var bill in Workspace.Payables.Bills.Where(item => item.BalanceDue > 0)) { <option value="@bill.Id">@bill.BillNumber — @bill.BalanceDue.ToString("C")</option> }</InputSelect></div>
            <div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Vendor credit date" class="field-input" @bind-Value="CreditForm.Date" /></div><div class="field-group"><label class="field-label">Amount</label><InputNumber aria-label="Vendor credit amount" class="field-input" @bind-Value="CreditForm.Amount" /></div>
            <div class="field-group"><label class="field-label">Offset account</label><InputSelect aria-label="Vendor credit offset account" class="field-input" @bind-Value="CreditForm.OffsetAccount"><option value="">Select account</option>@foreach (var account in Workspace.GeneralLedger.Accounts.Where(item => !item.IsControlAccount && item.Type is "Expense" or "Asset")) { <option value="@account.Number">@account.Number — @account.Name</option> }</InputSelect></div>
            <div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Vendor credit reference" class="field-input" @bind-Value="CreditForm.Reference" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Vendor credit reason" class="field-input" @bind-Value="CreditForm.Reason" /></div>
        </div><button class="action-primary" type="submit">Post vendor credit</button></EditForm></section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments" Context="refundAuthorization"><section class="panel"><h2>Refund advance or void bill</h2><div class="content-grid">
            <EditForm Model="RefundForm" OnValidSubmit="RefundAdvanceAsync"><div class="field-group"><label class="field-label">Advance</label><InputSelect aria-label="Refund vendor advance" class="field-input" @bind-Value="RefundForm.PaymentId"><option value="@Guid.Empty">Select advance</option>@foreach (var payment in (Workspace.Payables.Payments ?? []).Where(item => item.Status == "Posted" && item.TransactionUnappliedAmount > 0)) { <option value="@payment.Id">@payment.Reference — @FormatTransactionAmount(payment.TransactionUnappliedAmount, payment.TransactionCurrency) (@payment.UnappliedAmount.ToString("C") carrying)</option> }</InputSelect></div><div class="field-group"><label class="field-label">Bank</label><InputSelect aria-label="Vendor refund bank" class="field-input" @bind-Value="RefundForm.BankId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div><div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Vendor refund date" class="field-input" @bind-Value="RefundForm.Date" /></div>@if (SelectedRefundPayment is { } refundPayment && !IsBaseCurrency(refundPayment.TransactionCurrency)) { <div class="field-group"><label class="field-label">Refund-date closing exchange rate</label><InputSelect aria-label="Vendor refund exchange rate" class="field-input" @bind-Value="RefundForm.ExchangeRateId"><option value="">Select retained rate</option>@foreach (var rate in ApplicableRates(refundPayment.TransactionCurrency, RefundForm.Date)) { <option value="@rate.Id">@RateLabel(rate)</option> }</InputSelect></div> }<div class="field-group"><label class="field-label">Amount (@(SelectedRefundPayment?.TransactionCurrency ?? Workspace.Company.BaseCurrency))</label><InputNumber aria-label="Vendor refund amount" class="field-input" @bind-Value="RefundForm.Amount" /></div><div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Vendor refund reference" class="field-input" @bind-Value="RefundForm.Reference" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Vendor refund reason" class="field-input" @bind-Value="RefundForm.Reason" /></div><button class="action-primary" type="submit">Record vendor refund</button></EditForm>
            <EditForm Model="VoidForm" OnValidSubmit="VoidBillAsync"><div class="field-group"><label class="field-label">Bill</label><InputSelect aria-label="Void vendor bill" class="field-input" @bind-Value="VoidForm.DocumentId"><option value="@Guid.Empty">Select bill</option>@foreach (var bill in Workspace.Payables.Bills.Where(item => item.Status != "Voided" && item.BalanceDue == item.TotalAmount)) { <option value="@bill.Id">@bill.BillNumber</option> }</InputSelect></div><div class="field-group"><label class="field-label">Date</label><InputDate aria-label="Vendor bill void date" class="field-input" @bind-Value="VoidForm.Date" /></div><div class="field-group"><label class="field-label">Reason</label><InputText aria-label="Vendor bill void reason" class="field-input" @bind-Value="VoidForm.Reason" /></div><button class="action-primary" type="submit">Void vendor bill</button></EditForm>
        </div></section></AuthorizeView>

        <section class="panel"><h2>Vendor adjustment history</h2><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments"><div class="content-grid"><div class="field-group"><label class="field-label">Reversal date</label><InputDate aria-label="Vendor adjustment reversal date" class="field-input" @bind-Value="AdjustmentReversalForm.Date" /></div><div class="field-group"><label class="field-label">Reversal reason</label><InputText aria-label="Vendor adjustment reversal reason" class="field-input" @bind-Value="AdjustmentReversalForm.Reason" /></div></div></AuthorizeView><div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Kind</th><th>Vendor</th><th>Document</th><th>Reference</th><th>Amount</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var adjustment in Workspace.Payables.Adjustments ?? []) { <tr><td>@adjustment.AdjustmentDate</td><td>@adjustment.Kind</td><td>@adjustment.CounterpartyName</td><td>@adjustment.DocumentNumber</td><td>@adjustment.Reference</td><td>@adjustment.Amount.ToString("C")</td><td>@adjustment.Status</td><td>@if (adjustment.Status == "Posted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayments"><button class="action-secondary" type="button" @onclick="() => ReverseAdjustmentAsync(adjustment.Id)">Reverse</button></AuthorizeView> }</td></tr> }</tbody></table></div></section>

        <section class="content-grid">
            <article class="panel">
                <h2>Vendor roster</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vendor</th>
                            <th>State</th>
                            <th>Terms</th>
                            <th>Open balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vendor in Workspace.Payables.Vendors)
                        {
                            <tr>
                                <td>@vendor.VendorNumber - @vendor.Name</td>
                                <td>@vendor.State</td>
                                <td>@vendor.PaymentTerms</td>
                                <td>@vendor.OpenBalance.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>

            <article class="panel">
                <h2>Bill queue</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Bill</th>
                            <th>Vendor</th>
                            <th>Status</th>
                            <th>Lines</th>
                            <th>Due</th>
                            <th>Transaction balance</th>
                            <th>Base balance</th>
                            <th>Rate provenance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in Workspace.Payables.Bills)
                        {
                            <tr>
                                <td>@bill.BillNumber</td>
                                <td>@bill.VendorName</td>
                                <td>@bill.Status</td>
                                <td>@(bill.Lines?.Count ?? 0)</td>
                                <td>@bill.DueDate.ToString("MMM d, yyyy")</td>
                                <td>@FormatTransactionAmount(bill.TransactionBalanceDue, bill.TransactionCurrency)</td>
                                <td>@bill.BalanceDue.ToString("N2") @Workspace.Company.BaseCurrency</td>
                                <td>@(!IsBaseCurrency(bill.TransactionCurrency) ? $"{bill.ExchangeRateEffectiveOn}: {bill.ExchangeRateToBase:N10} — {bill.ExchangeRateSource}" : "Base currency")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>
        </section>
    </section>
}

@code {
    private BusinessWorkspaceSnapshot? Workspace;
    private IReadOnlyList<ExchangeRateSnapshot> ExchangeRates = [];
    private string? StatusMessage;
    private string RejectionReason = string.Empty;
    private BillEditor BillForm { get; } = new();
    private PaymentEditor PaymentForm { get; } = new();
    private PaymentReversalEditor ReversalForm { get; } = new();
    private VendorCreditEditor CreditForm { get; } = new();
    private RefundEditor RefundForm { get; } = new();
    private VoidEditor VoidForm { get; } = new();
    private AdjustmentReversalEditor AdjustmentReversalForm { get; } = new();
    private RecurringEditor RecurringForm { get; } = new();
    private static readonly string[] PaymentMethods = ["Check", "ACH", "Card", "Wire", "Cash", "Other"];
    private IEnumerable<PaymentApplicationEditor> AvailableBillApplications => PaymentForm.Applications.Where(application => application.CounterpartyId == PaymentForm.VendorId && application.Currency == NormalizeCurrency(PaymentForm.Currency));

    protected override async Task OnInitializedAsync()
    {
        Workspace = await WorkspaceService.GetWorkspaceAsync();
        ExchangeRates = await ConsolidationService.GetExchangeRatesAsync();
        BillForm.Currency = PaymentForm.Currency = Workspace.Company.BaseCurrency;
        SetBillDefaults();
        SyncPaymentApplications();
    }

    private async Task SaveBillDraftAsync()
    {
        var lines = BillForm.Lines.Select(line => new VendorBillLineRequest(line.Description, line.Quantity, line.UnitCost, line.Discount, line.Tax, line.ExpenseAccount, line.ProjectJobId, line.ProjectPhaseId, line.ProjectCostCodeId, line.DepartmentId, line.ClassId)).ToArray();
        var result = await TransactionService.SaveVendorBillDraftAsync(new CreateVendorBillRequest(BillForm.VendorId, BillForm.Number, BillForm.Date, BillForm.DueDate, 0m, lines.FirstOrDefault()?.ExpenseAccountNumber ?? DefaultCostAccountNumber, $"Bill {BillForm.Number}", lines, Currency: BillForm.Currency, ExchangeRateId: BillForm.ExchangeRateId));
        StatusMessage = result.Succeeded ? "Vendor bill draft saved." : result.ErrorMessage;
        if (result.Succeeded)
        {
            Workspace = await WorkspaceService.GetWorkspaceAsync();
            BillForm.Reset(DefaultCostAccountNumber);
            SyncPaymentApplications();
        }
    }

    private async Task SaveRecurringBillTemplateAsync() { var lines = BillForm.Lines.Select(line => new VendorBillLineRequest(line.Description, line.Quantity, line.UnitCost, line.Discount, line.Tax, line.ExpenseAccount, line.ProjectJobId, line.ProjectPhaseId, line.ProjectCostCodeId, line.DepartmentId, line.ClassId)).ToArray(); var request = new CreateVendorBillRequest(BillForm.VendorId, BillForm.Number, BillForm.Date, BillForm.DueDate, 0m, lines.FirstOrDefault()?.ExpenseAccountNumber ?? DefaultCostAccountNumber, $"Recurring bill {BillForm.Number}", lines, BillForm.Currency, BillForm.ExchangeRateId); var result = await TransactionService.SaveRecurringVendorBillTemplateAsync(new SaveRecurringVendorBillTemplateRequest(request, RecurringForm.Frequency, RecurringForm.Interval, RecurringForm.NextDate)); StatusMessage = result.Succeeded ? "Recurring vendor bill template saved." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); BillForm.Reset(DefaultCostAccountNumber); } }
    private async Task GenerateRecurringDraftsAsync() { var result = await TransactionService.GenerateDueRecurringDocumentsAsync(RecurringForm.GenerateThrough); StatusMessage = result.Succeeded ? "Due recurring drafts generated." : result.ErrorMessage; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    private async Task ApproveWorkflowAsync(Guid id) { var result = await TransactionService.ApproveSubledgerDocumentAsync(id); StatusMessage = result.Succeeded ? "Vendor bill draft approved." : result.ErrorMessage; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    private async Task RejectWorkflowAsync(SubledgerDocumentWorkflowSnapshot workflow) { var result = await TransactionService.RejectSubledgerDocumentAsync(new RejectSubledgerDocumentRequest(workflow.Id, RejectionReason, workflow.ConcurrencyToken)); StatusMessage = result.Succeeded ? "Vendor bill draft rejected. Its preparer can correct and resubmit it using the same vendor and bill number." : result.ErrorMessage; if (result.Succeeded) RejectionReason = string.Empty; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    private async Task PostWorkflowAsync(Guid id) { var result = await TransactionService.PostApprovedSubledgerDocumentAsync(id); StatusMessage = result.Succeeded ? "Approved vendor bill posted." : result.ErrorMessage; Workspace = await WorkspaceService.GetWorkspaceAsync(); SyncPaymentApplications(); }

    private void AddBillLine() => BillForm.Lines.Add(new BillLineEditor { ExpenseAccount = DefaultCostAccountNumber });
    private void RemoveBillLine(BillLineEditor line) { if (BillForm.Lines.Count > 1) BillForm.Lines.Remove(line); }

    private async Task ApplyPaymentAsync()
    {
        var applications = AvailableBillApplications.Where(application => application.Selected).Select(application => new PaymentDocumentApplicationRequest(application.DocumentId, application.Amount)).ToArray();
        var result = await TransactionService.RecordVendorPaymentAsync(new RecordVendorPaymentRequest(PaymentForm.VendorId, PaymentForm.BankId, PaymentForm.Date, PaymentForm.Amount, PaymentForm.Reference, PaymentForm.Method, applications, PaymentForm.Currency, PaymentForm.ExchangeRateId));
        StatusMessage = result.Succeeded ? "Vendor payment recorded." : result.ErrorMessage;
        if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); PaymentForm.Reset(); SyncPaymentApplications(); }
    }

    private async Task ReversePaymentAsync(Guid paymentId)
    {
        var result = await TransactionService.ReverseSubledgerPaymentAsync(new ReverseSubledgerPaymentRequest(paymentId, ReversalForm.Date, ReversalForm.Reason, ReversalForm.Kind));
        StatusMessage = result.Succeeded ? $"Vendor payment marked {ReversalForm.Kind.ToLowerInvariant()}." : result.ErrorMessage;
        if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); PaymentForm.Reset(); SyncPaymentApplications(); ReversalForm.Reason = string.Empty; }
    }

    private async Task RecordVendorCreditAsync() { var result = await TransactionService.RecordVendorCreditAsync(new RecordVendorCreditRequest(CreditForm.BillId, CreditForm.Date, CreditForm.Amount, CreditForm.Reference, CreditForm.OffsetAccount, CreditForm.Reason)); StatusMessage = result.Succeeded ? "Vendor credit posted." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); CreditForm.Reset(); SyncPaymentApplications(); } }
    private async Task RefundAdvanceAsync() { var result = await TransactionService.RefundUnappliedPaymentAsync(new RefundUnappliedPaymentRequest(RefundForm.PaymentId, RefundForm.BankId, RefundForm.Date, RefundForm.Amount, RefundForm.Reference, RefundForm.Reason, RefundForm.ExchangeRateId)); StatusMessage = result.Succeeded ? "Vendor refund recorded." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); RefundForm.Reset(); } }
    private async Task VoidBillAsync() { var result = await TransactionService.VoidVendorBillAsync(new VoidSubledgerDocumentRequest(VoidForm.DocumentId, VoidForm.Date, VoidForm.Reason)); StatusMessage = result.Succeeded ? "Vendor bill voided." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); VoidForm.Reset(); SyncPaymentApplications(); } }
    private async Task ReverseAdjustmentAsync(Guid id) { var result = await TransactionService.ReverseSubledgerAdjustmentAsync(new ReverseSubledgerAdjustmentRequest(id, AdjustmentReversalForm.Date, AdjustmentReversalForm.Reason)); StatusMessage = result.Succeeded ? "Vendor adjustment reversed." : result.ErrorMessage; if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); AdjustmentReversalForm.Reason = string.Empty; SyncPaymentApplications(); } }

    private void SyncPaymentApplications()
    {
        PaymentForm.Applications.Clear();
        if (Workspace is null) return;
        PaymentForm.Applications.AddRange(Workspace.Payables.Bills.Where(bill => bill.TransactionBalanceDue > 0).Select(bill => new PaymentApplicationEditor(bill.Id, bill.VendorId, bill.BillNumber, bill.DueDate, bill.TransactionBalanceDue, bill.TransactionCurrency)));
    }

    private string NormalizeCurrency(string? currency) => (string.IsNullOrWhiteSpace(currency) ? Workspace?.Company.BaseCurrency : currency)?.Trim().ToUpperInvariant() ?? string.Empty;
    private bool IsBaseCurrency(string? currency) => NormalizeCurrency(currency) == Workspace?.Company.BaseCurrency;
    private string FormatTransactionAmount(decimal amount, string currency) => IsBaseCurrency(currency) ? $"{amount:C} {currency}" : $"{amount:N2} {currency}";
    private IEnumerable<ExchangeRateSnapshot> ApplicableRates(string? currency, DateOnly date)
    {
        var transactionCurrency = NormalizeCurrency(currency); var baseCurrency = Workspace?.Company.BaseCurrency ?? string.Empty;
        return ExchangeRates.Where(rate => rate.IsActive && rate.RateType == "Closing" && rate.EffectiveOn <= date && ((rate.BaseCurrency == transactionCurrency && rate.QuoteCurrency == baseCurrency) || (rate.BaseCurrency == baseCurrency && rate.QuoteCurrency == transactionCurrency))).OrderByDescending(rate => rate.EffectiveOn);
    }
    private static string RateLabel(ExchangeRateSnapshot rate) => $"{rate.EffectiveOn}: {rate.BaseCurrency}/{rate.QuoteCurrency} {rate.Rate:N8} — {rate.Source}";
    private SubledgerPaymentSnapshot? SelectedRefundPayment => (Workspace?.Payables.Payments ?? []).SingleOrDefault(payment => payment.Id == RefundForm.PaymentId);

    private string DefaultCostAccountNumber => Workspace?.GeneralLedger.Accounts.SingleOrDefault(account => account.OperationalRole == BrassLedger.Domain.Accounting.AccountingAccountRoles.CostOfGoodsSold)?.Number ?? string.Empty;
    private IEnumerable<TrackingDimensionValueSnapshot> ActiveTrackingDimensions(string type, DateOnly effectiveOn) =>
        (Workspace?.GeneralLedger.TrackingDimensions ?? []).Where(value => value.DimensionType == type && value.IsActive && (!value.EffectiveFrom.HasValue || value.EffectiveFrom <= effectiveOn) && (!value.EffectiveThrough.HasValue || value.EffectiveThrough >= effectiveOn));

    private void SetBillDefaults()
    {
        foreach (var line in BillForm.Lines.Where(line => string.IsNullOrWhiteSpace(line.ExpenseAccount))) line.ExpenseAccount = DefaultCostAccountNumber;
        if (string.IsNullOrWhiteSpace(CreditForm.OffsetAccount)) CreditForm.OffsetAccount = DefaultCostAccountNumber;
    }

    private sealed class BillEditor
    {
        public Guid VendorId { get; set; }
        public string Number { get; set; } = string.Empty;
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public DateOnly DueDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(30));
        public string Currency { get; set; } = string.Empty;
        public Guid? ExchangeRateId { get; set; }
        public List<BillLineEditor> Lines { get; } = [new()];
        public decimal Total => Lines.Sum(line => line.Total);
        public void Reset(string defaultCostAccount) { Number = string.Empty; ExchangeRateId = null; Lines.Clear(); Lines.Add(new BillLineEditor { ExpenseAccount = defaultCostAccount }); }
    }
    private sealed class BillLineEditor
    {
        public string Description { get; set; } = string.Empty;
        public Guid? ProjectJobId { get; set; }
        public Guid? ProjectPhaseId { get; set; }
        public Guid? ProjectCostCodeId { get; set; }
        public Guid? DepartmentId { get; set; }
        public Guid? ClassId { get; set; }
        public decimal Quantity { get; set; } = 1m;
        public decimal UnitCost { get; set; }
        public decimal Discount { get; set; }
        public decimal Tax { get; set; }
        public string ExpenseAccount { get; set; } = string.Empty;
        public decimal Total => decimal.Round(Quantity * UnitCost - Discount + Tax, 2, MidpointRounding.AwayFromZero);
        public void ProjectChanged() { ProjectPhaseId = null; if (!ProjectJobId.HasValue) ProjectCostCodeId = null; }
    }
    private sealed class PaymentEditor
    {
        public Guid VendorId { get; set; }
        public Guid BankId { get; set; }
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public decimal Amount { get; set; }
        public string Method { get; set; } = "Check";
        public string Reference { get; set; } = string.Empty;
        public string Currency { get; set; } = string.Empty;
        public Guid? ExchangeRateId { get; set; }
        public List<PaymentApplicationEditor> Applications { get; } = [];
        public decimal AppliedAmount => Applications.Where(application => application.Selected).Sum(application => application.Amount);
        public decimal UnappliedAmount => Math.Max(0m, Amount - AppliedAmount);
        public void Reset() { VendorId = Guid.Empty; Amount = 0m; Reference = string.Empty; ExchangeRateId = null; Applications.Clear(); }
    }
    private sealed class PaymentApplicationEditor(Guid documentId, Guid counterpartyId, string documentNumber, DateOnly dueDate, decimal openBalance, string currency)
    {
        public Guid DocumentId { get; } = documentId; public Guid CounterpartyId { get; } = counterpartyId; public string DocumentNumber { get; } = documentNumber; public DateOnly DueDate { get; } = dueDate; public decimal OpenBalance { get; } = openBalance; public string Currency { get; } = currency; public bool Selected { get; set; } public decimal Amount { get; set; } = openBalance;
    }
    private sealed class PaymentReversalEditor { public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public string Kind { get; set; } = "Voided"; public string Reason { get; set; } = string.Empty; }
    private sealed class VendorCreditEditor { public Guid BillId { get; set; } public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public decimal Amount { get; set; } public string Reference { get; set; } = string.Empty; public string OffsetAccount { get; set; } = string.Empty; public string Reason { get; set; } = string.Empty; public void Reset() { BillId = Guid.Empty; Amount = 0; Reference = string.Empty; Reason = string.Empty; } }
    private sealed class RefundEditor { public Guid PaymentId { get; set; } public Guid BankId { get; set; } public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public decimal Amount { get; set; } public Guid? ExchangeRateId { get; set; } public string Reference { get; set; } = string.Empty; public string Reason { get; set; } = string.Empty; public void Reset() { PaymentId = Guid.Empty; Amount = 0; ExchangeRateId = null; Reference = string.Empty; Reason = string.Empty; } }
    private sealed class VoidEditor { public Guid DocumentId { get; set; } public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public string Reason { get; set; } = string.Empty; public void Reset() { DocumentId = Guid.Empty; Reason = string.Empty; } }
    private sealed class AdjustmentReversalEditor { public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today); public string Reason { get; set; } = string.Empty; }
    private sealed class RecurringEditor { public string Frequency { get; set; } = "Monthly"; public int Interval { get; set; } = 1; public DateOnly NextDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddMonths(1)); public DateOnly GenerateThrough { get; set; } = DateOnly.FromDateTime(DateTime.Today); }
}
