    private void AddParameterRow()
    {
        ParameterEditors.Add(new TaxParameterEditor
        {
            ValueType = "number",
            DisplayOrder = ParameterEditors.Count == 0 ? 10 : ParameterEditors.Max(parameter => parameter.DisplayOrder) + 10
        });
    }

    private void AddBracketRow()
    {
        BracketEditors.Add(new TaxBracketEditor
        {
            Sequence = BracketEditors.Count == 0 ? 1 : BracketEditors.Max(bracket => bracket.Sequence) + 1,
            UpperBoundAmount = 9999999.99m
        });
    }

    private void AddFormRequirementRow()
    {
        FormRequirementEditors.Add(new TaxFormRequirementEditor
        {
            FilingFrequency = "Quarterly"
        });
    }
    private void AddFieldDefinitionRow() => FieldDefinitionEditors.Add(new TaxFieldDefinitionEditor { DataType = "text", DefaultValueJson = "null", ValidationJson = "{}", DisplayOrder = FieldDefinitionEditors.Count == 0 ? 10 : FieldDefinitionEditors.Max(field => field.DisplayOrder) + 10 });
    private void AddTestCaseRow() => TestCaseEditors.Add(new TaxTestCaseEditor { InputJson = "{\"grossPay\":0}", ExpectedOutputJson = "{\"amount\":0}", IsRequiredForActivation = true });

    private async Task ReloadTaxSnapshotAsync()
    {
        TaxSnapshot = await TaxAdministrationService.GetSnapshotAsync();
        if (!SelectedRuleId.HasValue || TaxSnapshot.RuleSets.All(rule => rule.Id != SelectedRuleId.Value))
        {
            SelectedRuleId = TaxSnapshot.RuleSets.FirstOrDefault()?.Id;
        }

        LoadSelectedRuleEditors();
    }

    private async Task ImportTaxLocusAsync()
    {
        var result = await TaxAdministrationService.ImportTaxLocusAsync();
        StatusMessage = result.Succeeded ? "TaxLocus payroll reference files were captured in a new draft package (or the identical package was already present)." : result.ErrorMessage;
        if (result.Succeeded) await ReloadTaxSnapshotAsync();
    }

    private async Task CaptureStateSourceAsync()
    {
        var result = await TaxAdministrationService.CaptureStateSourceAsync(new CaptureTaxSourceRequest(SourceCaptureForm.JurisdictionCode, SourceCaptureForm.SourceUrl, SourceCaptureForm.Notes));
        StatusMessage = result.Succeeded ? "Official source captured with a content checksum for review." : result.ErrorMessage;
        if (result.Succeeded) { SourceCaptureForm = new(); await ReloadTaxSnapshotAsync(); }
    }

    private async Task ImportRuleContentAsync()
    {
        var result = await TaxAdministrationService.ImportTaxContentDocumentAsync(RuleContentJson);
        StatusMessage = result.Succeeded ? "Draft tax-content package imported. It remains inactive until validation and approval." : result.ErrorMessage;
        if (result.Succeeded) { RuleContentJson = string.Empty; await ReloadTaxSnapshotAsync(); }
    }

    private void LoadSelectedRuleEditors()
    {
        var selectedRule = GetSelectedRule();
        if (selectedRule is null)
        {
            CreateNewRule();
            return;
        }

        RuleForm = new TaxRuleEditor
        {
            Id = selectedRule.Id,
            Code = selectedRule.Code,
            JurisdictionCode = selectedRule.JurisdictionCode,
            JurisdictionName = selectedRule.JurisdictionName,
            JurisdictionType = selectedRule.JurisdictionType,
            TaxType = selectedRule.TaxType,
            CalculationMethod = selectedRule.CalculationMethod,
            WithholdingFrequency = selectedRule.WithholdingFrequency,
            EffectiveOn = selectedRule.EffectiveOn,
            Source = selectedRule.Source,
            Notes = selectedRule.Notes,
            IsEmployerSpecific = selectedRule.IsEmployerSpecific,
            SupportsBracketTable = selectedRule.SupportsBracketTable,
            SupportsParameterEditing = selectedRule.SupportsParameterEditing,
            IsActive = selectedRule.IsActive
            , TaxContentPackageId = selectedRule.TaxContentPackageId ?? Guid.Empty, ContentVersion = selectedRule.ContentVersion, MinimumEngineVersion = selectedRule.MinimumEngineVersion,
            ParentJurisdictionCode = selectedRule.ParentJurisdictionCode, ObligationCode = selectedRule.ObligationCode, CalculationVariant = selectedRule.CalculationVariant,
            ExclusiveGroup = selectedRule.ExclusiveGroup, VariantPriority = selectedRule.VariantPriority, ApplicabilityJson = selectedRule.ApplicabilityJson
        };
        ParameterEditors = selectedRule.Parameters
            .Select(parameter => new TaxParameterEditor
            {
                Id = parameter.Id,
                ParameterCode = parameter.ParameterCode,
                Label = parameter.Label,
                ValueType = parameter.ValueType,
                NumericValue = parameter.NumericValue,
                TextValue = parameter.TextValue,
                BooleanValue = parameter.BooleanValue ?? false,
                Notes = parameter.Notes,
                DisplayOrder = parameter.DisplayOrder
            })
            .ToList();
        BracketEditors = selectedRule.Brackets
            .Select(bracket => new TaxBracketEditor
            {
                Id = bracket.Id,
                Sequence = bracket.Sequence,
                UpperBoundAmount = bracket.UpperBoundAmount,
                FixedAmount = bracket.FixedAmount,
                Rate = bracket.Rate,
                Notes = bracket.Notes
            })
            .ToList();
        FormRequirementEditors = selectedRule.FormRequirements
            .Select(form => new TaxFormRequirementEditor
            {
                Id = form.Id,
                FormCode = form.FormCode,
                Name = form.Name,
                FilingFrequency = form.FilingFrequency,
                DeliveryChannel = form.DeliveryChannel,
                DueRule = form.DueRule,
                Notes = form.Notes
            })
            .ToList();
        FieldDefinitionEditors = selectedRule.FieldDefinitions.Select(field => new TaxFieldDefinitionEditor { Id = field.Id, FieldCode = field.FieldCode, Label = field.Label, DataType = field.DataType, IsRequired = field.IsRequired, DefaultValueJson = field.DefaultValueJson, ValidationJson = field.ValidationJson, DisplayOrder = field.DisplayOrder, HelpText = field.HelpText }).ToList();
        TestCaseEditors = selectedRule.TestCases.Select(testCase => new TaxTestCaseEditor { Id = testCase.Id, Name = testCase.Name, InputJson = testCase.InputJson, ExpectedOutputJson = testCase.ExpectedOutputJson, IsRequiredForActivation = testCase.IsRequiredForActivation }).ToList();
    }

