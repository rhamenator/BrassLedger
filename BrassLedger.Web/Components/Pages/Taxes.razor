@page "/taxes"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.ManageTaxes)]
@using BrassLedger.Application.Taxation
@using BrassLedger.Infrastructure.Auth
@inject IBusinessWorkspaceService WorkspaceService
@inject IProductCatalogService AssessmentService
@inject ITaxAdministrationService TaxAdministrationService

<PageTitle>Taxes</PageTitle>

@{
    var assessment = AssessmentService.GetCatalog();
    var selectedRule = GetSelectedRule();
}

@if (Workspace is null || TaxSnapshot is null)
{
    <section class="panel">
        <h1>Loading tax workspace...</h1>
        <p>Tax profiles, editable rule sets, and filing requirements are being prepared.</p>
    </section>
}
else
{
    <section class="page-shell">
        <header class="page-header">
            <div>
                <p class="eyebrow">Tax Administration</p>
                <h1>Keep withholdings, filing rules, and odd state behavior in editable tables instead of buried code.</h1>
            </div>
            <p class="page-intro">
                The archived tax engine exposed SUTA, SDIF, FUTA, yearly limits, bracket rows, and special state logic as data.
                BrassLedger keeps that spirit, but moves it into a cleaner rule library with editable parameters, brackets, and reporting requirements.
            </p>
        </header>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <section class="panel">
                <p class="lead">@StatusMessage</p>
            </section>
        }

        <section class="stats-grid">
            <article class="stat-card accent-sand">
                <span class="stat-value">@Workspace.Taxes.ProfileCount</span>
                <span class="stat-label">Active tax profiles</span>
            </article>
            <article class="stat-card accent-sky">
                <span class="stat-value">@TaxSnapshot.RuleSets.Count</span>
                <span class="stat-label">Editable rule sets</span>
            </article>
            <article class="stat-card accent-sage">
                <span class="stat-value">@TaxSnapshot.RuleSets.Sum(rule => rule.Brackets.Count)</span>
                <span class="stat-label">Bracket rows</span>
            </article>
            <article class="stat-card accent-coral">
                <span class="stat-value">@TaxSnapshot.RuleSets.Sum(rule => rule.FormRequirements.Count)</span>
                <span class="stat-label">Filing requirements</span>
            </article>
        </section>

        <section class="content-grid">
            <article class="panel">
                <h2>Archived source map</h2>
                <ul class="feature-list">
                    @foreach (var artifact in TaxSnapshot.LegacyArtifacts)
                    {
                        <li><strong>@artifact.Name:</strong> `@artifact.SourcePath` <br /> @artifact.Notes</li>
                    }
                </ul>
            </article>

            <article class="panel">
                <h2>Calculation methods</h2>
                <ul class="feature-list">
                    @foreach (var method in TaxSnapshot.Methods)
                    {
                        <li><strong>@method.Name:</strong> @method.Description</li>
                    }
                </ul>
            </article>
        </section>

        <section class="panel">
            <div class="section-heading"><h2>Manual tax-source intake</h2><button class="action-primary" type="button" @onclick="ImportTaxLocusAsync">Import TaxLocus payroll reference data</button></div>
            <p class="page-intro">This is an on-demand capture, never a scheduled update. TaxLocus is imported as a draft package with checksummed raw files. It does not become withholding logic or an active package until you complete review, rules, and regression cases.</p>
            <div class="content-grid"><div class="auth-form"><div class="field-group"><label class="field-label">State or locality code</label><InputText class="field-input" @bind-Value="SourceCaptureForm.JurisdictionCode" /></div><div class="field-group"><label class="field-label">Official HTTPS source URL</label><InputText class="field-input" @bind-Value="SourceCaptureForm.SourceUrl" /></div><div class="field-group"><label class="field-label">Review notes</label><InputTextArea class="field-input" @bind-Value="SourceCaptureForm.Notes" /></div><button class="action-secondary" type="button" @onclick="CaptureStateSourceAsync">Capture source for review</button><div class="field-group"><label class="field-label">Versioned rule-content JSON (manual or LLM draft)</label><InputTextArea class="field-input field-input-large" @bind-Value="RuleContentJson" /></div><button class="action-secondary" type="button" @onclick="ImportRuleContentAsync">Import draft rule content</button></div><div><table class="data-table"><thead><tr><th>Captured</th><th>Source</th><th>Jurisdiction</th><th>Evidence</th></tr></thead><tbody>@foreach (var capture in TaxSnapshot.SourceCaptures.Take(12)) { <tr><td>@capture.CapturedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td><a href="@capture.SourceUrl" target="_blank" rel="noopener noreferrer">@capture.SourceKind</a></td><td>@(string.IsNullOrWhiteSpace(capture.JurisdictionCode) ? "Dataset" : capture.JurisdictionCode)</td><td>@capture.ContentLength.ToString("N0") bytes · @capture.ContentSha256[..Math.Min(12, capture.ContentSha256.Length)]</td></tr> }</tbody></table></div></div>
        </section>

        <section class="panel">
            <div class="section-heading"><h2>Versioned tax-content packages</h2><button class="action-secondary" type="button" @onclick="CreateNewPackage">New package</button></div>
            <p class="page-intro">Draft package versions remain inactive until their linked rule tests pass the activation gate. Approved versions are snapshotted with payroll runs.</p>
            <div class="content-grid"><div class="auth-form">@if (IsApprovedPackage) { <p class="page-intro">This approved version is read-only. Create a new package version for any tax data or business-logic change.</p> }<fieldset disabled="@IsApprovedPackage"><div class="field-group"><label class="field-label">Package code</label><InputText aria-label="Tax package code" class="field-input" @bind-Value="PackageForm.PackageCode" /></div><div class="field-group"><label class="field-label">Version</label><InputText aria-label="Tax package version" class="field-input" @bind-Value="PackageForm.Version" /></div><div class="field-group"><label class="field-label">Effective date</label><InputDate aria-label="Tax package effective date" class="field-input" @bind-Value="PackageForm.EffectiveOn" /></div><div class="field-group"><label class="field-label">Minimum engine</label><InputText aria-label="Tax package minimum engine" class="field-input" @bind-Value="PackageForm.MinimumEngineVersion" /></div><div class="field-group"><label class="field-label">Status</label><InputSelect aria-label="Tax package status" class="field-input" @bind-Value="PackageForm.Status"><option>Draft</option><option>Validated</option><option>Approved</option><option>Superseded</option></InputSelect></div><div class="field-group"><label class="field-label">Manifest JSON</label><InputTextArea aria-label="Tax package manifest" class="field-input" @bind-Value="PackageForm.ManifestJson" /></div><div class="field-group"><label class="field-label">Change summary</label><InputText aria-label="Tax package change summary" class="field-input" @bind-Value="PackageForm.ChangeSummary" /></div><button class="action-primary" type="button" @onclick="SavePackageAsync">Save package</button>@if (PackageForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="ActivatePackageAsync">Validate and activate</button> }</fieldset></div><div><table class="data-table"><thead><tr><th>Package</th><th>Effective</th><th>Status</th><th>Minimum engine</th></tr></thead><tbody>@foreach (var package in TaxSnapshot.Packages) { <tr><td><button class="action-secondary" type="button" @onclick="() => SelectPackage(package.Id)">@package.PackageCode @package.Version</button></td><td>@package.EffectiveOn</td><td>@package.Status</td><td>@package.MinimumEngineVersion</td></tr> }</tbody></table></div></div>
        </section>

        <section class="content-grid">
            <article class="panel">
                <h2>Current tax profiles</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Jurisdiction</th>
                            <th>Type</th>
                            <th>Rate</th>
                            <th>Effective</th>
                            <th>Employer-specific</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var profile in Workspace.Taxes.Profiles)
                        {
                            <tr>
                                <td>@profile.Jurisdiction</td>
                                <td>@profile.TaxType</td>
                                <td>@profile.Rate.ToString("P3")</td>
                                <td>@profile.EffectiveOn.ToString("MMM d, yyyy")</td>
                                <td>@(profile.IsEmployerSpecific ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </article>

            <article class="panel">
                <h2>Rule library</h2>
                <div class="tax-rule-list">
                    @foreach (var rule in TaxSnapshot.RuleSets)
                    {
                        <button
                            class="tax-rule-chip @(rule.Id == SelectedRuleId ? "tax-rule-chip-active" : string.Empty)"
                            type="button"
                            @onclick="() => SelectRule(rule.Id)">
                            <span>@rule.Code</span>
                            <small>@rule.JurisdictionName · @rule.TaxType</small>
                        </button>
                    }
                </div>
            </article>
        </section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManageTaxes">
            <Authorized>
                <section class="content-grid">
                    <article class="panel">
                        <div class="section-heading">
                            <h2>Rule set details</h2>
                            <button class="action-secondary" type="button" @onclick="CreateNewRule">New rule set</button>
                        </div>

                        <div class="auth-form">
                            <div class="field-group">
                                <label class="field-label" for="taxRuleCode">Rule code</label>
                                <InputText id="taxRuleCode" class="field-input" @bind-Value="RuleForm.Code" />
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="taxJurisdictionCode">Jurisdiction code</label>
                                <InputText id="taxJurisdictionCode" class="field-input" @bind-Value="RuleForm.JurisdictionCode" />
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="stateJurisdiction">State jurisdiction catalog</label>
                                <select id="stateJurisdiction" class="field-input" @onchange="SetStateJurisdiction"><option value="">Select a state or enter a custom locality</option>@foreach (var state in TaxSnapshot.StateJurisdictions) { <option value="@state.Code">@state.Code — @state.Name</option> }</select>
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="taxJurisdictionName">Jurisdiction name</label>
                                <InputText id="taxJurisdictionName" class="field-input" @bind-Value="RuleForm.JurisdictionName" />
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="taxJurisdictionType">Jurisdiction type</label>
                                <InputSelect id="taxJurisdictionType" class="field-input" @bind-Value="RuleForm.JurisdictionType">
                                    <option value="Federal">Federal</option>
                                    <option value="State">State</option>
                                    <option value="Local">Local</option>
                                    <option value="Employer">Employer</option>
                                </InputSelect>
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="taxType">Tax type</label>
                                <InputText id="taxType" class="field-input" @bind-Value="RuleForm.TaxType" />
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="calculationMethod">Calculation method</label>
                                <InputSelect id="calculationMethod" class="field-input" @bind-Value="RuleForm.CalculationMethod">
                                    @foreach (var method in TaxSnapshot.Methods)
                                    {
                                        <option value="@method.Code">@method.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="withholdingFrequency">Withholding frequency</label>
                                <InputText id="withholdingFrequency" class="field-input" @bind-Value="RuleForm.WithholdingFrequency" />
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="effectiveOn">Effective on</label>
                                <InputDate id="effectiveOn" class="field-input" @bind-Value="RuleForm.EffectiveOn" />
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="taxSource">Source</label>
                                <InputText id="taxSource" class="field-input" @bind-Value="RuleForm.Source" />
                            </div>

                            <div class="field-group">
                                <label class="field-label" for="taxNotes">Notes</label>
                                <InputTextArea id="taxNotes" class="field-input field-input-large" @bind-Value="RuleForm.Notes" />
                            </div>
                            <div class="field-group"><label class="field-label">Content package</label><InputSelect aria-label="Tax rule content package" class="field-input" @bind-Value="RuleForm.TaxContentPackageId"><option value="@Guid.Empty">No package (legacy fallback)</option>@foreach (var package in TaxSnapshot.Packages) { <option value="@package.Id">@package.PackageCode @package.Version</option> }</InputSelect></div>
                            <div class="field-group"><label class="field-label">Content version</label><InputText aria-label="Tax rule content version" class="field-input" @bind-Value="RuleForm.ContentVersion" /></div>
                            <div class="field-group"><label class="field-label">Minimum engine version</label><InputText aria-label="Tax rule minimum engine version" class="field-input" @bind-Value="RuleForm.MinimumEngineVersion" /></div>
                            <div class="field-group"><label class="field-label">Parent jurisdiction code</label><InputText aria-label="Parent jurisdiction code" class="field-input" @bind-Value="RuleForm.ParentJurisdictionCode" /></div>
                            <div class="field-group"><label class="field-label">Tax obligation code</label><InputText aria-label="Tax obligation code" class="field-input" @bind-Value="RuleForm.ObligationCode" /></div>
                            <div class="field-group"><label class="field-label">Calculation variant</label><InputText aria-label="Calculation variant" class="field-input" @bind-Value="RuleForm.CalculationVariant" /></div>
                            <div class="field-group"><label class="field-label">Exclusive variant group</label><InputText aria-label="Exclusive variant group" class="field-input" @bind-Value="RuleForm.ExclusiveGroup" /></div>
                            <div class="field-group"><label class="field-label">Variant priority</label><InputNumber aria-label="Variant priority" class="field-input" @bind-Value="RuleForm.VariantPriority" /></div>
                            <div class="field-group"><label class="field-label">Applicability JSON</label><InputTextArea aria-label="Tax rule applicability JSON" class="field-input field-input-large" @bind-Value="RuleForm.ApplicabilityJson" /><small>Use allOf/anyOf conditions for residence, work location, filing status, payroll frequency, or annualized net wages.</small></div>

                            <div class="tax-checkbox-grid">
                                <label><InputCheckbox @bind-Value="RuleForm.IsEmployerSpecific" /> Employer-specific</label>
                                <label><InputCheckbox @bind-Value="RuleForm.SupportsBracketTable" /> Supports bracket rows</label>
                                <label><InputCheckbox @bind-Value="RuleForm.SupportsParameterEditing" /> Supports parameters</label>
                                <label><InputCheckbox @bind-Value="RuleForm.IsActive" /> Active</label>
                            </div>

                            <button class="action-primary" type="button" @onclick="SaveRuleAsync">Save rule set</button>
                        </div>
                    </article>

                    <article class="panel">
                        <h2>What we remove</h2>
                        <ul class="feature-list warning-list">
                            @foreach (var item in assessment.FeaturesToRemove)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </article>
                </section>

                <section class="panel">
                    <div class="section-heading">
                        <h2>Editable parameters</h2>
                        <button class="action-secondary" type="button" @onclick="AddParameterRow">Add parameter</button>
                    </div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Label</th>
                                <th>Type</th>
                                <th>Value</th>
                                <th>Notes</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var parameter in ParameterEditors)
                            {
                                <tr>
                                    <td><InputText class="field-input tax-grid-input" @bind-Value="parameter.ParameterCode" /></td>
                                    <td><InputText class="field-input tax-grid-input" @bind-Value="parameter.Label" /></td>
                                    <td>
                                        <InputSelect class="field-input tax-grid-input" @bind-Value="parameter.ValueType">
                                            <option value="number">Number</option>
                                            <option value="text">Text</option>
                                            <option value="bool">Boolean</option>
                                        </InputSelect>
                                    </td>
                                    <td>
                                        @if (parameter.ValueType == "text")
                                        {
                                            <InputText class="field-input tax-grid-input" @bind-Value="parameter.TextValue" />
                                        }
                                        else if (parameter.ValueType == "bool")
                                        {
                                            <label><InputCheckbox @bind-Value="parameter.BooleanValue" /> Enabled</label>
                                        }
                                        else
                                        {
                                            <InputNumber class="field-input tax-grid-input" @bind-Value="parameter.NumericValue" />
                                        }
                                    </td>
                                    <td><InputText class="field-input tax-grid-input" @bind-Value="parameter.Notes" /></td>
                                    <td><button class="action-secondary" type="button" @onclick="() => SaveParameterAsync(parameter)">Save</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>

                <section class="panel">
                    <div class="section-heading">
                        <h2>Bracket table</h2>
                        <button class="action-secondary" type="button" @onclick="AddBracketRow">Add bracket</button>
                    </div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Seq</th>
                                <th>Upper bound</th>
                                <th>Fixed amount</th>
                                <th>Rate</th>
                                <th>Notes</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bracket in BracketEditors)
                            {
                                <tr>
                                    <td><InputNumber class="field-input tax-grid-input" @bind-Value="bracket.Sequence" /></td>
                                    <td><InputNumber class="field-input tax-grid-input" @bind-Value="bracket.UpperBoundAmount" /></td>
                                    <td><InputNumber class="field-input tax-grid-input" @bind-Value="bracket.FixedAmount" /></td>
                                    <td><InputNumber class="field-input tax-grid-input" @bind-Value="bracket.Rate" /></td>
                                    <td><InputText class="field-input tax-grid-input" @bind-Value="bracket.Notes" /></td>
                                    <td><button class="action-secondary" type="button" @onclick="() => SaveBracketAsync(bracket)">Save</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>

                <section class="panel">
                    <div class="section-heading">
                        <h2>Reporting and filing requirements</h2>
                        <button class="action-secondary" type="button" @onclick="AddFormRequirementRow">Add filing requirement</button>
                    </div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Form</th>
                                <th>Name</th>
                                <th>Frequency</th>
                                <th>Delivery</th>
                                <th>Due rule</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var filing in FormRequirementEditors)
                            {
                                <tr>
                                    <td><InputText class="field-input tax-grid-input" @bind-Value="filing.FormCode" /></td>
                                    <td><InputText class="field-input tax-grid-input" @bind-Value="filing.Name" /></td>
                                    <td><InputText class="field-input tax-grid-input" @bind-Value="filing.FilingFrequency" /></td>
                                    <td><InputText class="field-input tax-grid-input" @bind-Value="filing.DeliveryChannel" /></td>
                                    <td><InputText class="field-input tax-grid-input" @bind-Value="filing.DueRule" /></td>
                                    <td><button class="action-secondary" type="button" @onclick="() => SaveFormRequirementAsync(filing)">Save</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>

                <section class="panel">
                    <div class="section-heading"><h2>Flexible rule fields</h2><button class="action-secondary" type="button" @onclick="AddFieldDefinitionRow">Add field</button></div>
                    <table class="data-table"><thead><tr><th>Code</th><th>Label</th><th>Type</th><th>Required</th><th>Default JSON</th><th>Validation JSON</th><th></th></tr></thead><tbody>@foreach (var field in FieldDefinitionEditors) { <tr><td><InputText class="field-input tax-grid-input" @bind-Value="field.FieldCode" /></td><td><InputText class="field-input tax-grid-input" @bind-Value="field.Label" /></td><td><InputSelect class="field-input tax-grid-input" @bind-Value="field.DataType"><option>text</option><option>number</option><option>bool</option><option>date</option></InputSelect></td><td><InputCheckbox @bind-Value="field.IsRequired" /></td><td><InputText class="field-input tax-grid-input" @bind-Value="field.DefaultValueJson" /></td><td><InputText class="field-input tax-grid-input" @bind-Value="field.ValidationJson" /></td><td><button class="action-secondary" type="button" @onclick="() => SaveFieldDefinitionAsync(field)">Save</button></td></tr> }</tbody></table>
                </section>

                <section class="panel">
                    <div class="section-heading"><h2>Activation regression cases</h2><button class="action-secondary" type="button" @onclick="AddTestCaseRow">Add case</button></div>
                    <p class="page-intro">Each required case must specify JSON input with <code>grossPay</code> and expected <code>amount</code> or <code>withholding</code>; package activation executes these cases.</p>
                    <table class="data-table"><thead><tr><th>Name</th><th>Input JSON</th><th>Expected JSON</th><th>Required</th><th></th></tr></thead><tbody>@foreach (var testCase in TestCaseEditors) { <tr><td><InputText class="field-input tax-grid-input" @bind-Value="testCase.Name" /></td><td><InputText class="field-input tax-grid-input" @bind-Value="testCase.InputJson" /></td><td><InputText class="field-input tax-grid-input" @bind-Value="testCase.ExpectedOutputJson" /></td><td><InputCheckbox @bind-Value="testCase.IsRequiredForActivation" /></td><td><button class="action-secondary" type="button" @onclick="() => SaveTestCaseAsync(testCase)">Save</button></td></tr> }</tbody></table>
                </section>
            </Authorized>
            <NotAuthorized>
                <section class="panel">
                    <h2>Editing restricted</h2>
                    <p>Signed-in users without tax-administration permissions can review active profiles and rule coverage, but only tax managers, administrators, or the owner can edit rules.</p>
                </section>
            </NotAuthorized>
        </AuthorizeView>

        @if (selectedRule is not null)
        {
            <section class="panel">
                <h2>Selected rule summary</h2>
                <div class="detail-grid">
                    <div><span class="detail-label">Rule code</span><strong>@selectedRule.Code</strong></div>
                    <div><span class="detail-label">Jurisdiction</span><strong>@selectedRule.JurisdictionName</strong></div>
                    <div><span class="detail-label">Type</span><strong>@selectedRule.TaxType</strong></div>
                    <div><span class="detail-label">Method</span><strong>@selectedRule.CalculationMethod</strong></div>
                    <div><span class="detail-label">Obligation</span><strong>@(string.IsNullOrWhiteSpace(selectedRule.ObligationCode) ? "Independent rule" : selectedRule.ObligationCode)</strong></div>
                    <div><span class="detail-label">Variant</span><strong>@(string.IsNullOrWhiteSpace(selectedRule.CalculationVariant) ? selectedRule.CalculationMethod : selectedRule.CalculationVariant)</strong></div>
                    <div><span class="detail-label">Exclusive group</span><strong>@(string.IsNullOrWhiteSpace(selectedRule.ExclusiveGroup) ? "None" : $"{selectedRule.ExclusiveGroup} (priority {selectedRule.VariantPriority})")</strong></div>
                    <div><span class="detail-label">Parameters</span><strong>@selectedRule.Parameters.Count</strong></div>
                    <div><span class="detail-label">Filings</span><strong>@selectedRule.FormRequirements.Count</strong></div>
                </div>
            </section>
        }
    </section>
}

@code {
    private BusinessWorkspaceSnapshot? Workspace;
    private TaxAdministrationSnapshot? TaxSnapshot;
    private Guid? SelectedRuleId;
    private string? StatusMessage;
    private TaxRuleEditor RuleForm { get; set; } = new();
    private List<TaxParameterEditor> ParameterEditors { get; set; } = [];
    private List<TaxBracketEditor> BracketEditors { get; set; } = [];
    private List<TaxFormRequirementEditor> FormRequirementEditors { get; set; } = [];
    private List<TaxFieldDefinitionEditor> FieldDefinitionEditors { get; set; } = [];
    private List<TaxTestCaseEditor> TestCaseEditors { get; set; } = [];
    private TaxContentPackageEditor PackageForm { get; set; } = new();
    private TaxSourceCaptureEditor SourceCaptureForm { get; set; } = new();
    private string RuleContentJson { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Workspace = await WorkspaceService.GetWorkspaceAsync();
        await ReloadTaxSnapshotAsync();
    }

    private TaxRuleSetSnapshot? GetSelectedRule()
    {
        if (TaxSnapshot is null)
        {
            return null;
        }

        return SelectedRuleId.HasValue
            ? TaxSnapshot.RuleSets.FirstOrDefault(rule => rule.Id == SelectedRuleId.Value)
            : TaxSnapshot.RuleSets.FirstOrDefault();
    }

    private void SelectRule(Guid ruleId)
    {
        SelectedRuleId = ruleId;
        LoadSelectedRuleEditors();
    }

    private void CreateNewRule()
    {
        SelectedRuleId = null;
        RuleForm = new TaxRuleEditor
        {
            EffectiveOn = DateOnly.FromDateTime(DateTime.Today),
            JurisdictionType = "State",
            WithholdingFrequency = "Per payroll",
            CalculationMethod = TaxSnapshot?.Methods.FirstOrDefault()?.Code ?? "custom-manual",
            SupportsParameterEditing = true,
            IsActive = true
        };
        ParameterEditors = [];
        BracketEditors = [];
        FormRequirementEditors = [];
        FieldDefinitionEditors = [];
        TestCaseEditors = [];
    }

    private void SetStateJurisdiction(ChangeEventArgs args)
    {
        var code = args.Value?.ToString();
        var state = TaxSnapshot?.StateJurisdictions.SingleOrDefault(item => item.Code == code);
        if (state is not null) { RuleForm.JurisdictionCode = state.Code; RuleForm.JurisdictionName = state.Name; RuleForm.JurisdictionType = "State"; }
    }

    private async Task SaveRuleAsync()
    {
        var result = await TaxAdministrationService.SaveRuleSetAsync(new SaveTaxRuleSetRequest(
            RuleForm.Id,
            RuleForm.Code,
            RuleForm.JurisdictionCode,
            RuleForm.JurisdictionName,
            RuleForm.JurisdictionType,
            RuleForm.TaxType,
            RuleForm.CalculationMethod,
            RuleForm.WithholdingFrequency,
            RuleForm.EffectiveOn,
            RuleForm.Source,
            RuleForm.Notes,
            RuleForm.IsEmployerSpecific,
            RuleForm.SupportsBracketTable,
            RuleForm.SupportsParameterEditing,
            RuleForm.IsActive,
            RuleForm.TaxContentPackageId == Guid.Empty ? null : RuleForm.TaxContentPackageId,
            RuleForm.ContentVersion,
            RuleForm.MinimumEngineVersion,
            RuleForm.ParentJurisdictionCode,
            RuleForm.ObligationCode,
            RuleForm.CalculationVariant,
            RuleForm.ExclusiveGroup,
            RuleForm.VariantPriority,
            RuleForm.ApplicabilityJson));

        StatusMessage = result.Succeeded ? "Tax rule set saved." : result.ErrorMessage;
        if (result.Succeeded)
        {
            SelectedRuleId = result.SavedId;
            await ReloadTaxSnapshotAsync();
        }
    }

    private void CreateNewPackage() => PackageForm = new TaxContentPackageEditor { EffectiveOn = DateOnly.FromDateTime(DateTime.Today), Status = "Draft", MinimumEngineVersion = "1.0", ManifestJson = "{}" };
    private void SelectPackage(Guid id)
    {
        var package = TaxSnapshot?.Packages.Single(item => item.Id == id); if (package is not null) PackageForm = new TaxContentPackageEditor { Id = package.Id, PackageCode = package.PackageCode, Version = package.Version, EffectiveOn = package.EffectiveOn, Status = package.Status, MinimumEngineVersion = package.MinimumEngineVersion, ManifestJson = package.ManifestJson, Source = package.Source, ChangeSummary = package.ChangeSummary };
    }
    private async Task SavePackageAsync()
    {
        var result = await TaxAdministrationService.SaveContentPackageAsync(new SaveTaxContentPackageRequest(PackageForm.Id, PackageForm.PackageCode, PackageForm.Version, PackageForm.EffectiveOn, PackageForm.Status, PackageForm.MinimumEngineVersion, PackageForm.ManifestJson, PackageForm.Source, PackageForm.ChangeSummary)); StatusMessage = result.Succeeded ? "Tax content package saved." : result.ErrorMessage; if (result.Succeeded) { PackageForm.Id = result.SavedId; await ReloadTaxSnapshotAsync(); }
    }
    private async Task ActivatePackageAsync()
    {
        var result = await TaxAdministrationService.ActivateContentPackageAsync(PackageForm.Id!.Value); StatusMessage = result.Succeeded ? "Tax content package validated and activated." : result.ErrorMessage; if (result.Succeeded) await ReloadTaxSnapshotAsync();
    }

    private bool IsApprovedPackage => string.Equals(PackageForm.Status, "Approved", StringComparison.Ordinal);

