@page "/forgot-password"
@attribute [AllowAnonymous]

<PageTitle>Reset Password</PageTitle>

<section class="auth-shell">
    <article class="auth-card">
        <p class="eyebrow">Account recovery</p>
        <h1>Request a password reset.</h1>
        <p class="page-intro">Enter your username or verified email address. The response is intentionally the same whether or not an eligible account exists.</p>

        @if (string.Equals(Status, "requested", StringComparison.OrdinalIgnoreCase))
        {
            <div class="status-banner" role="status">If the account and verified email are eligible, a one-time reset link will be sent. Check your email and contact your administrator if it does not arrive.</div>
        }
        else if (string.Equals(Error, "too-many-requests", StringComparison.OrdinalIgnoreCase))
        {
            <div class="auth-error" role="alert">Too many recovery requests came from this network. Wait one minute and try again.</div>
        }

        <form class="auth-form" method="post" action="/account/password-reset/request">
            <AntiforgeryToken />
            <div class="field-group">
                <label class="field-label" for="identifier">Username or verified email</label>
                <input id="identifier" class="field-input" name="identifier" autocomplete="username" maxlength="320" required />
            </div>
            <button class="action-primary" type="submit">Request reset link</button>
        </form>
        <p class="auth-note"><a href="/login">Return to sign in</a></p>
    </article>
</section>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
