    private async Task PostApprovedPayrollAsync(PayrollRunSnapshot run)
    {
        var result = await TransactionService.PostApprovedPayrollRunAsync(new PostApprovedPayrollRunRequest(run.Id, run.ConcurrencyToken));
        StatusMessage = result.Succeeded ? "Approved payroll posted to the ledger." : result.ErrorMessage;
        Workspace = await WorkspaceService.GetWorkspaceAsync();
        if (result.Succeeded)
        {
            PaymentFileForm.PayrollRunId = run.Id;
            PaymentFileForm.EffectiveEntryDate = run.PayDate;
            await RefreshPaymentFilesAsync();
            if (CanManagePayroll) await RefreshDepositSchedulesAsync();
        }
    }
    private async Task CancelPayrollAsync(PayrollRunSnapshot run)
    {
        if (string.IsNullOrWhiteSpace(ReversalReason)) { StatusMessage = "Enter a cancellation reason before cancelling the payroll draft."; return; }
        var result = await TransactionService.CancelPayrollRunAsync(new CancelPayrollRunRequest(run.Id, ReversalReason, run.ConcurrencyToken));
        StatusMessage = result.Succeeded ? "Payroll draft cancelled; its approved timecards are available for another reviewed draft." : result.ErrorMessage;
        if (result.Succeeded) ReversalReason = string.Empty;
        Workspace = await WorkspaceService.GetWorkspaceAsync();
        if (result.Succeeded && CanManagePayroll) await RefreshDepositSchedulesAsync();
    }
    private async Task ReversePayrollAsync(PayrollRunSnapshot run)
    {
        if (string.IsNullOrWhiteSpace(ReversalReason)) { StatusMessage = "Enter a reversal reason before reversing payroll."; return; }
        var result = await TransactionService.ReversePayrollRunAsync(new ReversePayrollRunRequest(run.Id, DateOnly.FromDateTime(DateTime.Today), ReversalReason, run.ConcurrencyToken));
        StatusMessage = result.Succeeded ? "Payroll run reversed with a linked audit journal." : result.ErrorMessage;
        if (result.Succeeded) ReversalReason = string.Empty;
        Workspace = await WorkspaceService.GetWorkspaceAsync();
    }
    private void ToggleLiabilityPayment(PayrollLiabilitySnapshot liability, object? value)
    {
        var selected = value is bool boolean ? boolean : bool.TryParse(value?.ToString(), out var parsed) && parsed;
        if (selected) { SelectedLiabilityIds.Add(liability.Id); LiabilityPaymentAmounts[liability.Id] = liability.OutstandingAmount; }
        else { SelectedLiabilityIds.Remove(liability.Id); LiabilityPaymentAmounts.Remove(liability.Id); }
    }
    private void SetLiabilityPaymentAmount(Guid liabilityId, object? value)
    {
        if (decimal.TryParse(value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var amount)) LiabilityPaymentAmounts[liabilityId] = amount;
    }
    private async Task RecordLiabilityPaymentAsync()
    {
        var applications = SelectedLiabilityIds.Select(id => new PayrollLiabilityPaymentApplicationInput(id, LiabilityPaymentAmounts.GetValueOrDefault(id))).ToArray();
        var result = await TransactionService.RecordPayrollLiabilityPaymentAsync(new RecordPayrollLiabilityPaymentRequest(LiabilityPaymentForm.BankAccountId, LiabilityPaymentForm.PaymentDate, LiabilityPaymentForm.Reference, LiabilityPaymentForm.Payee, LiabilityPaymentForm.Method, applications));
        StatusMessage = result.Succeeded ? "Payroll liability remittance posted and applied." : result.ErrorMessage;
        if (result.Succeeded) { SelectedLiabilityIds.Clear(); LiabilityPaymentAmounts.Clear(); LiabilityPaymentForm.Reset(); Workspace = await WorkspaceService.GetWorkspaceAsync(); if (CanManagePayroll) await RefreshDepositSchedulesAsync(); }
    }
    private async Task ReverseLiabilityPaymentAsync(PayrollLiabilityPaymentSnapshot payment)
    {
        if (string.IsNullOrWhiteSpace(LiabilityPaymentReversalReason)) { StatusMessage = "Enter a remittance reversal reason first."; return; }
        var today = DateOnly.FromDateTime(DateTime.Today);
        var reversalDate = today < payment.PaymentDate ? payment.PaymentDate : today;
        var result = await TransactionService.ReversePayrollLiabilityPaymentAsync(new ReversePayrollLiabilityPaymentRequest(payment.Id, reversalDate, LiabilityPaymentReversalReason, payment.ConcurrencyToken));
        StatusMessage = result.Succeeded ? "Payroll liability remittance reversed and balances reopened." : result.ErrorMessage;
        if (result.Succeeded) LiabilityPaymentReversalReason = string.Empty;
        Workspace = await WorkspaceService.GetWorkspaceAsync();
        if (result.Succeeded && CanManagePayroll) await RefreshDepositSchedulesAsync();
    }
