    private void ToggleApprovedTimecard(Guid timecardId, object? value)
    {
        var selected = value is bool boolean ? boolean : bool.TryParse(value?.ToString(), out var parsed) && parsed;
        if (selected) SelectedApprovedTimecardIds.Add(timecardId); else SelectedApprovedTimecardIds.Remove(timecardId);
        Preview = null;
    }

    private PostEmployeePayrollRunRequest BuildRequest()
    {
        var selectedEmployeeIds = (Workspace?.Payroll.Timecards ?? []).Where(card => SelectedApprovedTimecardIds.Contains(card.Id)).Select(card => card.EmployeeId).ToHashSet();
        var employees = RunLines.Where(line => line.Value > 0 || selectedEmployeeIds.Contains(line.Key)).Select(line => new EmployeePayrollInput(line.Key, line.Value)).ToArray();
        return new PostEmployeePayrollRunRequest(RunForm.BankAccountId, RunForm.PayDate, RunForm.Reference, employees, RunForm.PeriodStart, RunForm.PeriodEnd, RunForm.RunType, SelectedApprovedTimecardIds.ToArray());
    }
    private void SetRunLine(Guid employeeId, object? value)
    {
        if (decimal.TryParse(value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var amount))
        {
            RunLines[employeeId] = amount;
        }
    }
