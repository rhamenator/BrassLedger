@page "/payroll"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.AccessPayroll)]
@inject IBusinessWorkspaceService WorkspaceService
@inject IAccountingTransactionService TransactionService

<PageTitle>Payroll</PageTitle>

@if (Workspace is null)
{
    <section class="panel">
        <h1>Loading payroll...</h1>
    </section>
}
else
{
    <section class="page-shell">
        <header class="page-header">
            <div>
                <p class="eyebrow">Payroll and Time</p>
                <h1>Prepare, approve, post, and audit payroll.</h1>
            </div>
            <p class="page-intro">Build a dated payroll draft, review employee and jurisdiction calculations, approve it, and post it through a controlled ledger workflow.</p>
        </header>

        <section class="stats-grid">
            <article class="stat-card accent-sand">
                <span class="stat-value">@Workspace.Payroll.ActiveEmployees</span>
                <span class="stat-label">Active employees</span>
            </article>
            <article class="stat-card accent-sky">
                <span class="stat-value">@Workspace.Payroll.MonthlyGross.ToString("C0")</span>
                <span class="stat-label">Monthly gross</span>
            </article>
            <article class="stat-card accent-sage">
                <span class="stat-value">@Workspace.Taxes.ProfileCount</span>
                <span class="stat-label">Tax profiles</span>
            </article>
            <article class="stat-card accent-coral">
                <span class="stat-value">@Workspace.Taxes.EmployerSpecificCount</span>
                <span class="stat-label">Employer-specific rates</span>
            </article>
        </section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PreparePayroll"><Authorized Context="payrollPrepareContext">
        <section class="panel">
            <h2>Prepare payroll draft</h2>
            <p class="page-intro">Enter the pay period and employee earnings. Previewing does not change the books; saving creates a durable draft that must be approved before posting.</p>
            @if (!string.IsNullOrWhiteSpace(StatusMessage)) { <p class="lead" role="status" aria-live="polite">@StatusMessage</p> }
            <EditForm Model="RunForm" OnValidSubmit="PreviewPayrollAsync"><div class="content-grid">
                <div class="field-group"><label class="field-label">Pay date</label><InputDate aria-label="Payroll pay date" class="field-input" @bind-Value="RunForm.PayDate" /></div>
                <div class="field-group"><label class="field-label">Period start</label><InputDate aria-label="Payroll period start" class="field-input" @bind-Value="RunForm.PeriodStart" /></div>
                <div class="field-group"><label class="field-label">Period end</label><InputDate aria-label="Payroll period end" class="field-input" @bind-Value="RunForm.PeriodEnd" /></div>
                <div class="field-group"><label class="field-label">Run type</label><InputSelect aria-label="Payroll run type" class="field-input" @bind-Value="RunForm.RunType"><option>Regular</option><option>OffCycle</option><option>Correction</option><option>Adjustment</option></InputSelect></div>
                <div class="field-group"><label class="field-label">Run reference</label><InputText aria-label="Payroll run reference" class="field-input" @bind-Value="RunForm.Reference" /></div>
                <div class="field-group"><label class="field-label">Funding account</label><InputSelect aria-label="Payroll funding account" class="field-input" @bind-Value="RunForm.BankAccountId"><option value="@Guid.Empty">Select bank account</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name — @bank.CurrentBalance.ToString("C")</option> }</InputSelect></div>
            </div>
            <table class="data-table"><thead><tr><th>Employee</th><th>Work state</th><th>Gross pay</th></tr></thead><tbody>@foreach (var employee in Workspace.Payroll.Employees.Where(employee => employee.IsActive)) { var employeeId = employee.Id; <tr><td>@employee.FullName</td><td>@employee.State</td><td><input type="number" min="0" step="0.01" aria-label="@($"Gross pay for {employee.FullName}")" class="field-input" value="@RunLines[employeeId].ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="args => SetRunLine(employeeId, args.Value)" /></td></tr> }</tbody></table>
            <button class="action-secondary" type="submit">Preview payroll</button>
            @if (Preview is not null) { <button class="action-primary" type="button" @onclick="SavePayrollDraftAsync">Save reviewed draft</button> }</EditForm>
            @if (Preview is not null) { <table class="data-table"><thead><tr><th>Employee</th><th>Gross</th><th>Pre-tax benefits</th><th>Withholding</th><th>Post-tax benefits</th><th>Employer taxes</th><th>Net pay</th></tr></thead><tbody>@foreach (var line in Preview.Employees) { <tr><td>@line.EmployeeName (@line.WorkState)</td><td>@line.GrossPay.ToString("C")</td><td>@line.PreTaxDeductions.ToString("C")</td><td>@line.EmployeeWithholdings.ToString("C")</td><td>@line.PostTaxDeductions.ToString("C")</td><td>@line.EmployerPayrollTaxes.ToString("C")</td><td>@line.NetPay.ToString("C")</td></tr> }</tbody></table> }
        </section>
        </Authorized></AuthorizeView>

        <section class="panel">
            <h2>Payroll run workflow</h2>
            <p class="page-intro">Drafts do not affect cash or the ledger. Approve after review, post only when funding is ready, and use reversal to preserve the original run and create an equal-and-opposite journal.</p>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="payrollReverseReasonContext"><div class="field-group"><label class="field-label">Reversal reason</label><InputText aria-label="Payroll reversal reason" class="field-input" @bind-Value="ReversalReason" /></div></Authorized></AuthorizeView>
            @if (Workspace.Payroll.Runs?.Count > 0)
            {
                <table class="data-table"><thead><tr><th>Reference</th><th>Period</th><th>Pay date</th><th>Type</th><th>Status</th><th>Gross</th><th>Withholding</th><th>Employer tax</th><th>Net</th><th>Action</th></tr></thead><tbody>
                @foreach (var run in Workspace.Payroll.Runs)
                {
                    <tr><td>@run.Reference</td><td>@run.PeriodStart.ToString("MMM d")–@run.PeriodEnd.ToString("MMM d, yyyy")</td><td>@run.PayDate.ToString("MMM d, yyyy")</td><td>@run.RunType</td><td>@run.Status</td><td>@run.GrossPayroll.ToString("C")</td><td>@run.EmployeeWithholdings.ToString("C")</td><td>@run.EmployerPayrollTaxes.ToString("C")</td><td>@run.NetPay.ToString("C")</td><td>
                        @if (run.Status == "Draft") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApprovePayroll"><Authorized Context="payrollApproveContext"><button class="action-secondary" type="button" @onclick="async () => await ApprovePayrollAsync(run)">Approve</button></Authorized></AuthorizeView> }
                        else if (run.Status == "Approved") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PostPayroll"><Authorized Context="payrollPostContext"><button class="action-primary" type="button" @onclick="async () => await PostApprovedPayrollAsync(run)">Post</button></Authorized></AuthorizeView> }
                        else if (run.Status == "Posted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="payrollReverseContext"><button class="action-secondary" type="button" @onclick="async () => await ReversePayrollAsync(run)">Reverse</button></Authorized></AuthorizeView> }
                    </td></tr>
                }
                </tbody></table>
            }
            else { <p>No payroll drafts or posted runs yet.</p> }
        </section>

        <section class="panel">
                <h2>Employee roster</h2>
                <p class="page-intro">Review each employee’s base compensation and primary residence and work locations before preparing a run.</p>
                <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Work location</th>
                            <th>Residence location</th>
                            <th>Pay type</th>
                            <th>Monthly base</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Workspace.Payroll.Employees)
                        {
                            <tr>
                                <td>@employee.EmployeeNumber - @employee.FullName</td>
                                <td>@employee.Department</td>
                                <td>@employee.State@(string.IsNullOrWhiteSpace(employee.WorkCity) ? "" : $" · {employee.WorkCity}")</td>
                                <td>@employee.ResidenceState@(string.IsNullOrWhiteSpace(employee.ResidenceCity) ? "" : $" · {employee.ResidenceCity}")</td>
                                <td>@employee.PayType</td>
                                <td>@employee.MonthlyBasePay.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
        </section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.MaintainEmployeePayrollSetup"><Authorized Context="payrollElectionContext">
        <section class="panel">
                <h2>Employee tax elections and benefits</h2>
                <p class="page-intro">Record the actual Form W-4 year and Steps 2–4, benefit deductions, and residence/work locations. The verified 2026 federal calculator uses Publication 15-T Worksheet 1A; inactive profile examples never enter a calculation.</p>
                <div class="field-group payroll-employee-picker">
                    <label class="field-label">Employee</label>
                    <InputSelect aria-label="Tax-election employee" class="field-input" @bind-Value="SelectedPayrollSetupEmployeeId">
                        @foreach (var employee in Workspace.Payroll.Employees)
                        {
                            <option value="@employee.Id">@employee.EmployeeNumber — @employee.FullName</option>
                        }
                    </InputSelect>
                </div>
                @if (SelectedPayrollSetupEmployee is not null && SelectedPayrollSetup is not null)
                {
                    var employee = SelectedPayrollSetupEmployee;
                    var setup = SelectedPayrollSetup;
                    <div class="payroll-setup-grid">
                        <fieldset class="payroll-setup-group"><legend>Work location</legend>
                            <div class="field-group"><label class="field-label">State</label><InputText aria-label="@($"Work state for {employee.FullName}")" class="field-input" @bind-Value="setup.WorkState" /></div>
                            <div class="field-group"><label class="field-label">City</label><InputText aria-label="@($"Work city for {employee.FullName}")" class="field-input" @bind-Value="setup.WorkCity" /></div>
                        </fieldset>
                        <fieldset class="payroll-setup-group"><legend>Residence</legend>
                            <div class="field-group"><label class="field-label">State</label><InputText aria-label="@($"Residence state for {employee.FullName}")" class="field-input" @bind-Value="setup.ResidenceState" /></div>
                            <div class="field-group"><label class="field-label">City</label><InputText aria-label="@($"Residence city for {employee.FullName}")" class="field-input" @bind-Value="setup.ResidenceCity" /></div>
                        </fieldset>
                        <fieldset class="payroll-setup-group"><legend>Pay schedule</legend>
                            <div class="field-group"><label class="field-label">Filing status</label><InputSelect aria-label="@($"Filing status for {employee.FullName}")" class="field-input" @bind-Value="setup.FilingStatus"><option>Single</option><option>Married filing jointly</option><option>Head of household</option></InputSelect></div>
                            <div class="field-group"><label class="field-label">Payroll frequency</label><InputSelect aria-label="@($"Payroll frequency for {employee.FullName}")" class="field-input" @bind-Value="setup.PayrollFrequency"><option>Weekly</option><option>Biweekly</option><option>Semimonthly</option><option>Monthly</option><option>Quarterly</option><option>Semiannual</option><option>Annual</option><option>Daily</option></InputSelect></div>
                        </fieldset>
                        <fieldset class="payroll-setup-group payroll-w4-group"><legend>Federal Form W-4</legend>
                            <div class="field-group"><label class="field-label">Form year</label><InputNumber aria-label="@($"Federal Form W-4 year for {employee.FullName}")" class="field-input" @bind-Value="setup.FederalFormW4Year" /></div>
                            <label class="check-field"><InputCheckbox @bind-Value="setup.FederalStep2MultipleJobs" /> Step 2: multiple jobs or spouse works</label>
                            <div class="field-group"><label class="field-label">Step 3 credits</label><InputNumber aria-label="@($"Federal Step 3 credits for {employee.FullName}")" class="field-input" @bind-Value="setup.FederalStep3Credits" /></div>
                            <div class="field-group"><label class="field-label">Step 4(a) other income</label><InputNumber aria-label="@($"Federal Step 4 other income for {employee.FullName}")" class="field-input" @bind-Value="setup.FederalStep4OtherIncome" /></div>
                            <div class="field-group"><label class="field-label">Step 4(b) deductions</label><InputNumber aria-label="@($"Federal Step 4 deductions for {employee.FullName}")" class="field-input" @bind-Value="setup.FederalStep4Deductions" /></div>
                            <div class="field-group"><label class="field-label">Step 4(c) extra withholding</label><InputNumber aria-label="@($"Additional withholding for {employee.FullName}")" class="field-input" @bind-Value="setup.AdditionalWithholding" /></div>
                            <label class="check-field"><InputCheckbox @bind-Value="setup.FederalWithholdingExempt" /> Withholding exemption is on file</label>
                            @if (setup.FederalFormW4Year < 2020) { <div class="field-group"><label class="field-label">Legacy allowances</label><InputNumber aria-label="@($"Legacy allowances for {employee.FullName}")" class="field-input" @bind-Value="setup.Allowances" /></div> }
                        </fieldset>
                        <fieldset class="payroll-setup-group"><legend>Recurring benefits</legend>
                            <div class="field-group"><label class="field-label">Pre-tax deduction</label><InputNumber aria-label="@($"Pre-tax benefits for {employee.FullName}")" class="field-input" @bind-Value="setup.PreTaxBenefitDeductions" /></div>
                            <div class="field-group"><label class="field-label">Post-tax deduction</label><InputNumber aria-label="@($"Post-tax benefits for {employee.FullName}")" class="field-input" @bind-Value="setup.PostTaxBenefitDeductions" /></div>
                        </fieldset>
                    </div>
                    <button class="action-primary" type="button" @onclick="async () => await SaveSetupAsync(employee.Id, setup)">Save @employee.FullName’s elections</button>
                }
        </section>
        </Authorized></AuthorizeView>

        <section class="content-grid">

            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManagePayrollSensitiveData"><Authorized Context="payrollSensitiveContext">
            <article class="panel">
                <h2>Protected employment and payment details</h2>
                <p class="page-intro">Tax identifiers and bank numbers are encrypted at rest and are never displayed after saving. Leave a protected field blank to keep its existing value.</p>
                <div class="field-group"><label class="field-label">Employee</label><InputSelect aria-label="Protected-details employee" class="field-input" @bind-Value="SelectedEmployeeId" @bind-Value:after="LoadEmploymentEditor">@foreach (var employee in Workspace.Payroll.Employees) { <option value="@employee.Id">@employee.EmployeeNumber — @employee.FullName</option> }</InputSelect></div>
                @if (SelectedEmployee is not null)
                {
                    <p>SSN: @(SelectedEmployee.HasSocialSecurityNumber ? "On file" : "Not provided") · Bank account: @(SelectedEmployee.HasBankAccount ? "On file" : "Not provided")</p>
                    <EditForm Model="EmploymentForm" OnValidSubmit="SaveEmploymentDetailsAsync"><div class="content-grid">
                        <div class="field-group"><label class="field-label">Address line 1</label><InputText aria-label="Employee address line 1" class="field-input" @bind-Value="EmploymentForm.AddressLine1" /></div>
                        <div class="field-group"><label class="field-label">Address line 2</label><InputText aria-label="Employee address line 2" class="field-input" @bind-Value="EmploymentForm.AddressLine2" /></div>
                        <div class="field-group"><label class="field-label">Postal code</label><InputText aria-label="Employee postal code" class="field-input" @bind-Value="EmploymentForm.PostalCode" /></div>
                        <div class="field-group"><label class="field-label">Residence county</label><InputText aria-label="Employee residence county" class="field-input" @bind-Value="EmploymentForm.ResidenceCounty" /></div>
                        <div class="field-group"><label class="field-label">Residence school district</label><InputText aria-label="Employee residence school district" class="field-input" @bind-Value="EmploymentForm.ResidenceSchoolDistrict" /></div>
                        <div class="field-group"><label class="field-label">Work county</label><InputText aria-label="Employee work county" class="field-input" @bind-Value="EmploymentForm.WorkCounty" /></div>
                        <div class="field-group"><label class="field-label">Work school district</label><InputText aria-label="Employee work school district" class="field-input" @bind-Value="EmploymentForm.WorkSchoolDistrict" /></div>
                        <div class="field-group"><label class="field-label">Employment start</label><InputDate aria-label="Employee employment start" class="field-input" @bind-Value="EmploymentForm.EmploymentStartedOn" /></div>
                        <div class="field-group"><label class="field-label">Employment end</label><InputDate aria-label="Employee employment end" class="field-input" @bind-Value="EmploymentForm.EmploymentEndedOn" /></div>
                        <div class="field-group"><label class="field-label">Hourly rate</label><InputNumber aria-label="Employee hourly rate" class="field-input" @bind-Value="EmploymentForm.HourlyRate" /></div>
                        <div class="field-group"><label class="field-label">Overtime rate</label><InputNumber aria-label="Employee overtime rate" class="field-input" @bind-Value="EmploymentForm.OvertimeRate" /></div>
                        <div class="field-group"><label class="field-label">New SSN</label><input aria-label="Employee Social Security number" class="field-input" type="password" inputmode="numeric" autocomplete="off" @bind="EmploymentForm.SocialSecurityNumber" /></div>
                        <div class="field-group"><label class="field-label">New routing number</label><input aria-label="Employee bank routing number" class="field-input" type="password" inputmode="numeric" autocomplete="off" @bind="EmploymentForm.BankRoutingNumber" /></div>
                        <div class="field-group"><label class="field-label">New account number</label><input aria-label="Employee bank account number" class="field-input" type="password" inputmode="numeric" autocomplete="off" @bind="EmploymentForm.BankAccountNumber" /></div>
                        <div class="field-group"><label class="field-label">Account type</label><InputSelect aria-label="Employee bank account type" class="field-input" @bind-Value="EmploymentForm.BankAccountType"><option value="">Select</option><option>Checking</option><option>Savings</option></InputSelect></div>
                        <div class="field-group"><label class="field-label"><InputCheckbox @bind-Value="EmploymentForm.DirectDepositEnabled" /> Direct deposit enabled</label></div>
                        <div class="field-group"><label class="field-label"><InputCheckbox @bind-Value="EmploymentForm.ClearSocialSecurityNumber" /> Remove stored SSN</label></div>
                        <div class="field-group"><label class="field-label"><InputCheckbox @bind-Value="EmploymentForm.ClearBankDetails" /> Remove stored bank details</label></div>
                    </div><button class="action-primary" type="submit">Save protected details</button></EditForm>
                }
            </article>
            </Authorized></AuthorizeView>

            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManagePayroll"><Authorized Context="payrollJurisdictionContext">
            <article class="panel">
                <h2>Residence/work tax rules</h2>
                <p class="page-intro">Configure a reciprocity exemption when work-location withholding should not apply, or a resident credit percentage against configured residence withholding. Use the jurisdiction names exactly as they appear in Tax profiles (for example, Arizona or a city name).</p>
                <EditForm Model="JurisdictionRuleForm" OnValidSubmit="SaveJurisdictionRuleAsync"><div class="content-grid"><div class="field-group"><label class="field-label">Residence jurisdiction</label><InputText aria-label="Residence jurisdiction" class="field-input" @bind-Value="JurisdictionRuleForm.ResidenceJurisdiction" /></div><div class="field-group"><label class="field-label">Work jurisdiction</label><InputText aria-label="Work jurisdiction" class="field-input" @bind-Value="JurisdictionRuleForm.WorkJurisdiction" /></div><div class="field-group"><label class="field-label">Resident credit rate</label><InputNumber aria-label="Resident credit rate" class="field-input" @bind-Value="JurisdictionRuleForm.ResidentCreditRate" /></div><div class="field-group"><label class="field-label"><InputCheckbox @bind-Value="JurisdictionRuleForm.ExemptWorkWithholding" /> Exempt work withholding</label></div><div class="field-group"><label class="field-label">Notes</label><InputText aria-label="Jurisdiction rule notes" class="field-input" @bind-Value="JurisdictionRuleForm.Notes" /></div></div><button class="action-primary" type="submit">Save jurisdiction rule</button></EditForm>
                @if (Workspace.Payroll.JurisdictionRules?.Count > 0) { <table class="data-table"><thead><tr><th>Residence</th><th>Work</th><th>Work exemption</th><th>Resident credit</th><th>Notes</th></tr></thead><tbody>@foreach (var rule in Workspace.Payroll.JurisdictionRules) { <tr><td>@rule.ResidenceJurisdiction</td><td>@rule.WorkJurisdiction</td><td>@(rule.ExemptWorkWithholding ? "Yes" : "No")</td><td>@rule.ResidentCreditRate.ToString("P0")</td><td>@rule.Notes</td></tr> }</tbody></table> }
            </article>
            </Authorized></AuthorizeView>
        </section>

            <section class="panel">
                <h2>Tax profiles in payroll scope</h2>
                <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Jurisdiction</th>
                            <th>Type</th>
                            <th>Rate</th>
                            <th>Effective</th>
                            <th>Status</th>
                            <th>Source</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var profile in Workspace.Taxes.Profiles)
                        {
                            <tr>
                                <td>@profile.Jurisdiction</td>
                                <td>@profile.TaxType</td>
                                <td>@profile.Rate.ToString("P3")</td>
                                <td>@profile.EffectiveOn.ToString("MMM d, yyyy")</td>
                                <td>@(profile.IsActive && profile.IsVerified ? "Active · verified" : profile.IsActive ? "Blocked · unverified" : "Inactive")</td>
                                <td>@profile.Source@if (!string.IsNullOrWhiteSpace(profile.VerificationNotes)) { <span> — @profile.VerificationNotes</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </section>
    </section>
}

@code {
    private BusinessWorkspaceSnapshot? Workspace;
    private string? StatusMessage;
    private PayrollRunEditor RunForm { get; } = new();
    private readonly Dictionary<Guid, decimal> RunLines = [];
    private readonly Dictionary<Guid, EmployeePayrollEditor> EmployeeSetups = [];
    private PayrollRunEstimate? Preview;
    private string ReversalReason = string.Empty;
    private JurisdictionRuleEditor JurisdictionRuleForm { get; } = new();
    private Guid SelectedPayrollSetupEmployeeId;
    private Guid SelectedEmployeeId;
    private EmployeeEmploymentEditor EmploymentForm = new();
    private EmployeeSnapshot? SelectedPayrollSetupEmployee => Workspace?.Payroll.Employees.FirstOrDefault(employee => employee.Id == SelectedPayrollSetupEmployeeId);
    private EmployeePayrollEditor? SelectedPayrollSetup => EmployeeSetups.GetValueOrDefault(SelectedPayrollSetupEmployeeId);
    private EmployeeSnapshot? SelectedEmployee => Workspace?.Payroll.Employees.FirstOrDefault(employee => employee.Id == SelectedEmployeeId);

    protected override async Task OnInitializedAsync()
    {
        Workspace = await WorkspaceService.GetWorkspaceAsync();
        foreach (var employee in Workspace.Payroll.Employees)
        {
            RunLines[employee.Id] = decimal.Round(employee.MonthlyBasePay / 2m, 2);
            EmployeeSetups[employee.Id] = new EmployeePayrollEditor(employee.FilingStatus, employee.PayrollFrequency, employee.Allowances, employee.AdditionalWithholding, employee.PreTaxBenefitDeductions, employee.PostTaxBenefitDeductions, employee.ResidenceState, employee.ResidenceCity, employee.State, employee.WorkCity, employee.FederalFormW4Year, employee.FederalStep2MultipleJobs, employee.FederalStep3Credits, employee.FederalStep4OtherIncome, employee.FederalStep4Deductions, employee.FederalWithholdingExempt);
        }
        SelectedPayrollSetupEmployeeId = Workspace.Payroll.Employees.FirstOrDefault()?.Id ?? Guid.Empty;
        SelectedEmployeeId = SelectedPayrollSetupEmployeeId;
        LoadEmploymentEditor();
    }

    private PostEmployeePayrollRunRequest BuildRequest() => new(RunForm.BankAccountId, RunForm.PayDate, RunForm.Reference, RunLines.Where(line => line.Value > 0).Select(line => new EmployeePayrollInput(line.Key, line.Value)).ToArray(), RunForm.PeriodStart, RunForm.PeriodEnd, RunForm.RunType);
    private void SetRunLine(Guid employeeId, object? value)
    {
        if (decimal.TryParse(value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var amount))
        {
            RunLines[employeeId] = amount;
        }
    }
    private async Task PreviewPayrollAsync()
    {
        Preview = await TransactionService.PreviewEmployeePayrollRunAsync(BuildRequest());
        StatusMessage = Preview is null ? "Payroll could not be calculated. Confirm every employee has positive gross pay and applicable tax profiles." : "Review the calculated employee payroll before posting.";
    }
    private async Task SavePayrollDraftAsync()
    {
        var result = await TransactionService.SaveEmployeePayrollRunDraftAsync(BuildRequest());
        StatusMessage = result.Succeeded ? "Payroll draft saved. It has not changed the ledger or funding account." : result.ErrorMessage;
        if (result.Succeeded) { Preview = null; Workspace = await WorkspaceService.GetWorkspaceAsync(); }
    }
    private async Task ApprovePayrollAsync(PayrollRunSnapshot run)
    {
        var result = await TransactionService.ApprovePayrollRunAsync(new ApprovePayrollRunRequest(run.Id, run.ConcurrencyToken));
        StatusMessage = result.Succeeded ? "Payroll run approved and ready for posting." : result.ErrorMessage;
        Workspace = await WorkspaceService.GetWorkspaceAsync();
    }
    private async Task PostApprovedPayrollAsync(PayrollRunSnapshot run)
    {
        var result = await TransactionService.PostApprovedPayrollRunAsync(new PostApprovedPayrollRunRequest(run.Id, run.ConcurrencyToken));
        StatusMessage = result.Succeeded ? "Approved payroll posted to the ledger." : result.ErrorMessage;
        Workspace = await WorkspaceService.GetWorkspaceAsync();
    }
    private async Task ReversePayrollAsync(PayrollRunSnapshot run)
    {
        if (string.IsNullOrWhiteSpace(ReversalReason)) { StatusMessage = "Enter a reversal reason before reversing payroll."; return; }
        var result = await TransactionService.ReversePayrollRunAsync(new ReversePayrollRunRequest(run.Id, DateOnly.FromDateTime(DateTime.Today), ReversalReason, run.ConcurrencyToken));
        StatusMessage = result.Succeeded ? "Payroll run reversed with a linked audit journal." : result.ErrorMessage;
        if (result.Succeeded) ReversalReason = string.Empty;
        Workspace = await WorkspaceService.GetWorkspaceAsync();
    }
    private async Task SaveSetupAsync(Guid employeeId, EmployeePayrollEditor setup)
    {
        var result = await TransactionService.SaveEmployeePayrollSetupAsync(new SaveEmployeePayrollSetupRequest(employeeId, setup.FilingStatus, setup.Allowances, setup.AdditionalWithholding, setup.PreTaxBenefitDeductions, setup.PostTaxBenefitDeductions, setup.ResidenceState, setup.ResidenceCity, setup.WorkState, setup.WorkCity, setup.PayrollFrequency, setup.FederalFormW4Year, setup.FederalStep2MultipleJobs, setup.FederalStep3Credits, setup.FederalStep4OtherIncome, setup.FederalStep4Deductions, setup.FederalWithholdingExempt));
        StatusMessage = result.Succeeded ? "Employee payroll setup saved." : result.ErrorMessage;
        if (result.Succeeded) Workspace = await WorkspaceService.GetWorkspaceAsync();
    }
    private void LoadEmploymentEditor()
    {
        var employee = SelectedEmployee;
        EmploymentForm = employee is null ? new() : new EmployeeEmploymentEditor { AddressLine1 = employee.AddressLine1, AddressLine2 = employee.AddressLine2, PostalCode = employee.PostalCode, ResidenceCounty = employee.ResidenceCounty, ResidenceSchoolDistrict = employee.ResidenceSchoolDistrict, WorkCounty = employee.WorkCounty, WorkSchoolDistrict = employee.WorkSchoolDistrict, EmploymentStartedOn = employee.EmploymentStartedOn, EmploymentEndedOn = employee.EmploymentEndedOn, HourlyRate = employee.HourlyRate, OvertimeRate = employee.OvertimeRate, DirectDepositEnabled = employee.DirectDepositEnabled, ConcurrencyToken = employee.ConcurrencyToken };
    }
    private async Task SaveEmploymentDetailsAsync()
    {
        var request = new SaveEmployeeEmploymentDetailsRequest(SelectedEmployeeId, EmploymentForm.AddressLine1, EmploymentForm.AddressLine2, EmploymentForm.PostalCode, EmploymentForm.ResidenceCounty, EmploymentForm.ResidenceSchoolDistrict, EmploymentForm.WorkCounty, EmploymentForm.WorkSchoolDistrict, EmploymentForm.EmploymentStartedOn, EmploymentForm.EmploymentEndedOn, EmploymentForm.HourlyRate, EmploymentForm.OvertimeRate, EmploymentForm.DirectDepositEnabled, EmploymentForm.BankAccountType, EmploymentForm.SocialSecurityNumber, EmploymentForm.BankRoutingNumber, EmploymentForm.BankAccountNumber, EmploymentForm.ClearSocialSecurityNumber, EmploymentForm.ClearBankDetails, EmploymentForm.ConcurrencyToken);
        var result = await TransactionService.SaveEmployeeEmploymentDetailsAsync(request);
        StatusMessage = result.Succeeded ? "Protected employee details saved. Stored identifiers remain masked." : result.ErrorMessage;
        if (result.Succeeded) { Workspace = await WorkspaceService.GetWorkspaceAsync(); LoadEmploymentEditor(); }
    }
    private async Task SaveJurisdictionRuleAsync()
    {
        var result = await TransactionService.SavePayrollJurisdictionRuleAsync(new SavePayrollJurisdictionRuleRequest(null, JurisdictionRuleForm.ResidenceJurisdiction, JurisdictionRuleForm.WorkJurisdiction, JurisdictionRuleForm.ExemptWorkWithholding, JurisdictionRuleForm.ResidentCreditRate, true, JurisdictionRuleForm.Notes));
        StatusMessage = result.Succeeded ? "Residence/work tax rule saved." : result.ErrorMessage;
        if (result.Succeeded) Workspace = await WorkspaceService.GetWorkspaceAsync();
    }

