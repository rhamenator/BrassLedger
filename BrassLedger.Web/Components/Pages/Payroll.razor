@page "/payroll"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.AccessPayroll)]
@inject IBusinessWorkspaceService WorkspaceService
@inject IAccountingTransactionService TransactionService
@inject IPayrollReportingService PayrollReportingService
@inject IPayrollFilingService PayrollFilingService
@inject IPayrollDeductionConfigurationService PayrollDeductionConfigurationService
@inject IPayrollPaymentFileService PayrollPaymentFileService
@inject IPayrollDepositScheduleService PayrollDepositScheduleService
@inject IPayrollDisasterReliefService PayrollDisasterReliefService
@inject ISsaWageFileService SsaWageFileService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Payroll</PageTitle>

@if (Workspace is null)
{
    <section class="panel">
        <h1>Loading payroll...</h1>
    </section>
}
else
{
    <section class="page-shell">
        <header class="page-header">
            <div>
                <p class="eyebrow">Payroll and Time</p>
                <h1>Prepare, approve, post, and audit payroll.</h1>
            </div>
            <p class="page-intro">Build a dated payroll draft, review employee and jurisdiction calculations, approve it, and post it through a controlled ledger workflow.</p>
        </header>
        @if (!string.IsNullOrWhiteSpace(StatusMessage)) { <p class="lead" role="status" aria-live="polite">@StatusMessage</p> }

        <section class="stats-grid">
            <article class="stat-card accent-sand">
                <span class="stat-value">@Workspace.Payroll.ActiveEmployees</span>
                <span class="stat-label">Active employees</span>
            </article>
            <article class="stat-card accent-sky">
                <span class="stat-value">@Workspace.Payroll.MonthlyGross.ToString("C0")</span>
                <span class="stat-label">Monthly gross</span>
            </article>
            <article class="stat-card accent-sage">
                <span class="stat-value">@Workspace.Taxes.ProfileCount</span>
                <span class="stat-label">Tax profiles</span>
            </article>
            <article class="stat-card accent-coral">
                <span class="stat-value">@Workspace.Taxes.EmployerSpecificCount</span>
                <span class="stat-label">Employer-specific rates</span>
            </article>
        </section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManagePayrollSensitiveData"><Authorized Context="payrollFilingContext">
        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.MaintainEmployeePayrollSetup"><Authorized Context="deductionConfigurationContext">
        <section class="panel">
            <h2>Deduction, benefit, and court-order plans</h2>
            <p class="page-intro">Create effective-dated plans, then enroll employees below. Percentage values are decimal rates (for example, 0.05 is 5%). Court-order limits require a dated official source and JSON rule parameters; payroll records both the requested and applied amounts whenever a limit is reached.</p>
            <details open="@DeductionPlanForm.Id.HasValue"><summary>@(DeductionPlanForm.Id.HasValue ? $"Edit plan {DeductionPlanForm.Code}" : "Create a deduction or benefit plan")</summary>
            <EditForm Model="DeductionPlanForm" OnValidSubmit="SaveDeductionPlanAsync">
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Plan code</label><InputText aria-label="Deduction plan code" class="field-input" @bind-Value="DeductionPlanForm.Code" /></div>
                    <div class="field-group"><label class="field-label">Plan name</label><InputText aria-label="Deduction plan name" class="field-input" @bind-Value="DeductionPlanForm.Name" /></div>
                    <div class="field-group"><label class="field-label">Category</label><InputSelect aria-label="Deduction plan category" class="field-input" @bind-Value="DeductionPlanForm.Category">@foreach (var category in DeductionCategories) { <option value="@category">@CategoryLabel(category)</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Calculation</label><InputSelect aria-label="Deduction calculation method" class="field-input" @bind-Value="DeductionPlanForm.CalculationMethod"><option>Fixed</option><option>PercentGross</option><option>PercentDisposable</option></InputSelect></div>
                    <div class="field-group"><label class="field-label">Employee value</label><InputNumber aria-label="Default employee deduction value" class="field-input" @bind-Value="DeductionPlanForm.DefaultEmployeeValue" /></div>
                    <div class="field-group"><label class="field-label">Employer value</label><InputNumber aria-label="Default employer contribution value" class="field-input" @bind-Value="DeductionPlanForm.DefaultEmployerValue" /></div>
                    <div class="field-group"><label class="field-label">Liability account</label><InputText aria-label="Deduction liability account" class="field-input" @bind-Value="DeductionPlanForm.LiabilityAccountNumber" /></div>
                    <div class="field-group"><label class="field-label">Priority</label><InputNumber aria-label="Deduction priority" class="field-input" @bind-Value="DeductionPlanForm.Priority" /></div>
                    <div class="field-group"><label class="field-label">Per-pay employee limit</label><InputNumber aria-label="Employee limit per pay" class="field-input" @bind-Value="DeductionPlanForm.EmployeeLimitPerPay" /></div>
                    <div class="field-group"><label class="field-label">Annual employee limit</label><InputNumber aria-label="Annual employee deduction limit" class="field-input" @bind-Value="DeductionPlanForm.EmployeeAnnualLimit" /></div>
                    <div class="field-group"><label class="field-label">Minimum net pay</label><InputNumber aria-label="Minimum employee net pay" class="field-input" @bind-Value="DeductionPlanForm.MinimumNetPay" /></div>
                    <div class="field-group"><label class="field-label">Legal limit</label><InputSelect aria-label="Deduction legal limit rule" class="field-input" @bind-Value="DeductionPlanForm.LimitRuleCode"><option>None</option><option>OrdinaryGarnishmentFederal</option><option>ChildSupportFederal</option><option>ConfiguredDisposablePercent</option><option>NoCcpaLimit</option></InputSelect></div>
                    <div class="field-group"><label class="field-label">Effective</label><InputDate aria-label="Deduction plan effective date" class="field-input" @bind-Value="DeductionPlanForm.EffectiveOn" /></div>
                    <div class="field-group"><label class="field-label">Expires</label><InputDate aria-label="Deduction plan expiration date" class="field-input" @bind-Value="DeductionPlanForm.ExpiresOn" /></div>
                    <div class="field-group"><label class="field-label">Official source URL</label><InputText aria-label="Deduction legal official source URL" class="field-input" @bind-Value="DeductionPlanForm.OfficialSourceUrl" /></div>
                    <div class="field-group"><label class="field-label">Source retrieved</label><InputDate aria-label="Deduction legal source retrieval date" class="field-input" @bind-Value="DeductionPlanForm.SourceRetrievedOn" /></div>
                    <div class="field-group"><label class="field-label">Legal rule JSON</label><InputTextArea aria-label="Deduction legal rule JSON" class="field-input" @bind-Value="DeductionPlanForm.LimitRuleJson" /></div>
                </div>
                @if (DeductionPlanForm.LimitRuleCode is "OrdinaryGarnishmentFederal" or "ChildSupportFederal") { <button class="action-secondary" type="button" @onclick="LoadFederalDeductionRuleDefaults">Load current federal defaults</button> }
                <div class="content-grid"><label class="check-field"><InputCheckbox @bind-Value="DeductionPlanForm.IsPreTax" /> Pretax</label><label class="check-field"><InputCheckbox @bind-Value="DeductionPlanForm.ExemptFromFederalIncomeTax" /> Exempt from federal income tax</label><label class="check-field"><InputCheckbox @bind-Value="DeductionPlanForm.ExemptFromFica" /> Exempt from FICA</label><label class="check-field"><InputCheckbox @bind-Value="DeductionPlanForm.ExemptFromFuta" /> Exempt from FUTA</label><label class="check-field"><InputCheckbox @bind-Value="DeductionPlanForm.ReducesDisposableEarnings" /> Required by law when computing disposable earnings</label><label class="check-field"><InputCheckbox @bind-Value="DeductionPlanForm.IsActive" /> Active</label></div>
                <button class="action-primary" type="submit">@(DeductionPlanForm.Id.HasValue ? "Update plan" : "Create plan")</button>@if (DeductionPlanForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="ResetDeductionPlanEditor">Cancel edit</button> }
            </EditForm></details>
            @if (DeductionConfiguration.Plans.Count > 0) { <div class="table-scroll"><table class="data-table"><thead><tr><th>Priority</th><th>Plan</th><th>Category</th><th>Calculation</th><th>Limits</th><th>Effective</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var plan in DeductionConfiguration.Plans) { <tr><td>@plan.Priority</td><td><strong>@plan.Code</strong><br />@plan.Name</td><td>@CategoryLabel(plan.Category)</td><td>@plan.CalculationMethod<br />@(plan.IsPreTax ? "Pretax" : "Post-tax")</td><td>@plan.LimitRuleCode@if (plan.EmployeeLimitPerPay.HasValue) { <br /><span>@plan.EmployeeLimitPerPay.Value.ToString("C") per pay</span> }@if (plan.EmployeeAnnualLimit.HasValue) { <br /><span>@plan.EmployeeAnnualLimit.Value.ToString("C") annual</span> }</td><td>@plan.EffectiveOn@if (plan.ExpiresOn.HasValue) { <span>–@plan.ExpiresOn</span> }</td><td>@(plan.IsActive ? "Active" : "Inactive")</td><td><button class="action-secondary" type="button" @onclick="() => EditDeductionPlan(plan)">Edit</button></td></tr> }</tbody></table></div> }

            <h3>Employee elections and orders</h3>
            <p>Order details are protected payroll data. For support limits, JSON may include <code>supportsAnotherSpouseOrChild</code> and <code>arrearsOver12Weeks</code>; court and case references can be retained in the same audited object.</p>
            <details open="@DeductionElectionForm.Id.HasValue"><summary>@(DeductionElectionForm.Id.HasValue ? $"Edit {DeductionElectionForm.EmployeeId}'s election" : "Enroll an employee or record an order")</summary><EditForm Model="DeductionElectionForm" OnValidSubmit="SaveDeductionElectionAsync"><div class="content-grid">
                <div class="field-group"><label class="field-label">Employee</label><InputSelect aria-label="Deduction election employee" class="field-input" @bind-Value="DeductionElectionForm.EmployeeId">@foreach (var employee in Workspace.Payroll.Employees) { <option value="@employee.Id">@employee.EmployeeNumber — @employee.FullName</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label">Plan</label><InputSelect aria-label="Deduction election plan" class="field-input" @bind-Value="DeductionElectionForm.PayrollDeductionPlanId">@foreach (var plan in DeductionConfiguration.Plans) { <option value="@plan.Id">@plan.Code — @plan.Name</option> }</InputSelect></div>
                <div class="field-group"><label class="field-label">Employee value override</label><InputNumber aria-label="Employee deduction value override" class="field-input" @bind-Value="DeductionElectionForm.EmployeeValueOverride" /></div>
                <div class="field-group"><label class="field-label">Employer value override</label><InputNumber aria-label="Employer deduction value override" class="field-input" @bind-Value="DeductionElectionForm.EmployerValueOverride" /></div>
                <div class="field-group"><label class="field-label">Annual limit override</label><InputNumber aria-label="Employee annual deduction limit override" class="field-input" @bind-Value="DeductionElectionForm.EmployeeAnnualLimitOverride" /></div>
                <div class="field-group"><label class="field-label">Effective</label><InputDate aria-label="Deduction election effective date" class="field-input" @bind-Value="DeductionElectionForm.EffectiveOn" /></div>
                <div class="field-group"><label class="field-label">Expires</label><InputDate aria-label="Deduction election expiration date" class="field-input" @bind-Value="DeductionElectionForm.ExpiresOn" /></div>
                <div class="field-group"><label class="field-label">Protected order/election JSON</label><InputTextArea aria-label="Protected deduction order details" class="field-input" @bind-Value="DeductionElectionForm.OrderDetailsJson" /></div>
                <label class="check-field"><InputCheckbox @bind-Value="DeductionElectionForm.IsActive" /> Active</label>
            </div><button class="action-primary" type="submit">@(DeductionElectionForm.Id.HasValue ? "Update election" : "Enroll employee")</button>@if (DeductionElectionForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="ResetDeductionElectionEditor">Cancel edit</button> }</EditForm></details>
            @if (DeductionConfiguration.Elections.Count > 0) { <div class="table-scroll"><table class="data-table"><thead><tr><th>Employee</th><th>Plan</th><th>Effective</th><th>Overrides</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var election in DeductionConfiguration.Elections) { <tr><td>@EmployeeName(election.EmployeeId)</td><td>@election.PlanCode — @election.PlanName</td><td>@election.EffectiveOn@if (election.ExpiresOn.HasValue) { <span>–@election.ExpiresOn</span> }</td><td>@(election.EmployeeValueOverride?.ToString() ?? "Plan default")</td><td>@(election.IsActive ? "Active" : "Inactive")</td><td><button class="action-secondary" type="button" @onclick="() => EditDeductionElection(election)">Edit</button></td></tr> }</tbody></table></div> }
        </section>
        </Authorized></AuthorizeView>

        <section class="panel">
            <h2>Employee payment files</h2>
            <p class="page-intro">Generate immutable files only after payroll posts and employee payments reconcile to net pay. ACH instruction CSV and check-register CSV are bank-neutral exports. NACHA PPD output uses 94-byte records and control totals, but remains marked for bank validation because each originating bank controls its accepted origin values and submission process.</p>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.MaintainEmployeePayrollSetup"><Authorized Context="bankOriginContext">
                <h3>ACH originating-bank settings</h3>
                <details open="@BankOriginForm.Id.HasValue"><summary>@(BankOriginForm.Id.HasValue ? $"Edit origin for {BankOriginForm.BankAccountId}" : "Configure an ACH bank origin")</summary><EditForm Model="BankOriginForm" OnValidSubmit="SaveBankOriginAsync"><div class="content-grid">
                    <div class="field-group"><label class="field-label">Funding account</label><InputSelect aria-label="ACH origin funding account" class="field-input" @bind-Value="BankOriginForm.BankAccountId">@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Immediate destination routing</label><InputText aria-label="ACH immediate destination routing number" class="field-input" autocomplete="off" @bind-Value="BankOriginForm.ImmediateDestinationRoutingNumber" /></div>
                    <div class="field-group"><label class="field-label">Immediate origin</label><InputText aria-label="ACH immediate origin" class="field-input" autocomplete="off" @bind-Value="BankOriginForm.ImmediateOrigin" /></div>
                    <div class="field-group"><label class="field-label">Destination bank name</label><InputText aria-label="ACH destination bank name" class="field-input" @bind-Value="BankOriginForm.DestinationBankName" /></div>
                    <div class="field-group"><label class="field-label">Origin name</label><InputText aria-label="ACH origin name" class="field-input" @bind-Value="BankOriginForm.OriginName" /></div>
                    <div class="field-group"><label class="field-label">Company identification</label><InputText aria-label="ACH company identification" class="field-input" autocomplete="off" @bind-Value="BankOriginForm.CompanyIdentification" /></div>
                    <div class="field-group"><label class="field-label">Entry description</label><InputText aria-label="ACH company entry description" class="field-input" @bind-Value="BankOriginForm.CompanyEntryDescription" /></div>
                    <div class="field-group"><label class="field-label">Originating DFI ID</label><InputText aria-label="ACH originating DFI identification" class="field-input" @bind-Value="BankOriginForm.OriginatingDfiIdentification" /></div>
                    <div class="field-group"><label class="field-label">Effective</label><InputDate aria-label="ACH origin effective date" class="field-input" @bind-Value="BankOriginForm.EffectiveOn" /></div>
                    <div class="field-group"><label class="field-label">Expires</label><InputDate aria-label="ACH origin expiration date" class="field-input" @bind-Value="BankOriginForm.ExpiresOn" /></div>
                    <div class="field-group"><label class="field-label">Bank-validation notes</label><InputTextArea aria-label="ACH bank validation notes" class="field-input" @bind-Value="BankOriginForm.BankValidationNotes" /></div>
                    <label class="check-field"><InputCheckbox @bind-Value="BankOriginForm.IsActive" /> Active</label><label class="check-field"><InputCheckbox @bind-Value="BankOriginForm.IsBankValidated" /> Originating bank validated these exact settings</label>
                </div><button class="action-primary" type="submit">@(BankOriginForm.Id.HasValue ? "Update bank origin" : "Save bank origin")</button>@if (BankOriginForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="ResetBankOriginEditor">Cancel edit</button> }</EditForm></details>
                @if (PaymentFileWorkspace.BankOrigins.Count > 0) { <div class="table-scroll"><table class="data-table"><thead><tr><th>Funding account</th><th>Destination</th><th>Origin</th><th>Effective</th><th>Bank validation</th><th></th></tr></thead><tbody>@foreach (var origin in PaymentFileWorkspace.BankOrigins) { <tr><td>@origin.BankAccountName</td><td>@origin.DestinationBankName<br />••••@origin.DestinationRoutingLastFour</td><td>@origin.OriginName<br />@origin.ImmediateOriginMasked</td><td>@origin.EffectiveOn@if (origin.ExpiresOn.HasValue) { <span>–@origin.ExpiresOn</span> }</td><td>@(origin.IsBankValidated ? "Validated" : "Not validated")<br />@origin.BankValidationNotes</td><td><button class="action-secondary" type="button" @onclick="() => EditBankOrigin(origin)">Edit</button></td></tr> }</tbody></table></div> }
            </Authorized></AuthorizeView>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PostPayroll"><Authorized Context="paymentFileGenerateContext">
                <h3>Generate from posted payroll</h3>
                <div class="content-grid"><div class="field-group"><label class="field-label">Payroll run</label><InputSelect aria-label="Payment file payroll run" class="field-input" @bind-Value="PaymentFileForm.PayrollRunId">@foreach (var run in Workspace.Payroll.Runs?.Where(item => item.Status == "Posted") ?? []) { <option value="@run.Id">@run.Reference — @run.PayDate</option> }</InputSelect></div><div class="field-group"><label class="field-label">Format</label><InputSelect aria-label="Payroll payment file format" class="field-input" @bind-Value="PaymentFileForm.Format"><option value="AchInstructionsCsv">ACH instruction CSV</option><option value="CheckRegisterCsv">Check register CSV</option><option value="NachaPpd">NACHA PPD (bank validation required)</option></InputSelect></div><div class="field-group"><label class="field-label">Effective entry date</label><InputDate aria-label="ACH effective entry date" class="field-input" @bind-Value="PaymentFileForm.EffectiveEntryDate" /></div></div>
                <button class="action-primary" type="button" @onclick="GeneratePaymentFileAsync" disabled="@(PaymentFileForm.PayrollRunId == Guid.Empty)">Generate immutable payment file</button>@if (PaymentFileForm.PayrollRunId == Guid.Empty) { <p>No posted, unreversed payroll run is available.</p> }
            </Authorized></AuthorizeView>
            @if (PaymentFileWorkspace.Files.Count > 0) { <div class="table-scroll"><table class="data-table"><thead><tr><th>Payroll</th><th>Format</th><th>Entries</th><th>Total</th><th>Status</th><th>Generated</th><th>Integrity</th><th></th></tr></thead><tbody>@foreach (var file in PaymentFileWorkspace.Files) { <tr><td>@file.PayrollReference</td><td>@file.Format<br /><small>@file.SpecificationVersion</small></td><td>@file.EntryCount</td><td>@file.CreditTotal.ToString("C")</td><td>@file.Status@if (!string.IsNullOrWhiteSpace(file.VoidReason)) { <br /><strong>@file.VoidReason</strong> }</td><td>@file.GeneratedAtUtc.ToLocalTime().ToString("g")</td><td><code>@file.ContentSha256[..12]</code><br /><code>@file.SourceDigestSha256[..12]</code></td><td><a class="action-secondary" href="@($"/payroll/payment-files/{file.Id}/download")">@(file.Status == "Voided" ? "Download voided copy" : "Download")</a></td></tr> }</tbody></table></div> }
            else { <p>No payment files have been generated.</p> }
        </section>

        <section class="panel">
            <h2>Federal filing data and payroll close</h2>
            <p class="page-intro">Generate source-locked 2026 Form 941, Form 940, or W-2/W-3 data from posted, unreversed payroll. Approval freezes the source digest and locks affected payroll until the filing is reopened. JSON output is preparation data for professional review; it is not an electronically transmitted return.</p>
            <div class="content-grid">
                <div class="field-group"><label class="field-label">Form</label><InputSelect aria-label="Payroll filing form" class="field-input" @bind-Value="FilingForm.FormCode"><option value="941">941 quarterly</option><option value="940">940 annual FUTA</option><option value="W2">W-2 / W-3 annual</option></InputSelect></div>
                <div class="field-group"><label class="field-label">Tax year</label><InputNumber aria-label="Payroll filing tax year" class="field-input" @bind-Value="FilingForm.TaxYear" /></div>
                @if (FilingForm.FormCode == "941") { <div class="field-group"><label class="field-label">Quarter</label><InputSelect aria-label="Payroll filing quarter" class="field-input" @bind-Value="FilingForm.Quarter"><option value="1">Q1</option><option value="2">Q2</option><option value="3">Q3</option><option value="4">Q4</option></InputSelect></div> }
            </div>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PreparePayroll"><Authorized Context="filingPrepareContext"><button class="action-primary" type="button" @onclick="GenerateFilingAsync">Generate filing draft</button></Authorized></AuthorizeView>
            @if (PayrollFilings.Count > 0)
            {
                <div class="table-scroll"><table class="data-table"><thead><tr><th>Form</th><th>Period</th><th>Status</th><th>Generated</th><th>Source digest</th><th>Official source</th><th>Actions</th></tr></thead><tbody>
                @foreach (var filing in PayrollFilings)
                {
                    <tr><td>@filing.FormCode</td><td>@filing.TaxYear@(filing.Quarter.HasValue ? $" Q{filing.Quarter}" : "")</td><td>@filing.Status</td><td>@filing.PreparedAtUtc.ToLocalTime().ToString("g")</td><td><code>@filing.SourceDigestSha256[..12]</code></td><td><a href="@filing.OfficialSourceUrl" target="_blank" rel="noopener">IRS guidance</a></td><td><a class="action-secondary" href="@($"/payroll/filings/{filing.Id}/data.json")">Download JSON</a>@if (filing.Status == "Draft") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PreparePayroll"><Authorized Context="filingRegenerateContext"><button class="action-secondary" type="button" @onclick="() => RegenerateFilingAsync(filing)">Regenerate</button></Authorized></AuthorizeView><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApprovePayroll"><Authorized Context="filingApproveContext"><button class="action-primary" type="button" @onclick="() => ApproveFilingAsync(filing)">Approve</button></Authorized></AuthorizeView> } else if (filing.Status == "Approved") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="filingReopenContext"><button class="action-secondary" type="button" @onclick="() => ReopenFilingAsync(filing)">Reopen</button></Authorized></AuthorizeView> }</td></tr>
                }
                </tbody></table></div>
            }
            else { <p>No federal filing-data drafts have been generated.</p> }
            @if (PayrollFilings.Any(filing => filing.FormCode == "941" && filing.HasApprovedBaseline))
            {
                <details open="@CorrectionForm.Id.HasValue"><summary>@(CorrectionForm.Id.HasValue ? "Regenerate Form 941-X draft" : "Prepare a Form 941-X correction")</summary>
                    <p class="page-intro">First reopen the affected payroll period and post the authorized correcting payroll entries. BrassLedger compares those current records with the approved 941 (or latest approved 941-X) without overwriting either filing.</p>
                    <div class="content-grid">
                        <div class="field-group"><label class="field-label">Approved Form 941 baseline</label><InputSelect aria-label="Original approved Form 941 filing" class="field-input" @bind-Value="CorrectionForm.OriginalPayrollFilingId">@foreach (var filing in PayrollFilings.Where(item => item.FormCode == "941" && item.HasApprovedBaseline)) { <option value="@filing.Id">@filing.TaxYear Q@filing.Quarter</option> }</InputSelect></div>
                        <div class="field-group"><label class="field-label">Process</label><InputSelect aria-label="Form 941-X process" class="field-input" @bind-Value="CorrectionForm.Process"><option>Adjustment</option><option>Claim</option></InputSelect></div>
                        <div class="field-group"><label class="field-label">Error discovered</label><InputDate aria-label="Form 941-X discovery date" class="field-input" @bind-Value="CorrectionForm.DiscoveredOn" /></div>
                        <div class="field-group"><label class="field-label">Federal withholding correction</label><InputSelect aria-label="Federal withholding correction type" class="field-input" @bind-Value="CorrectionForm.FederalWithholdingCorrectionType"><option value="None">No FIT correction</option><option value="SameYearRepaid">Same-year correction; employee repaid/reimbursed</option><option value="AdministrativeError">Administrative reporting error</option><option value="Section3509">IRC section 3509 rates</option></InputSelect></div>
                        <div class="field-group"><label class="field-label">Employee-tax certification</label><InputSelect aria-label="Form 941-X employee tax certification" class="field-input" @bind-Value="CorrectionForm.EmployeeCertificationCode"><option value="UnderreportedOnly">Underreported tax only</option><option value="RepaidOrReimbursed">Employees repaid or reimbursed</option><option value="EmployeeConsent">Employee statements/consents retained</option><option value="EmployerShareOnly">Employer share only where consent unavailable</option><option value="NotWithheld">Corrected amount was not withheld</option></InputSelect></div>
                        <div class="field-group"><label class="field-label">Certification evidence reference</label><InputText aria-label="Form 941-X certification evidence reference" class="field-input" @bind-Value="CorrectionForm.EmployeeCertificationEvidenceReference" /></div>
                        <div class="field-group"><label class="field-label">W-2/W-2c evidence reference</label><InputText aria-label="Form W-2c evidence reference" class="field-input" @bind-Value="CorrectionForm.WageStatementEvidenceReference" /></div>
                        <div class="field-group"><label class="field-label"><InputCheckbox aria-label="Applicable wage statements corrected" @bind-Value="CorrectionForm.WageStatementsCorrected" /> Applicable W-2/W-2c forms filed or scheduled</label></div>
                        <div class="field-group"><label class="field-label">Detailed explanation</label><InputTextArea aria-label="Form 941-X correction explanation" class="field-input" @bind-Value="CorrectionForm.Explanation" /></div>
                    </div>
                    <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PreparePayroll"><Authorized Context="correctionPrepareContext"><button class="action-primary" type="button" @onclick="SaveForm941CorrectionAsync">Generate source-locked 941-X draft</button>@if (CorrectionForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="ResetForm941Correction">Cancel edit</button> }</Authorized></AuthorizeView>
                </details>
            }
            @if (PayrollFilings.Any(filing => filing.FormCode == "W2" && filing.HasApprovedBaseline))
            {
                <details open="@W2CorrectionForm.Id.HasValue"><summary>@(W2CorrectionForm.Id.HasValue ? "Regenerate W-2c/W-3c draft" : "Prepare W-2c/W-3c corrections")</summary>
                    <p class="page-intro">Compare current posted annual payroll and employee identity data with the immutable approved W-2/W-3 baseline or latest approved correction. The package marks address-only and state/local-only changes that must not be sent to SSA.</p>
                    <div class="content-grid">
                        <div class="field-group"><label class="field-label">Approved W-2/W-3 baseline</label><InputSelect aria-label="Original approved W-2 filing" class="field-input" @bind-Value="W2CorrectionForm.OriginalPayrollFilingId">@foreach (var filing in PayrollFilings.Where(item => item.FormCode == "W2" && item.HasApprovedBaseline)) { <option value="@filing.Id">@filing.TaxYear W-2/W-3</option> }</InputSelect></div>
                        <div class="field-group"><label class="field-label">Error discovered</label><InputDate aria-label="W-2c discovery date" class="field-input" @bind-Value="W2CorrectionForm.DiscoveredOn" /></div>
                        <div class="field-group"><label class="field-label">Employee-delivery evidence</label><InputText aria-label="W-2c employee delivery evidence" class="field-input" @bind-Value="W2CorrectionForm.EmployeeStatementEvidenceReference" /></div>
                        <label class="check-field"><InputCheckbox aria-label="Corrected employee statements furnished" @bind-Value="W2CorrectionForm.EmployeeStatementsFurnished" /> Corrected employee statements furnished or scheduled</label>
                        <div class="field-group"><label class="field-label">Detailed explanation</label><InputTextArea aria-label="W-2c correction explanation" class="field-input" @bind-Value="W2CorrectionForm.Explanation" /></div>
                    </div>
                    <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PreparePayroll"><Authorized Context="w2cPrepareContext"><button class="action-primary" type="button" @onclick="SaveW2CorrectionAsync">Generate source-locked W-2c/W-3c draft</button>@if (W2CorrectionForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="ResetW2Correction">Cancel edit</button> }</Authorized></AuthorizeView>
                </details>
            }
            <details open="@SsaConfigurationForm.Id.HasValue"><summary>SSA EFW2C specification and AccuWage workflow</summary>
                <p class="page-intro">SSA published tax-year 2026 EFW2C on July 10, 2026. BrassLedger permits activation only after the exact PDF is hashed and reviewed against the 2026 layout; a generated file is not ready for SSA submission until AccuWage Online returns a retained successful result.</p>
                <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PreparePayroll"><Authorized Context="ssaPrepareContext">
                    <EditForm Model="SsaConfigurationForm" OnValidSubmit="SaveSsaConfigurationAsync"><h3>Specification evidence</h3><div class="content-grid">
                        <div class="field-group"><label class="field-label">Tax year</label><InputNumber aria-label="SSA specification tax year" class="field-input" @bind-Value="SsaConfigurationForm.SpecificationTaxYear" /></div><div class="field-group"><label class="field-label">Specification version</label><InputText aria-label="SSA specification version" class="field-input" @bind-Value="SsaConfigurationForm.SpecificationVersion" /></div>
                        <div class="field-group"><label class="field-label">Layout compatibility</label><InputText aria-label="SSA layout compatibility code" class="field-input" @bind-Value="SsaConfigurationForm.LayoutCompatibilityCode" /></div><div class="field-group"><label class="field-label">Official SSA PDF</label><InputText aria-label="Official SSA specification URL" class="field-input" @bind-Value="SsaConfigurationForm.OfficialSpecificationUrl" /></div>
                        <div class="field-group"><label class="field-label">Official PDF SHA-256</label><InputText aria-label="SSA specification SHA-256" class="field-input" @bind-Value="SsaConfigurationForm.OfficialSpecificationSha256" /></div><div class="field-group"><label class="field-label">Retrieved</label><InputDate aria-label="SSA specification retrieval date" class="field-input" @bind-Value="SsaConfigurationForm.SourceRetrievedOn" /></div>
                        <div class="field-group"><label class="field-label">Review notes</label><InputTextArea aria-label="SSA specification review notes" class="field-input" @bind-Value="SsaConfigurationForm.ReviewNotes" /></div>
                    </div><h3>BSO submitter and employer</h3><div class="content-grid">
                        <div class="field-group"><label class="field-label">Submitter EIN</label><InputText aria-label="SSA submitter EIN" class="field-input" @bind-Value="SsaConfigurationForm.SubmitterEin" /></div><div class="field-group"><label class="field-label">Attesting BSO user ID</label><InputText aria-label="SSA BSO user ID" class="field-input" @bind-Value="SsaConfigurationForm.BsoUserId" /></div><div class="field-group"><label class="field-label">Submitter name</label><InputText aria-label="SSA submitter name" class="field-input" @bind-Value="SsaConfigurationForm.SubmitterName" /></div>
                        <div class="field-group"><label class="field-label">Submitter location address</label><InputText aria-label="SSA submitter location address" class="field-input" @bind-Value="SsaConfigurationForm.LocationAddress" /></div><div class="field-group"><label class="field-label">Submitter delivery address</label><InputText aria-label="SSA submitter delivery address" class="field-input" @bind-Value="SsaConfigurationForm.DeliveryAddress" /></div><div class="field-group"><label class="field-label">Submitter city</label><InputText aria-label="SSA submitter city" class="field-input" @bind-Value="SsaConfigurationForm.City" /></div><div class="field-group"><label class="field-label">State</label><InputText aria-label="SSA submitter state" maxlength="2" class="field-input" @bind-Value="SsaConfigurationForm.State" /></div><div class="field-group"><label class="field-label">Postal code</label><InputText aria-label="SSA submitter postal code" class="field-input" @bind-Value="SsaConfigurationForm.PostalCode" /></div>
                        <div class="field-group"><label class="field-label">Submitter contact</label><InputText aria-label="SSA submitter contact name" class="field-input" @bind-Value="SsaConfigurationForm.ContactName" /></div><div class="field-group"><label class="field-label">Phone</label><InputText aria-label="SSA submitter contact phone" class="field-input" @bind-Value="SsaConfigurationForm.ContactPhone" /></div><div class="field-group"><label class="field-label">Email</label><InputText aria-label="SSA submitter contact email" class="field-input" @bind-Value="SsaConfigurationForm.ContactEmail" /></div><div class="field-group"><label class="field-label">Preparer</label><InputSelect aria-label="SSA preparer code" class="field-input" @bind-Value="SsaConfigurationForm.PreparerCode"><option value="L">Self-prepared</option><option value="A">Accounting firm</option><option value="S">Service bureau</option><option value="P">Parent company</option><option value="O">Other</option></InputSelect></div>
                        <div class="field-group"><label class="field-label">Employer location address</label><InputText aria-label="SSA employer location address" class="field-input" @bind-Value="SsaConfigurationForm.EmployerLocationAddress" /></div><div class="field-group"><label class="field-label">Employer delivery address</label><InputText aria-label="SSA employer delivery address" class="field-input" @bind-Value="SsaConfigurationForm.EmployerDeliveryAddress" /></div><div class="field-group"><label class="field-label">Employer city</label><InputText aria-label="SSA employer city" class="field-input" @bind-Value="SsaConfigurationForm.EmployerCity" /></div><div class="field-group"><label class="field-label">Employer state</label><InputText aria-label="SSA employer state" maxlength="2" class="field-input" @bind-Value="SsaConfigurationForm.EmployerState" /></div><div class="field-group"><label class="field-label">Employer postal code</label><InputText aria-label="SSA employer postal code" class="field-input" @bind-Value="SsaConfigurationForm.EmployerPostalCode" /></div>
                        <div class="field-group"><label class="field-label">Employer contact</label><InputText aria-label="SSA employer contact name" class="field-input" @bind-Value="SsaConfigurationForm.EmployerContactName" /></div><div class="field-group"><label class="field-label">Employer phone</label><InputText aria-label="SSA employer contact phone" class="field-input" @bind-Value="SsaConfigurationForm.EmployerContactPhone" /></div><div class="field-group"><label class="field-label">Employer email</label><InputText aria-label="SSA employer contact email" class="field-input" @bind-Value="SsaConfigurationForm.EmployerContactEmail" /></div>
                        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApprovePayroll"><Authorized Context="ssaConfigurationApproveContext"><label class="check-field"><InputCheckbox @bind-Value="SsaConfigurationForm.IsApproved" /> Approved against exact SSA PDF</label><label class="check-field"><InputCheckbox @bind-Value="SsaConfigurationForm.IsActive" /> Active for this tax year</label></Authorized></AuthorizeView>
                    </div><button class="action-primary" type="submit">@(SsaConfigurationForm.Id.HasValue ? "Update SSA configuration" : "Save SSA configuration")</button>@if (SsaConfigurationForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="ResetSsaConfiguration">Cancel edit</button> }</EditForm>
                    @if (SsaWageFiles.Configurations.Count > 0) { <div class="table-scroll"><table class="data-table"><thead><tr><th>Year/version</th><th>Evidence</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var config in SsaWageFiles.Configurations) { <tr><td>@config.Submitter.SpecificationTaxYear<br />@config.Submitter.SpecificationVersion</td><td><a href="@config.Submitter.OfficialSpecificationUrl" target="_blank" rel="noopener">SSA PDF</a><br /><code>@config.OfficialSpecificationSha256[..Math.Min(12, config.OfficialSpecificationSha256.Length)]</code></td><td>@(config.IsApproved ? "Approved" : "Draft") / @(config.IsActive ? "Active" : "Inactive")</td><td><button class="action-secondary" type="button" @onclick="() => EditSsaConfiguration(config)">Edit</button></td></tr> }</tbody></table></div> }
                    <h3>Generate from approved correction</h3><div class="content-grid"><div class="field-group"><label class="field-label">W-2c/W-3c correction</label><InputSelect aria-label="SSA source correction" class="field-input" @bind-Value="SelectedSsaCorrectionId">@foreach (var correction in PayrollFilingCorrections.Where(item => item.FormCode == "W-2c/W-3c" && item.Status == "Approved")) { <option value="@correction.Id">@correction.TaxYear correction #@correction.Sequence</option> }</InputSelect></div></div><button class="action-primary" type="button" disabled="@(SelectedSsaCorrectionId == Guid.Empty)" @onclick="GenerateSsaWageFileAsync">Generate immutable file for AccuWage</button>
                </Authorized></AuthorizeView>
                @if (SsaWageFiles.Files.Count > 0) { <h3>Immutable wage files</h3><div class="content-grid"><div class="field-group"><label class="field-label">AccuWage evidence reference</label><InputText aria-label="AccuWage evidence reference" class="field-input" @bind-Value="SsaValidationEvidence" /></div><div class="field-group"><label class="field-label">Validation notes</label><InputTextArea aria-label="AccuWage validation notes" class="field-input" @bind-Value="SsaValidationNotes" /></div></div><div class="table-scroll"><table class="data-table"><thead><tr><th>File</th><th>Records</th><th>Status</th><th>Integrity</th><th>Actions</th></tr></thead><tbody>@foreach (var file in SsaWageFiles.Files) { <tr><td>@file.FileName<br />@file.GeneratedAtUtc.ToLocalTime().ToString("g")</td><td>@file.EmployeeRecordCount employees / @file.RecordCount total</td><td>@file.Status@if (!string.IsNullOrWhiteSpace(file.AccuWageEvidenceReference)) { <br /><span class="muted-copy">@file.AccuWageEvidenceReference</span> }</td><td><code>@file.ContentSha256[..12]</code></td><td><a class="action-secondary" href="@($"/payroll/ssa-wage-files/{file.Id}/download")">Download</a>@if (file.Status == "GeneratedForAccuWage") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApprovePayroll"><Authorized Context="ssaValidationContext"><button class="action-primary" type="button" @onclick="() => RecordSsaValidationAsync(file, true)">Record pass</button><button class="action-secondary" type="button" @onclick="() => RecordSsaValidationAsync(file, false)">Record rejection</button></Authorized></AuthorizeView> }</td></tr> }</tbody></table></div> }
            </details>
            @if (PayrollFilingCorrections.Count > 0)
            {
                <h3>Federal filing correction history</h3><div class="field-group"><label class="field-label">Draft void reason</label><InputText aria-label="Payroll filing correction void reason" class="field-input" @bind-Value="CorrectionVoidReason" /></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Correction</th><th>Process</th><th>Discovered</th><th>Status</th><th>Source digest</th><th>Actions</th></tr></thead><tbody>@foreach (var correction in PayrollFilingCorrections) { <tr><td>@correction.FormCode · @correction.TaxYear@(correction.Quarter > 0 ? $" Q{correction.Quarter}" : "") · #@correction.Sequence</td><td>@correction.Process</td><td>@correction.DiscoveredOn</td><td>@correction.Status@if (!string.IsNullOrWhiteSpace(correction.VoidReason)) { <br /><span class="muted-copy">@correction.VoidReason</span> }</td><td><code>@correction.CorrectedSourceDigestSha256[..12]</code></td><td><a class="action-secondary" href="@($"/payroll/filing-corrections/{correction.Id}/data.json")">Download JSON</a>@if (correction.Status == "Draft") { <button class="action-secondary" type="button" @onclick="() => EditFilingCorrection(correction)">Edit</button><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApprovePayroll"><Authorized Context="correctionApproveContext"><button class="action-primary" type="button" @onclick="() => ApproveFilingCorrectionAsync(correction)">Approve</button></Authorized></AuthorizeView><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="correctionVoidContext"><button class="action-secondary" type="button" @onclick="() => VoidFilingCorrectionAsync(correction)">Void draft</button></Authorized></AuthorizeView> }</td></tr> }</tbody></table></div>
            }
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="filingReasonContext"><div class="field-group"><label class="field-label">Reopen reason</label><InputText aria-label="Payroll filing reopen reason" class="field-input" @bind-Value="FilingReopenReason" /></div></Authorized></AuthorizeView>
            <h3>Close payroll period</h3>
            <div class="content-grid"><div class="field-group"><label class="field-label">Period type</label><InputSelect aria-label="Payroll close period type" class="field-input" @bind-Value="CloseForm.PeriodType"><option>Quarter</option><option>Year</option></InputSelect></div><div class="field-group"><label class="field-label">Tax year</label><InputNumber aria-label="Payroll close tax year" class="field-input" @bind-Value="CloseForm.TaxYear" /></div>@if (CloseForm.PeriodType == "Quarter") { <div class="field-group"><label class="field-label">Quarter</label><InputSelect aria-label="Payroll close quarter" class="field-input" @bind-Value="CloseForm.Quarter"><option value="1">Q1</option><option value="2">Q2</option><option value="3">Q3</option><option value="4">Q4</option></InputSelect></div> }</div>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PostPayroll"><Authorized Context="periodCloseContext"><button class="action-primary" type="button" @onclick="ClosePayrollPeriodAsync">Close payroll period</button></Authorized></AuthorizeView>
            @if (PayrollClosePeriods.Count > 0) { <div class="table-scroll"><table class="data-table"><thead><tr><th>Period</th><th>Status</th><th>Closed</th><th>Reason</th><th></th></tr></thead><tbody>@foreach (var period in PayrollClosePeriods) { <tr><td>@period.TaxYear @(period.PeriodType == "Quarter" ? $"Q{period.Quarter}" : "Year")</td><td>@period.Status</td><td>@period.ClosedAtUtc.ToLocalTime().ToString("g")</td><td>@period.ReopenReason</td><td>@if (period.Status == "Closed") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="periodReopenContext"><button class="action-secondary" type="button" @onclick="() => ReopenPayrollPeriodAsync(period)">Reopen</button></Authorized></AuthorizeView> }</td></tr> }</tbody></table></div> }
        </section>
        </Authorized></AuthorizeView>

        <section class="panel">
            <h2>Timecards and variable earnings</h2>
            <p class="page-intro">Capture dated earnings at their actual work location. Draft timecards must be submitted and approved before they can feed a payroll run.</p>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PreparePayroll"><Authorized Context="timecardPrepareContext">
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Employee</label><InputSelect aria-label="Timecard employee" class="field-input" @bind-Value="TimecardForm.EmployeeId" @bind-Value:after="ApplyTimecardEmployeeDefaults">@foreach (var employee in Workspace.Payroll.Employees.Where(employee => employee.IsActive)) { <option value="@employee.Id">@employee.EmployeeNumber — @employee.FullName</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Period start</label><InputDate aria-label="Timecard period start" class="field-input" @bind-Value="TimecardForm.PeriodStart" /></div>
                    <div class="field-group"><label class="field-label">Period end</label><InputDate aria-label="Timecard period end" class="field-input" @bind-Value="TimecardForm.PeriodEnd" /></div>
                    <div class="field-group"><label class="field-label">Notes</label><InputText aria-label="Timecard notes" class="field-input" @bind-Value="TimecardForm.Notes" /></div>
                </div>
                @foreach (var entry in TimecardForm.Entries)
                {
                    <fieldset class="time-entry-card"><legend>Earning entry @(TimecardForm.Entries.IndexOf(entry) + 1)</legend><div class="time-entry-grid">
                        <div class="field-group"><label class="field-label">Work date</label><InputDate aria-label="Time entry work date" class="field-input" @bind-Value="entry.WorkDate" /></div>
                        <div class="field-group"><label class="field-label">Earning type</label><InputSelect aria-label="Time entry earning type" class="field-input" @bind-Value="entry.EarningType"><option>Regular</option><option>Overtime</option><option>Double time</option><option>PTO</option><option>Sick</option><option>Holiday</option><option>Bonus</option><option>Commission</option><option>Tips</option><option>Piecework</option><option>Shift differential</option><option>On-call</option><option>Severance</option><option>Taxable fringe</option><option>Reimbursement</option></InputSelect></div>
                        <div class="field-group"><label class="field-label">Code</label><InputText aria-label="Time entry earning code" class="field-input" @bind-Value="entry.EarningCode" /></div>
                        <div class="field-group"><label class="field-label">Hours</label><InputNumber aria-label="Time entry hours" class="field-input" @bind-Value="entry.Hours" /></div>
                        <div class="field-group"><label class="field-label">Rate</label><InputNumber aria-label="Time entry rate" class="field-input" @bind-Value="entry.Rate" /></div>
                        <div class="field-group"><label class="field-label">Amount override</label><InputNumber aria-label="Time entry amount" class="field-input" @bind-Value="entry.Amount" /></div>
                        <div class="field-group"><label class="field-label">Work state</label><InputText aria-label="Time entry work state" class="field-input" @bind-Value="entry.WorkState" /></div>
                        <div class="field-group"><label class="field-label">Work county</label><InputText aria-label="Time entry work county" class="field-input" @bind-Value="entry.WorkCounty" /></div>
                        <div class="field-group"><label class="field-label">Work city</label><InputText aria-label="Time entry work city" class="field-input" @bind-Value="entry.WorkCity" /></div>
                        <div class="field-group"><label class="field-label">School district</label><InputText aria-label="Time entry work school district" class="field-input" @bind-Value="entry.WorkSchoolDistrict" /></div>
                        <div class="field-group"><label class="field-label">Project / job</label><InputSelect aria-label="Time entry project" class="field-input" @bind-Value="entry.ProjectJobId"><option value="">None</option>@foreach (var project in Workspace.Projects.Jobs) { <option value="@project.Id">@project.JobNumber — @project.Name</option> }</InputSelect></div>
                        <div class="field-group"><label class="field-label">Entry notes</label><InputText aria-label="Time entry notes" class="field-input" @bind-Value="entry.Notes" /></div>
                        <label class="check-field"><InputCheckbox @bind-Value="entry.IsTaxable" /> Taxable earning</label>
                    </div><button class="action-secondary" type="button" @onclick="() => RemoveTimeEntry(entry)" disabled="@(TimecardForm.Entries.Count == 1)">Remove entry</button></fieldset>
                }
                <button class="action-secondary" type="button" @onclick="AddTimeEntry">Add earning entry</button>
                <button class="action-primary" type="button" @onclick="SaveTimecardAsync">@(TimecardForm.Id.HasValue ? "Update timecard draft" : "Save timecard draft")</button>
            </Authorized></AuthorizeView>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="timecardVoidReasonContext"><div class="field-group timecard-void-reason"><label class="field-label">Void reason</label><InputText aria-label="Timecard void reason" class="field-input" @bind-Value="TimecardVoidReason" /></div></Authorized></AuthorizeView>
            @if (Workspace.Payroll.Timecards?.Count > 0)
            {
                <div class="table-scroll"><table class="data-table"><thead><tr><th>Include</th><th>Employee</th><th>Period</th><th>Status</th><th>Hours</th><th>Amount</th><th>Entries</th><th>Actions</th></tr></thead><tbody>
                @foreach (var timecard in Workspace.Payroll.Timecards)
                {
                    <tr><td>@if (timecard.Status == "Approved") { <input type="checkbox" aria-label="@($"Include approved timecard for {timecard.EmployeeName}")" checked="@SelectedApprovedTimecardIds.Contains(timecard.Id)" @onchange="args => ToggleApprovedTimecard(timecard.Id, args.Value)" /> } else { <span aria-label="Not available">—</span> }</td><td>@timecard.EmployeeNumber — @timecard.EmployeeName</td><td>@timecard.PeriodStart to @timecard.PeriodEnd</td><td>@timecard.Status</td><td>@timecard.TotalHours.ToString("N2")</td><td>@timecard.TotalAmount.ToString("C")</td><td>@timecard.Entries.Count</td><td>
                        @if (timecard.Status == "Draft") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PreparePayroll"><Authorized Context="timecardDraftActionContext"><button class="action-secondary" type="button" @onclick="() => LoadTimecard(timecard)">Edit</button><button class="action-primary" type="button" @onclick="() => SubmitTimecardAsync(timecard)">Submit</button></Authorized></AuthorizeView> }
                        @if (timecard.Status == "Submitted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApprovePayroll"><Authorized Context="timecardApproveActionContext"><button class="action-primary" type="button" @onclick="() => ApproveTimecardAsync(timecard)">Approve</button></Authorized></AuthorizeView> }
                        @if (timecard.Status is "Draft" or "Submitted" or "Approved") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="timecardVoidActionContext"><button class="action-secondary" type="button" @onclick="() => VoidTimecardAsync(timecard)">Void</button></Authorized></AuthorizeView> }
                    </td></tr>
                }
                </tbody></table></div>
            }
            else { <p>No timecards have been prepared.</p> }
        </section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PreparePayroll"><Authorized Context="payrollPrepareContext">
        <section class="panel">
            <h2>Prepare payroll draft</h2>
            <p class="page-intro">Enter the pay period and employee base earnings, then select approved timecards above. Stored time entries replace entered gross pay for hourly employees and are added to base pay for salaried employees. Previewing does not change the books; saving atomically assigns the selected timecards to the new draft.</p>
            <EditForm Model="RunForm" OnValidSubmit="PreviewPayrollAsync"><div class="content-grid">
                <div class="field-group"><label class="field-label">Pay date</label><InputDate aria-label="Payroll pay date" class="field-input" @bind-Value="RunForm.PayDate" /></div>
                <div class="field-group"><label class="field-label">Period start</label><InputDate aria-label="Payroll period start" class="field-input" @bind-Value="RunForm.PeriodStart" /></div>
                <div class="field-group"><label class="field-label">Period end</label><InputDate aria-label="Payroll period end" class="field-input" @bind-Value="RunForm.PeriodEnd" /></div>
                <div class="field-group"><label class="field-label">Run type</label><InputSelect aria-label="Payroll run type" class="field-input" @bind-Value="RunForm.RunType"><option>Regular</option><option>OffCycle</option><option>Correction</option><option>Adjustment</option></InputSelect></div>
                <div class="field-group"><label class="field-label">Run reference</label><InputText aria-label="Payroll run reference" class="field-input" @bind-Value="RunForm.Reference" /></div>
                <div class="field-group"><label class="field-label">Funding account</label><InputSelect aria-label="Payroll funding account" class="field-input" @bind-Value="RunForm.BankAccountId"><option value="@Guid.Empty">Select bank account</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name — @bank.CurrentBalance.ToString("C")</option> }</InputSelect></div>
            </div>
            <table class="data-table"><thead><tr><th>Employee</th><th>Work state</th><th>Gross pay</th></tr></thead><tbody>@foreach (var employee in Workspace.Payroll.Employees.Where(employee => employee.IsActive)) { var employeeId = employee.Id; <tr><td>@employee.FullName</td><td>@employee.State</td><td><input type="number" min="0" step="0.01" aria-label="@($"Gross pay for {employee.FullName}")" class="field-input" value="@RunLines[employeeId].ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="args => SetRunLine(employeeId, args.Value)" /></td></tr> }</tbody></table>
            <button class="action-secondary" type="submit">Preview payroll</button>
            @if (Preview is not null) { <button class="action-primary" type="button" @onclick="SavePayrollDraftAsync">Save reviewed draft</button> }</EditForm>
            @if (Preview is not null)
            {
                <table class="data-table"><thead><tr><th>Employee</th><th>Gross</th><th>Pre-tax benefits</th><th>Withholding</th><th>Post-tax benefits</th><th>Employer taxes</th><th>Employer benefits</th><th>Net pay</th></tr></thead><tbody>@foreach (var line in Preview.Employees) { <tr><td>@line.EmployeeName (@line.WorkState)</td><td>@line.GrossPay.ToString("C")</td><td>@line.PreTaxDeductions.ToString("C")</td><td>@line.EmployeeWithholdings.ToString("C")</td><td>@line.PostTaxDeductions.ToString("C")</td><td>@line.EmployerPayrollTaxes.ToString("C")</td><td>@line.EmployerBenefitContributions.ToString("C")</td><td>@line.NetPay.ToString("C")</td></tr> }</tbody></table>
                @foreach (var line in Preview.Employees.Where(item => item.Deductions?.Count > 0))
                {
                    <details><summary>Review deductions for @line.EmployeeName</summary><div class="table-scroll"><table class="data-table"><thead><tr><th>Code</th><th>Type</th><th>Requested</th><th>Applied</th><th>Employer</th><th>Tax treatment</th><th>Limit</th></tr></thead><tbody>@foreach (var deduction in line.Deductions!) { <tr><td>@deduction.DeductionCode</td><td>@deduction.DeductionType</td><td>@(deduction.RequestedEmployeeAmount ?? deduction.EmployeeAmount).ToString("C")</td><td>@deduction.EmployeeAmount.ToString("C")</td><td>@deduction.EmployerAmount.ToString("C")</td><td>@(deduction.IsPreTax ? "Pretax" : "Post-tax")</td><td>@if (deduction.LimitApplied) { <strong>Limited by @deduction.LimitRuleCode</strong> } else { <span>Not limited</span> }</td></tr> }</tbody></table></div></details>
                }
            }
        </section>
        </Authorized></AuthorizeView>

        <section class="panel">
            <h2>Payroll run workflow</h2>
            <p class="page-intro">Drafts do not affect cash or the ledger. Approve after review, post only when funding is ready, and use reversal to preserve the original run and create an equal-and-opposite journal.</p>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="payrollReverseReasonContext"><div class="field-group"><label class="field-label">Cancellation / reversal reason</label><InputText aria-label="Payroll cancellation or reversal reason" class="field-input" @bind-Value="ReversalReason" /></div></Authorized></AuthorizeView>
            @if (Workspace.Payroll.Runs?.Count > 0)
            {
                <table class="data-table"><thead><tr><th>Reference</th><th>Period</th><th>Pay date</th><th>Type</th><th>Status</th><th>Gross</th><th>Withholding</th><th>Employer tax</th><th>Employer benefits</th><th>Net</th><th>Action</th></tr></thead><tbody>
                @foreach (var run in Workspace.Payroll.Runs)
                {
                    <tr><td>@run.Reference</td><td>@run.PeriodStart.ToString("MMM d")–@run.PeriodEnd.ToString("MMM d, yyyy")</td><td>@run.PayDate.ToString("MMM d, yyyy")</td><td>@run.RunType</td><td>@run.Status</td><td>@run.GrossPayroll.ToString("C")</td><td>@run.EmployeeWithholdings.ToString("C")</td><td>@run.EmployerPayrollTaxes.ToString("C")</td><td>@run.EmployerBenefitContributions.ToString("C")</td><td>@run.NetPay.ToString("C")</td><td>
                        @if (run.Status == "Draft") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApprovePayroll"><Authorized Context="payrollApproveContext"><button class="action-secondary" type="button" @onclick="async () => await ApprovePayrollAsync(run)">Approve</button></Authorized></AuthorizeView><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="payrollCancelContext"><button class="action-secondary" type="button" @onclick="async () => await CancelPayrollAsync(run)">Cancel</button></Authorized></AuthorizeView> }
                        else if (run.Status == "Approved") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PostPayroll"><Authorized Context="payrollPostContext"><button class="action-primary" type="button" @onclick="async () => await PostApprovedPayrollAsync(run)">Post</button></Authorized></AuthorizeView> }
                        else if (run.Status == "Posted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="payrollReverseContext"><button class="action-secondary" type="button" @onclick="async () => await ReversePayrollAsync(run)">Reverse</button></Authorized></AuthorizeView> }
                        @if (run.Status is "Posted" or "Reversed") { <button class="action-secondary" type="button" @onclick="() => LoadPayrollRegisterAsync(run.Id)">View register</button> }
                    </td></tr>
                }
                </tbody></table>
            }
            else { <p>No payroll drafts or posted runs yet.</p> }
            @if (SelectedRegister is not null)
            {
                <section class="report-preview" aria-label="Payroll register preview">
                    <h3>Register — @SelectedRegister.PayrollReference</h3>
                    <p class="page-intro">@SelectedRegister.PeriodStart.ToString("MMM d, yyyy") through @SelectedRegister.PeriodEnd.ToString("MMM d, yyyy") · paid @SelectedRegister.PayDate.ToString("MMM d, yyyy") · @SelectedRegister.Status</p>
                    <a class="action-secondary" href="@($"/payroll/reports/{SelectedRegister.PayrollRunId}/register.csv")">Download CSV</a>
                    <div class="table-scroll"><table class="data-table"><thead><tr><th>Employee</th><th>Method</th><th>Status</th><th>Gross</th><th>Employee taxes</th><th>Deductions</th><th>Employer taxes</th><th>Employer benefits</th><th>Net</th><th></th></tr></thead><tbody>
                    @foreach (var employee in SelectedRegister.Employees)
                    {
                        <tr><td>@employee.EmployeeNumber — @employee.EmployeeName</td><td>@employee.PaymentMethod</td><td>@employee.PaymentStatus</td><td>@employee.GrossPay.ToString("C")</td><td>@employee.EmployeeWithholdings.ToString("C")</td><td>@((employee.PreTaxDeductions + employee.PostTaxDeductions).ToString("C"))</td><td>@employee.EmployerPayrollTaxes.ToString("C")</td><td>@employee.EmployerBenefitContributions.ToString("C")</td><td>@employee.NetPay.ToString("C")</td><td><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManagePayrollSensitiveData"><Authorized Context="payStatementContext"><button class="action-secondary" type="button" @onclick="() => LoadPayStatementAsync(SelectedRegister.PayrollRunId, employee.EmployeeId)">Pay statement</button></Authorized></AuthorizeView></td></tr>
                    }
                    <tr><th colspan="3">Totals</th><th>@SelectedRegister.GrossPayroll.ToString("C")</th><th>@SelectedRegister.EmployeeWithholdings.ToString("C")</th><th>@((SelectedRegister.PreTaxDeductions + SelectedRegister.PostTaxDeductions).ToString("C"))</th><th>@SelectedRegister.EmployerPayrollTaxes.ToString("C")</th><th>@SelectedRegister.EmployerBenefitContributions.ToString("C")</th><th>@SelectedRegister.NetPay.ToString("C")</th><th></th></tr>
                    </tbody></table></div>
                </section>
            }
            @if (SelectedPayStatement is not null)
            {
                <section class="report-preview pay-statement" aria-label="Pay statement preview">
                    <h3>Pay statement — @SelectedPayStatement.EmployeeName</h3>
                    <p>@SelectedPayStatement.CompanyLegalName · @SelectedPayStatement.PayrollReference · @SelectedPayStatement.PeriodStart.ToString("MMM d")–@SelectedPayStatement.PeriodEnd.ToString("MMM d, yyyy") · paid @SelectedPayStatement.PayDate.ToString("MMM d, yyyy")</p>
                    <p><strong>@SelectedPayStatement.PaymentMethod</strong> · @SelectedPayStatement.MaskedDestination · @SelectedPayStatement.PaymentStatus</p>
                    <div class="stats-grid"><article class="stat-card"><span class="stat-value">@SelectedPayStatement.GrossPay.ToString("C")</span><span class="stat-label">Gross pay</span></article><article class="stat-card"><span class="stat-value">@SelectedPayStatement.EmployeeWithholdings.ToString("C")</span><span class="stat-label">Employee taxes</span></article><article class="stat-card"><span class="stat-value">@((SelectedPayStatement.PreTaxDeductions + SelectedPayStatement.PostTaxDeductions).ToString("C"))</span><span class="stat-label">Deductions</span></article><article class="stat-card"><span class="stat-value">@SelectedPayStatement.NetPay.ToString("C")</span><span class="stat-label">Net pay</span></article></div>
                    <h4>Earnings</h4><div class="table-scroll"><table class="data-table"><thead><tr><th>Type</th><th>Date</th><th>Location</th><th>Hours</th><th>Rate</th><th>Amount</th></tr></thead><tbody>@foreach (var earning in SelectedPayStatement.Earnings) { <tr><td>@earning.Code — @earning.Type</td><td>@(earning.WorkedOn?.ToString("MMM d, yyyy") ?? "—")</td><td>@string.Join(", ", new[] { earning.WorkCity, earning.WorkCounty, earning.WorkState }.Where(value => !string.IsNullOrWhiteSpace(value)))</td><td>@earning.Hours.ToString("N2")</td><td>@earning.Rate.ToString("C")</td><td>@earning.Amount.ToString("C")</td></tr> }</tbody></table></div>
                    <h4>Taxes and deductions</h4><div class="table-scroll"><table class="data-table"><thead><tr><th>Item</th><th>Jurisdiction / treatment</th><th>Employee</th><th>Employer</th></tr></thead><tbody>@foreach (var tax in SelectedPayStatement.Taxes) { <tr><td>@tax.TaxType</td><td>@tax.JurisdictionName</td><td>@tax.EmployeeAmount.ToString("C")</td><td>@tax.EmployerAmount.ToString("C")</td></tr> } @foreach (var deduction in SelectedPayStatement.Deductions) { <tr><td>@deduction.Type</td><td>@(deduction.IsPreTax ? "Pre-tax" : "Post-tax")</td><td>@deduction.EmployeeAmount.ToString("C")</td><td>@deduction.EmployerAmount.ToString("C")</td></tr> }</tbody></table></div>
                    <p><strong>YTD:</strong> gross @SelectedPayStatement.YearToDateGross.ToString("C") · employee taxes @SelectedPayStatement.YearToDateEmployeeTaxes.ToString("C") · deductions @SelectedPayStatement.YearToDateEmployeeDeductions.ToString("C") · net @SelectedPayStatement.YearToDateNetPay.ToString("C")</p>
                </section>
            }
        </section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManagePayroll"><Authorized Context="depositScheduleContext">
        <section class="panel">
            <h2>Federal payroll deposit schedule</h2>
            <p class="page-intro">Configure the annual Form 941 deposit schedule from the official lookback calculation. Approved schedules assign business-day-adjusted due dates to federal income-tax, Social Security, and Medicare liabilities. BrassLedger automatically applies the $100,000 next-day rule and the resulting semiweekly transition.</p>
            @foreach (var summary in DepositScheduleWorkspace.Summaries)
            {
                <div class="stats-grid"><article class="stat-card"><span class="stat-value">@summary.EffectiveScheduleType</span><span class="stat-label">@summary.TaxYear effective schedule</span></article><article class="stat-card"><span class="stat-value">@summary.OpenAmount.ToString("C")</span><span class="stat-label">Open Form 941 liabilities</span></article><article class="stat-card"><span class="stat-value">@(summary.NextDueDate?.ToString("MMM d, yyyy") ?? "Not scheduled")</span><span class="stat-label">Next due date</span></article><article class="stat-card accent-coral"><span class="stat-value">@summary.OverdueAmount.ToString("C")</span><span class="stat-label">Past due as of today</span></article></div>
            }
            @if (DepositScheduleWorkspace.Shortfalls?.Count > 0) { <h3>Deposit accuracy and makeup dates</h3><div class="table-scroll"><table class="data-table"><thead><tr><th>Quarter / due</th><th>Required</th><th>Paid by due</th><th>Shortfall</th><th>Safe-harbor ceiling</th><th>Makeup deadline</th><th>Status</th></tr></thead><tbody>@foreach (var item in DepositScheduleWorkspace.Shortfalls ?? []) { <tr><td>@item.TaxYear Q@item.Quarter<br />@item.DepositDueDate</td><td>@item.RequiredAmount.ToString("C")</td><td>@item.PaidByDueDate.ToString("C")</td><td>@item.ShortfallAtDueDate.ToString("C")</td><td>@item.SafeHarborTolerance.ToString("C")</td><td>@item.MakeupDueDate</td><td>@item.Status</td></tr> }</tbody></table></div> }
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApprovePayroll"><Authorized Context="depositScheduleApprovalContext">
            <details open="@DepositScheduleForm.Id.HasValue"><summary>@(DepositScheduleForm.Id.HasValue ? $"Edit {DepositScheduleForm.TaxYear} Form 941 schedule" : "Configure a Form 941 deposit schedule")</summary>
                <EditForm Model="DepositScheduleForm" OnValidSubmit="SaveDepositScheduleAsync"><div class="content-grid">
                    <div class="field-group"><label class="field-label">Tax year</label><InputNumber aria-label="Deposit schedule tax year" class="field-input" @bind-Value="DepositScheduleForm.TaxYear" /></div>
                    <div class="field-group"><label class="field-label">Schedule</label><InputSelect aria-label="Federal deposit schedule type" class="field-input" @bind-Value="DepositScheduleForm.ScheduleType"><option>Monthly</option><option>Semiweekly</option></InputSelect></div>
                    <div class="field-group"><label class="field-label">Lookback liability</label><InputNumber aria-label="Federal deposit lookback liability" class="field-input" @bind-Value="DepositScheduleForm.LookbackLiability" /></div>
                    <div class="field-group"><label class="field-label">Lookback begins</label><InputDate aria-label="Federal deposit lookback start" class="field-input" @bind-Value="DepositScheduleForm.LookbackPeriodStart" /></div>
                    <div class="field-group"><label class="field-label">Lookback ends</label><InputDate aria-label="Federal deposit lookback end" class="field-input" @bind-Value="DepositScheduleForm.LookbackPeriodEnd" /></div>
                    <div class="field-group"><label class="field-label">Monthly threshold</label><InputNumber aria-label="Federal monthly schedule threshold" class="field-input" @bind-Value="DepositScheduleForm.MonthlyThreshold" /></div>
                    <div class="field-group"><label class="field-label">Next-day threshold</label><InputNumber aria-label="Federal next-day deposit threshold" class="field-input" @bind-Value="DepositScheduleForm.NextDayThreshold" /></div>
                    <div class="field-group"><label class="field-label">Return-payment threshold</label><InputNumber aria-label="Federal small liability threshold" class="field-input" @bind-Value="DepositScheduleForm.SmallLiabilityThreshold" /></div>
                    <div class="field-group"><label class="field-label">Payment-with-return quarters (JSON)</label><InputText aria-label="Federal small liability election quarters JSON" class="field-input" @bind-Value="DepositScheduleForm.SmallLiabilityElectionQuartersJson" /></div>
                    <div class="field-group"><label class="field-label">IRS rules URL</label><InputText aria-label="Federal deposit rules URL" class="field-input" @bind-Value="DepositScheduleForm.OfficialRulesUrl" /></div>
                    <div class="field-group"><label class="field-label">IRS calendar URL</label><InputText aria-label="Federal deposit calendar URL" class="field-input" @bind-Value="DepositScheduleForm.OfficialCalendarUrl" /></div>
                    <div class="field-group"><label class="field-label">Source retrieved</label><InputDate aria-label="Federal deposit source retrieval date" class="field-input" @bind-Value="DepositScheduleForm.SourceRetrievedOn" /></div>
                    <div class="field-group"><label class="field-label">Legal holidays (JSON dates)</label><InputTextArea aria-label="Federal deposit legal holidays JSON" class="field-input" @bind-Value="DepositScheduleForm.LegalHolidaysJson" /></div>
                    <div class="field-group"><label class="field-label">Review / override notes</label><InputTextArea aria-label="Federal deposit schedule review notes" class="field-input" @bind-Value="DepositScheduleForm.ReviewNotes" /></div>
                    <label class="check-field"><InputCheckbox @bind-Value="DepositScheduleForm.IsApproved" /> Approved against the official sources</label><label class="check-field"><InputCheckbox @bind-Value="DepositScheduleForm.IsActive" /> Active</label>
                </div><button class="action-secondary" type="button" @onclick="Load2026FederalDepositDefaults">Load official 2026 defaults</button> <button class="action-primary" type="submit">@(DepositScheduleForm.Id.HasValue ? "Update deposit schedule" : "Save deposit schedule")</button>@if (DepositScheduleForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="ResetDepositScheduleEditor">Cancel edit</button> }</EditForm>
            </details>
            </Authorized></AuthorizeView>
            @if (DepositScheduleWorkspace.Configurations.Count > 0) { <div class="table-scroll"><table class="data-table"><thead><tr><th>Year</th><th>Configured</th><th>Recommended</th><th>Lookback</th><th>Sources</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var schedule in DepositScheduleWorkspace.Configurations) { <tr><td>@schedule.TaxYear</td><td>@schedule.ScheduleType</td><td>@schedule.RecommendedScheduleType</td><td>@schedule.LookbackLiability.ToString("C")<br /><small>@schedule.LookbackPeriodStart–@schedule.LookbackPeriodEnd</small></td><td><a href="@schedule.OfficialRulesUrl" target="_blank" rel="noopener">Pub. 15</a> · <a href="@schedule.OfficialCalendarUrl" target="_blank" rel="noopener">Pub. 509</a></td><td>@(schedule.IsApproved ? "Approved" : "Draft") / @(schedule.IsActive ? "Active" : "Inactive")</td><td><AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApprovePayroll"><Authorized Context="depositScheduleEditContext"><button class="action-secondary" type="button" @onclick="() => EditDepositSchedule(schedule)">Edit</button></Authorized></AuthorizeView></td></tr> }</tbody></table></div> }
            <h3>IRS disaster relief</h3><p class="page-intro">Record only relief explicitly granted by an IRS announcement and document why this company is an affected taxpayer. Deposit penalty abatement is tracked without changing the legal deposit due date.</p>
            @if (DisasterReliefWorkspace.DepositImpacts.Count > 0) { <div class="table-scroll"><table class="data-table"><thead><tr><th>Announcement</th><th>Original due</th><th>Required</th><th>Paid by due</th><th>Relief deadline</th><th>Status</th></tr></thead><tbody>@foreach (var impact in DisasterReliefWorkspace.DepositImpacts) { <tr><td>@impact.AnnouncementCode</td><td>@impact.OriginalDueDate</td><td>@impact.RequiredAmount.ToString("C")</td><td>@impact.PaidByOriginalDueDate.ToString("C")</td><td>@impact.PenaltyReliefDeadline<br /><span class="muted-copy">@impact.PaidByReliefDeadline.ToString("C") paid</span></td><td>@impact.Status</td></tr> }</tbody></table></div> }
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ApprovePayroll"><Authorized Context="disasterApprovalContext"><details open="@DisasterReliefForm.Id.HasValue"><summary>@(DisasterReliefForm.Id.HasValue ? "Edit disaster relief" : "Configure disaster relief")</summary><EditForm Model="DisasterReliefForm" OnValidSubmit="SaveDisasterReliefAsync"><div class="content-grid">
                <div class="field-group"><label class="field-label">IRS announcement code</label><InputText aria-label="IRS disaster announcement code" class="field-input" @bind-Value="DisasterReliefForm.AnnouncementCode" /></div><div class="field-group"><label class="field-label">Disaster name</label><InputText aria-label="Payroll disaster name" class="field-input" @bind-Value="DisasterReliefForm.DisasterName" /></div><div class="field-group"><label class="field-label">FEMA declaration</label><InputText aria-label="FEMA disaster declaration number" class="field-input" @bind-Value="DisasterReliefForm.FemaDeclarationNumber" /></div>
                <div class="field-group"><label class="field-label">Affected-taxpayer basis</label><InputSelect aria-label="Affected taxpayer basis" class="field-input" @bind-Value="DisasterReliefForm.AffectedTaxpayerBasis"><option value="PrincipalPlaceOfBusiness">Principal place of business in covered area</option><option value="RecordsInCoveredArea">Necessary records in covered area</option><option value="IrsIndividualDetermination">IRS individual determination</option></InputSelect></div><div class="field-group"><label class="field-label">Eligibility evidence reference</label><InputText aria-label="Disaster eligibility evidence reference" class="field-input" @bind-Value="DisasterReliefForm.EligibilityEvidenceReference" /></div><div class="field-group"><label class="field-label">Covered areas (JSON)</label><InputTextArea aria-label="Disaster covered areas JSON" class="field-input" @bind-Value="DisasterReliefForm.CoveredAreasJson" /></div>
                <div class="field-group"><label class="field-label">Relief actions (JSON)</label><InputTextArea aria-label="Disaster relief actions JSON" class="field-input" @bind-Value="DisasterReliefForm.ReliefActionsJson" /></div><div class="field-group"><label class="field-label">Official IRS announcement</label><InputText aria-label="Official IRS disaster URL" class="field-input" @bind-Value="DisasterReliefForm.OfficialSourceUrl" /></div><div class="field-group"><label class="field-label">Source retrieved</label><InputDate aria-label="Disaster source retrieval date" class="field-input" @bind-Value="DisasterReliefForm.SourceRetrievedOn" /></div><div class="field-group"><label class="field-label">Review notes</label><InputTextArea aria-label="Disaster relief review notes" class="field-input" @bind-Value="DisasterReliefForm.ReviewNotes" /></div><label class="check-field"><InputCheckbox @bind-Value="DisasterReliefForm.IsApproved" /> Approved against exact IRS announcement</label><label class="check-field"><InputCheckbox @bind-Value="DisasterReliefForm.IsActive" /> Active for this company</label>
            </div><button class="action-primary" type="submit">@(DisasterReliefForm.Id.HasValue ? "Update disaster relief" : "Save disaster relief")</button>@if (DisasterReliefForm.Id.HasValue) { <button class="action-secondary" type="button" @onclick="ResetDisasterReliefEditor">Cancel edit</button> }</EditForm></details></Authorized></AuthorizeView>
            @if (DisasterReliefWorkspace.Configurations.Count > 0) { <div class="table-scroll"><table class="data-table"><thead><tr><th>Announcement</th><th>Covered areas</th><th>Eligibility</th><th>Actions</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var relief in DisasterReliefWorkspace.Configurations) { <tr><td>@relief.AnnouncementCode<br /><a href="@relief.OfficialSourceUrl" target="_blank" rel="noopener">@relief.DisasterName</a></td><td>@string.Join("; ", relief.CoveredAreas)</td><td>@relief.AffectedTaxpayerBasis<br /><span class="muted-copy">@relief.EligibilityEvidenceReference</span></td><td>@string.Join(", ", relief.ReliefActions.Select(action => action.ActionType))</td><td>@(relief.IsApproved ? "Approved" : "Draft") / @(relief.IsActive ? "Active" : "Inactive")</td><td><button class="action-secondary" type="button" @onclick="() => EditDisasterRelief(relief)">Edit</button></td></tr> }</tbody></table></div> }
        </section>
        </Authorized></AuthorizeView>

        <section class="panel">
            <h2>Payroll liabilities</h2>
            <p class="page-intro">Posting creates one traceable payable for every tax and deduction line. A blank due date means the filing or deposit schedule still requires configuration; it is not permission to defer payment.</p>
            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.PostPayroll"><Authorized Context="liabilityPaymentContext">
                @if (Workspace.Payroll.Liabilities?.Any(liability => liability.Status is "Open" or "PartiallyPaid") == true)
                {
                <div class="content-grid">
                    <div class="field-group"><label class="field-label">Funding account</label><InputSelect aria-label="Liability payment funding account" class="field-input" @bind-Value="LiabilityPaymentForm.BankAccountId"><option value="@Guid.Empty">Select bank</option>@foreach (var bank in Workspace.Treasury.BankAccounts) { <option value="@bank.Id">@bank.Name — @bank.CurrentBalance.ToString("C")</option> }</InputSelect></div>
                    <div class="field-group"><label class="field-label">Payment date</label><InputDate aria-label="Liability payment date" class="field-input" @bind-Value="LiabilityPaymentForm.PaymentDate" /></div>
                    <div class="field-group"><label class="field-label">Reference</label><InputText aria-label="Liability payment reference" class="field-input" @bind-Value="LiabilityPaymentForm.Reference" /></div>
                    <div class="field-group"><label class="field-label">Payee / agency</label><InputText aria-label="Liability payment payee" class="field-input" @bind-Value="LiabilityPaymentForm.Payee" /></div>
                    <div class="field-group"><label class="field-label">Method</label><InputSelect aria-label="Liability payment method" class="field-input" @bind-Value="LiabilityPaymentForm.Method"><option>EFT</option><option>ACH</option><option>Check</option><option>Wire</option><option>Other</option></InputSelect></div>
                </div>
                    <div class="liability-selection-list">
                    @foreach (var liability in Workspace.Payroll.Liabilities.Where(liability => liability.Status is "Open" or "PartiallyPaid"))
                    {
                        <div class="liability-selection-row"><label class="check-field"><input type="checkbox" aria-label="@($"Select {liability.ObligationCode} for payment")" checked="@SelectedLiabilityIds.Contains(liability.Id)" @onchange="args => ToggleLiabilityPayment(liability, args.Value)" /> @liability.EmployeeName · @liability.ObligationCode · @liability.OutstandingAmount.ToString("C")</label><input type="number" min="0.01" max="@liability.OutstandingAmount" step="0.01" aria-label="@($"Payment amount for {liability.ObligationCode}")" class="field-input" value="@LiabilityPaymentAmounts.GetValueOrDefault(liability.Id).ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="args => SetLiabilityPaymentAmount(liability.Id, args.Value)" disabled="@(!SelectedLiabilityIds.Contains(liability.Id))" /></div>
                    }
                    </div>
                    <button class="action-primary" type="button" @onclick="RecordLiabilityPaymentAsync">Record selected remittance</button>
                }
            </Authorized></AuthorizeView>
            @if (Workspace.Payroll.Liabilities?.Count > 0)
            {
                <div class="table-scroll"><table class="data-table"><thead><tr><th>Employee</th><th>Obligation</th><th>Jurisdiction</th><th>Source</th><th>Account</th><th>Original</th><th>Outstanding</th><th>Due</th><th>Status</th></tr></thead><tbody>
                @foreach (var liability in Workspace.Payroll.Liabilities)
                {
                    <tr><td>@liability.EmployeeName</td><td>@liability.ObligationCode<br /><span class="muted-copy">@liability.Description</span></td><td>@(string.IsNullOrWhiteSpace(liability.JurisdictionName) ? "—" : liability.JurisdictionName)</td><td>@liability.SourceType</td><td>@liability.LiabilityAccountNumber</td><td>@liability.OriginalAmount.ToString("C")</td><td>@liability.OutstandingAmount.ToString("C")</td><td>@(liability.DueDate?.ToString("MMM d, yyyy") ?? "Schedule required")@if (!string.IsNullOrWhiteSpace(liability.DepositRuleCode)) { <br /><span class="muted-copy">@liability.DepositScheduleType · @liability.DepositRuleCode</span> }</td><td>@liability.Status</td></tr>
                }
                </tbody></table></div>
            }
            else { <p>No posted payroll liabilities yet.</p> }
            @if (Workspace.Payroll.LiabilityPayments?.Count > 0)
            {
                <h3>Remittance history</h3>
                <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="liabilityPaymentReverseContext"><div class="field-group"><label class="field-label">Remittance reversal reason</label><InputText aria-label="Liability payment reversal reason" class="field-input" @bind-Value="LiabilityPaymentReversalReason" /></div></Authorized></AuthorizeView>
                <div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Reference</th><th>Payee</th><th>Method</th><th>Amount</th><th>Applications</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var payment in Workspace.Payroll.LiabilityPayments) { <tr><td>@payment.PaymentDate</td><td>@payment.Reference</td><td>@payment.Payee</td><td>@payment.Method</td><td>@payment.Amount.ToString("C")</td><td>@payment.Applications.Count</td><td>@payment.Status</td><td>@if (payment.Status == "Posted") { <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ReversePayroll"><Authorized Context="liabilityPaymentReverseActionContext"><button class="action-secondary" type="button" @onclick="() => ReverseLiabilityPaymentAsync(payment)">Reverse</button></Authorized></AuthorizeView> }</td></tr> }</tbody></table></div>
            }
        </section>

        <section class="panel">
                <h2>Employee roster</h2>
                <p class="page-intro">Review each employee’s base compensation and primary residence and work locations before preparing a run.</p>
                <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Work location</th>
                            <th>Residence location</th>
                            <th>Pay type</th>
                            <th>Monthly base</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Workspace.Payroll.Employees)
                        {
                            <tr>
                                <td>@employee.EmployeeNumber - @employee.FullName</td>
                                <td>@employee.Department</td>
                                <td>@employee.State@(string.IsNullOrWhiteSpace(employee.WorkCity) ? "" : $" · {employee.WorkCity}")</td>
                                <td>@employee.ResidenceState@(string.IsNullOrWhiteSpace(employee.ResidenceCity) ? "" : $" · {employee.ResidenceCity}")</td>
                                <td>@employee.PayType</td>
                                <td>@employee.MonthlyBasePay.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
        </section>

        <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.MaintainEmployeePayrollSetup"><Authorized Context="payrollElectionContext">
        <section class="panel">
                <h2>Employee tax elections and benefits</h2>
                <p class="page-intro">Record the actual Form W-4 year and Steps 2–4, benefit deductions, and residence/work locations. The verified 2026 federal calculator uses Publication 15-T Worksheet 1A; inactive profile examples never enter a calculation.</p>
                <div class="field-group payroll-employee-picker">
                    <label class="field-label">Employee</label>
                    <InputSelect aria-label="Tax-election employee" class="field-input" @bind-Value="SelectedPayrollSetupEmployeeId">
                        @foreach (var employee in Workspace.Payroll.Employees)
                        {
                            <option value="@employee.Id">@employee.EmployeeNumber — @employee.FullName</option>
                        }
                    </InputSelect>
                </div>
                @if (SelectedPayrollSetupEmployee is not null && SelectedPayrollSetup is not null)
                {
                    var employee = SelectedPayrollSetupEmployee;
                    var setup = SelectedPayrollSetup;
                    <div class="payroll-setup-grid">
                        <fieldset class="payroll-setup-group"><legend>Work location</legend>
                            <div class="field-group"><label class="field-label">State</label><InputText aria-label="@($"Work state for {employee.FullName}")" class="field-input" @bind-Value="setup.WorkState" /></div>
                            <div class="field-group"><label class="field-label">City</label><InputText aria-label="@($"Work city for {employee.FullName}")" class="field-input" @bind-Value="setup.WorkCity" /></div>
                        </fieldset>
                        <fieldset class="payroll-setup-group"><legend>Residence</legend>
                            <div class="field-group"><label class="field-label">State</label><InputText aria-label="@($"Residence state for {employee.FullName}")" class="field-input" @bind-Value="setup.ResidenceState" /></div>
                            <div class="field-group"><label class="field-label">City</label><InputText aria-label="@($"Residence city for {employee.FullName}")" class="field-input" @bind-Value="setup.ResidenceCity" /></div>
                        </fieldset>
                        <fieldset class="payroll-setup-group"><legend>Pay schedule</legend>
                            <div class="field-group"><label class="field-label">Filing status</label><InputSelect aria-label="@($"Filing status for {employee.FullName}")" class="field-input" @bind-Value="setup.FilingStatus"><option>Single</option><option>Married filing jointly</option><option>Head of household</option></InputSelect></div>
                            <div class="field-group"><label class="field-label">Payroll frequency</label><InputSelect aria-label="@($"Payroll frequency for {employee.FullName}")" class="field-input" @bind-Value="setup.PayrollFrequency"><option>Weekly</option><option>Biweekly</option><option>Semimonthly</option><option>Monthly</option><option>Quarterly</option><option>Semiannual</option><option>Annual</option><option>Daily</option></InputSelect></div>
                        </fieldset>
                        <fieldset class="payroll-setup-group payroll-w4-group"><legend>Federal Form W-4</legend>
                            <div class="field-group"><label class="field-label">Form year</label><InputNumber aria-label="@($"Federal Form W-4 year for {employee.FullName}")" class="field-input" @bind-Value="setup.FederalFormW4Year" /></div>
                            <label class="check-field"><InputCheckbox @bind-Value="setup.FederalStep2MultipleJobs" /> Step 2: multiple jobs or spouse works</label>
                            <div class="field-group"><label class="field-label">Step 3 credits</label><InputNumber aria-label="@($"Federal Step 3 credits for {employee.FullName}")" class="field-input" @bind-Value="setup.FederalStep3Credits" /></div>
                            <div class="field-group"><label class="field-label">Step 4(a) other income</label><InputNumber aria-label="@($"Federal Step 4 other income for {employee.FullName}")" class="field-input" @bind-Value="setup.FederalStep4OtherIncome" /></div>
                            <div class="field-group"><label class="field-label">Step 4(b) deductions</label><InputNumber aria-label="@($"Federal Step 4 deductions for {employee.FullName}")" class="field-input" @bind-Value="setup.FederalStep4Deductions" /></div>
                            <div class="field-group"><label class="field-label">Step 4(c) extra withholding</label><InputNumber aria-label="@($"Additional withholding for {employee.FullName}")" class="field-input" @bind-Value="setup.AdditionalWithholding" /></div>
                            <label class="check-field"><InputCheckbox @bind-Value="setup.FederalWithholdingExempt" /> Withholding exemption is on file</label>
                            @if (setup.FederalFormW4Year < 2020) { <div class="field-group"><label class="field-label">Legacy allowances</label><InputNumber aria-label="@($"Legacy allowances for {employee.FullName}")" class="field-input" @bind-Value="setup.Allowances" /></div> }
                        </fieldset>
                        <fieldset class="payroll-setup-group"><legend>Recurring benefits</legend>
                            <div class="field-group"><label class="field-label">Pre-tax deduction</label><InputNumber aria-label="@($"Pre-tax benefits for {employee.FullName}")" class="field-input" @bind-Value="setup.PreTaxBenefitDeductions" /></div>
                            <div class="field-group"><label class="field-label">Post-tax deduction</label><InputNumber aria-label="@($"Post-tax benefits for {employee.FullName}")" class="field-input" @bind-Value="setup.PostTaxBenefitDeductions" /></div>
                        </fieldset>
                    </div>
                    <button class="action-primary" type="button" @onclick="async () => await SaveSetupAsync(employee.Id, setup)">Save @employee.FullName’s elections</button>
                }
        </section>
        </Authorized></AuthorizeView>

        <section class="content-grid">

            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManagePayrollSensitiveData"><Authorized Context="payrollSensitiveContext">
            <article class="panel">
                <h2>Protected employment and payment details</h2>
                <p class="page-intro">Tax identifiers and bank numbers are encrypted at rest and are never displayed after saving. Leave a protected field blank to keep its existing value.</p>
                <div class="field-group"><label class="field-label">Employee</label><InputSelect aria-label="Protected-details employee" class="field-input" @bind-Value="SelectedEmployeeId" @bind-Value:after="LoadEmploymentEditor">@foreach (var employee in Workspace.Payroll.Employees) { <option value="@employee.Id">@employee.EmployeeNumber — @employee.FullName</option> }</InputSelect></div>
                @if (SelectedEmployee is not null)
                {
                    <p>SSN: @(SelectedEmployee.HasSocialSecurityNumber ? "On file" : "Not provided") · Bank account: @(SelectedEmployee.HasBankAccount ? "On file" : "Not provided")</p>
                    <EditForm Model="EmploymentForm" OnValidSubmit="SaveEmploymentDetailsAsync"><div class="content-grid">
                        <div class="field-group"><label class="field-label">Address line 1</label><InputText aria-label="Employee address line 1" class="field-input" @bind-Value="EmploymentForm.AddressLine1" /></div>
                        <div class="field-group"><label class="field-label">Address line 2</label><InputText aria-label="Employee address line 2" class="field-input" @bind-Value="EmploymentForm.AddressLine2" /></div>
                        <div class="field-group"><label class="field-label">Mailing city</label><InputText aria-label="Employee mailing city" class="field-input" @bind-Value="EmploymentForm.AddressCity" /></div>
                        <div class="field-group"><label class="field-label">Mailing state</label><InputText aria-label="Employee mailing state" class="field-input" maxlength="2" @bind-Value="EmploymentForm.AddressState" /></div>
                        <div class="field-group"><label class="field-label">Postal code</label><InputText aria-label="Employee postal code" class="field-input" @bind-Value="EmploymentForm.PostalCode" /></div>
                        <div class="field-group"><label class="field-label">Residence county</label><InputText aria-label="Employee residence county" class="field-input" @bind-Value="EmploymentForm.ResidenceCounty" /></div>
                        <div class="field-group"><label class="field-label">Residence school district</label><InputText aria-label="Employee residence school district" class="field-input" @bind-Value="EmploymentForm.ResidenceSchoolDistrict" /></div>
                        <div class="field-group"><label class="field-label">Work county</label><InputText aria-label="Employee work county" class="field-input" @bind-Value="EmploymentForm.WorkCounty" /></div>
                        <div class="field-group"><label class="field-label">Work school district</label><InputText aria-label="Employee work school district" class="field-input" @bind-Value="EmploymentForm.WorkSchoolDistrict" /></div>
                        <div class="field-group"><label class="field-label">Employment start</label><InputDate aria-label="Employee employment start" class="field-input" @bind-Value="EmploymentForm.EmploymentStartedOn" /></div>
                        <div class="field-group"><label class="field-label">Employment end</label><InputDate aria-label="Employee employment end" class="field-input" @bind-Value="EmploymentForm.EmploymentEndedOn" /></div>
                        <div class="field-group"><label class="field-label">Hourly rate</label><InputNumber aria-label="Employee hourly rate" class="field-input" @bind-Value="EmploymentForm.HourlyRate" /></div>
                        <div class="field-group"><label class="field-label">Overtime rate</label><InputNumber aria-label="Employee overtime rate" class="field-input" @bind-Value="EmploymentForm.OvertimeRate" /></div>
                        <div class="field-group"><label class="field-label">New SSN</label><input aria-label="Employee Social Security number" class="field-input" type="password" inputmode="numeric" autocomplete="off" @bind="EmploymentForm.SocialSecurityNumber" /></div>
                        <div class="field-group"><label class="field-label">New routing number</label><input aria-label="Employee bank routing number" class="field-input" type="password" inputmode="numeric" autocomplete="off" @bind="EmploymentForm.BankRoutingNumber" /></div>
                        <div class="field-group"><label class="field-label">New account number</label><input aria-label="Employee bank account number" class="field-input" type="password" inputmode="numeric" autocomplete="off" @bind="EmploymentForm.BankAccountNumber" /></div>
                        <div class="field-group"><label class="field-label">Account type</label><InputSelect aria-label="Employee bank account type" class="field-input" @bind-Value="EmploymentForm.BankAccountType"><option value="">Select</option><option>Checking</option><option>Savings</option></InputSelect></div>
                        <div class="field-group"><label class="field-label">Authorization signed date</label><InputDate aria-label="Direct deposit authorization signed date" class="field-input" @bind-Value="EmploymentForm.DirectDepositAuthorizationOn" />@if (SelectedEmployee?.HasDirectDepositAuthorization == true) { <small>Stored authorization dated @SelectedEmployee.DirectDepositAuthorizationOn</small> }</div>
                        <div class="field-group"><label class="field-label">Authorization evidence reference</label><InputText aria-label="Direct deposit authorization evidence reference" class="field-input" autocomplete="off" @bind-Value="EmploymentForm.DirectDepositAuthorizationReference" /></div>
                        <div class="field-group"><label class="field-label"><InputCheckbox @bind-Value="EmploymentForm.DirectDepositEnabled" /> Direct deposit enabled</label></div>
                        <div class="field-group"><label class="field-label"><InputCheckbox @bind-Value="EmploymentForm.ClearSocialSecurityNumber" /> Remove stored SSN</label></div>
                        <div class="field-group"><label class="field-label"><InputCheckbox @bind-Value="EmploymentForm.ClearBankDetails" /> Remove stored bank details</label></div>
                        <div class="field-group"><label class="field-label"><InputCheckbox @bind-Value="EmploymentForm.ClearDirectDepositAuthorization" /> Remove stored direct-deposit authorization</label></div>
                    </div><button class="action-primary" type="submit">Save protected details</button></EditForm>
                }
            </article>
            </Authorized></AuthorizeView>

            <AuthorizeView Policy="@BrassLedgerAuthorizationPolicies.ManagePayroll"><Authorized Context="payrollJurisdictionContext">
            <article class="panel">
                <h2>Residence/work tax rules</h2>
                <p class="page-intro">Configure a reciprocity exemption when work-location withholding should not apply, or a resident credit percentage against configured residence withholding. Use the jurisdiction names exactly as they appear in Tax profiles (for example, Arizona or a city name).</p>
                <EditForm Model="JurisdictionRuleForm" OnValidSubmit="SaveJurisdictionRuleAsync"><div class="content-grid"><div class="field-group"><label class="field-label">Residence jurisdiction</label><InputText aria-label="Residence jurisdiction" class="field-input" @bind-Value="JurisdictionRuleForm.ResidenceJurisdiction" /></div><div class="field-group"><label class="field-label">Work jurisdiction</label><InputText aria-label="Work jurisdiction" class="field-input" @bind-Value="JurisdictionRuleForm.WorkJurisdiction" /></div><div class="field-group"><label class="field-label">Resident credit rate</label><InputNumber aria-label="Resident credit rate" class="field-input" @bind-Value="JurisdictionRuleForm.ResidentCreditRate" /></div><div class="field-group"><label class="field-label"><InputCheckbox @bind-Value="JurisdictionRuleForm.ExemptWorkWithholding" /> Exempt work withholding</label></div><div class="field-group"><label class="field-label">Notes</label><InputText aria-label="Jurisdiction rule notes" class="field-input" @bind-Value="JurisdictionRuleForm.Notes" /></div></div><button class="action-primary" type="submit">Save jurisdiction rule</button></EditForm>
                @if (Workspace.Payroll.JurisdictionRules?.Count > 0) { <table class="data-table"><thead><tr><th>Residence</th><th>Work</th><th>Work exemption</th><th>Resident credit</th><th>Notes</th></tr></thead><tbody>@foreach (var rule in Workspace.Payroll.JurisdictionRules) { <tr><td>@rule.ResidenceJurisdiction</td><td>@rule.WorkJurisdiction</td><td>@(rule.ExemptWorkWithholding ? "Yes" : "No")</td><td>@rule.ResidentCreditRate.ToString("P0")</td><td>@rule.Notes</td></tr> }</tbody></table> }
            </article>
            </Authorized></AuthorizeView>
        </section>

            <section class="panel">
                <h2>Tax profiles in payroll scope</h2>
                <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Jurisdiction</th>
                            <th>Type</th>
                            <th>Rate</th>
                            <th>Effective</th>
                            <th>Status</th>
                            <th>Source</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var profile in Workspace.Taxes.Profiles)
                        {
                            <tr>
                                <td>@profile.Jurisdiction</td>
                                <td>@profile.TaxType</td>
                                <td>@profile.Rate.ToString("P3")</td>
                                <td>@profile.EffectiveOn.ToString("MMM d, yyyy")</td>
                                <td>@(profile.IsActive && profile.IsVerified ? "Active · verified" : profile.IsActive ? "Blocked · unverified" : "Inactive")</td>
                                <td>@profile.Source@if (!string.IsNullOrWhiteSpace(profile.VerificationNotes)) { <span> — @profile.VerificationNotes</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </section>
    </section>
}

@code {
    private BusinessWorkspaceSnapshot? Workspace;
    private string? StatusMessage;
    private PayrollRunEditor RunForm { get; } = new();
    private readonly Dictionary<Guid, decimal> RunLines = [];
    private readonly Dictionary<Guid, EmployeePayrollEditor> EmployeeSetups = [];
    private PayrollTimecardEditor TimecardForm = new();
    private string TimecardVoidReason = string.Empty;
    private PayrollRunEstimate? Preview;
    private PayrollRegister? SelectedRegister;
    private PayrollPayStatement? SelectedPayStatement;
    private List<PayrollFilingSnapshot> PayrollFilings { get; set; } = [];
    private List<PayrollFilingCorrectionSnapshot> PayrollFilingCorrections { get; set; } = [];
    private List<PayrollClosePeriodSnapshot> PayrollClosePeriods { get; set; } = [];
    private PayrollFilingEditor FilingForm { get; } = new();
    private Form941CorrectionEditor CorrectionForm { get; set; } = new();
    private W2CorrectionEditor W2CorrectionForm { get; set; } = new();
    private PayrollCloseEditor CloseForm { get; } = new();
    private PayrollDeductionConfiguration DeductionConfiguration { get; set; } = new([], []);
    private PayrollDeductionPlanEditor DeductionPlanForm { get; set; } = new();
    private PayrollDeductionElectionEditor DeductionElectionForm { get; set; } = new();
    private PayrollPaymentFileWorkspace PaymentFileWorkspace { get; set; } = new([], []);
    private PayrollBankOriginEditor BankOriginForm { get; set; } = new();
    private PayrollPaymentFileEditor PaymentFileForm { get; set; } = new();
    private PayrollDepositScheduleWorkspace DepositScheduleWorkspace { get; set; } = new([], []);
    private PayrollDepositScheduleEditor DepositScheduleForm { get; set; } = new();
    private PayrollDisasterReliefWorkspace DisasterReliefWorkspace { get; set; } = new([], []);
    private PayrollDisasterReliefEditor DisasterReliefForm { get; set; } = new();
    private SsaWageFileWorkspace SsaWageFiles { get; set; } = new([], []);
    private SsaWageFileConfigurationEditor SsaConfigurationForm { get; set; } = new();
    private Guid SelectedSsaCorrectionId;
    private string SsaValidationEvidence = string.Empty;
    private string SsaValidationNotes = string.Empty;
    private bool CanManagePayroll;
    private static readonly string[] DeductionCategories = ["Medical", "Dental", "Vision", "HSA", "HealthFSA", "DependentCareFSA", "Retirement401k", "Retirement403b", "Retirement457", "RetirementSimpleIra", "RetirementSepIra", "RetirementRoth", "LifeInsurance", "DisabilityInsurance", "Transit", "Parking", "UnionDues", "CharitableContribution", "EmployeeLoan", "ChildSupport", "Alimony", "OrdinaryGarnishment", "TaxLevy", "BankruptcyOrder", "FederalAgencyDebt", "PtoPurchase", "Other"];
    private string FilingReopenReason = string.Empty;
    private string CorrectionVoidReason = string.Empty;
    private string ReversalReason = string.Empty;
    private JurisdictionRuleEditor JurisdictionRuleForm { get; } = new();
    private Guid SelectedPayrollSetupEmployeeId;
    private Guid SelectedEmployeeId;
    private HashSet<Guid> SelectedApprovedTimecardIds { get; } = [];
    private HashSet<Guid> SelectedLiabilityIds { get; } = [];
    private Dictionary<Guid, decimal> LiabilityPaymentAmounts { get; } = [];
    private PayrollLiabilityPaymentEditor LiabilityPaymentForm { get; } = new();
    private string LiabilityPaymentReversalReason = string.Empty;
    private EmployeeEmploymentEditor EmploymentForm = new();
    private EmployeeSnapshot? SelectedPayrollSetupEmployee => Workspace?.Payroll.Employees.FirstOrDefault(employee => employee.Id == SelectedPayrollSetupEmployeeId);
    private EmployeePayrollEditor? SelectedPayrollSetup => EmployeeSetups.GetValueOrDefault(SelectedPayrollSetupEmployeeId);
    private EmployeeSnapshot? SelectedEmployee => Workspace?.Payroll.Employees.FirstOrDefault(employee => employee.Id == SelectedEmployeeId);

    private async Task LoadPayrollRegisterAsync(Guid payrollRunId)
    {
        SelectedRegister = await PayrollReportingService.GetRegisterAsync(payrollRunId);
        SelectedPayStatement = null;
        StatusMessage = SelectedRegister is null ? "Payroll register not found." : $"Loaded register {SelectedRegister.PayrollReference}.";
    }

    private async Task LoadPayStatementAsync(Guid payrollRunId, Guid employeeId)
    {
        SelectedPayStatement = await PayrollReportingService.GetPayStatementAsync(payrollRunId, employeeId);
        StatusMessage = SelectedPayStatement is null ? "Pay statement not found." : $"Loaded pay statement for {SelectedPayStatement.EmployeeName}.";
    }

    protected override async Task OnInitializedAsync()
    {
        Workspace = await WorkspaceService.GetWorkspaceAsync();
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CanManagePayroll = authenticationState.User.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.PayrollManage);
        if (authenticationState.User.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.PayrollSensitiveData)) { PayrollFilings = (await PayrollFilingService.GetFilingsAsync()).ToList(); PayrollFilingCorrections = (await PayrollFilingService.GetCorrectionsAsync()).ToList(); SsaWageFiles = await SsaWageFileService.GetAsync(); }
        if (authenticationState.User.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.PayrollSensitiveData)) PaymentFileWorkspace = await PayrollPaymentFileService.GetAsync();
        if (authenticationState.User.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.PayrollSensitiveData) && authenticationState.User.HasClaim(BrassLedgerAuthenticationDefaults.PermissionClaimType, BrassLedgerPermissions.PayrollManage)) DeductionConfiguration = await PayrollDeductionConfigurationService.GetAsync();
        if (CanManagePayroll) { DepositScheduleWorkspace = await PayrollDepositScheduleService.GetAsync(); DisasterReliefWorkspace = await PayrollDisasterReliefService.GetAsync(); }
        PayrollClosePeriods = (await PayrollFilingService.GetClosePeriodsAsync()).ToList();
        foreach (var employee in Workspace.Payroll.Employees)
        {
            RunLines[employee.Id] = decimal.Round(employee.MonthlyBasePay / 2m, 2);
            EmployeeSetups[employee.Id] = new EmployeePayrollEditor(employee.FilingStatus, employee.PayrollFrequency, employee.Allowances, employee.AdditionalWithholding, employee.PreTaxBenefitDeductions, employee.PostTaxBenefitDeductions, employee.ResidenceState, employee.ResidenceCity, employee.State, employee.WorkCity, employee.FederalFormW4Year, employee.FederalStep2MultipleJobs, employee.FederalStep3Credits, employee.FederalStep4OtherIncome, employee.FederalStep4Deductions, employee.FederalWithholdingExempt);
        }
        SelectedPayrollSetupEmployeeId = Workspace.Payroll.Employees.FirstOrDefault()?.Id ?? Guid.Empty;
        SelectedEmployeeId = SelectedPayrollSetupEmployeeId;
        DeductionElectionForm.EmployeeId = SelectedPayrollSetupEmployeeId;
        DeductionElectionForm.PayrollDeductionPlanId = DeductionConfiguration.Plans.FirstOrDefault()?.Id ?? Guid.Empty;
        SelectedSsaCorrectionId = PayrollFilingCorrections.FirstOrDefault(item => item.FormCode == "W-2c/W-3c" && item.Status == "Approved")?.Id ?? Guid.Empty;
        var defaultBankAccountId = Workspace.Treasury.BankAccounts.FirstOrDefault()?.Id ?? Guid.Empty;
        RunForm.BankAccountId = defaultBankAccountId;
        LiabilityPaymentForm.BankAccountId = defaultBankAccountId;
        BankOriginForm.BankAccountId = defaultBankAccountId;
        PaymentFileForm.PayrollRunId = Workspace.Payroll.Runs?.FirstOrDefault(item => item.Status == "Posted")?.Id ?? Guid.Empty;
        CorrectionForm.OriginalPayrollFilingId = PayrollFilings.FirstOrDefault(filing => filing.FormCode == "941" && filing.HasApprovedBaseline)?.Id ?? Guid.Empty;
        W2CorrectionForm.OriginalPayrollFilingId = PayrollFilings.FirstOrDefault(filing => filing.FormCode == "W2" && filing.HasApprovedBaseline)?.Id ?? Guid.Empty;
        LoadEmploymentEditor();
        ResetTimecardEditor();
    }

    private static string CategoryLabel(string value) => value switch { "HealthFSA" => "Health FSA", "DependentCareFSA" => "Dependent-care FSA", "Retirement401k" => "401(k)", "Retirement403b" => "403(b)", "Retirement457" => "457 plan", "RetirementSimpleIra" => "SIMPLE IRA", "RetirementSepIra" => "SEP IRA", "RetirementRoth" => "Roth retirement", "LifeInsurance" => "Life insurance", "DisabilityInsurance" => "Disability insurance", "UnionDues" => "Union dues", "CharitableContribution" => "Charitable contribution", "EmployeeLoan" => "Employee loan", "ChildSupport" => "Child support", "OrdinaryGarnishment" => "Ordinary garnishment", "TaxLevy" => "Tax levy", "BankruptcyOrder" => "Bankruptcy order", "FederalAgencyDebt" => "Federal agency debt", "PtoPurchase" => "PTO purchase", _ => value };
    private string EmployeeName(Guid employeeId) => Workspace?.Payroll.Employees.FirstOrDefault(item => item.Id == employeeId)?.FullName ?? "Employee unavailable";

    private async Task RefreshDeductionConfigurationAsync()
    {
        DeductionConfiguration = await PayrollDeductionConfigurationService.GetAsync();
        if (DeductionElectionForm.PayrollDeductionPlanId == Guid.Empty) DeductionElectionForm.PayrollDeductionPlanId = DeductionConfiguration.Plans.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private async Task SaveDeductionPlanAsync()
    {
        var form = DeductionPlanForm;
        var result = await PayrollDeductionConfigurationService.SavePlanAsync(new SavePayrollDeductionPlanRequest(form.Id, form.Code, form.Name, form.Category, form.CalculationMethod, form.DefaultEmployeeValue, form.DefaultEmployerValue, form.IsPreTax, form.ExemptFromFederalIncomeTax, form.ExemptFromFica, form.ExemptFromFuta, form.ReducesDisposableEarnings, form.LiabilityAccountNumber, form.Priority, form.EmployeeLimitPerPay, form.EmployeeAnnualLimit, form.MinimumNetPay, form.LimitRuleCode, form.LimitRuleJson, form.OfficialSourceUrl, form.SourceRetrievedOn, form.EffectiveOn, form.ExpiresOn, form.IsActive, form.ConcurrencyToken));
        StatusMessage = result.Succeeded ? "Effective-dated payroll deduction plan saved with its legal-source metadata." : result.ErrorMessage;
