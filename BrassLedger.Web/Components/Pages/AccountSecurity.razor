@page "/account/security"
@attribute [Authorize(Policy = BrassLedgerAuthorizationPolicies.ManageAccountSecurity)]
@inject IUserAuthenticationService AuthenticationService
@inject IAccountActionService AccountActionService
@inject IUserSessionService UserSessionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Account Security</PageTitle>

<section class="page-shell">
    <section class="hero">
        <div class="hero-copy">
            <p class="eyebrow">Account security</p>
            <h1>Protect your operator account and review recent access.</h1>
            <p class="page-intro">Changing your password or revoking other sessions invalidates every previously issued session cookie. This browser receives a fresh session so you can continue working.</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(DisplayMessage))
    {
        <div class="@(IsError ? "auth-error" : "status-banner")" role="@(IsError ? "alert" : "status")">@DisplayMessage</div>
    }

    @if (Snapshot is null)
    {
        <section class="panel"><p>Loading account security details…</p></section>
    }
    else
    {
        <section class="panel">
            <h2>@Snapshot.DisplayName</h2>
            <div class="content-grid">
                <div><span class="field-label">Username</span><strong>@Snapshot.UserName</strong></div>
                <div><span class="field-label">Email</span><strong>@Snapshot.Email</strong></div>
                <div><span class="field-label">Email verification</span><strong>@(Snapshot.EmailConfirmedAtUtc is null ? "Not verified" : $"Verified {FormatTimestamp(Snapshot.EmailConfirmedAtUtc)}")</strong></div>
                <div><span class="field-label">Last successful sign-in</span><strong>@FormatTimestamp(Snapshot.LastSuccessfulSignInUtc)</strong></div>
                <div><span class="field-label">Password last changed</span><strong>@FormatTimestamp(Snapshot.LastPasswordChangedUtc)</strong></div>
                <div><span class="field-label">Authenticator MFA</span><strong>@(Snapshot.MfaEnabled ? "Enabled" : "Not enabled")</strong></div>
                <div><span class="field-label">MFA enrolled</span><strong>@FormatTimestamp(Snapshot.MfaEnrolledAtUtc)</strong></div>
            </div>
        </section>

        @if (Snapshot.EmailConfirmedAtUtc is null)
        {
            <section class="panel">
                <h2>Verify email address</h2>
                <p class="page-intro">A verified address is required for secure password recovery. BrassLedger sends a one-use link to the address shown above; it never displays the link in the application.</p>
                @if (!AccountActionService.EmailDeliveryConfigured)
                {
                    <div class="auth-error" role="alert">Security-email delivery is not configured. Ask an administrator to configure HTTPS public links and SMTP delivery.</div>
                }
                <form method="post" action="/account/email-verification/request">
                    <AntiforgeryToken />
                    <button class="action-secondary" type="submit" disabled="@(!AccountActionService.EmailDeliveryConfigured)">Send verification message</button>
                </form>
            </section>
        }

        <section class="panel">
            <h2>Change email address</h2>
            <p class="page-intro">Changing the address requires your current password, signs out every browser, disables recovery until the replacement address is verified, and sends a one-use verification link to the new address.</p>
            @if (!AccountActionService.EmailDeliveryConfigured)
            {
                <div class="auth-error" role="alert">Email changes are unavailable until security-email delivery is configured.</div>
            }
            <details>
                <summary>Replace account email</summary>
                <form class="auth-form" method="post" action="/account/email/change">
                    <AntiforgeryToken />
                    <div class="field-group"><label class="field-label" for="newEmail">New email address</label><input id="newEmail" class="field-input" name="newEmail" type="email" autocomplete="email" maxlength="320" required /></div>
                    <div class="field-group"><label class="field-label" for="emailChangePassword">Current password</label><input id="emailChangePassword" class="field-input" name="currentPassword" type="password" autocomplete="current-password" maxlength="1024" required /></div>
                    <button class="action-secondary" type="submit" disabled="@(!AccountActionService.EmailDeliveryConfigured)">Change address and sign out</button>
                </form>
            </details>
        </section>

        <section class="panel">
            <h2>Authenticator MFA</h2>
            @if (EnrollmentComplete)
            {
                <div class="status-banner" role="status">
                    @(ReplacementRecoveryCodes is null ? "Authenticator MFA is enabled" : "Recovery codes were replaced") and prior sessions are invalid. Keep the recovery codes below in a secure offline location, then sign in again.
                </div>
                <div class="field-group">
                    <span class="field-label">New one-use recovery codes</span>
                    <div class="recovery-code-grid">
                        @foreach (var recoveryCode in ReplacementRecoveryCodes ?? Enrollment?.RecoveryCodes ?? [])
                        {
                            <code>@recoveryCode</code>
                        }
                    </div>
                </div>
                <a class="action-primary" href="/login">Sign in again</a>
            }
            else if (Snapshot.MfaEnabled)
            {
                <p class="page-intro">A password and a fresh authenticator or one-use recovery code are required at sign-in. @Snapshot.RecoveryCodesRemaining recovery code(s) remain.</p>
                @if (Snapshot.MfaRequiredByRole)
                {
                    <p class="page-intro"><strong>MFA cannot be disabled while any active company role assigned to this account requires it.</strong></p>
                }
                <details>
                    <summary>Replace recovery codes</summary>
                    <p class="page-intro">This immediately invalidates every prior recovery code and other signed-in session. Enter the current password plus an authenticator or remaining recovery code.</p>
                    <EditForm Model="RecoveryReplacementForm" OnValidSubmit="ReplaceRecoveryCodesAsync">
                        <div class="auth-form">
                            <div class="field-group"><label class="field-label" for="replacementPassword">Current password</label><InputText id="replacementPassword" class="field-input" type="password" autocomplete="current-password" @bind-Value="RecoveryReplacementForm.CurrentPassword" /></div>
                            <div class="field-group"><label class="field-label" for="replacementCode">Authenticator or recovery code</label><InputText id="replacementCode" class="field-input" autocomplete="one-time-code" @bind-Value="RecoveryReplacementForm.VerificationCode" /></div>
                            <button class="action-secondary" type="submit">Invalidate and replace recovery codes</button>
                        </div>
                    </EditForm>
                </details>
                @if (!Snapshot.MfaRequiredByRole)
                {
                    <details>
                        <summary>Disable authenticator MFA</summary>
                        <p class="page-intro">Disabling MFA requires both the current password and a current authenticator or recovery code. All sessions and unused recovery codes will be invalidated.</p>
                        <form class="auth-form" method="post" action="/account/disable-mfa">
                            <AntiforgeryToken />
                            <div class="field-group"><label class="field-label" for="disableMfaPassword">Current password</label><input id="disableMfaPassword" class="field-input" name="currentPassword" type="password" autocomplete="current-password" required /></div>
                            <div class="field-group"><label class="field-label" for="disableMfaCode">Authenticator or recovery code</label><input id="disableMfaCode" class="field-input" name="verificationCode" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" required /></div>
                            <button class="action-secondary" type="submit">Disable MFA and revoke sessions</button>
                        </form>
                    </details>
                }
            }
            else if (Enrollment is null)
            {
                <p class="page-intro">Use any RFC 6238-compatible authenticator app. Re-enter your password before BrassLedger creates a protected secret and ten one-use recovery codes.</p>
                <EditForm Model="EnrollmentForm" OnValidSubmit="BeginMfaEnrollmentAsync">
                    <div class="auth-form">
                        <div class="field-group"><label class="field-label" for="enrollmentPassword">Current password</label><InputText id="enrollmentPassword" class="field-input" type="password" autocomplete="current-password" @bind-Value="EnrollmentForm.CurrentPassword" /></div>
                        <button class="action-primary" type="submit">Set up authenticator</button>
                    </div>
                </EditForm>
            }
            else
            {
                <p class="page-intro">Add this account to the authenticator by opening the setup link on the device or entering the key manually. Then save every recovery code before verification.</p>
                <div class="field-group"><span class="field-label">Manual setup key</span><code class="security-secret">@Enrollment.Secret</code></div>
                <p><a href="@Enrollment.OtpAuthUri">Open authenticator setup link</a></p>
                <div class="field-group">
                    <span class="field-label">One-use recovery codes — shown only during this enrollment</span>
                    <div class="recovery-code-grid">
                        @foreach (var recoveryCode in Enrollment.RecoveryCodes ?? [])
                        {
                            <code>@recoveryCode</code>
                        }
                    </div>
                </div>
                <EditForm Model="EnrollmentVerificationForm" OnValidSubmit="EnableMfaAsync">
                    <div class="auth-form">
                        <div class="field-group"><label class="field-label" for="enrollmentCode">Current six-digit authenticator code</label><InputText id="enrollmentCode" class="field-input" autocomplete="one-time-code" inputmode="numeric" @bind-Value="EnrollmentVerificationForm.VerificationCode" /></div>
                        <label><InputCheckbox @bind-Value="EnrollmentVerificationForm.RecoveryCodesSaved" /> I saved the recovery codes in a secure location.</label>
                        <button class="action-primary" type="submit">Verify and enable MFA</button>
                    </div>
                </EditForm>
            }
        </section>

        <section class="content-grid">
            <article class="panel">
                <h2>Change password</h2>
                <p class="page-intro">Use at least 12 characters. Your new password must differ from the current password.</p>
                <form class="auth-form" method="post" action="/account/change-password">
                    <AntiforgeryToken />
                    <div class="field-group">
                        <label class="field-label" for="currentPassword">Current password</label>
                        <input id="currentPassword" class="field-input" name="currentPassword" type="password" autocomplete="current-password" required />
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="newPassword">New password</label>
                        <input id="newPassword" class="field-input" name="newPassword" type="password" autocomplete="new-password" minlength="12" required />
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="confirmPassword">Confirm new password</label>
                        <input id="confirmPassword" class="field-input" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" required />
                    </div>
                    <button class="action-primary" type="submit">Change password</button>
                </form>
            </article>

            <article class="panel">
                <h2>Signed-in browsers</h2>
                <p class="page-intro">Each browser session is individually tracked. Network addresses are masked here and browser names are inferred from the user-agent string, so they may be approximate.</p>
                @if (Sessions.Count == 0)
                {
                    <p class="page-intro">No active named sessions were found. Sign in again if this browser stops responding.</p>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead><tr><th>Browser</th><th>Network</th><th>Authentication</th><th>Signed in</th><th>Last used</th><th>Action</th></tr></thead>
                            <tbody>
                            @foreach (var session in Sessions)
                            {
                                <tr>
                                    <td><strong>@session.Device</strong>@if (session.IsCurrent) { <div class="muted-copy">This browser</div> }</td>
                                    <td>@session.MaskedNetwork</td>
                                    <td>@session.AuthenticationMethod</td>
                                    <td>@FormatTimestamp(session.CreatedAtUtc)</td>
                                    <td>@FormatTimestamp(session.LastSeenAtUtc)</td>
                                    <td>@if (!session.IsCurrent) { <button class="action-secondary" type="button" @onclick="() => RevokeSessionAsync(session.Id)">Sign out</button> }</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                <p class="page-intro">Use the broad action after losing a device or noticing activity you do not recognize. It rotates account security and signs out every other session immediately.</p>
                <form method="post" action="/account/revoke-other-sessions">
                    <AntiforgeryToken />
                    <button class="action-secondary" type="submit">Sign out other sessions</button>
                </form>
            </article>
        </section>

        <section class="panel">
            <h2>Recent account activity</h2>
            @if (Snapshot.RecentEvents.Count == 0)
            {
                <p class="page-intro">No account events have been recorded yet.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>When</th><th>Event</th><th>Result</th><th>Network</th><th>Details</th></tr></thead>
                        <tbody>
                        @foreach (var securityEvent in Snapshot.RecentEvents)
                        {
                            <tr>
                                <td>@securityEvent.OccurredUtc.LocalDateTime</td>
                                <td>@FormatEvent(securityEvent.EventType)</td>
                                <td>@(securityEvent.Succeeded ? "Succeeded" : "Rejected")</td>
                                <td>@(string.IsNullOrWhiteSpace(securityEvent.IpAddress) ? "Not recorded" : securityEvent.IpAddress)</td>
                                <td>@securityEvent.Detail</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private AccountSecuritySnapshot? Snapshot { get; set; }
    private Guid UserId { get; set; }
    private Guid CompanyId { get; set; }
    private Guid SessionId { get; set; }
    private System.Security.Claims.ClaimsPrincipal Principal { get; set; } = new();
    private IReadOnlyList<UserSessionSnapshot> Sessions { get; set; } = [];
    private MfaEnrollmentResult? Enrollment { get; set; }
    private bool EnrollmentComplete { get; set; }
    private MfaEnrollmentForm EnrollmentForm { get; set; } = new();
    private MfaEnrollmentVerificationForm EnrollmentVerificationForm { get; set; } = new();
    private MfaRecoveryReplacementForm RecoveryReplacementForm { get; set; } = new();
    private IReadOnlyList<string>? ReplacementRecoveryCodes { get; set; }
    private string? LocalMessage { get; set; }
    private bool LocalError { get; set; }
    private string RequestIpAddress { get; set; } = string.Empty;
    private string RequestUserAgent { get; set; } = string.Empty;
    private bool IsError => LocalError || !string.IsNullOrWhiteSpace(Error);
    private string? DisplayMessage => LocalMessage ?? Message;

    private string? Message => Error switch
    {
        "current-password" => "The current password was not correct. Your password was not changed.",
        "password-reused" => "Choose a password that differs from your current password.",
        "invalid-password" => "Enter matching new passwords containing at least 12 characters.",
        "mfa-disable-rejected" => "MFA was not disabled. Check both the current password and the authenticator or recovery code.",
        "email-verification-unavailable" => "A verification message could not be queued. Confirm security-email configuration and the account email address.",
        "email-change-rejected" => "The email address was not changed. Check the current password, replacement address, and whether that address belongs to another operator.",
        "too-many-requests" => "Too many account-recovery requests came from this network. Wait one minute and try again.",
        _ => Status switch
        {
            "mfa-required" => "Your access role requires MFA. Set up and verify an authenticator before opening business data.",
            "password-changed" => "Your password was changed and all other sessions were signed out.",
            "sessions-revoked" => "All other sessions were signed out. This browser remains signed in.",
            "mfa-disabled" => "Authenticator MFA and all remaining recovery codes were disabled. Other sessions were signed out.",
            "email-verification-requested" => "A one-use verification link was queued for the account email address. If no message arrives, ask an administrator to review email delivery.",
            _ => null
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var requestContext = HttpContextAccessor.HttpContext;
        RequestIpAddress = requestContext?.Connection.RemoteIpAddress?.ToString() ?? string.Empty;
        RequestUserAgent = requestContext?.Request.Headers.UserAgent.ToString() ?? string.Empty;
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        Principal = principal;
        if (Guid.TryParse(principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId)
            && Guid.TryParse(principal.FindFirst(BrassLedgerAuthenticationDefaults.CompanyIdClaimType)?.Value, out var companyId)
            && Guid.TryParse(principal.FindFirst(BrassLedgerAuthenticationDefaults.SessionIdClaimType)?.Value, out var sessionId))
        {
            UserId = userId;
            CompanyId = companyId;
            SessionId = sessionId;
            Snapshot = await AuthenticationService.GetAccountSecurityAsync(UserId);
            Sessions = await UserSessionService.GetActiveAsync(UserId, SessionId, Principal);
        }
    }

    private async Task RevokeSessionAsync(Guid sessionId)
    {
        var revoked = await UserSessionService.RevokeAsync(
            UserId, CompanyId, sessionId, SessionId, Principal, RequestIpAddress, RequestUserAgent);
        LocalError = !revoked;
        LocalMessage = revoked
            ? "The selected browser session was signed out."
            : "That session was already inactive, expired, or could not be revoked.";
        Sessions = await UserSessionService.GetActiveAsync(UserId, SessionId, Principal);
    }

    private async Task BeginMfaEnrollmentAsync()
    {
        LocalMessage = null;
        Enrollment = await AuthenticationService.BeginMfaEnrollmentAsync(
            UserId,
            CompanyId,
            EnrollmentForm.CurrentPassword,
            RequestIpAddress,
            RequestUserAgent);
        LocalError = Enrollment.Outcome != MfaOperationOutcome.Succeeded;
        if (LocalError)
        {
            LocalMessage = Enrollment.Outcome == MfaOperationOutcome.InvalidPassword
                ? "The current password was not accepted. MFA setup did not begin."
                : "MFA setup could not begin for this account.";
            Enrollment = null;
        }
    }

    private async Task EnableMfaAsync()
    {
        if (!EnrollmentVerificationForm.RecoveryCodesSaved)
        {
            LocalError = true;
            LocalMessage = "Save the recovery codes and confirm that you have done so before enabling MFA.";
            return;
        }

        var result = await AuthenticationService.EnableMfaAsync(
            UserId,
            CompanyId,
            EnrollmentVerificationForm.VerificationCode,
            RequestIpAddress,
            RequestUserAgent);
        LocalError = result.Outcome != MfaOperationOutcome.Succeeded;
        if (LocalError)
        {
            LocalMessage = result.Outcome == MfaOperationOutcome.LockedOut
                ? "Authenticator verification is temporarily locked after repeated failures."
                : "The authenticator code was not accepted. Wait for a fresh code and try again.";
            return;
        }

        EnrollmentComplete = true;
        LocalMessage = null;
    }

    private async Task ReplaceRecoveryCodesAsync()
    {
        var result = await AuthenticationService.RegenerateMfaRecoveryCodesAsync(
            UserId,
            CompanyId,
            RecoveryReplacementForm.CurrentPassword,
            RecoveryReplacementForm.VerificationCode,
            RequestIpAddress,
            RequestUserAgent);
        LocalError = result.Outcome != MfaOperationOutcome.Succeeded;
        if (LocalError)
        {
            LocalMessage = "Recovery codes were not replaced. Check both the current password and second factor.";
            return;
        }

        ReplacementRecoveryCodes = result.RecoveryCodes;
        EnrollmentComplete = true;
        LocalMessage = null;
    }

    private static string FormatTimestamp(DateTimeOffset? timestamp) =>
        timestamp is null ? "Not recorded" : timestamp.Value.LocalDateTime.ToString("g");

    private static string FormatEvent(string eventType) => eventType.Replace('_', ' ');

    private sealed class MfaEnrollmentForm { public string CurrentPassword { get; set; } = string.Empty; }
    private sealed class MfaEnrollmentVerificationForm { public string VerificationCode { get; set; } = string.Empty; public bool RecoveryCodesSaved { get; set; } }
    private sealed class MfaRecoveryReplacementForm { public string CurrentPassword { get; set; } = string.Empty; public string VerificationCode { get; set; } = string.Empty; }
}
